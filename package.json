{
  "name": "things-to-do-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pakse-envelope.mjs && node scripts/prepare-pakse-stamped-envelope.mjs",
    "dev": "astro dev",
    "build": "node scripts/prepare-pakse-envelope.mjs && node scripts/prepare-pakse-stamped-envelope.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "prepare:pakse-envelope": "node scripts/prepare-pakse-envelope.mjs && node scripts/prepare-pakse-stamped-envelope.mjs",
    "images:sync": "node scripts/sync-place-images.mjs",
    "images:all": "node scripts/sync-place-images.mjs",
    "images:refresh-all": "node scripts/sync-place-images.mjs --refresh-generic",
    "images:pakse": "node scripts/sync-place-images.mjs --city=Pakse --country=Laos --refresh-generic",
    "images:vang-vieng": "node scripts/sync-place-images.mjs --city=\"Vang Vieng\" --country=Laos --category=cafes --refresh-generic && node scripts/sync-place-images.mjs --city=\"Vang Vieng\" --country=Laos --category=accommodation --refresh-generic && node scripts/sync-place-images.mjs --city=\"Vang Vieng\" --country=Laos --category=scooter-rental --refresh-generic && node scripts/sync-place-images.mjs --city=\"Vang Vieng\" --country=Laos --category=things-to-do --refresh-generic && node scripts/sync-place-images.mjs --city=\"Vang Vieng\" --country=Laos --category=gyms-fitness --refresh-generic",
    "images:audit": "node scripts/audit-place-image-system.mjs",
    "images:places": "node scripts/sync-place-images.mjs",
    "images:city": "node scripts/sync-place-images.mjs",
    "images:restaurants": "node scripts/sync-place-images.mjs --category=restaurants",
    "images:cafes": "node scripts/sync-place-images.mjs --category=cafes",
    "images:accommodation": "node scripts/sync-place-images.mjs --category=accommodation",
    "images:rentals": "node scripts/sync-place-images.mjs --category=scooter-rental",
    "images:activities": "node scripts/sync-place-images.mjs --category=things-to-do",
    "images:waterfalls": "node scripts/sync-place-images.mjs --category=waterfalls",
    "images:bolaven": "node scripts/sync-place-images.mjs --category=bolaven-loop",
    "images:gyms": "node scripts/sync-place-images.mjs --category=gyms-fitness",
    "images:markets": "node scripts/sync-place-images.mjs --category=markets-shopping",
    "images:essential": "node scripts/sync-place-images.mjs --category=essential-information"
  },
  "dependencies": {
    "astro": "^5.12.0",
    "typescript": "^5.9.0"
  }
}
