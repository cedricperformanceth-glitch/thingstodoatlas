---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  sectionLabel?: string;
}

const {
  title = 'Admin',
  description = 'Internal ThingsToDoAtlas workspace.',
  sectionLabel = 'Overview'
}: Props = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { href: '/admin', label: 'Overview', number: '00' },
  { href: '/admin/communication', label: 'Communication agents', number: '01' },
  { href: '/admin/conversations', label: 'Conversation agents', number: '02' },
  { href: '/admin/seo', label: 'SEO & analytics', number: '03' }
].map((item) => ({ ...item, active: currentPath === item.href }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#203c31" />
    <title>{title} | ThingsToDoAtlas Admin</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar" aria-label="Admin navigation">
        <a class="admin-brand" href="/admin" aria-label="ThingsToDoAtlas admin home">
          <span class="admin-brand__wordmark">Things<span>ToDo</span>Atlas</span>
          <small>Control room</small>
        </a>

        <div class="admin-sidebar__label">Workspace map</div>
        <nav class="admin-nav">
          {navigation.map((item) => (
            <a
              class:list={['admin-nav__link', { 'is-active': item.active }]}
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              <span>{item.number}</span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>

        <div class="admin-sidebar__note">
          <span class="admin-status-dot" aria-hidden="true"></span>
          <p><strong>Architecture phase</strong><br />No agent or external service is connected.</p>
        </div>

        <a class="admin-back-link" href="/">
          <span aria-hidden="true">←</span>
          View the public atlas
        </a>
      </aside>

      <div class="admin-workspace">
        <header class="admin-topbar">
          <div>
            <span>Internal workspace</span>
            <strong>{sectionLabel}</strong>
          </div>
          <div class="admin-topbar__status"><i aria-hidden="true"></i> Structure only</div>

          <details class="admin-mobile-menu">
            <summary>Admin menu</summary>
            <nav aria-label="Mobile admin navigation">
              {navigation.map((item) => (
                <a
                  class:list={{ 'is-active': item.active }}
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                >
                  <span>{item.number}</span>{item.label}
                </a>
              ))}
              <a href="/"><span>←</span>Public atlas</a>
            </nav>
          </details>
        </header>

        <main class="admin-main">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  .admin-body {
    min-height: 100vh;
    margin: 0;
    padding: 0;
    background:
      linear-gradient(rgba(49, 85, 69, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(49, 85, 69, .025) 1px, transparent 1px),
      var(--paper);
    background-size: 36px 36px;
    color: var(--ink);
  }

  .admin-shell {
    display: grid;
    grid-template-columns: 286px minmax(0, 1fr);
    min-height: 100vh;
  }

  .admin-sidebar {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding: 34px 26px 28px;
    overflow-y: auto;
    background: var(--green-dark);
    color: #f7f2e7;
    border-right: 1px solid rgba(255, 255, 255, .08);
  }

  .admin-brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    width: fit-content;
    margin-bottom: 54px;
  }

  .admin-brand__wordmark {
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: -.055em;
  }

  .admin-brand__wordmark span { color: #e19a73; }

  .admin-brand small {
    color: rgba(255, 255, 255, .55);
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-size: 1.08rem;
    letter-spacing: .03em;
    transform: rotate(-2deg);
  }

  .admin-sidebar__label {
    margin: 0 12px 14px;
    color: rgba(255, 255, 255, .42);
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .admin-nav {
    display: grid;
    gap: 6px;
  }

  .admin-nav__link {
    position: relative;
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;
    align-items: center;
    min-height: 52px;
    padding: 10px 12px;
    color: rgba(255, 255, 255, .66);
    border: 1px solid transparent;
    transition: color .2s ease, background .2s ease, transform .2s ease;
  }

  .admin-nav__link span {
    color: rgba(255, 255, 255, .34);
    font-family: Fraunces, serif;
    font-size: .72rem;
  }

  .admin-nav__link strong {
    font-size: .77rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .admin-nav__link:hover,
  .admin-nav__link:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, .055);
    outline: none;
    transform: translateX(2px);
  }

  .admin-nav__link.is-active {
    color: #fff;
    background: rgba(255, 255, 255, .08);
    border-color: rgba(225, 154, 115, .38);
  }

  .admin-nav__link.is-active::before {
    content: '';
    position: absolute;
    top: 11px;
    bottom: 11px;
    left: -1px;
    width: 3px;
    background: #e19a73;
  }

  .admin-nav__link.is-active span { color: #e7aa86; }

  .admin-sidebar__note {
    display: grid;
    grid-template-columns: 9px 1fr;
    gap: 10px;
    margin-top: auto;
    padding: 17px 14px;
    border: 1px dashed rgba(255, 255, 255, .17);
    background: rgba(255, 255, 255, .035);
  }

  .admin-sidebar__note p {
    margin: 0;
    color: rgba(255, 255, 255, .54);
    font-size: .67rem;
    line-height: 1.6;
  }

  .admin-sidebar__note strong {
    color: rgba(255, 255, 255, .8);
    font-weight: 600;
  }

  .admin-status-dot {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: #e19a73;
    box-shadow: 0 0 0 4px rgba(225, 154, 115, .1);
  }

  .admin-back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    color: rgba(255, 255, 255, .56);
    font-size: .68rem;
    font-weight: 600;
  }

  .admin-back-link:hover,
  .admin-back-link:focus-visible { color: #fff; outline: none; }

  .admin-workspace { min-width: 0; }

  .admin-topbar {
    position: sticky;
    z-index: 10;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    padding: 14px clamp(26px, 4vw, 58px);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
  }

  .admin-topbar > div:first-child {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .admin-topbar > div:first-child span {
    color: var(--muted);
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .admin-topbar > div:first-child strong {
    color: var(--green);
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-size: 1.14rem;
    font-weight: 600;
  }

  .admin-topbar__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .admin-topbar__status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .admin-mobile-menu { display: none; }

  .admin-main {
    width: min(1180px, calc(100% - clamp(52px, 8vw, 116px)));
    margin: 0 auto;
    padding: clamp(56px, 7vw, 92px) 0 100px;
  }

  .admin-page { display: grid; gap: 58px; }

  .admin-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr);
    gap: clamp(42px, 7vw, 92px);
    align-items: end;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }

  .admin-hero--section { align-items: center; }

  .admin-kicker {
    margin-bottom: 20px;
    color: var(--terracotta);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .admin-hero h1 {
    max-width: 820px;
    margin-bottom: 24px;
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .admin-hero--section h1 { font-size: clamp(2.9rem, 5.4vw, 5.2rem); }

  .admin-hero__lede {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(.96rem, 1.25vw, 1.08rem);
    line-height: 1.75;
  }

  .admin-paper-note {
    position: relative;
    padding: 26px 25px 24px;
    border: 1px solid #d6ccba;
    background: #f8f2e5;
    box-shadow: 8px 9px 0 rgba(49, 85, 69, .055);
    transform: rotate(1deg);
  }

  .admin-paper-note::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 72px;
    height: 18px;
    background: rgba(199, 184, 145, .42);
    transform: translateX(-50%) rotate(-2deg);
  }

  .admin-paper-note > span {
    display: block;
    margin-bottom: 14px;
    color: var(--terracotta);
    font-family: 'Caveat', 'Segoe Print', cursive;
    font-size: 1.18rem;
    font-weight: 600;
  }

  .admin-paper-note p,
  .admin-paper-note ol {
    margin: 0;
    color: var(--muted);
    font-size: .77rem;
    line-height: 1.65;
  }

  .admin-paper-note ol { padding-left: 19px; }
  .admin-paper-note li + li { margin-top: 4px; }

  .admin-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 25px;
  }

  .admin-section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.8vw, 3.35rem);
  }

  .admin-section-heading p {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.65;
    text-align: right;
  }

  .admin-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .admin-area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--white) 68%, var(--paper));
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .admin-area-card::after {
    content: '';
    position: absolute;
    right: -42px;
    bottom: -52px;
    width: 150px;
    height: 150px;
    border: 1px dashed rgba(49, 85, 69, .15);
    border-radius: 50%;
  }

  .admin-area-card:hover,
  .admin-area-card:focus-visible {
    outline: none;
    border-color: rgba(49, 85, 69, .42);
    box-shadow: 0 18px 45px rgba(37, 41, 35, .08);
    transform: translateY(-4px);
  }

  .admin-area-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 46px;
  }

  .admin-area-card__number {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--terracotta);
    border-radius: 50%;
    color: var(--terracotta);
    font-family: Fraunces, serif;
    font-size: .88rem;
  }

  .admin-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .admin-pill::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .admin-area-card h3 {
    margin: 0 0 15px;
    font-size: clamp(1.8rem, 2.7vw, 2.55rem);
    letter-spacing: -.04em;
  }

  .admin-area-card > p {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: .79rem;
    line-height: 1.7;
  }

  .admin-area-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px dashed var(--line);
    color: var(--green);
    font-size: .68rem;
    font-weight: 700;
  }

  .admin-area-card__meta span:last-child { font-size: 1.05rem; }

  .admin-scope-banner {
    display: grid;
    grid-template-columns: minmax(150px, .35fr) 1fr;
    gap: 30px;
    padding: 28px 30px;
    border-left: 3px solid var(--green);
    background: rgba(49, 85, 69, .06);
  }

  .admin-scope-banner strong {
    color: var(--green);
    font-family: Fraunces, serif;
    font-size: 1.3rem;
    font-weight: 500;
  }

  .admin-scope-banner p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.7;
  }

  .admin-blueprint {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    gap: 24px;
    align-items: start;
  }

  .admin-panel {
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--white) 72%, var(--paper));
  }

  .admin-panel--dark {
    background: var(--green-dark);
    color: #fffdf8;
    border-color: var(--green-dark);
  }

  .admin-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
    padding-bottom: 21px;
    border-bottom: 1px solid var(--line);
  }

  .admin-panel--dark .admin-panel__header { border-color: rgba(255, 255, 255, .14); }

  .admin-panel__header h2 {
    margin: 0 0 7px;
    font-size: clamp(1.65rem, 2.6vw, 2.35rem);
  }

  .admin-panel__header p {
    margin: 0;
    color: var(--muted);
    font-size: .73rem;
  }

  .admin-panel--dark .admin-panel__header p { color: rgba(255, 255, 255, .55); }

  .admin-agent-list { display: grid; gap: 12px; }

  .admin-agent-card {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 17px 18px;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .admin-agent-card__index {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(183, 102, 69, .5);
    border-radius: 50%;
    color: var(--terracotta);
    font-family: Fraunces, serif;
    font-size: .72rem;
  }

  .admin-agent-card h3 {
    margin: 0 0 5px;
    font-family: 'DM Sans', sans-serif;
    font-size: .84rem;
    font-weight: 700;
    letter-spacing: -.01em;
  }

  .admin-agent-card p {
    margin: 0;
    color: var(--muted);
    font-size: .7rem;
    line-height: 1.55;
  }

  .admin-agent-card__status {
    color: var(--muted);
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .admin-rail-list { display: grid; gap: 0; }

  .admin-rail-item {
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .13);
  }

  .admin-rail-item:first-child { padding-top: 0; }
  .admin-rail-item:last-child { padding-bottom: 0; border-bottom: 0; }

  .admin-rail-item span {
    display: block;
    margin-bottom: 6px;
    color: #e7aa86;
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .admin-rail-item strong {
    display: block;
    margin-bottom: 6px;
    font-family: Fraunces, serif;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .admin-rail-item p {
    margin: 0;
    color: rgba(255, 255, 255, .55);
    font-size: .69rem;
    line-height: 1.6;
  }

  .admin-connection-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .admin-connection-card {
    min-height: 190px;
    padding: 22px;
    border: 1px dashed #c9c2b5;
    background: rgba(255, 253, 248, .45);
  }

  .admin-connection-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }

  .admin-connection-card__top span:first-child {
    color: var(--terracotta);
    font-family: Fraunces, serif;
    font-size: .72rem;
  }

  .admin-connection-card__top span:last-child {
    color: var(--muted);
    font-size: .54rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .admin-connection-card h3 {
    margin: 0 0 9px;
    font-family: 'DM Sans', sans-serif;
    font-size: .84rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .admin-connection-card p {
    margin: 0;
    color: var(--muted);
    font-size: .7rem;
    line-height: 1.6;
  }

  .admin-checklist {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .admin-checklist li {
    position: relative;
    padding: 13px 0 13px 27px;
    border-bottom: 1px dashed var(--line);
    color: var(--muted);
    font-size: .75rem;
    line-height: 1.55;
  }

  .admin-checklist li::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 2px;
    width: 10px;
    height: 10px;
    border: 1px solid var(--terracotta);
    transform: rotate(4deg);
  }

  .admin-placeholder-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 25px 28px;
    border: 1px solid rgba(49, 85, 69, .2);
    background: rgba(49, 85, 69, .055);
  }

  .admin-placeholder-action strong {
    display: block;
    margin-bottom: 5px;
    color: var(--green);
    font-family: Fraunces, serif;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .admin-placeholder-action p {
    margin: 0;
    color: var(--muted);
    font-size: .72rem;
  }

  .admin-placeholder-action button {
    flex: 0 0 auto;
    padding: 11px 16px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 700 .59rem/1 'DM Sans', sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: not-allowed;
  }

  @media (max-width: 1050px) {
    .admin-card-grid,
    .admin-connection-grid { grid-template-columns: 1fr; }
    .admin-area-card { min-height: 260px; }
    .admin-area-card__top { margin-bottom: 30px; }
    .admin-blueprint { grid-template-columns: 1fr; }
  }

  @media (max-width: 860px) {
    .admin-shell { display: block; }
    .admin-sidebar { display: none; }
    .admin-topbar {
      min-height: 68px;
      padding: 12px 20px;
    }
    .admin-topbar > div:first-child,
    .admin-topbar__status { display: none; }
    .admin-mobile-menu {
      display: block;
      width: 100%;
    }
    .admin-mobile-menu summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: var(--green);
      font-family: 'Caveat', 'Segoe Print', cursive;
      font-size: 1.2rem;
      font-weight: 600;
      list-style: none;
    }
    .admin-mobile-menu summary::-webkit-details-marker { display: none; }
    .admin-mobile-menu summary::after { content: '+'; font-family: 'DM Sans', sans-serif; }
    .admin-mobile-menu[open] summary::after { content: '−'; }
    .admin-mobile-menu nav {
      display: grid;
      gap: 4px;
      padding: 18px 0 7px;
    }
    .admin-mobile-menu nav a {
      display: flex;
      gap: 13px;
      padding: 11px 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: .76rem;
      font-weight: 600;
    }
    .admin-mobile-menu nav a span { width: 24px; color: var(--terracotta); }
    .admin-mobile-menu nav a.is-active { color: var(--green); }
    .admin-main {
      width: min(100% - 32px, 720px);
      padding: 48px 0 78px;
    }
    .admin-hero {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-bottom: 38px;
    }
    .admin-paper-note { max-width: 420px; }
    .admin-section-heading {
      display: block;
      margin-bottom: 22px;
    }
    .admin-section-heading p {
      margin-top: 13px;
      text-align: left;
    }
    .admin-scope-banner { grid-template-columns: 1fr; gap: 9px; }
  }

  @media (max-width: 560px) {
