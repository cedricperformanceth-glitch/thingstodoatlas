---
import '../styles/global.css';
import '../styles/atlas-system.css';
import '../styles/restaurant-polaroids.css';
import '../styles/sri-lanka-cleanup.css';
import '../styles/sri-lanka-ticket.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TripDrawer from '../components/TripDrawer.astro';
import TripPageContext from '../components/TripPageContext.astro';
import TripManager from '../components/TripManager.astro';
import TripSummaryModal from '../components/TripSummaryModal.astro';

const {
  title,
  description = 'A thoughtful guide to places worth your time across Asia.',
  canonical = 'https://thingstodoatlas.com/'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>{title} | ThingsToDoAtlas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ThingsToDoAtlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <SiteHeader />

    <main id="main-content">
      <slot />
    </main>

    <TripDrawer />
    <TripPageContext />
    <TripManager />
    <TripSummaryModal />

    <SiteFooter />
  </body>
</html>
