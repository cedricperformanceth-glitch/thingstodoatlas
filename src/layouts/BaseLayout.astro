---
import '../styles/global.css';
import '../styles/atlas-system.css';
import '../styles/restaurant-polaroids.css';
import '../styles/sri-lanka-cleanup.css';
import '../styles/sri-lanka-ticket.css';
import '../styles/site-header.css';
import '../styles/site-footer.css';
import '../styles/shared-layout-fixes.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TripDrawer from '../components/TripDrawer.astro';
import TripPageContext from '../components/TripPageContext.astro';
import TripManager from '../components/TripManager.astro';
import TripSummaryModal from '../components/TripSummaryModal.astro';
import JourneyUxEnhancements from '../components/JourneyUxEnhancements.astro';

const {
  title,
  description = 'A thoughtful guide to places worth your time across Asia.',
  canonical = 'https://thingstodoatlas.com/'
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomepage = normalizedPath === '/';
const isPaksePage = normalizedPath === '/laos/pakse';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>{title} | ThingsToDoAtlas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ThingsToDoAtlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class={isHomepage ? 'is-homepage' : undefined}>
    <SiteHeader />

    <div id="main-content" role="main">
      {isPaksePage && <a class="pakse-map-back" href="/laos">← Back to the Laos map</a>}
      <slot />
      <JourneyUxEnhancements />
    </div>

    <TripDrawer />
    <TripPageContext />
    <TripManager />
    <TripSummaryModal />

    <SiteFooter />
  </body>
</html>

<style is:global>
  .is-homepage .atlas-hero__copy > .button--arrow {
    display: none;
  }

  .pakse-map-back {
    position: absolute;
    z-index: 20;
    top: clamp(5.5rem, 7vw, 6.75rem);
    right: max(1.25rem, calc((100vw - 1180px) / 2));
    display: inline-flex;
    margin: 0;
    color: rgba(31, 57, 45, .62);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .pakse-map-back:hover,
  .pakse-map-back:focus-visible {
    color: #8a4d36;
  }

  .pakse-page .pakse-hero__boat > .pakse-hero__field-note {
    display: block;
    width: max-content;
    max-width: calc(100% + 3rem);
    margin: .15rem auto .2rem;
    text-align: center;
    white-space: nowrap;
    transform: rotate(-5deg);
    transform-origin: center;
  }

  @media (min-width: 701px) {
    .atlas-hero__copy .hero-hand-note {
      bottom: 9.5rem;
    }
  }

  @media (max-width: 820px) {
    .pakse-map-back {
      top: 4rem;
      right: 1rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const placePakseFieldNote = () => {
      const boat = document.querySelector('.pakse-page .pakse-hero__boat');
      const note = document.querySelector('.pakse-page .pakse-hero__field-note');
      if (!(boat instanceof HTMLElement) || !(note instanceof HTMLElement) || note.parentElement === boat) return;
      const caption = boat.querySelector('figcaption');
      if (caption) caption.insertAdjacentElement('beforebegin', note);
      else boat.append(note);
    };

    document.addEventListener('astro:page-load', placePakseFieldNote);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placePakseFieldNote, { once: true });
    else placePakseFieldNote();
  })();
</script>