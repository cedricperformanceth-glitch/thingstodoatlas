---
import '../styles/global.css';
import '../styles/restaurant-polaroids.css';
import '../styles/sri-lanka-cleanup.css';
import PlanMyTrip from '../components/PlanMyTrip.astro';
const { title, description = 'A thoughtful guide to places worth your time across Asia.', canonical = 'https://thingstodoatlas.com/' } = Astro.props;
const countries = [
  { name: 'Thailand', href: '/#country-thailand', slug: 'thailand', number: '01' },
  { name: 'Laos', href: '/laos', slug: 'laos', number: '02' },
  { name: 'Sri Lanka', href: '/#country-sri-lanka', slug: 'sri-lanka', number: '03' }
];
const currentPath = Astro.url.pathname;
const isPakseCafePage = currentPath === '/laos/pakse/cafes' || currentPath === '/laos/pakse/cafes/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | ThingsToDoAtlas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ThingsToDoAtlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class:list={[{ 'cafe-category-page': isPakseCafePage }]}>
    <header class="site-header">
      <a class="site-logo" href="/" aria-label="ThingsToDoAtlas home">
        <img src="https://raw.githubusercontent.com/cedricperformanceth-glitch/thingstodoatlas/master/calque%20SVG/ChatGPT%20Image%2026%20juil.%202026%2C%2001_49_26_result.webp" alt="ThingsToDoAtlas" width="1536" height="1024" />
      </a>
      <nav class="country-nav" aria-label="Choose a country">
        {countries.map((country) => <a class:list={[{ 'is-active': currentPath.startsWith(`/${country.slug}`), 'is-coming-soon': country.slug !== 'laos' }]} href={country.href} aria-current={currentPath.startsWith(`/${country.slug}`) ? 'page' : undefined}><span class="nav-chapter">{country.number}</span>{country.name}{country.slug !== 'laos' && <sup>soon</sup>}</a>)}
      </nav>
      <span class="header-note">Field Notes <i aria-hidden="true">·</i> Vol. 01</span>
    </header>
    <main><slot /></main>
    {isPakseCafePage && (
      <script is:inline>
        const cafeHeading = document.querySelector('.chapter-sheet__title');
        const cafeAside = cafeHeading?.querySelector('.chapter-sheet__aside');
        if (cafeHeading && cafeAside && !cafeHeading.querySelector('.cafe-heading-art')) {
          const artwork = document.createElement('div');
          artwork.className = 'cafe-heading-art';
          artwork.setAttribute('aria-hidden', 'true');
          artwork.innerHTML = `
            <svg viewBox="0 0 260 210" role="presentation" focusable="false">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <g transform="translate(94 22) rotate(-11)">
                  <path d="M4 28C5 10 18-2 33 1c15 3 23 19 18 35-5 17-21 28-35 23C5 55 2 42 4 28Z" stroke-width="2.25" />
                  <path d="M31 5c-8 8-9 17-4 25 5 8 5 16-3 25" stroke-width="1.75" />
                  <path d="M12 18l11-7M8 30l13-8M8 41l12-7M36 12l10 8M34 25l12 8M32 39l9 7" stroke-width=".8" opacity=".42" />
                </g>
                <g transform="translate(42 55) rotate(-34)">
                  <path d="M3 25C5 9 17-1 30 1c15 2 23 17 19 32-4 16-18 27-31 24C6 54 1 41 3 25Z" stroke-width="2.15" />
                  <path d="M29 5c-7 8-8 15-4 22 5 8 5 15-3 25" stroke-width="1.65" />
                  <path d="M10 16l10-6M7 27l12-7M8 39l10-6M34 12l9 7M33 25l10 7M31 38l8 6" stroke-width=".78" opacity=".4" />
                </g>
                <g transform="translate(142 58) rotate(24)">
                  <path d="M3 26C4 9 17-1 31 1c15 2 24 18 20 34-4 17-19 28-32 24C6 55 1 42 3 26Z" stroke-width="2.2" />
                  <path d="M31 5c-8 8-8 16-4 24 5 8 5 16-3 25" stroke-width="1.7" />
                  <path d="M10 16l11-7M7 28l13-8M8 40l11-7M36 13l9 7M35 27l10 7M33 40l8 6" stroke-width=".8" opacity=".42" />
                </g>
                <g transform="translate(78 92) rotate(9)">
                  <path d="M3 31C4 11 19-2 35 1c18 3 28 22 23 40-5 20-22 33-38 28C6 65 1 49 3 31Z" stroke-width="2.55" />
                  <path d="M35 6c-9 10-10 20-4 29 6 10 6 19-4 29" stroke-width="1.95" />
                  <path d="M12 19l13-8M8 32l15-9M9 46l14-8M42 14l11 8M41 29l12 8M39 45l10 7M18 57l12-7" stroke-width=".9" opacity=".44" />
                </g>
                <g transform="translate(132 110) rotate(-21)">
                  <path d="M3 30C5 11 19-2 35 1c17 3 27 21 22 39-5 19-21 32-37 28C6 64 1 48 3 30Z" stroke-width="2.5" />
                  <path d="M35 6c-9 10-10 19-4 28 6 10 6 19-4 29" stroke-width="1.9" />
                  <path d="M12 18l13-8M8 31l15-9M9 45l14-8M42 14l10 8M41 29l11 8M39 44l9 7" stroke-width=".88" opacity=".44" />
                </g>
                <g transform="translate(188 98) rotate(38)">
                  <path d="M3 23C4 8 15-1 27 1c13 2 21 15 17 29-4 15-16 24-28 21C5 48 1 37 3 23Z" stroke-width="2" />
                  <path d="M27 5c-7 7-7 13-3 20 4 7 4 13-3 22" stroke-width="1.55" />
                  <path d="M9 14l9-6M7 24l10-6M8 35l9-5M31 11l8 6M30 23l8 6M28 35l7 5" stroke-width=".72" opacity=".38" />
                </g>
                <g transform="translate(28 128) rotate(-8)">
                  <path d="M3 21C4 8 14 0 25 1c12 2 19 13 16 26-3 13-14 22-25 20C6 45 1 34 3 21Z" stroke-width="1.9" />
                  <path d="M25 5c-6 6-7 12-3 18 4 6 4 12-3 20" stroke-width="1.45" />
                  <path d="M8 13l8-5M6 22l9-5M7 32l8-5M29 10l7 5M28 20l7 5M27 31l6 4" stroke-width=".7" opacity=".36" />
                </g>
                <path d="M33 177c27 6 61 7 89 2M112 184c31 5 73 3 105-5M66 190c18 3 37 3 55 0" stroke-width="1" opacity=".22" />
                <path d="M49 170l13-2M74 177l15-2M103 172l11-2M145 180l14-2M181 173l13-2" stroke-width=".85" opacity=".25" />
              </g>
            </svg>`;
          cafeHeading.insertBefore(artwork, cafeAside);
        }
      </script>
    )}
    <PlanMyTrip />
    <footer class="site-footer"><div><a class="wordmark" href="/">Things<span>ToDo</span>Atlas</a><p>A practical atlas for places worth your time.</p></div><small>Built for the curious. Chapters open as they are ready.</small></footer>
    <nav class="bottom-country-bar" aria-label="Country chapters">
      {countries.map((country) => <a class:list={[{ 'is-active': currentPath.startsWith(`/${country.slug}`), 'is-coming-soon': country.slug !== 'laos' }]} href={country.href} aria-current={currentPath.startsWith(`/${country.slug}`) ? 'page' : undefined}><span class="bottom-chapter">{country.number}</span>{country.name}</a>)}
    </nav>
  </body>
</html>

<style is:global>
  .plan-trip-widget[hidden],
  .plan-trip-drawer[hidden],
  .plan-trip-drawer__foot[hidden] {
    display: none;
  }

  body.cafe-category-page .chapter-sheet__title {
    grid-template-columns: minmax(0, 1.55fr) minmax(150px, .5fr) minmax(275px, .72fr);
    gap: clamp(24px, 3vw, 54px);
  }

  .cafe-heading-art {
    display: grid;
    place-items: center;
    align-self: center;
    width: min(100%, 230px);
    margin: 0 auto;
    color: var(--green);
    pointer-events: none;
  }

  .cafe-heading-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  @media (max-width: 980px) {
    body.cafe-category-page .chapter-sheet__title {
      grid-template-columns: minmax(0, 1.25fr) minmax(125px, .42fr) minmax(240px, .72fr);
      gap: 24px;
    }

    .cafe-heading-art { width: min(100%, 175px); }
  }

  @media (max-width: 700px) {
    body.cafe-category-page .chapter-sheet__title {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .cafe-heading-art {
      width: 150px;
      margin: -4px auto 0;
    }
  }
</style>