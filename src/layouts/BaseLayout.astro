---
import '../styles/global.css';
import '../styles/atlas-system.css';
import '../styles/restaurant-polaroids.css';
import '../styles/sri-lanka-cleanup.css';
import '../styles/sri-lanka-ticket.css';
import '../styles/site-header.css';
import '../styles/site-footer.css';
import '../styles/shared-layout-fixes.css';
import '../styles/pakse-envelope-hero.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TripDrawer from '../components/TripDrawer.astro';
import TripPageContext from '../components/TripPageContext.astro';
import TripManager from '../components/TripManager.astro';
import TripSummaryModal from '../components/TripSummaryModal.astro';
import JourneyUxEnhancements from '../components/JourneyUxEnhancements.astro';
import VangViengMapActivation from '../components/VangViengMapActivation.astro';
import LandmarkPageBridge from '../components/LandmarkPageBridge.astro';
import TadLoExplorePageBridge from '../components/TadLoExplorePageBridge.astro';
import LandmarkPageBackHistory from '../components/LandmarkPageBackHistory.astro';
import LaosEditorialGuideLink from '../components/LaosEditorialGuideLink.astro';

const {
  title,
  description = 'A thoughtful guide to places worth your time across Asia.',
  canonical = 'https://thingstodoatlas.com/',
  image,
  imageAlt = title,
  structuredData
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomepage = normalizedPath === '/';
const isLaosMap = normalizedPath === '/laos';
const socialImage = image ? new URL(image, canonical).href : undefined;
const structuredDataItems = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>{title} | ThingsToDoAtlas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ThingsToDoAtlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} | ThingsToDoAtlas`} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body class={isHomepage ? 'is-homepage' : undefined}>
    <SiteHeader />

    <div id="main-content" role="main">
      <slot />
      {isLaosMap && <LaosEditorialGuideLink />}
      <JourneyUxEnhancements />
      <VangViengMapActivation />
      <LandmarkPageBridge />
      <TadLoExplorePageBridge />
      <LandmarkPageBackHistory />
    </div>

    <TripDrawer />
    <TripPageContext />
    <TripManager />
    <TripSummaryModal />

    <SiteFooter />
  </body>
</html>

<style is:global>
  .is-homepage .atlas-hero__copy > .button--arrow {
    display: none;
  }

  @media (min-width: 701px) {
    .atlas-hero__copy .hero-hand-note {
      bottom: 9.5rem;
    }
  }
</style>
