  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v4l3 2',
  pin: 'M12 21s6-5.3 6-11a6 6 0 1 0-12 0c0 5.7 6 11 6 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  cash: 'M4 7h16v10H4V7Zm4 0a4 4 0 0 1-4 4m16 0a4 4 0 0 1-4-4m-8 10a4 4 0 0 0-4-4m16 0a4 4 0 0 0-4 4m-4-7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z',
  wallet: 'M4 6.5h13a2 2 0 0 1 2 2v9H5a2 2 0 0 1-2-2v-8a3 3 0 0 1 3-3h10v2M14 11h6v4h-6a2 2 0 0 1 0-4Z',
  qr: 'M4 4h5v5H4V4Zm11 0h5v5h-5V4ZM4 15h5v5H4v-5Zm11 0h2v2h-2v-2Zm3 0h2v5h-5v-2h3v-3Z',
