---
interface Props {
  label: string;
}

const { label } = Astro.props;
const value = label.toLowerCase();

let icon = 'compass';

if (value.includes('passport') || value.includes('visa')) icon = 'passport';
else if (value.includes('processing') || value.includes('time') || value.includes('duration')) icon = 'clock';
else if (value.includes('entry point') || value.includes('location') || value.includes('getting there')) icon = 'pin';
else if (value.includes('currency') || value.includes('cash') || value.includes('price')) icon = 'cash';
else if (value.includes('habit') || value.includes('withdraw')) icon = 'wallet';
else if (value.includes('qr') || value.includes('payment')) icon = 'qr';
else if (value.includes('backup') || value.includes('card')) icon = 'card';
else if (value.includes('navigation') || value.includes('map')) icon = 'map';
else if (value.includes('translation') || value.includes('language')) icon = 'translate';
else if (value.includes('communication') || value.includes('message')) icon = 'message';
else if (value.includes('phone') || value.includes('sim')) icon = 'phone';
else if (value.includes('north') || value.includes('rail') || value.includes('train')) icon = 'train';
else if (value.includes('central') || value.includes('road')) icon = 'road';
else if (value.includes('south')) icon = 'direction';
else if (value.includes('planning') || value.includes('next step')) icon = 'calendar';

const paths: Record<string, string> = {
