---
const { place, index = 0, href } = Astro.props;
const cardNumber = String(index + 1).padStart(2, '0');
---

<article class="activity-link-card" id={place.slug}>
  <a href={href} aria-label={`Open ${place.name} activity page`}>
    <div class="activity-link-card__image">
      <img src={place.image} alt={place.imageAlt} width="720" height="520" loading="lazy" decoding="async" />
      <span class="activity-link-card__number" aria-hidden="true">{cardNumber}</span>
      <span class="activity-link-card__source">WITH {place.partnerName.toUpperCase()}</span>
    </div>
    <div class="activity-link-card__copy">
      <p>{place.subcategory}</p>
      <h3>{place.name}</h3>
      <span>{place.shortDescription}</span>
      <footer><small>ACTIVITY PAGE</small><b aria-hidden="true">↗</b></footer>
    </div>
  </a>
</article>

<style>
  .activity-link-card{min-width:0;border:1px solid rgba(75,81,70,.22);background:#eee8dc;box-shadow:5px 7px 0 rgba(49,85,69,.07);transition:transform .22s ease,box-shadow .22s ease}
  .activity-link-card:hover{transform:translateY(-4px);box-shadow:8px 11px 0 rgba(49,85,69,.1)}
  .activity-link-card>a{display:block;height:100%;color:inherit;text-decoration:none}
  .activity-link-card__image{position:relative;height:215px;overflow:hidden;background:var(--paper-deep)}
  .activity-link-card__image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(24,31,26,.48));pointer-events:none}
  .activity-link-card__image img{width:100%;height:100%;object-fit:cover;filter:saturate(.76) contrast(.96)}
  .activity-link-card__number{position:absolute;z-index:2;top:14px;left:14px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(255,253,248,.8);border-radius:50%;background:rgba(32,60,49,.82);color:#fffdf8;font:500 .95rem/1 Fraunces,serif}
  .activity-link-card__source{position:absolute;z-index:2;right:13px;bottom:12px;padding:6px 8px;border:1px solid rgba(255,253,248,.72);background:rgba(32,60,49,.74);color:#fffdf8;font:700 .48rem/1 'DM Sans',sans-serif;letter-spacing:.12em}
  .activity-link-card__copy{display:flex;min-height:220px;flex-direction:column;padding:24px 23px 22px}
  .activity-link-card__copy p{margin:0 0 10px;color:var(--terracotta);font-size:.57rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .activity-link-card__copy h3{margin:0 0 11px;color:var(--green);font:500 clamp(1.55rem,2.2vw,2.05rem)/1.06 Fraunces,serif}
  .activity-link-card__copy>span{color:var(--muted);font-size:.79rem;line-height:1.55}
  .activity-link-card footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:20px;border-top:1px solid rgba(49,85,69,.15);color:var(--green)}
  .activity-link-card footer small{font-size:.52rem;font-weight:800;letter-spacing:.12em}
  .activity-link-card footer b{color:var(--terracotta);font:500 1rem/1 Fraunces,serif}
  .activity-link-card>a:focus-visible{outline:2px solid var(--terracotta);outline-offset:4px}
  @media(max-width:700px){.activity-link-card__image{height:220px}.activity-link-card__copy{min-height:0}}
  @media(prefers-reduced-motion:reduce){.activity-link-card{transition:none}}
</style>
