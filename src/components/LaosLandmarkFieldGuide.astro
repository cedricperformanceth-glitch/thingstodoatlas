---
import LandmarkGuideFinalCta from './LandmarkGuideFinalCta.astro';
import type { LandmarkGalleryItem } from '../data/laosLandmarks';
import type { LaosLandmarkPageEntry } from '../data/laosLandmarkPageRegistry';
import { getRelatedLandmarkPages } from '../data/laosLandmarkPageRegistry';
import { laosLandmarkPageEditorial } from '../data/laosLandmarkPageEditorial';
import { laosLandmarkPageFieldNotes } from '../data/laosLandmarkPageFieldNotes';
import { laosLandmarkPageFacts } from '../data/laosLandmarkPageFacts';
import { getLicensedLandmarkGallery } from '../data/laosLandmarkLicensedMedia';
import { getLandmarkPagePresentation } from '../data/laosLandmarkPagePresentation';

interface Props {
  entry: LaosLandmarkPageEntry;
}

const { entry } = Astro.props;
const { landmark } = entry;
const guide = laosLandmarkPageEditorial[entry.slug] || entry.guide;
const pageFieldNote = laosLandmarkPageFieldNotes[entry.slug];
const presentation = getLandmarkPagePresentation(entry.slug);
const isExpeditionLayout = presentation.layoutVariant === 'expedition';
const licensedGallery = getLicensedLandmarkGallery(entry.slug, landmark.gallery);
const images: LandmarkGalleryItem[] = licensedGallery.length
  ? licensedGallery
  : [{ src: '/images/laos/pakse.webp', alt: landmark.name }];
const hero = images[0];
const second = images[1] || images[0];
const third = images[2] || images[1] || images[0];
const related = getRelatedLandmarkPages(entry);
const sections = guide.sections.slice(0, 4);
const facts = (laosLandmarkPageFacts[entry.slug] || landmark.facts).slice(0, 6);

const sourceCaption = (image: LandmarkGalleryItem) => ({
  author: image.author || 'Source photo',
  source: image.sourcePage || '',
  license: image.license || ''
});

const heroCredit = sourceCaption(hero);
const secondCredit = sourceCaption(second);
const thirdCredit = sourceCaption(third);

const questions = presentation.faq || facts.slice(0, 5).map((item) => ({
  question: item.label.endsWith('?') ? item.label : `${item.label}?`,
  answer: item.value
}));
---

<main class="field-guide-page">
  <nav class="field-guide-return" aria-label={`${landmark.name} guide navigation`}>
    <button type="button" data-landmark-page-back><span aria-hidden="true">←</span> Back to where you were</button>
    <a href={`${entry.sourceRoute}#explore-board-${entry.citySlug}`}>{entry.cityName} field guide</a>
  </nav>

  <article class="field-guide-article" aria-labelledby={`landmark-title-${entry.slug}`}>
    <nav class="field-guide-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Atlas</a><span aria-hidden="true">/</span>
      <a href="/laos">Laos</a><span aria-hidden="true">/</span>
      <a href={entry.sourceRoute}>{entry.cityName}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{landmark.name}</span>
    </nav>

    <header class="field-guide-hero">
      <div class="field-guide-hero__copy">
        <p class="field-guide-kicker">{guide.eyebrow}</p>
        <h1 id={`landmark-title-${entry.slug}`}>{landmark.name}</h1>
        {presentation.aliases && <p class="field-guide-aliases">{presentation.aliases}</p>}
        <p class="field-guide-deck">{entry.editorialAngle}</p>

        <div class="field-guide-axis field-guide-axis--four" aria-label={`${landmark.name} visit rhythm`}>
          <span class="field-guide-axis__label">READ THE VISIT</span>
          <ol>
            {sections.map((section, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</li>
            ))}
          </ol>
          <p>{entry.fieldNote}</p>
        </div>

        <div class="field-guide-stamp">
          <span>FIELD NOTE</span><strong>Plan the visit</strong><small>{entry.cityName} · Laos</small>
        </div>
      </div>

      <figure class="field-guide-hero__photo">
        <span class="field-guide-tape" aria-hidden="true"></span>
        <img src={hero.src} alt={hero.alt} width="1800" height="1120" fetchpriority="high" />
        {(heroCredit.source || heroCredit.author) && (
          <figcaption>
            Photo: {heroCredit.source ? <a href={heroCredit.source} target="_blank" rel="noreferrer">{heroCredit.author}</a> : heroCredit.author}
            {heroCredit.license && <> · {heroCredit.license}</>}
          </figcaption>
        )}
        <span class="field-guide-photo-scribble" aria-hidden="true">{landmark.cityContext.route}</span>
      </figure>
    </header>

    <section class="field-guide-quick" aria-label={`${landmark.name} overview`}>
      <div><span>Time</span><strong>{guide.duration}</strong><small>{landmark.cityContext.duration}</small></div>
      <div><span>Route</span><strong>{landmark.cityContext.route}</strong><small>{entry.cityName} is the guide base used here.</small></div>
      <div><span>Budget</span><strong>{guide.budget}</strong><small>Reconfirm changing prices locally.</small></div>
      <div><span>Best for</span><strong>{guide.bestFor}</strong><small>{landmark.region}</small></div>
    </section>

    <div class:list={{ 'field-guide-layout': true, 'field-guide-layout--expedition-intro': isExpeditionLayout }}>
      <div class="field-guide-story">
        {sections.slice(0, 2).map((section, index) => (
          <section class="field-guide-section">
            <p class="section-label">{section.label}</p>
            <h2>{section.title}</h2>
            <p class:list={{ 'field-guide-lead': index === 0 }}>{section.text}</p>
            {section.note && <blockquote>{section.note}</blockquote>}
          </section>
        ))}
      </div>

      {isExpeditionLayout ? (
        <figure class="field-guide-photo field-guide-photo--expedition-side">
          <span class="field-guide-tape" aria-hidden="true"></span>
          <img src={second.src} alt={second.alt} width="1100" height="900" loading="lazy" decoding="async" />
          {(secondCredit.source || secondCredit.author) && (
            <figcaption>
              Photo: {secondCredit.source ? <a href={secondCredit.source} target="_blank" rel="noreferrer">{secondCredit.author}</a> : secondCredit.author}
              {secondCredit.license && <> · {secondCredit.license}</>}
            </figcaption>
          )}
        </figure>
      ) : (
        <aside class="field-guide-side-note">
          <span class="field-guide-note-tape" aria-hidden="true"></span>
          <p>QUICK FIELD NOTES</p>
          <ol>
            {facts.slice(0, 5).map((item) => <li><strong>{item.label}:</strong> {item.value}</li>)}
          </ol>
          <span>{entry.fieldNote}</span>
        </aside>
      )}
    </div>

    <div class="field-guide-ad-slot" data-ad-slot="landmark-01" aria-label="Advertisement placeholder">
      <span>ADVERTISEMENT</span>
    </div>

    {isExpeditionLayout ? (
      <div class="field-guide-layout field-guide-layout--expedition-time">
        <div class="field-guide-story">
          <section class="field-guide-section">
            <p class="section-label">{sections[2]?.label || '03 · TIME'}</p>
            <h2>{sections[2]?.title || 'Give the visit enough time'}</h2>
            {(pageFieldNote?.time?.length ? pageFieldNote.time : [sections[2]?.text || landmark.cityContext.duration]).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        </div>

        <aside class="field-guide-paper-note field-guide-paper-note--expedition-time">
          <span class="field-guide-note-tape" aria-hidden="true"></span>
          <span>KEEP CLOSE</span>
          <ul>
            {facts.slice(0, 5).map((item) => <li>{item.label}</li>)}
          </ul>
          <p>Access, conditions, opening arrangements and prices can change. Reconfirm the practical details before leaving {entry.cityName}.</p>
        </aside>
      </div>
    ) : (
      <section class="field-guide-photo-story">
        <figure class="field-guide-photo field-guide-photo--portrait">
          <span class="field-guide-tape" aria-hidden="true"></span>
          <img src={second.src} alt={second.alt} width="1100" height="1500" loading="lazy" decoding="async" />
          {(secondCredit.source || secondCredit.author) && (
            <figcaption>
              Photo: {secondCredit.source ? <a href={secondCredit.source} target="_blank" rel="noreferrer">{secondCredit.author}</a> : secondCredit.author}
              {secondCredit.license && <> · {secondCredit.license}</>}
            </figcaption>
          )}
        </figure>

        <div class="field-guide-section field-guide-section--climb">
          <p class="section-label">{sections[2]?.label || '03 · TIME'}</p>
          <h2>{sections[2]?.title || 'Give the visit enough time'}</h2>
          <p>{sections[2]?.text || landmark.cityContext.duration}</p>
          <blockquote>{entry.fieldNote}</blockquote>
        </div>
      </section>
    )}

    {!isExpeditionLayout && images.length > 1 && (
      <section class="field-guide-gallery" aria-label={`${landmark.name} photo notes`}>
        {[second, third].map((image) => {
          const credit = sourceCaption(image);
          return (
            <figure>
              <img src={image.src} alt={image.alt} width="1100" height="760" loading="lazy" decoding="async" />
              {(credit.source || credit.author) && (
                <figcaption>
                  {credit.source ? <a href={credit.source} target="_blank" rel="noreferrer">{credit.author}</a> : credit.author}
                  {credit.license && <> · {credit.license}</>}
                </figcaption>
              )}
            </figure>
          );
        })}
        <p class="field-guide-gallery-note" aria-hidden="true">leave room between the pins</p>
      </section>
    )}

    <div class="field-guide-ad-slot" data-ad-slot="landmark-02" aria-label="Advertisement placeholder">
      <span>ADVERTISEMENT</span>
    </div>

    <div class:list={{ 'field-guide-layout': true, 'field-guide-layout--reverse': true, 'field-guide-layout--expedition-final': isExpeditionLayout }}>
      <div class="field-guide-story">
        <section class="field-guide-section">
          <p class="section-label">{sections[3]?.label || '04 · ON THE GROUND'}</p>
          <h2>{sections[3]?.title || 'How to approach it'}</h2>
          <p>{pageFieldNote?.approach || sections[3]?.text || landmark.description}</p>
        </section>
        <section class="field-guide-section">
          <p class="section-label">FIELD NOTE · BEFORE YOU LEAVE</p>
          <h2>{presentation.finalHeading || 'What matters more than another pin'}</h2>
          <p>{entry.editorialAngle}</p>
          <p>{pageFieldNote?.beforeYouLeave || guide.fieldNote}</p>
        </section>
      </div>

      {isExpeditionLayout ? (
        <figure class="field-guide-photo field-guide-photo--expedition-final">
          <span class="field-guide-tape" aria-hidden="true"></span>
          <img src={third.src} alt={third.alt} width="1100" height="900" loading="lazy" decoding="async" />
          {(thirdCredit.source || thirdCredit.author) && (
            <figcaption>
              Photo: {thirdCredit.source ? <a href={thirdCredit.source} target="_blank" rel="noreferrer">{thirdCredit.author}</a> : thirdCredit.author}
              {thirdCredit.license && <> · {thirdCredit.license}</>}
            </figcaption>
          )}
        </figure>
      ) : (
        <aside class="field-guide-paper-note">
          <span class="field-guide-note-tape" aria-hidden="true"></span>
          <span>KEEP CLOSE</span>
          <ul>
            {facts.slice(0, 5).map((item) => <li>{item.label}</li>)}
          </ul>
          <p>Conditions, access, opening arrangements and prices can change. Reconfirm time-sensitive details before departure.</p>
        </aside>
      )}
    </div>

    <section class="field-guide-practical" aria-labelledby={`landmark-practical-${entry.slug}`}>
      <div class="field-guide-practical__heading">
        <div>
          <p class="section-label">PLAN THE VISIT</p>
          <h2 id={`landmark-practical-${entry.slug}`}>{landmark.name}, practically</h2>
        </div>
        <p>The useful details in one place before you leave {entry.cityName}.</p>
      </div>
      <div class="field-guide-practical__cards">
        {facts.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.label}</h3>
            <p>{item.value}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="field-guide-ad-slot" data-ad-slot="landmark-03" aria-label="Advertisement placeholder">
      <span>ADVERTISEMENT</span>
    </div>

    <section class="field-guide-faq" aria-labelledby={`landmark-faq-${entry.slug}`}>
      <p class="section-label">QUESTIONS BEFORE GOING</p>
      <h2 id={`landmark-faq-${entry.slug}`}>{landmark.name}, without the guesswork</h2>
      <p class="field-guide-faq__intro">{presentation.faqIntro || 'Short answers built from the practical field information already attached to this landmark.'}</p>
      {questions.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="field-guide-related" aria-labelledby={`landmark-related-${entry.slug}`}>
      <header class="field-guide-related__heading">
        <div>
          <p class="section-label">KEEP EXPLORING LAOS</p>
          <h2 id={`landmark-related-${entry.slug}`}>Where does the road go next?</h2>
        </div>
        <p>Four other field notes that connect naturally with this part of the trip.</p>
      </header>
      <div class="field-guide-related__grid">
        {related.map((relatedEntry) => {
          const relatedGallery = getLicensedLandmarkGallery(relatedEntry.slug, relatedEntry.landmark.gallery);
          const image = relatedGallery[0] || relatedEntry.landmark.gallery[0];
          return (
            <a class="field-guide-related-card" href={relatedEntry.route}>
              <span class="field-guide-related-card__image"><img src={image.src} alt={image.alt} width="700" height="900" loading="lazy" decoding="async" /></span>
              {(image.author || image.license || image.sourcePage) && (
                <span class="field-guide-related-card__credit">
                  Photo: {image.author || 'Wikimedia contributor'}
                  {image.sourcePage?.includes('commons.wikimedia.org') && <> · Wikimedia Commons</>}
                  {image.license && <> · {image.license}</>}
                  {image.sourcePage && <> · <span class="field-guide-related-card__source">Source ↗</span></>}
                </span>
              )}
              <span class="field-guide-related-card__copy">
                <small>{relatedEntry.landmark.cityContext.kicker}</small>
                <strong>{relatedEntry.landmark.name}</strong>
                <p>{relatedEntry.landmark.cityContext.summary}</p>
                <span class="field-guide-related-card__arrow">Open the field note <b aria-hidden="true">↗</b></span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <LandmarkGuideFinalCta entry={entry} />
  </article>
</main>

<style>
  .field-guide-layout--expedition-intro,
  .field-guide-layout--expedition-time,
  .field-guide-layout--expedition-final {
    grid-template-columns: minmax(0, 1.34fr) minmax(280px, .66fr);
    gap: clamp(44px, 7vw, 88px);
  }

  .field-guide-photo--expedition-side,
  .field-guide-photo--expedition-final {
    align-self: center;
    width: 100%;
    transform: rotate(1deg);
  }

  .field-guide-photo--expedition-side img,
  .field-guide-photo--expedition-final img {
    width: 100%;
    height: clamp(300px, 31vw, 420px);
    object-fit: cover;
  }

  .field-guide-photo--expedition-final {
    transform: rotate(-1deg);
  }

  .field-guide-paper-note--expedition-time {
    align-self: center;
    margin-top: 0;
  }

  .field-guide-layout--expedition-time .field-guide-section p + p {
    margin-top: 22px !important;
  }

  @media (max-width: 820px) {
    .field-guide-layout--expedition-intro,
    .field-guide-layout--expedition-time,
    .field-guide-layout--expedition-final {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .field-guide-photo--expedition-side,
    .field-guide-photo--expedition-final,
    .field-guide-paper-note--expedition-time {
      width: min(100%, 560px);
      justify-self: center;
    }

    .field-guide-photo--expedition-side img,
    .field-guide-photo--expedition-final img {
      height: clamp(260px, 65vw, 380px);
    }
  }
</style>

<script>
  const setupLandmarkPageBack = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-landmark-page-back]').forEach((button) => {
      if (button.dataset.backReady === 'true') return;
      button.dataset.backReady = 'true';
      button.addEventListener('click', () => {
        const stored = sessionStorage.getItem('atlas:landmark-return');
        if (stored && history.length > 1) history.back();
        else location.href = button.closest('main')?.querySelector<HTMLAnchorElement>('.field-guide-return a')?.href || '/laos';
      });
    });
  };
  setupLandmarkPageBack();
  document.addEventListener('astro:page-load', setupLandmarkPageBack);
</script>
