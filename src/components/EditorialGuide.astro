---
import EditorialFactIcon from './EditorialFactIcon.astro';
import type { EditorialGuideData } from '../data/editorialGuides';
import '../styles/editorial-guide.css';
import '../styles/editorial-guide-columns.css';

interface Props {
  guide: EditorialGuideData;
  mountSelector?: string;
}

const { guide, mountSelector } = Astro.props;
const dialogId = `${guide.slug}-dialog`;
const titleId = `${guide.slug}-dialog-title`;
const introId = `${guide.slug}-intro`;
const guideHash = `#${guide.slug}`;
---

<div
  class="editorial-guide"
  data-editorial-guide-root
  data-mount-selector={mountSelector}
  data-guide-hash={guideHash}
>
  <button
    class="editorial-guide__trigger"
    type="button"
    aria-controls={dialogId}
    aria-expanded="false"
    data-editorial-guide-trigger
  >
    <span class="editorial-guide__trigger-tape" aria-hidden="true"></span>
    <span class="editorial-guide__trigger-eyebrow">{guide.triggerEyebrow}</span>
    <span class="editorial-guide__trigger-title">{guide.triggerTitle}</span>
    <span class="editorial-guide__trigger-arrow" aria-hidden="true">↝</span>
  </button>

  <div
    class="editorial-guide__overlay"
    id={dialogId}
    aria-hidden="true"
    hidden
    data-editorial-guide-overlay
  >
    <section
      class="editorial-guide__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby={titleId}
      data-editorial-guide-panel
    >
      <h2 id={titleId} class="editorial-guide__sr-only">{guide.destination} field guide</h2>

      <header class="editorial-guide__topbar">
        <button class="editorial-guide__home" type="button" data-editorial-guide-home aria-current="page">
          <span>{guide.typeLabel}</span>
          <strong>{guide.destination}</strong>
          <small>Before you begin</small>
        </button>

        <button class="editorial-guide__close" type="button" data-editorial-guide-close>
          <span>Close</span>
          <b aria-hidden="true">×</b>
        </button>
      </header>

      <nav class="editorial-guide__nav" aria-label={`${guide.destination} field guide chapters`} role="tablist">
        {guide.sections.map((section, index) => {
          const tabId = `${guide.slug}-${section.id}-tab`;
          const panelId = `${guide.slug}-${section.id}-panel`;

          return (
            <button
              id={tabId}
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls={panelId}
              tabindex="-1"
              data-editorial-guide-view={section.id}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{section.title}</strong>
            </button>
          );
        })}
      </nav>

      <div class="editorial-guide__stage" data-editorial-guide-stage>
        <section
          class="editorial-guide__view editorial-guide__view--intro"
          id={introId}
          data-editorial-guide-view-panel="intro"
          aria-hidden="false"
        >
          <p class="editorial-guide__eyebrow">{guide.typeLabel} · {guide.destination}</p>
          <h3>{guide.title}</h3>
          <p class="editorial-guide__lead">{guide.intro}</p>
          <span class="editorial-guide__hint">Choose a chapter above</span>
        </section>

        {guide.sections.map((section, index) => {
          const tabId = `${guide.slug}-${section.id}-tab`;
          const panelId = `${guide.slug}-${section.id}-panel`;

          return (
            <article
              class="editorial-guide__view editorial-guide__view--chapter"
              id={panelId}
              role="tabpanel"
              tabindex="0"
              aria-labelledby={tabId}
              aria-hidden="true"
              hidden
              data-editorial-guide-view-panel={section.id}
            >
              <div class="editorial-guide__chapter-grid">
                <div class="editorial-guide__chapter-rail">
                  {section.facts && section.facts.length > 0 && (
                    <dl class="editorial-guide__facts">
                      {section.facts.map((fact) => (
                        <div>
                          <EditorialFactIcon label={fact.label} />
                          <dt>{fact.label}</dt>
                          <dd>{fact.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {section.note && (
                    <aside class="editorial-guide__note">
                      <span>{section.note.label || 'Field note'}</span>
                      <p>{section.note.text}</p>
                    </aside>
                  )}
                </div>

                <div class="editorial-guide__chapter-copy">
                  <div class="editorial-guide__section-heading">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <div>
                      {section.eyebrow && <p>{section.eyebrow}</p>}
                      <h3>{section.title}</h3>
                    </div>
                  </div>

                  <div class="editorial-guide__prose">
                    {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <footer class="editorial-guide__footer">
        <button type="button" data-editorial-guide-home>Back to introduction</button>

        {guide.links && guide.links.length > 0 && (
          <div class="editorial-guide__links">
            {guide.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </div>
        )}

        <button type="button" data-editorial-guide-close>Return to the Laos map <span aria-hidden="true">↗</span></button>
      </footer>
    </section>
  </div>
</div>

<script>
  const setupEditorialGuides = () => {
    document.querySelectorAll<HTMLElement>('[data-editorial-guide-root]').forEach((root) => {
      if (root.dataset.editorialGuideReady === 'true') return;
      root.dataset.editorialGuideReady = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('[data-editorial-guide-trigger]');
      const overlay = root.querySelector<HTMLElement>('[data-editorial-guide-overlay]');
      const panel = root.querySelector<HTMLElement>('[data-editorial-guide-panel]');
      const stage = root.querySelector<HTMLElement>('[data-editorial-guide-stage]');
      const homeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-editorial-guide-home]'));
      const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-editorial-guide-view]'));
      const viewPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-editorial-guide-view-panel]'));
      const mountSelector = root.dataset.mountSelector;
      const guideHash = root.dataset.guideHash || '';
      let previousFocus: Element | null = null;

      if (!trigger || !overlay || !panel || !stage || viewPanels.length === 0) return;

      if (mountSelector) {
        const mount = document.querySelector(mountSelector);
        if (mount) mount.appendChild(trigger);
      }

      const syncPageLock = () => {
        const hasOpenGuide = document.querySelector<HTMLElement>('[data-editorial-guide-overlay]:not([hidden])');
        document.documentElement.classList.toggle('editorial-guide-open', Boolean(hasOpenGuide));
      };

      const showView = (viewId = 'intro') => {
        viewPanels.forEach((view) => {
          const isActive = view.dataset.editorialGuideViewPanel === viewId;
          view.hidden = !isActive;
          view.setAttribute('aria-hidden', String(!isActive));
        });

        viewButtons.forEach((button) => {
          const isActive = button.dataset.editorialGuideView === viewId;
          button.setAttribute('aria-selected', String(isActive));
          button.tabIndex = isActive ? 0 : -1;
          button.classList.toggle('is-active', isActive);
        });

        homeButtons.forEach((button) => {
          if (viewId === 'intro') button.setAttribute('aria-current', 'page');
          else button.removeAttribute('aria-current');
        });

        stage.scrollTo({ top: 0, behavior: 'auto' });
      };

      const openGuide = (updateHash = true) => {
        previousFocus = document.activeElement;
        showView('intro');
        overlay.hidden = false;
        overlay.setAttribute('aria-hidden', 'false');
        trigger.setAttribute('aria-expanded', 'true');
        syncPageLock();

        if (updateHash && guideHash && window.location.hash !== guideHash) {
          history.pushState({ editorialGuide: guideHash }, '', guideHash);
        }

        requestAnimationFrame(() => {
          homeButtons[0]?.focus();
        });
      };

      const closeGuide = (updateHash = true) => {
        overlay.hidden = true;
        overlay.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
        syncPageLock();

        if (updateHash && guideHash && window.location.hash === guideHash) {
          history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
        }

        if (previousFocus instanceof HTMLElement && document.contains(previousFocus)) previousFocus.focus();
        else trigger.focus();
      };

      trigger.addEventListener('click', () => openGuide());

      homeButtons.forEach((button) => {
        button.addEventListener('click', () => showView('intro'));
      });

      viewButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          const viewId = button.dataset.editorialGuideView;
          if (viewId) showView(viewId);
        });

        button.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();

          let nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % viewButtons.length;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + viewButtons.length) % viewButtons.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = viewButtons.length - 1;

          const nextButton = viewButtons[nextIndex];
          const viewId = nextButton?.dataset.editorialGuideView;
          nextButton?.focus();
          if (viewId) showView(viewId);
        });
      });

      overlay.querySelectorAll('[data-editorial-guide-close]').forEach((button) => {
        button.addEventListener('click', () => closeGuide());
      });

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closeGuide();
      });

      panel.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeGuide();
          return;
        }

        if (event.key !== 'Tab') return;
        const focusable = Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'))
          .filter((element) => element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      const syncFromHash = () => {
        if (guideHash && window.location.hash === guideHash && overlay.hidden) openGuide(false);
        if (guideHash && window.location.hash !== guideHash && !overlay.hidden) closeGuide(false);
      };

      window.addEventListener('hashchange', syncFromHash);
      window.addEventListener('popstate', syncFromHash);
      syncFromHash();
    });
  };

  setupEditorialGuides();
  document.addEventListener('astro:page-load', setupEditorialGuides);
</script>
