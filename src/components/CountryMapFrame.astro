---
import PlanMyTripIntro from './PlanMyTripIntro.astro';

interface Props {
  countrySlug: string;
  countryName: string;
  chapter: string;
  mapImage: string;
  mapAlt: string;
  mapWidth?: number;
  mapHeight?: number;
  mapClass?: string;
}

const {
  countrySlug,
  countryName,
  chapter,
  mapImage,
  mapAlt,
  mapWidth = 1024,
  mapHeight = 1536,
  mapClass = ''
} = Astro.props;
const columns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
const rows = Array.from({ length: 12 }, (_, index) => index + 1);
---

<section class={`country-map country-map--${countrySlug}`} aria-labelledby={`${countrySlug}-map-title`}>
  <div class="country-map__sheet">
    <div class="country-map__canvas">
      <header class="country-map__header">
        <span class="country-map__note">FIELD MAP · {countryName.toUpperCase()}</span>
        <div class="country-map__title-block">
          <span>{countryName.toUpperCase()} · CHAPTER {chapter}</span>
          <h1 id={`${countrySlug}-map-title`}>Choose a place on the map</h1>
        </div>
      </header>

      <img class={`country-map__drawing ${mapClass}`} src={mapImage} alt={mapAlt} width={mapWidth} height={mapHeight} />

      <svg class="country-map__grid" viewBox="0 0 1024 1536" aria-hidden="true">
        <g class="country-map__grid-lines">
          {Array.from({ length: 9 }, (_, index) => <line x1={index * 128} y1="0" x2={index * 128} y2="1536" />)}
          {Array.from({ length: 13 }, (_, index) => <line x1="0" y1={index * 128} x2="1024" y2={index * 128} />)}
        </g>
        <g class="country-map__grid-labels">
          {columns.map((label, index) => <text x={(index * 128) + 64} y="34" text-anchor="middle">{label}</text>)}
          {rows.map((label, index) => <text x="18" y={(index * 128) + 74}>{label}</text>)}
        </g>
      </svg>

      <div class="country-map__overlay"><slot /></div>
    </div>
  </div>
  <PlanMyTripIntro />
</section>

<style>
  .country-map { min-height: 100vh; padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2)); background: #f2eee3; color: #1f2924; }
  .country-map__sheet { position: relative; width: fit-content; margin: 0 auto; padding: 26px 26px 10px; border: 1px solid rgba(31, 41, 36, .14); background: #f7f2e6; }
  .country-map__sheet::before, .country-map__sheet::after { content: ''; position: absolute; z-index: 3; width: 78px; height: 22px; background: rgba(199, 181, 143, .48); }
  .country-map__sheet::before { top: -9px; left: 8%; transform: rotate(-4deg); }
  .country-map__sheet::after { right: 8%; bottom: -8px; transform: rotate(3deg); }
  .country-map__canvas { position: relative; width: min(80vw, 1120px); aspect-ratio: 1; margin: 0 auto; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(31, 41, 36, .2), 0 8px 22px rgba(31, 41, 36, .06); }
  .country-map__header { position: absolute; z-index: 4; top: clamp(1.4rem, 3vw, 2.5rem); left: clamp(1.25rem, 4vw, 3.25rem); right: clamp(1.25rem, 4vw, 3.25rem); display: flex; align-items: flex-start; justify-content: space-between; gap: 1.25rem; color: #1f392d; pointer-events: none; }
  .country-map__note { flex: 0 0 auto; color: rgba(31, 57, 45, .62); font: 500 1rem/1 Caveat, cursive; letter-spacing: .08em; }
  .country-map__title-block { width: min(42rem, 70%); margin-left: auto; text-align: right; }
  .country-map__title-block span { display: block; margin-bottom: .15rem; color: rgba(31, 57, 45, .62); font: 500 .92rem/1 Caveat, cursive; letter-spacing: .1em; }
  .country-map__title-block h1 { margin: 0; color: #1f392d; font: 550 clamp(2rem, 4.1vw, 3.35rem)/1 Caveat, cursive; letter-spacing: .01em; }
  .country-map__drawing, .country-map__grid, .country-map__overlay { position: absolute; left: 50%; top: 50%; width: 61.2%; height: 91.8%; transform: translate(-50%, -50%); }
  .country-map__drawing { object-fit: contain; }
  .country-map__grid { z-index: 1; overflow: hidden; pointer-events: none; }
  .country-map__overlay { z-index: 2; pointer-events: none; }
  .country-map__overlay :global(a), .country-map__overlay :global(button), .country-map__overlay :global([role='button']) { pointer-events: auto; }
  .country-map__grid-lines line { stroke: rgba(42, 75, 61, .22); stroke-width: 1.5; stroke-dasharray: 8 10; vector-effect: non-scaling-stroke; }
  .country-map__grid-labels text { fill: rgba(42, 75, 61, .58); font: 600 27px Caveat, cursive; paint-order: stroke; stroke: rgba(255, 255, 255, .9); stroke-width: 5px; stroke-linejoin: round; }
  .country-map--thailand .country-map__drawing, .country-map--thailand .country-map__grid, .country-map--thailand .country-map__overlay { width: 46%; height: 69%; transform: translate(-50%, -43%); }
  .country-map--sri-lanka .country-map__drawing, .country-map--sri-lanka .country-map__grid, .country-map--sri-lanka .country-map__overlay { width: 44%; height: 76%; }
  @media (max-width: 700px) {
    .country-map { padding-top: 3.5rem; }
    .country-map__sheet { width: auto; padding: .75rem .75rem 10px; }
    .country-map__canvas { width: calc(100vw - 4rem); }
    .country-map__header { gap: .15rem; flex-wrap: wrap; }
    .country-map__title-block { width: 100%; order: 2; }
    .country-map__note { order: 1; margin-right: auto; font-size: .8rem; }
    .country-map__title-block span { font-size: .72rem; }
    .country-map__title-block h1 { font-size: clamp(1.8rem, 8vw, 2.65rem); }
    .country-map__grid-labels text { font-size: 34px; }
  }
</style>
