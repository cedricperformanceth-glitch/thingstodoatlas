<style is:global>
  #wat-phou-modal[data-wat-phou-compact='true'] {
    width: min(920px, calc(100vw - 48px));
    height: auto;
    max-height: min(650px, calc(100vh - 48px));
    overflow: auto;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
    grid-template-columns: minmax(280px, .86fr) minmax(390px, 1.14fr);
    height: auto;
    min-height: 0;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story {
    display: flex;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    padding: 42px 36px 34px 42px;
    overflow: visible;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__eyebrow {
    margin-bottom: 12px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story h2 {
    font-size: clamp(3.6rem, 6vw, 5.2rem);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__region {
    margin-top: 13px !important;
    font-size: 1.15rem !important;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__underline {
    margin-bottom: 12px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__description {
    max-width: 30rem;
    font-size: 1.08rem;
    line-height: 1.34;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__annotations,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__scribble,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__facts,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__thumbnails,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__arrow,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__counter,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-actions__annotation,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-visual__closing {
    display: none !important;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__visual {
    justify-content: flex-start;
    padding: 28px 30px 26px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage {
    min-height: 274px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage > img {
    height: 274px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__credit {
    margin-top: 8px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__actions {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    margin-top: 15px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-action {
    min-height: 44px;
    padding-inline: 8px;
    font-size: .96rem;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px dashed rgba(49, 85, 69, .28);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta span {
    display: grid;
    gap: 4px;
    min-width: 0;
    color: #315545;
    font: 650 .92rem/1.05 'Caveat', 'Segoe Print', cursive;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta small {
    color: #a45d3a;
    font: 700 .48rem/1.2 'DM Sans', sans-serif;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] [data-wat-phou-plan] {
    border: 1px solid #b8653e;
    background: #f4e7d2;
    color: #9a5134;
    font-weight: 700;
    box-shadow: 2px 3px 0 rgba(184, 101, 62, .14);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] [data-wat-phou-plan]:hover {
    background: #f8ddc4;
  }

  .wat-phou-return-target {
    position: relative;
    z-index: 6;
    outline: 3px solid rgba(217, 119, 69, .88) !important;
    outline-offset: 7px !important;
    box-shadow: 0 0 0 12px rgba(217, 119, 69, .12), 0 16px 35px rgba(31, 57, 45, .16) !important;
    transition: outline-color 600ms ease, box-shadow 600ms ease !important;
  }

  @media (max-width: 850px) {
    #wat-phou-modal[data-wat-phou-compact='true'] {
      width: min(760px, calc(100vw - 32px));
      max-height: calc(100vh - 32px);
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
      grid-template-columns: minmax(240px, .85fr) minmax(330px, 1.15fr);
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story {
      padding: 38px 27px 28px 32px;
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__visual {
      padding: 25px 24px 23px;
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__actions {
      grid-template-columns: 1fr !important;
    }
  }

  @media (max-width: 650px) {
    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wat-phou-return-target { transition: none !important; }
  }
</style>

<script>
  const WAT_PHOU_MODAL_ID = 'wat-phou-modal';
  const WAT_PHOU_GUIDE_URL = '/laos/pakse/things-to-do/wat-phou';
  const WAT_PHOU_RETURN_KEY = 'atlas:wat-phou-return';

  type WatPhouReturnState = {
    sourcePath: string;
    sourceId: string;
    sourceKind: string;
    categorySlug?: string;
    scrollY: number;
  };

  const currentLockedScrollY = () => {
    const fixedTop = Number.parseFloat(document.body.style.top || '');
    return Number.isFinite(fixedTop) && fixedTop < 0 ? Math.abs(fixedTop) : window.scrollY;
  };

  const sourceKindFor = (element: HTMLElement) => {
    if (element.matches('#category-wat-phou') || element.closest('#category-wat-phou')) return 'things-to-do';
    if (element.matches('.explore-board-card') || element.closest('.explore-board-card')) return 'explore-board';
    if (element.matches('.city-landmark-card') || element.closest('.city-landmark-card')) return 'landmark-list';
    return 'landmark';
  };

  const sourceElementFor = (trigger: HTMLElement) => (
    trigger.closest<HTMLElement>('#category-wat-phou, .explore-board-card, .city-landmark-card') || trigger
  );

  const ensureSourceIdentity = (trigger: HTMLElement, index: number) => {
    const source = sourceElementFor(trigger);
    if (source.id) return source;
    const kind = sourceKindFor(source);
    source.id = `wat-phou-source-${kind}-${index + 1}`;
    return source;
  };

  const prepareWatPhouSources = () => {
    document.querySelectorAll<HTMLElement>(`[data-open-landmark="${WAT_PHOU_MODAL_ID}"]`).forEach((trigger, index) => {
      const source = ensureSourceIdentity(trigger, index);
      trigger.dataset.watPhouSourceId = source.id;
      trigger.dataset.watPhouSourceKind = sourceKindFor(source);
    });
  };

  const activeCategorySlug = () => (
    document.querySelector<HTMLElement>('[data-city-category-button][aria-selected="true"]')?.dataset.cityCategoryButton || undefined
  );

  const recordSource = (trigger: HTMLElement) => {
    const sourceId = trigger.dataset.watPhouSourceId;
    const sourceKind = trigger.dataset.watPhouSourceKind;
    const dialog = document.getElementById(WAT_PHOU_MODAL_ID);
    if (!(dialog instanceof HTMLDialogElement) || !sourceId) return;
    dialog.dataset.watPhouSourceId = sourceId;
    dialog.dataset.watPhouSourceKind = sourceKind || 'landmark';
  };

  const addCompactPreviewMeta = (dialog: HTMLDialogElement) => {
    const story = dialog.querySelector<HTMLElement>('.landmark-modal__story');
    if (!story || story.querySelector('.wat-phou-preview-meta')) return;
    const meta = document.createElement('div');
    meta.className = 'wat-phou-preview-meta';
    meta.setAttribute('aria-label', 'Wat Phou quick practical notes');
    meta.innerHTML = `
      <span><small>Time on site</small>2–3 hours</span>
      <span><small>Effort</small>Moderate climb</span>
      <span><small>Best rhythm</small>Go early</span>
    `;
    story.append(meta);
  };

  const installGuideLink = (dialog: HTMLDialogElement) => {
    if (dialog.querySelector('[data-wat-phou-plan]')) return true;
    const oldButton = dialog.querySelector<HTMLElement>('[data-open-landmark-guide]');
    if (!oldButton) return false;

    const link = document.createElement('a');
    link.className = oldButton.className || 'landmark-action landmark-action--guide';
    link.href = WAT_PHOU_GUIDE_URL;
    link.dataset.watPhouPlan = '';
    link.innerHTML = '<span aria-hidden="true">✎</span> Plan my visit';
    link.setAttribute('aria-label', 'Open the complete Wat Phou visit guide');
    oldButton.replaceWith(link);

    link.addEventListener('click', () => {
      const sourceId = dialog.dataset.watPhouSourceId || '';
      const sourceKind = dialog.dataset.watPhouSourceKind || 'landmark';
      if (sourceId) {
        const state: WatPhouReturnState = {
          sourcePath: `${location.pathname}${location.search}${location.hash}`,
          sourceId,
          sourceKind,
          categorySlug: activeCategorySlug(),
          scrollY: currentLockedScrollY()
        };
        sessionStorage.setItem(WAT_PHOU_RETURN_KEY, JSON.stringify(state));
      }
      if (dialog.open) dialog.close();
    });
    return true;
  };

  const compactWatPhouModal = () => {
    const dialog = document.getElementById(WAT_PHOU_MODAL_ID);
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.dataset.watPhouCompact = 'true';
    const eyebrow = dialog.querySelector<HTMLElement>('.landmark-modal__eyebrow');
    if (eyebrow) eyebrow.textContent = 'LAOS · QUICK FIELD CARD';
    addCompactPreviewMeta(dialog);
    installGuideLink(dialog);
  };

  const clearLandmarkScrollLock = () => {
    const root = document.documentElement;
    if (root.dataset.landmarkScrollLocked !== 'true') return;
    delete root.dataset.landmarkScrollLocked;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.right = '';
    document.body.style.left = '';
    document.body.style.width = '';
  };

  const restoreWatPhouSource = () => {
    const raw = sessionStorage.getItem(WAT_PHOU_RETURN_KEY);
    if (!raw) return;

    let state: WatPhouReturnState | null = null;
    try { state = JSON.parse(raw) as WatPhouReturnState; } catch { sessionStorage.removeItem(WAT_PHOU_RETURN_KEY); }
    if (!state) return;
    const currentPath = `${location.pathname}${location.search}${location.hash}`;
    const sameDocument = currentPath === state.sourcePath || location.pathname === state.sourcePath.split(/[?#]/)[0];
    if (!sameDocument) return;

    clearLandmarkScrollLock();
    document.querySelectorAll<HTMLDialogElement>('.landmark-modal[open], [data-landmark-guide-dialog][open]').forEach((dialog) => dialog.close());

    if (state.categorySlug) {
      const tab = document.querySelector<HTMLButtonElement>(`[data-city-category-button="${CSS.escape(state.categorySlug)}"]`);
      if (tab && tab.getAttribute('aria-selected') !== 'true') tab.click();
    }

    requestAnimationFrame(() => requestAnimationFrame(() => {
      const source = document.getElementById(state!.sourceId);
      if (source) {
        source.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'auto' });
        if (source instanceof HTMLElement) source.focus({ preventScroll: true });
        source.classList.add('wat-phou-return-target');
        window.setTimeout(() => source.classList.remove('wat-phou-return-target'), 2200);
      } else {
        window.scrollTo({ top: state!.scrollY, left: 0, behavior: 'auto' });
      }
      sessionStorage.removeItem(WAT_PHOU_RETURN_KEY);
    }));
  };

  const bindWatPhouSourceTracking = () => {
    const root = document.documentElement;
    if (root.dataset.watPhouSourceTracking === 'true') return;
    root.dataset.watPhouSourceTracking = 'true';

    const capture = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>(`[data-open-landmark="${WAT_PHOU_MODAL_ID}"]`);
      if (trigger) recordSource(trigger);
    };

    document.addEventListener('click', capture, true);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') capture(event);
    }, true);
  };

  const setupWatPhouPrototype = () => {
    prepareWatPhouSources();
    bindWatPhouSourceTracking();
    compactWatPhouModal();
    restoreWatPhouSource();

    if (document.body.dataset.watPhouObserverReady === 'true') return;
    document.body.dataset.watPhouObserverReady = 'true';
    const observer = new MutationObserver(() => compactWatPhouModal());
    observer.observe(document.body, { childList: true, subtree: true });
  };

  setupWatPhouPrototype();
  document.addEventListener('astro:page-load', setupWatPhouPrototype);
  window.addEventListener('pageshow', setupWatPhouPrototype);
</script>
