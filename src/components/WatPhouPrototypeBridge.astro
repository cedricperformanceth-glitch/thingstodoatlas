<style is:global>
  #wat-phou-modal[data-wat-phou-compact='true'] {
    width: min(840px, calc(100vw - 48px));
    height: auto;
    max-height: min(500px, calc(100vh - 48px));
    overflow: auto;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
    grid-template-columns: minmax(260px, .84fr) minmax(360px, 1.16fr);
    align-items: start;
    height: auto;
    min-height: 0;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story {
    display: flex;
    min-height: 0;
    align-self: start;
    flex-direction: column;
    justify-content: flex-start;
    padding: 22px 26px 18px 32px;
    overflow: visible;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story h2 {
    font-size: clamp(3.1rem, 4.8vw, 4.15rem);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__region {
    margin-top: 8px !important;
    font-size: 1.02rem !important;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__underline {
    margin-top: 4px;
    margin-bottom: 7px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__description {
    max-width: 27rem;
    font-size: .94rem;
    line-height: 1.24;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__annotations,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-story__scribble,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__facts,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__thumbnails,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__arrow,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__counter,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-actions__annotation,
  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-visual__closing {
    display: none !important;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__visual {
    align-self: start;
    justify-content: flex-start;
    padding: 16px 20px 0;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-visual__meta {
    margin-bottom: 5px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage {
    min-height: 198px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage > img {
    height: 198px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__credit {
    min-height: 0;
    margin-top: 4px;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__actions {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 7px;
    margin-top: 7px;
    margin-bottom: 0;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .landmark-action {
    min-height: 38px;
    padding: 6px 7px;
    font-size: .86rem;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 9px;
    padding-top: 8px;
    border-top: 1px dashed rgba(49, 85, 69, .28);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta span {
    display: grid;
    gap: 2px;
    min-width: 0;
    color: #315545;
    font: 650 .78rem/1.02 'Caveat', 'Segoe Print', cursive;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] .wat-phou-preview-meta small {
    color: #a45d3a;
    font: 700 .42rem/1.15 'DM Sans', sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  #wat-phou-modal[data-wat-phou-compact='true'] [data-wat-phou-plan] {
    border: 1px solid #b8653e;
    background: #f4e7d2;
    color: #9a5134;
    font-weight: 700;
    box-shadow: 2px 3px 0 rgba(184, 101, 62, .14);
  }

  #wat-phou-modal[data-wat-phou-compact='true'] [data-wat-phou-plan]:hover {
    background: #f8ddc4;
  }

  .wat-phou-return-target {
    position: relative;
    z-index: 6;
    outline: 3px solid rgba(217, 119, 69, .88) !important;
    outline-offset: 7px !important;
    box-shadow: 0 0 0 12px rgba(217, 119, 69, .12), 0 16px 35px rgba(31, 57, 45, .16) !important;
  }

  @media (max-width: 850px) {
    #wat-phou-modal[data-wat-phou-compact='true'] {
      width: min(730px, calc(100vw - 32px));
      max-height: min(480px, calc(100vh - 32px));
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
      grid-template-columns: minmax(230px, .82fr) minmax(320px, 1.18fr);
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__story {
      padding: 20px 20px 16px 26px;
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage,
    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-gallery__stage > img {
      min-height: 184px;
      height: 184px;
    }

    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__actions {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 650px) {
    #wat-phou-modal[data-wat-phou-compact='true'] .landmark-modal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const WAT_PHOU_MODAL_ID = 'wat-phou-modal';
  const WAT_PHOU_GUIDE_URL = '/laos/pakse/things-to-do/wat-phou';
  const WAT_PHOU_RETURN_KEY = 'atlas:wat-phou-return';

  type WatPhouReturnState = {
    sourcePath: string;
    sourceId: string;
    categorySlug?: string;
    scrollY: number;
  };

  const sourceElementFor = (trigger: HTMLElement) => (
    trigger.closest<HTMLElement>('#category-wat-phou, .explore-board-card, .city-landmark-card') || trigger
  );

  const sourceKindFor = (source: HTMLElement) => {
    if (source.matches('#category-wat-phou')) return 'things-to-do';
    if (source.matches('.explore-board-card')) return 'explore-board';
    if (source.matches('.city-landmark-card')) return 'landmark-list';
    return 'landmark';
  };

  const prepareSources = () => {
    document.querySelectorAll<HTMLElement>(`[data-open-landmark="${WAT_PHOU_MODAL_ID}"]`).forEach((trigger, index) => {
      const source = sourceElementFor(trigger);
      if (!source.id) source.id = `wat-phou-source-${sourceKindFor(source)}-${index + 1}`;
      trigger.dataset.watPhouSourceId = source.id;
    });
  };

  const activeCategorySlug = () => (
    document.querySelector<HTMLElement>('[data-city-category-button][aria-selected="true"]')?.dataset.cityCategoryButton || undefined
  );

  const currentPageScroll = () => {
    const fixedTop = Number.parseFloat(document.body.style.top || '');
    return Number.isFinite(fixedTop) && fixedTop < 0 ? Math.abs(fixedTop) : window.scrollY;
  };

  const rememberTrigger = (trigger: HTMLElement) => {
    const dialog = document.getElementById(WAT_PHOU_MODAL_ID);
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.dataset.watPhouSourceId = trigger.dataset.watPhouSourceId || '';
  };

  const addPreviewMeta = (dialog: HTMLDialogElement) => {
    const story = dialog.querySelector<HTMLElement>('.landmark-modal__story');
    if (!story || story.querySelector('.wat-phou-preview-meta')) return;
    const meta = document.createElement('div');
    meta.className = 'wat-phou-preview-meta';
    meta.setAttribute('aria-label', 'Wat Phou quick practical notes');
    meta.innerHTML = `
      <span><small>Time on site</small>2–3 hours</span>
      <span><small>Effort</small>Moderate climb</span>
      <span><small>Best rhythm</small>Go early</span>
    `;
    story.append(meta);
  };

  const installPageLink = (dialog: HTMLDialogElement) => {
    const actions = dialog.querySelector<HTMLElement>('.landmark-modal__actions');
    if (!actions) return false;

    let link = actions.querySelector<HTMLAnchorElement>('[data-wat-phou-plan]');
    if (!link) {
      const oldGuideButton = actions.querySelector<HTMLElement>('[data-open-landmark-guide]');
      link = document.createElement('a');
      link.className = oldGuideButton?.className || 'landmark-action landmark-action--guide';
      link.href = WAT_PHOU_GUIDE_URL;
      link.dataset.watPhouPlan = '';
      link.dataset.openLandmarkGuide = 'wat-phou-page';
      link.innerHTML = '<span aria-hidden="true">✎</span> Plan my visit';
      link.setAttribute('aria-label', 'Open the complete Wat Phou visit guide');

      if (oldGuideButton) oldGuideButton.replaceWith(link);
      else {
        const saveButton = actions.querySelector('[data-add-landmark]');
        actions.insertBefore(link, saveButton || null);
      }
    }

    if (link.dataset.returnReady !== 'true') {
      link.dataset.returnReady = 'true';
      link.addEventListener('click', () => {
        const sourceId = dialog.dataset.watPhouSourceId || '';
        if (!sourceId) return;
        const state: WatPhouReturnState = {
          sourcePath: `${location.pathname}${location.search}${location.hash}`,
          sourceId,
          categorySlug: activeCategorySlug(),
          scrollY: currentPageScroll()
        };
        sessionStorage.setItem(WAT_PHOU_RETURN_KEY, JSON.stringify(state));
        if (dialog.open) dialog.close();
      });
    }

    return true;
  };

  const configureWatPhou = () => {
    prepareSources();
    const dialog = document.getElementById(WAT_PHOU_MODAL_ID);
    if (!(dialog instanceof HTMLDialogElement)) return false;
    dialog.dataset.watPhouCompact = 'true';
    const eyebrow = dialog.querySelector<HTMLElement>('.landmark-modal__eyebrow');
    if (eyebrow) eyebrow.textContent = 'LAOS · QUICK FIELD CARD';
    addPreviewMeta(dialog);
    return installPageLink(dialog);
  };

  const restoreSource = () => {
    const raw = sessionStorage.getItem(WAT_PHOU_RETURN_KEY);
    if (!raw) return;

    let state: WatPhouReturnState | null = null;
    try { state = JSON.parse(raw) as WatPhouReturnState; }
    catch { sessionStorage.removeItem(WAT_PHOU_RETURN_KEY); }
    if (!state || location.pathname !== state.sourcePath.split(/[?#]/)[0]) return;

    if (state.categorySlug) {
      const tab = document.querySelector<HTMLButtonElement>(`[data-city-category-button="${CSS.escape(state.categorySlug)}"]`);
      if (tab && tab.getAttribute('aria-selected') !== 'true') tab.click();
    }

    window.setTimeout(() => {
      const source = document.getElementById(state!.sourceId);
      if (source) {
        source.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'auto' });
        source.classList.add('wat-phou-return-target');
        window.setTimeout(() => source.classList.remove('wat-phou-return-target'), 1800);
      } else {
        window.scrollTo({ top: state!.scrollY, left: 0, behavior: 'auto' });
      }
      sessionStorage.removeItem(WAT_PHOU_RETURN_KEY);
    }, 80);
  };

  const bindTracking = () => {
    if (document.documentElement.dataset.watPhouTrackingReady === 'true') return;
    document.documentElement.dataset.watPhouTrackingReady = 'true';
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>(`[data-open-landmark="${WAT_PHOU_MODAL_ID}"]`);
      if (trigger) rememberTrigger(trigger);
    }, true);
  };

  const setupWatPhouPrototype = () => {
    bindTracking();
    restoreSource();
    [0, 40, 120, 300, 700].forEach((delay) => {
      window.setTimeout(() => configureWatPhou(), delay);
    });
  };

  setupWatPhouPrototype();
  document.addEventListener('astro:page-load', setupWatPhouPrototype);
  window.addEventListener('pageshow', setupWatPhouPrototype);
</script>
