---
import { countryNavigation } from '../data/atlasConfig';
---

<footer
  id="atlas-global-footer"
  class="atlas-footer"
  aria-label="Things To Do Atlas footer"
>
  <div class="atlas-footer__inner">
    <div class="atlas-footer__brand">
      <a href="/" aria-label="ThingsToDoAtlas home">
        <img
          src="/images/branding/things-to-do-atlas-stamp-transparent.webp"
          alt="ThingsToDoAtlas"
          width="512"
          height="512"
          decoding="async"
        />
      </a>
    </div>

    <div class="atlas-footer__content">
      <div class="atlas-footer__heading">
        <p>Things To Do Atlas</p>
        <span aria-hidden="true"></span>
      </div>

      <div class="atlas-footer__links">
        <nav aria-labelledby="footer-navigation-title">
          <h2 id="footer-navigation-title">Navigation</h2>
          <div class="atlas-footer__link-list">
            {countryNavigation.map((country) => (
              <a href={country.href}>{country.name}</a>
            ))}
          </div>
        </nav>

        <nav aria-labelledby="footer-contact-title">
          <h2 id="footer-contact-title">Contact</h2>
          <div class="atlas-footer__link-list">
            <a href="/admin">Admin</a>
          </div>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const mountFooter = () => {
      const footer = document.getElementById('atlas-global-footer');
      if (!(footer instanceof HTMLElement)) return;

      footer.hidden = false;
      footer.removeAttribute('aria-hidden');

      /*
       * Some legacy pages still contain their own <main> element inside the
       * shared layout. Browsers may repair that invalid nesting differently.
       * Mounting the shared footer directly under <body> guarantees one footer
       * in the same place on every public route.
       */
      if (footer.parentElement !== document.body) document.body.appendChild(footer);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountFooter, { once: true });
    } else {
      mountFooter();
    }
  })();
</script>