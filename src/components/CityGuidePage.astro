---
import type { CityGuideDefinition } from '../data/contentModel';
import { getCategoriesForCity } from '../data/contentModel';

interface Props {
  city: CityGuideDefinition;
}

const { city } = Astro.props;
const categories = getCategoriesForCity(city);
---

<div class="city-guide">
  <section class="city-guide__hero" aria-labelledby={`${city.slug}-title`}>
    <div class="city-guide__copy">
      <p class="city-guide__eyebrow">{city.countryName.toUpperCase()} · CHAPTER {city.chapter}</p>
      <h1 id={`${city.slug}-title`}>{city.name}</h1>
      <p class="city-guide__lede">{city.description}</p>
      <span class="city-guide__field-note">FIELD NOTE — {city.fieldNote}</span>
    </div>

    <figure class="city-guide__visual">
      <span class="city-guide__tape city-guide__tape--top" aria-hidden="true"></span>
      <img src={city.image} alt={city.imageAlt} width="1600" height="1100" fetchpriority="high" />
      <figcaption>{city.caption}</figcaption>
      <span class="city-guide__tape city-guide__tape--bottom" aria-hidden="true"></span>
    </figure>
  </section>

  <section class="city-guide__categories" aria-labelledby={`${city.slug}-categories-title`}>
    <div class="city-guide__heading">
      <p>{city.name.toUpperCase()} DIRECTORY</p>
      <h2 id={`${city.slug}-categories-title`}>Open the notebook</h2>
      <span>Start with the part of the trip you need now. Every saved card remains available in My Trip.</span>
    </div>

    <div class="city-category-grid">
      {categories.map((category, index) => (
        <a
          class={`city-category-card city-category-card--${index % 4}`}
          href={`/${city.countrySlug}/${city.slug}/${category.slug}`}
          aria-label={`Explore ${category.title} in ${city.name}`}
        >
          <span class="city-category-card__tape" aria-hidden="true"></span>
          <span class="city-category-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="city-category-card__copy">
            <span class="city-category-card__kicker">{category.kicker}</span>
            <strong>{category.title}</strong>
            <span class="city-category-card__text">{category.text}</span>
            <span class="city-category-card__meta">Open the list <b aria-hidden="true">→</b></span>
          </span>
        </a>
      ))}
    </div>
  </section>
</div>

<style>
  .city-guide { min-height: 100vh; background: #f2eee3; color: #1f2924; }
  .city-guide__hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(2rem, 5vw, 5rem); width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; padding: clamp(5rem, 7vw, 6.5rem) 0 clamp(2.5rem, 4vw, 3.5rem); }
  .city-guide__copy { position: relative; z-index: 2; max-width: 32rem; }
  .city-guide__eyebrow { margin: 0 0 .75rem; color: #8a4d36; font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .city-guide h1 { margin: 0; color: #1f392d; font-size: clamp(4rem, 8vw, 6.8rem); letter-spacing: -.065em; line-height: .84; }
  .city-guide__lede { max-width: 31rem; margin: clamp(1.25rem, 2vw, 1.75rem) 0 0; color: #3f4943; font: 500 clamp(1rem, 1.4vw, 1.18rem)/1.58 Fraunces, serif; }
  .city-guide__field-note { display: inline-block; margin-top: 1.2rem; color: rgba(31, 57, 45, .62); font: 500 clamp(.82rem, 1vw, 1rem)/1 Caveat, cursive; transform: rotate(-1.2deg); }
  .city-guide__visual { position: relative; width: clamp(24rem, 36vw, 34rem); margin: 0; padding: .5rem .5rem 1.6rem; background: #fbf8f0; box-shadow: 0 10px 24px rgba(38, 45, 40, .1); transform: rotate(.8deg); }
  .city-guide__visual img { display: block; width: 100%; height: clamp(12rem, 16vw, 15rem); object-fit: cover; }
  .city-guide__visual figcaption { position: absolute; left: .75rem; bottom: .4rem; color: rgba(31, 41, 36, .62); font: 500 .72rem/1 Caveat, cursive; }
  .city-guide__tape { position: absolute; z-index: 2; width: 3.8rem; height: .8rem; background: rgba(196, 177, 139, .48); }
  .city-guide__tape--top { top: -.28rem; left: 50%; transform: translateX(-50%) rotate(-3deg); }
  .city-guide__tape--bottom { right: 1rem; bottom: -.28rem; transform: rotate(4deg); }
  .city-guide__categories { width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; padding: clamp(2rem, 4vw, 4rem) 0 clamp(5rem, 8vw, 8rem); }
  .city-guide__heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); gap: 1rem 3rem; align-items: end; margin-bottom: 2rem; }
  .city-guide__heading p { grid-column: 1; margin: 0 0 .4rem; color: rgba(31, 57, 45, .56); font-size: .7rem; font-weight: 700; letter-spacing: .2em; }
  .city-guide__heading h2 { grid-column: 1; margin: 0; color: #1f392d; font-size: clamp(2rem, 4vw, 3.6rem); }
  .city-guide__heading > span { grid-column: 2; grid-row: 1 / 3; color: #70766d; font-size: .82rem; line-height: 1.65; }
  .city-category-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .city-category-card { position: relative; display: grid; grid-template-columns: 5rem minmax(0, 1fr); align-items: start; gap: 1rem; min-height: 11rem; padding: 1.35rem; overflow: visible; color: #181a18; background: #f8f5ec; border: 1px solid rgba(24, 26, 24, .2); box-shadow: 0 5px 12px rgba(31, 41, 36, .045); transition: transform 180ms ease, box-shadow 180ms ease; }
  .city-category-card--0 { transform: rotate(-.35deg); }
  .city-category-card--1 { transform: rotate(.3deg); }
  .city-category-card--2 { transform: rotate(-.18deg); }
  .city-category-card--3 { transform: rotate(.42deg); }
  .city-category-card:hover { transform: translateY(-3px) rotate(0); box-shadow: 4px 7px 0 rgba(49, 85, 69, .08); }
  .city-category-card__tape { position: absolute; top: -.45rem; left: .75rem; width: 4.3rem; height: 1.25rem; background: rgba(213, 204, 184, .72); clip-path: polygon(2% 12%, 95% 0, 100% 84%, 5% 100%); transform: rotate(-6deg); }
  .city-category-card:nth-child(even) .city-category-card__tape { display: none; }
  .city-category-card__number { display: grid; place-items: center; width: 4rem; height: 4rem; border: 1px solid rgba(49, 85, 69, .45); border-radius: 50%; color: #315545; font: 500 1.35rem/1 Fraunces, serif; transform: rotate(-3deg); }
  .city-category-card__copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; }
  .city-category-card__kicker { margin-bottom: .35rem; color: #8a4d36; font-size: .56rem; font-weight: 700; letter-spacing: .15em; }
  .city-category-card strong { color: #1f392d; font: 600 clamp(1.45rem, 2.4vw, 2rem)/1.05 Caveat, cursive; }
  .city-category-card__text { max-width: 22rem; margin-top: .8rem; color: rgba(24, 26, 24, .76); font: 400 .88rem/1.45 Fraunces, serif; }
  .city-category-card__meta { display: inline-flex; gap: .4rem; margin-top: auto; padding-top: .8rem; color: #315545; font-size: .68rem; font-weight: 700; letter-spacing: .06em; }
  .city-category-card__meta b { color: #b76645; }
  @media (max-width: 900px) { .city-category-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .city-guide__hero { grid-template-columns: 1fr; }
    .city-guide__visual { width: min(100%, 34rem); margin: 0 auto; }
    .city-guide__heading { grid-template-columns: 1fr; }
    .city-guide__heading > span { grid-column: 1; grid-row: auto; max-width: 34rem; }
  }
  @media (max-width: 560px) { .city-category-card { grid-template-columns: 4.25rem minmax(0, 1fr); min-height: 9.5rem; padding: 1rem; } .city-category-card__number { width: 3.4rem; height: 3.4rem; } }
  @media (prefers-reduced-motion: reduce) { .city-category-card { transition: none; } }
</style>
