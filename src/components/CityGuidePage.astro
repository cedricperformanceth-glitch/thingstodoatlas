---
import type { CityGuideDefinition } from '../data/contentModel';
import { getCategoriesForCity } from '../data/contentModel';
import CityCategorySPA from './TravelDeskCategorySPA.astro';
import CityCategoryPanel from './TravelDeskCategoryPanel.astro';

interface Props {
  city: CityGuideDefinition;
}

const { city } = Astro.props;
const categories = getCategoriesForCity(city);
const tabs = categories.map((category) => ({
  slug: category.slug,
  title: category.title,
  kicker: category.kicker,
  icon: category.icon,
  count: 0,
  countLabel: 'notes soon'
}));
const categoryNouns: Record<string, string> = {
  restaurants: 'restaurants',
  cafes: 'cafés',
  accommodation: 'stays',
  'scooter-rental': 'rental addresses',
  'things-to-do': 'experiences',
  'gyms-fitness': 'places to train',
  'markets-shopping': 'markets and shops',
  'essential-information': 'useful addresses'
};
---

<div class="city-guide">
  <section class="city-guide__hero" aria-labelledby={`${city.slug}-title`}>
    <div class="city-guide__copy">
      <p class="city-guide__eyebrow">{city.countryName.toUpperCase()} · CHAPTER {city.chapter}</p>
      <h1 id={`${city.slug}-title`}>{city.name}</h1>
      <p class="city-guide__lede">{city.description}</p>
      <span class="city-guide__field-note">FIELD NOTE — {city.fieldNote}</span>
    </div>

    <figure class="city-guide__visual">
      <span class="city-guide__tape city-guide__tape--top" aria-hidden="true"></span>
      <img src={city.image} alt={city.imageAlt} width="1600" height="1100" fetchpriority="high" />
      <figcaption>{city.caption}</figcaption>
      <span class="city-guide__tape city-guide__tape--bottom" aria-hidden="true"></span>
    </figure>
  </section>

  <CityCategorySPA
    cityName={city.name}
    categories={tabs}
    defaultSlug={categories[0]?.slug}
    eyebrow="THE PRACTICAL NOTEBOOK"
    title={`Plan your stay in ${city.name}`}
    intro=""
    transitionTitle="Now for the practical side."
    transitionText="Eat · sleep · explore · prepare the road ahead"
  >
    {categories.map((category, index) => (
      <CityCategoryPanel
        slug={category.slug}
        cityName={city.name}
        title={category.title}
        count={0}
        noun={categoryNouns[category.slug] || 'addresses'}
        summary={`${category.title} in ${city.name}`}
        intro=""
        fieldNote={String(index + 1).padStart(2, '0')}
        active={index === 0}
      >
        <div class="city-panel-empty">
          <h4>This notebook tab is ready.</h4>
          <p>Carefully checked local addresses will appear here without changing the page or the way My Trip works.</p>
        </div>
      </CityCategoryPanel>
    ))}
  </CityCategorySPA>
</div>

<style>
  .city-guide{min-height:100vh;background:#f2eee3;color:#1f2924}.city-guide__hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:clamp(2rem,5vw,5rem);width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(5rem,7vw,6.5rem) 0 clamp(3rem,5vw,4.5rem)}.city-guide__copy{position:relative;z-index:2;max-width:32rem}.city-guide__eyebrow{margin:0 0 .75rem;color:#8a4d36;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.city-guide h1{margin:0;color:#1f392d;font-size:clamp(4rem,8vw,6.8rem);letter-spacing:-.065em;line-height:.84}.city-guide__lede{max-width:31rem;margin:clamp(1.25rem,2vw,1.75rem) 0 0;color:#3f4943;font:500 clamp(1rem,1.4vw,1.18rem)/1.58 Fraunces,serif}.city-guide__field-note{display:inline-block;margin-top:1.2rem;color:rgba(31,57,45,.62);font:500 clamp(.82rem,1vw,1rem)/1 Caveat,cursive;transform:rotate(-1.2deg)}.city-guide__visual{position:relative;width:clamp(24rem,36vw,34rem);margin:0;padding:.5rem .5rem 1.6rem;background:#fbf8f0;box-shadow:0 10px 24px rgba(38,45,40,.1);transform:rotate(.8deg)}.city-guide__visual img{display:block;width:100%;height:clamp(12rem,16vw,15rem);object-fit:cover}.city-guide__visual figcaption{position:absolute;left:.75rem;bottom:.4rem;color:rgba(31,41,36,.62);font:500 .72rem/1 Caveat,cursive}.city-guide__tape{position:absolute;z-index:2;width:3.8rem;height:.8rem;background:rgba(196,177,139,.48)}.city-guide__tape--top{top:-.28rem;left:50%;transform:translateX(-50%) rotate(-3deg)}.city-guide__tape--bottom{right:1rem;bottom:-.28rem;transform:rotate(4deg)}
  @media(max-width:820px){.city-guide__hero{grid-template-columns:1fr}.city-guide__visual{width:min(100%,34rem);margin:0 auto}}
</style>
