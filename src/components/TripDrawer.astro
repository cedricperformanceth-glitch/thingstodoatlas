<div class="plan-trip-widget" data-trip-widget hidden>
  <button class="plan-trip-fab" type="button" data-trip-toggle aria-expanded="false" aria-controls="plan-trip-drawer" aria-label="Open My Trip">
    <span class="plan-trip-fab__icon" aria-hidden="true">
      <img src="/images/plan-my-trip-logo.webp" alt="" width="1024" height="1536" />
    </span>
    <span class="plan-trip-fab__copy">
      <small>FIELD NOTES</small>
      <strong data-trip-fab-title>MY TRIP</strong>
    </span>
    <span class="plan-trip-fab__count" data-trip-count>00</span>
  </button>

  <aside class="plan-trip-drawer" id="plan-trip-drawer" data-trip-drawer hidden aria-label="My Trip" role="dialog" aria-modal="false">
    <div class="plan-trip-drawer__head">
      <p class="plan-trip-drawer__kicker">FIELD NOTES <span aria-hidden="true">·</span> PERSONAL ROUTE</p>
      <h2 data-trip-title>My Trip</h2>
      <p class="plan-trip-drawer__summary" data-trip-summary aria-live="polite"></p>
      <button class="plan-trip-drawer__close" type="button" data-trip-close aria-label="Close My Trip">×</button>
    </div>
    <div class="plan-trip-drawer__body" data-trip-content></div>
    <div class="plan-trip-drawer__foot" data-trip-footer hidden>
      <a href="/" data-trip-explore>CONTINUE EXPLORING <span aria-hidden="true">→</span></a>
      <button type="button" data-trip-clear>CLEAR CARDS</button>
    </div>
  </aside>
</div>

<style is:global>
  .plan-trip-widget {
    position: fixed;
    z-index: 40;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    justify-items: end;
    gap: .8rem;
  }
  .plan-trip-widget[hidden],
  .plan-trip-drawer[hidden],
  .plan-trip-drawer__foot[hidden] { display: none; }
  .plan-trip-fab {
    position: relative;
    min-width: 224px;
    height: 66px;
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: center;
    gap: .65rem;
    padding: 6px 10px 6px 7px;
    border: 1px solid rgba(49, 85, 69, .42);
    background: linear-gradient(rgba(247, 242, 230, .96), rgba(247, 242, 230, .96)), repeating-linear-gradient(0deg, transparent 0 8px, rgba(49, 85, 69, .035) 8px 9px);
    color: #315545;
    box-shadow: 4px 5px 0 rgba(49, 85, 69, .12), 0 12px 30px rgba(32, 60, 49, .12);
    transform: rotate(-.45deg);
    cursor: pointer;
    transition: opacity 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .plan-trip-fab::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 31px;
    width: 42px;
    height: 10px;
    background: rgba(210, 177, 126, .66);
    transform: rotate(-3deg);
  }
  .plan-trip-fab:hover { transform: rotate(0) translateY(-2px); box-shadow: 5px 7px 0 rgba(49, 85, 69, .13), 0 16px 34px rgba(32, 60, 49, .15); }
  .plan-trip-widget.is-open .plan-trip-fab { visibility: hidden; pointer-events: none; opacity: 0; }
  .plan-trip-fab__icon { width: 52px; height: 52px; overflow: hidden; background: #d8d5cf; }
  .plan-trip-fab__icon img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 54%; filter: grayscale(1) contrast(1.12) brightness(1.3); mix-blend-mode: multiply; }
  .plan-trip-fab__copy { min-width: 0; text-align: left; }
  .plan-trip-fab__copy small { display: block; margin-bottom: .24rem; color: #b76645; font: 700 .48rem/1 'DM Sans', sans-serif; letter-spacing: .17em; }
  .plan-trip-fab__copy strong { display: block; max-width: 120px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font: 600 .76rem/1.1 'DM Sans', sans-serif; letter-spacing: .055em; }
  .plan-trip-fab__count { min-width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid #b76645; border-radius: 50%; color: #b76645; font: 600 .72rem/1 Fraunces, serif; transform: rotate(4deg); }
  .plan-trip-drawer {
    width: min(446px, calc(100vw - 2rem));
    max-height: min(680px, calc(100vh - 4rem));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    border: 1px solid rgba(49, 85, 69, .32);
    background: radial-gradient(circle at 12% 8%, rgba(183, 102, 69, .055), transparent 27%), repeating-linear-gradient(0deg, transparent 0 10px, rgba(49, 85, 69, .025) 10px 11px), #eee8dc;
    color: #252923;
    box-shadow: 7px 9px 0 rgba(49, 85, 69, .09), 0 24px 60px rgba(32, 60, 49, .24);
    transform-origin: bottom right;
    animation: plan-trip-open 200ms ease-out both;
  }
  .plan-trip-drawer__head { position: relative; padding: 1.45rem 3.7rem 1.2rem 1.45rem; border-bottom: 1px dashed rgba(49, 85, 69, .28); }
  .plan-trip-drawer__head::after { content: ''; position: absolute; left: 1.45rem; bottom: 1rem; width: 96px; border-top: 1px solid rgba(183, 102, 69, .55); transform: rotate(-1deg); }
  .plan-trip-drawer__kicker { margin: 0 0 .55rem; color: #b76645; font: 700 .54rem/1 'DM Sans', sans-serif; letter-spacing: .17em; }
  .plan-trip-drawer__kicker span { padding: 0 .24rem; color: #315545; }
  .plan-trip-drawer__head h2 { margin: 0 0 .6rem; color: #315545; font: 500 clamp(1.85rem, 6vw, 2.35rem)/1 Fraunces, serif; letter-spacing: -.045em; }
  .plan-trip-drawer__summary { margin: 0; padding-bottom: .75rem; color: #6f746d; font: 500 1.05rem/1 Caveat, cursive; transform: rotate(-.7deg); }
  .plan-trip-drawer__close { position: absolute; top: 1rem; right: 1rem; width: 34px; height: 34px; display: grid; place-items: center; padding: 0; border: 1px solid rgba(49, 85, 69, .24); border-radius: 50%; background: rgba(247, 242, 230, .6); color: #315545; font: 400 1.35rem/1 'DM Sans', sans-serif; cursor: pointer; }
  .plan-trip-drawer__body { min-height: 132px; max-height: 470px; overflow: auto; padding: 1.15rem 1.35rem 1.5rem; scrollbar-color: rgba(49, 85, 69, .38) transparent; scrollbar-width: thin; }
  .plan-trip-empty { margin: .2rem 0 0; padding: 1rem 1.05rem; border: 1px dashed rgba(49, 85, 69, .26); background: rgba(247, 242, 230, .62); color: #667068; font-size: .8rem; line-height: 1.6; transform: rotate(-.35deg); }
  .plan-trip-empty strong { display: block; margin-bottom: .5rem; color: #315545; font: 500 1.35rem/1.1 Fraunces, serif; }
  .plan-trip-notes { display: grid; padding: .15rem .2rem .35rem; }
  .plan-trip-note { --note-accent: #b58442; --note-rotation: -.45deg; position: relative; min-height: 128px; display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: .8rem; margin: 0 2px .58rem; padding: .92rem 2.6rem .9rem .85rem; border: 1px solid rgba(70, 75, 65, .2); background: linear-gradient(90deg, transparent 45px, rgba(183, 102, 69, .12) 45px 46px, transparent 46px), repeating-linear-gradient(0deg, transparent 0 25px, rgba(49, 85, 69, .055) 25px 26px), #f8f3e8; box-shadow: 3px 4px 0 rgba(49, 85, 69, .08); transform: translateX(-2px) rotate(var(--note-rotation)); }
  .plan-trip-note:nth-child(3n + 2) { --note-rotation: .6deg; transform: translateX(3px) rotate(var(--note-rotation)); }
  .plan-trip-note--stay { --note-accent: #315545; }
  .plan-trip-note--eat { --note-accent: #b76645; }
  .plan-trip-note--bar { --note-accent: #7f3d3f; }
  .plan-trip-note__number { padding-top: .17rem; color: #315545; font: 500 1.28rem/1 Fraunces, serif; }
  .plan-trip-note__stamp { display: inline-flex; align-items: center; min-height: 20px; margin-bottom: .42rem; padding: 0 .48rem; border: 1px solid var(--note-accent); color: var(--note-accent); font: 700 .48rem/1 'DM Sans', sans-serif; letter-spacing: .15em; }
  .plan-trip-note strong { display: block; overflow-wrap: anywhere; color: #315545; font: 500 1.12rem/1.08 Fraunces, serif; }
  .plan-trip-note small { display: block; margin-top: .32rem; overflow: hidden; color: #70766d; font: 400 .65rem/1.35 'DM Sans', sans-serif; text-overflow: ellipsis; white-space: nowrap; }
  .plan-trip-note__link { display: inline-block; margin-top: .55rem; padding-bottom: .2rem; border-bottom: 1px solid rgba(183, 102, 69, .48); color: #315545; font: 600 .64rem/1 'DM Sans', sans-serif; }
  .plan-trip-note__remove { position: absolute; top: .6rem; right: .65rem; width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; background: transparent; color: #7c8078; font: 500 1.25rem/1 Caveat, cursive; cursor: pointer; }
  .plan-trip-note[hidden] { display: none; }
  .plan-trip-more { justify-self: center; margin: .45rem 0 0; padding: .65rem .85rem; border: 1px dashed rgba(49, 85, 69, .4); background: rgba(247, 242, 230, .72); color: #315545; font: 700 .58rem/1 'DM Sans', sans-serif; letter-spacing: .12em; cursor: pointer; }
  .plan-trip-drawer__switcher { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .55rem .7rem; align-items: end; margin: .55rem 0 .15rem; padding-top: .75rem; border-top: 1px dashed rgba(49, 85, 69, .2); }
  .plan-trip-drawer__switcher label { grid-column: 1 / -1; color: #70766d; font: 700 .48rem/1 'DM Sans', sans-serif; letter-spacing: .14em; }
  .plan-trip-drawer__switcher select { min-width: 0; height: 36px; padding: 0 .65rem; border: 1px solid rgba(49, 85, 69, .28); border-radius: 0; background: rgba(247, 242, 230, .76); color: #315545; font: 600 .68rem/1 'DM Sans', sans-serif; }
  .plan-trip-drawer__switcher button { min-height: 36px; padding: 0 .72rem; border: 1px solid #b76645; background: transparent; color: #b76645; font: 700 .52rem/1 'DM Sans', sans-serif; letter-spacing: .08em; cursor: pointer; }
  .plan-trip-drawer__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem 1rem; padding: .95rem 1.35rem 1.05rem; border-top: 1px dashed rgba(49, 85, 69, .28); background: rgba(247, 242, 230, .65); }
  .plan-trip-drawer__foot a { color: #315545; font: 700 .6rem/1 'DM Sans', sans-serif; letter-spacing: .075em; }
  .plan-trip-drawer__foot button { padding: 0; border: 0; border-bottom: 1px solid rgba(112, 118, 109, .38); background: transparent; color: #70766d; font: 600 .53rem/1.5 'DM Sans', sans-serif; letter-spacing: .08em; cursor: pointer; }
  .plan-trip-drawer__foot [data-trip-delete] { color: #9d4938; }
  .plan-trip-fab:focus-visible, .plan-trip-drawer button:focus-visible, .plan-trip-drawer a:focus-visible { outline: 2px solid #b76645; outline-offset: 3px; }
  @keyframes plan-trip-open { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 700px) {
    .plan-trip-widget { right: .75rem; bottom: 4.9rem; }
    .plan-trip-fab { min-width: 202px; height: 60px; grid-template-columns: 46px 1fr auto; }
    .plan-trip-fab__icon { width: 46px; height: 46px; }
    .plan-trip-drawer { width: calc(100vw - 1.5rem); max-height: calc(100vh - 6rem); }
    .plan-trip-drawer__body { max-height: none; padding: 1rem .9rem 1.2rem; }
  }
  @media (max-width: 380px) {
    .plan-trip-fab { min-width: 184px; }
    .plan-trip-fab__copy small { display: none; }
    .plan-trip-drawer__switcher { grid-template-columns: 1fr; }
    .plan-trip-drawer__switcher label { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .plan-trip-drawer { animation: none; } .plan-trip-fab { transition: none; } }
</style>
