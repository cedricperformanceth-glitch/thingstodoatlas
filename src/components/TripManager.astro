---
import { tripCountryConfig } from '../data/atlasConfig';
---

<script id="atlas-trip-config" type="application/json" set:html={JSON.stringify(tripCountryConfig)}></script>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'thingsToDoAtlas.trips.v2';
    const LEGACY_STORAGE_KEY = 'thingsToDoAtlas.trip.v1';
    const configNode = document.getElementById('atlas-trip-config');
    const COUNTRIES = configNode ? JSON.parse(configNode.textContent || '{}') : {};

    const slugify = (value) => String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

    const createId = (prefix = 'trip') => `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;

    const getPageContext = () => {
      const segments = window.location.pathname.split('/').filter(Boolean);
      const countrySlug = segments.find((segment) => Boolean(COUNTRIES[segment])) || '';
      const citySlug = countrySlug ? (segments[segments.indexOf(countrySlug) + 1] || '') : '';
      const country = COUNTRIES[countrySlug];
      const city = country?.cities?.find((entry) => entry.slug === citySlug);
      return {
        countrySlug,
        countryName: country?.name || '',
        citySlug,
        cityName: city?.name || '',
        cityRoute: city?.route || country?.route || '/'
      };
    };

    const getCountryFromUrl = (url) => {
      try {
        const pathname = new URL(url || '/', window.location.origin).pathname;
        return pathname.split('/').filter(Boolean).find((segment) => Boolean(COUNTRIES[segment])) || '';
      } catch {
        return '';
      }
    };

    const toRelativeUrl = (url) => {
      try {
        const parsed = new URL(url || '/', window.location.origin);
        return `${parsed.pathname}${parsed.search}${parsed.hash}`;
      } catch {
        return String(url || '/');
      }
    };

    const getCity = (countrySlug, citySlug) => COUNTRIES[countrySlug]?.cities?.find((city) => city.slug === citySlug) || null;

    const normalizeItem = (rawItem, fallback = {}) => {
      const page = getPageContext();
      const countrySlug = rawItem.countrySlug || fallback.countrySlug || getCountryFromUrl(rawItem.url) || page.countrySlug || 'laos';
      const countryName = rawItem.countryName || fallback.countryName || COUNTRIES[countrySlug]?.name || countrySlug;
      const cityName = rawItem.city || rawItem.cityName || fallback.cityName || page.cityName || '';
      const citySlug = rawItem.citySlug || fallback.citySlug || page.citySlug || slugify(cityName);
      const kind = rawItem.kind || (String(rawItem.group || '').toLowerCase() === 'landmarks' ? 'landmark' : 'place');
      const originalId = rawItem.originalId || rawItem.placeId || (String(rawItem.id || '').includes(':') ? String(rawItem.id).split(':').pop() : rawItem.id) || slugify(rawItem.name);
      const id = String(rawItem.id || '').includes(':')
        ? String(rawItem.id)
        : `${countrySlug}:${kind}:${citySlug || 'country'}:${originalId}`;

      return {
        id,
        originalId,
        kind,
        name: String(rawItem.name || 'Saved place'),
        countrySlug,
        countryName,
        citySlug,
        city: cityName,
        group: String(rawItem.group || (kind === 'landmark' ? 'landmarks' : 'things-to-do')),
        category: String(rawItem.category || (kind === 'landmark' ? 'Landmark' : 'Saved place')),
        address: String(rawItem.address || ''),
        url: toRelativeUrl(rawItem.url || COUNTRIES[countrySlug]?.route || '/'),
        savedAt: rawItem.savedAt || new Date().toISOString()
      };
    };

    const emptyStore = () => ({ version: 2, activeTripId: null, activeTripByCountry: {}, trips: [] });

    const setActiveTrip = (store, trip) => {
      store.activeTripId = trip?.id || null;
      store.activeTripByCountry ||= {};
      if (trip?.countrySlug) store.activeTripByCountry[trip.countrySlug] = trip.id;
    };

    const migrateLegacyStore = () => {
      try {
        const legacy = JSON.parse(localStorage.getItem(LEGACY_STORAGE_KEY) || 'null');
        if (!legacy?.started || !Array.isArray(legacy.items)) return null;
        const citySlug = legacy.startingCity || 'pakse';
        const city = getCity('laos', citySlug);
        const trip = {
          id: createId('trip-laos'),
          name: 'Laos Trip 1',
          countrySlug: 'laos',
          countryName: 'Laos',
          startingCity: citySlug,
          startingCityName: city?.name || citySlug,
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
          items: legacy.items.map((item) => normalizeItem(item, {
            countrySlug: 'laos',
            countryName: 'Laos',
            citySlug,
            cityName: city?.name || citySlug
          }))
        };
        const migrated = { version: 2, activeTripId: trip.id, activeTripByCountry: { laos: trip.id }, trips: [trip] };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(migrated));
        localStorage.removeItem(LEGACY_STORAGE_KEY);
        return migrated;
      } catch {
        return null;
      }
    };

    const readStore = () => {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        if (parsed?.version === 2 && Array.isArray(parsed.trips)) {
          const trips = parsed.trips.map((trip) => ({
            ...trip,
            items: Array.isArray(trip.items)
              ? trip.items.map((item) => normalizeItem(item, {
                  countrySlug: trip.countrySlug,
                  countryName: trip.countryName,
                  citySlug: trip.startingCity,
                  cityName: trip.startingCityName
                }))
              : []
          }));
          const activeTripId = trips.some((trip) => trip.id === parsed.activeTripId) ? parsed.activeTripId : (trips[0]?.id || null);
          const activeTripByCountry = { ...(parsed.activeTripByCountry || {}) };
          Object.keys(activeTripByCountry).forEach((countrySlug) => {
            if (!trips.some((trip) => trip.id === activeTripByCountry[countrySlug] && trip.countrySlug === countrySlug)) delete activeTripByCountry[countrySlug];
          });
          return { version: 2, activeTripId, activeTripByCountry, trips };
        }
      } catch {
        // Corrupted browser storage is replaced by an empty notebook.
      }
      return migrateLegacyStore() || emptyStore();
    };

    const writeStore = (store) => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
      window.dispatchEvent(new CustomEvent('atlas:trips-changed'));
    };

    const getTripNumber = (store, countrySlug) => {
      const expression = / Trip (\d+)$/;
      return store.trips
        .filter((trip) => trip.countrySlug === countrySlug)
        .reduce((highest, trip) => Math.max(highest, Number(trip.name?.match(expression)?.[1] || 0)), 0) + 1;
    };

    const createTrip = (store, countrySlug, options = {}) => {
      const country = COUNTRIES[countrySlug];
      if (!country) return null;
      const trip = {
        id: createId(`trip-${countrySlug}`),
        name: `${country.name} Trip ${getTripNumber(store, countrySlug)}`,
        countrySlug,
        countryName: country.name,
        startingCity: options.startingCity || '',
        startingCityName: options.startingCityName || '',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        items: []
      };
      store.trips.push(trip);
      setActiveTrip(store, trip);
      return trip;
    };

    const latestTripForCountry = (store, countrySlug) => store.trips
      .filter((trip) => trip.countrySlug === countrySlug)
      .sort((a, b) => String(b.updatedAt || '').localeCompare(String(a.updatedAt || '')))[0] || null;

    const getActiveTrip = (store) => store.trips.find((trip) => trip.id === store.activeTripId) || null;

    const getCountryActiveTrip = (store, countrySlug) => {
      const rememberedId = store.activeTripByCountry?.[countrySlug];
      return store.trips.find((trip) => trip.id === rememberedId && trip.countrySlug === countrySlug)
        || latestTripForCountry(store, countrySlug);
    };

    const ensureTripForItem = (store, item) => {
      let trip = getActiveTrip(store);
      if (!trip || trip.countrySlug !== item.countrySlug) trip = getCountryActiveTrip(store, item.countrySlug);
      if (!trip) {
        trip = createTrip(store, item.countrySlug, {
          startingCity: item.citySlug,
          startingCityName: item.city
        });
      }
      if (!trip) return null;
      if (!trip.startingCity && item.citySlug) {
        trip.startingCity = item.citySlug;
        trip.startingCityName = item.city;
      }
      setActiveTrip(store, trip);
      return trip;
    };

    const parseTripItem = (button) => {
      const page = getPageContext();
      if (button.dataset.tripPlace) {
        try {
          return normalizeItem(JSON.parse(button.dataset.tripPlace), {
            countrySlug: page.countrySlug,
            countryName: page.countryName,
            citySlug: page.citySlug,
            cityName: page.cityName
          });
        } catch {
          return null;
        }
      }
      const dialog = button.closest('.landmark-modal');
      if (!(dialog instanceof HTMLDialogElement)) return null;
      const name = dialog.querySelector('h2')?.textContent?.trim() || 'Landmark';
      const region = dialog.querySelector('.landmark-modal__region')?.textContent?.trim() || '';
      return normalizeItem({
        id: dialog.id,
        kind: 'landmark',
        name,
        countrySlug: page.countrySlug,
        countryName: page.countryName,
        city: '',
        citySlug: '',
        group: 'landmarks',
        category: 'Landmark',
        address: region,
        url: `${window.location.pathname}#${dialog.id}`
      });
    };

    const getNoteType = (item) => {
      const group = String(item.group || '').toLowerCase();
      const category = String(item.category || '').toLowerCase();
      if (group === 'accommodation' || /hostel|hotel|guesthouse|stay/.test(category)) return { key: 'stay', label: 'STAY' };
      if (/bar|beer|wine/.test(category)) return { key: 'bar', label: 'BAR' };
      if (group === 'restaurants' || group === 'cafes' || /restaurant|café|cafe|coffee|bakery|food|noodle|grill|bistro|trattoria/.test(category)) return { key: 'eat', label: 'EAT' };
      return { key: 'explore', label: item.kind === 'landmark' ? 'LANDMARK' : 'EXPLORE' };
    };

    const closeDrawer = () => {
      const widget = document.querySelector('[data-trip-widget]');
      const drawer = document.querySelector('[data-trip-drawer]');
      const toggle = document.querySelector('[data-trip-toggle]');
      if (drawer) drawer.hidden = true;
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      widget?.classList.remove('is-open');
    };

    const openDrawer = () => {
      const widget = document.querySelector('[data-trip-widget]');
      const drawer = document.querySelector('[data-trip-drawer]');
      const toggle = document.querySelector('[data-trip-toggle]');
      if (!drawer || !toggle) return;
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      widget?.classList.add('is-open');
      drawer.querySelector('[data-trip-close]')?.focus();
    };

    const installControls = () => {
      const head = document.querySelector('.plan-trip-drawer__head');
      const summary = document.querySelector('[data-trip-summary]');
      if (head && summary && !head.querySelector('[data-trip-switcher]')) {
        const switcher = document.createElement('div');
        switcher.className = 'plan-trip-drawer__switcher';
        switcher.dataset.tripSwitcher = '';
        const label = document.createElement('label');
        label.htmlFor = 'plan-trip-select';
        label.textContent = 'ACTIVE TRIP';
        const select = document.createElement('select');
        select.id = 'plan-trip-select';
        select.dataset.tripSelect = '';
        select.setAttribute('aria-label', 'Choose one of your saved trips');
        const create = document.createElement('button');
        create.type = 'button';
        create.dataset.tripNew = '';
        create.textContent = '+ NEW TRIP';
        switcher.append(label, select, create);
        summary.insertAdjacentElement('afterend', switcher);
      }
      const footer = document.querySelector('[data-trip-footer]');
      if (footer && !footer.querySelector('[data-trip-delete]')) {
        const removeTrip = document.createElement('button');
        removeTrip.type = 'button';
        removeTrip.dataset.tripDelete = '';
        removeTrip.textContent = 'DELETE TRIP';
        footer.append(removeTrip);
      }
    };

    const updateStartButton = () => {
      const select = document.querySelector('[data-trip-city-select]');
      const start = document.querySelector('[data-trip-start]');
      const label = document.querySelector('[data-trip-start-label]');
      if (!(select instanceof HTMLSelectElement) || !(start instanceof HTMLButtonElement) || !label) return;
      const countrySlug = select.dataset.tripCountry || getPageContext().countrySlug;
      const city = getCity(countrySlug, select.value);
      const hasCountryTrips = readStore().trips.some((trip) => trip.countrySlug === countrySlug);
      start.disabled = !city;
      label.textContent = city ? `${hasCountryTrips ? 'Start another trip in' : 'Begin in'} ${city.name}` : 'Choose a city first';
    };

    const configureIntro = () => {
      const select = document.querySelector('[data-trip-city-select]');
      if (!(select instanceof HTMLSelectElement)) return;
      const countrySlug = select.dataset.tripCountry || getPageContext().countrySlug;
      const country = COUNTRIES[countrySlug];
      if (!country?.cities?.length) return;
      const previousValue = select.value;
      select.replaceChildren();
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = 'Select a starting point';
      select.append(placeholder);
      country.cities.forEach((city) => {
        const option = document.createElement('option');
        option.value = city.slug;
        option.textContent = city.name;
        select.append(option);
      });
      if (country.cities.some((city) => city.slug === previousValue)) select.value = previousValue;
      select.dataset.tripCountry = countrySlug;
      document.querySelector('[data-trip-start]')?.setAttribute('data-trip-country', countrySlug);
      updateStartButton();
    };

    const renderTripSelector = (store, activeTrip) => {
      const select = document.querySelector('[data-trip-select]');
      if (!(select instanceof HTMLSelectElement)) return;
      select.replaceChildren();
      Object.entries(COUNTRIES).forEach(([countrySlug, country]) => {
        const trips = store.trips.filter((trip) => trip.countrySlug === countrySlug);
        if (!trips.length) return;
        const group = document.createElement('optgroup');
        group.label = country.name;
        trips.forEach((trip) => {
          const option = document.createElement('option');
          option.value = trip.id;
          option.textContent = `${trip.name} · ${trip.items.length} ${trip.items.length === 1 ? 'card' : 'cards'}`;
          option.selected = trip.id === activeTrip.id;
          group.append(option);
        });
        select.append(group);
      });
    };

    const renderItems = (trip, content) => {
      content.replaceChildren();
      if (!trip.items.length) {
        const empty = document.createElement('p');
        empty.className = 'plan-trip-empty';
        const title = document.createElement('strong');
        title.textContent = `${trip.name} is ready.`;
        empty.append(title, document.createTextNode('Explore freely and save the restaurants, stays, experiences or landmarks that belong in this route.'));
        content.append(empty);
        return;
      }
      const stack = document.createElement('section');
      stack.className = 'plan-trip-notes';
      stack.setAttribute('aria-label', `Saved cards in ${trip.name}`);
      trip.items.forEach((item, index) => {
        const noteType = getNoteType(item);
        const row = document.createElement('article');
        row.className = `plan-trip-note plan-trip-note--${noteType.key}`;
        if (index >= 4) row.hidden = true;
        const number = document.createElement('span');
        number.className = 'plan-trip-note__number';
        number.textContent = String(index + 1).padStart(2, '0');
        const details = document.createElement('div');
        const stamp = document.createElement('span');
        stamp.className = 'plan-trip-note__stamp';
        stamp.textContent = noteType.label;
        const name = document.createElement('strong');
        name.textContent = item.name;
        const meta = document.createElement('small');
        const location = item.city || item.countryName || trip.countryName;
        meta.textContent = `${location}${item.address ? ` · ${item.address}` : ''}`;
        details.append(stamp, name, meta);
        if (item.url) {
          const link = document.createElement('a');
          link.className = 'plan-trip-note__link';
          link.href = item.url;
          link.dataset.tripOpenCard = '';
          link.textContent = 'Open the saved card →';
          details.append(link);
        }
        const remove = document.createElement('button');
        remove.className = 'plan-trip-note__remove';
        remove.type = 'button';
        remove.dataset.tripRemove = item.id;
        remove.setAttribute('aria-label', `Remove ${item.name} from ${trip.name}`);
        remove.textContent = '×';
        row.append(number, details, remove);
        stack.append(row);
      });
      if (trip.items.length > 4) {
        const more = document.createElement('button');
        more.className = 'plan-trip-more';
        more.type = 'button';
        more.dataset.tripMore = '';
        const remaining = trip.items.length - 4;
        more.textContent = `+ ${remaining} MORE SAVED ${remaining === 1 ? 'CARD' : 'CARDS'}`;
        more.setAttribute('aria-expanded', 'false');
        stack.append(more);
      }
      content.append(stack);
    };

    const syncAddButtons = (store, activeTrip) => {
      document.querySelectorAll('[data-trip-add], [data-add-landmark]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const item = parseTripItem(button);
        if (!item) return;
        const targetTrip = activeTrip?.countrySlug === item.countrySlug ? activeTrip : getCountryActiveTrip(store, item.countrySlug);
        const saved = Boolean(targetTrip?.items.some((savedItem) => savedItem.id === item.id));
        button.textContent = saved ? 'Saved to My Trip' : 'Add to My Trip';
        button.disabled = saved;
        button.setAttribute('aria-pressed', String(saved));
        button.title = targetTrip ? `${saved ? 'Saved in' : 'Save in'} ${targetTrip.name}` : `Create a ${item.countryName} trip and save this card`;
      });
    };

    const render = () => {
      installControls();
      const store = readStore();
      const page = getPageContext();
      const pageTrip = page.countrySlug ? getCountryActiveTrip(store, page.countrySlug) : null;
      if (pageTrip && store.activeTripId !== pageTrip.id) setActiveTrip(store, pageTrip);
      const activeTrip = getActiveTrip(store);
      const widget = document.querySelector('[data-trip-widget]');
      const drawer = document.querySelector('[data-trip-drawer]');
      const content = document.querySelector('[data-trip-content]');
      const count = document.querySelector('[data-trip-count]');
      const summary = document.querySelector('[data-trip-summary]');
      const title = document.querySelector('[data-trip-title]');
      const fabTitle = document.querySelector('[data-trip-fab-title]');
      const footer = document.querySelector('[data-trip-footer]');
      const explore = document.querySelector('[data-trip-explore]');
      const toggle = document.querySelector('[data-trip-toggle]');
      if (!widget || !drawer || !content || !count || !summary || !title || !fabTitle || !footer || !explore || !toggle) return;
      if (!activeTrip) {
        widget.hidden = true;
        closeDrawer();
        syncAddButtons(store, null);
        updateStartButton();
        return;
      }
      widget.hidden = false;
      const itemCount = activeTrip.items.length;
      const cityCount = new Set(activeTrip.items.filter((item) => item.kind !== 'landmark').map((item) => item.city).filter(Boolean)).size;
      count.textContent = String(itemCount).padStart(2, '0');
      fabTitle.textContent = activeTrip.name.toUpperCase();
      title.textContent = activeTrip.name;
      summary.textContent = itemCount
        ? `${itemCount} saved ${itemCount === 1 ? 'card' : 'cards'}${cityCount ? ` across ${cityCount} ${cityCount === 1 ? 'city' : 'cities'}` : ''}.`
        : `An empty ${activeTrip.countryName} field notebook.`;
      toggle.setAttribute('aria-label', `Open ${activeTrip.name} with ${itemCount} saved ${itemCount === 1 ? 'card' : 'cards'}`);
      drawer.setAttribute('aria-label', activeTrip.name);
      footer.hidden = false;
      const startingCity = getCity(activeTrip.countrySlug, activeTrip.startingCity);
      explore.href = startingCity?.route || COUNTRIES[activeTrip.countrySlug]?.route || '/';
      explore.firstChild.textContent = `CONTINUE EXPLORING ${activeTrip.countryName.toUpperCase()} `;
      renderTripSelector(store, activeTrip);
      renderItems(activeTrip, content);
      syncAddButtons(store, activeTrip);
      updateStartButton();
    };

    const openCardFromHash = () => {
      const hash = decodeURIComponent(window.location.hash.replace(/^#/, ''));
      if (!hash) return;
      const landmarkTrigger = [...document.querySelectorAll('[data-open-landmark]')].find((trigger) => trigger.dataset.openLandmark === hash);
      if (landmarkTrigger instanceof HTMLElement) return landmarkTrigger.click();
      const target = document.getElementById(hash);
      const placeTrigger = target?.querySelector?.('[data-place-open]');
      if (placeTrigger instanceof HTMLElement) return placeTrigger.click();
      if (target instanceof HTMLDialogElement && !target.open) target.showModal();
    };

    const handleClick = (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const toggle = target.closest('[data-trip-toggle]');
      if (toggle) { event.preventDefault(); openDrawer(); return; }
      const close = target.closest('[data-trip-close]');
      if (close) { event.preventDefault(); closeDrawer(); document.querySelector('[data-trip-toggle]')?.focus(); return; }
      const start = target.closest('[data-trip-start]');
      if (start instanceof HTMLButtonElement) {
        event.preventDefault();
        const select = document.querySelector('[data-trip-city-select]');
        if (!(select instanceof HTMLSelectElement) || !select.value) return;
        const countrySlug = select.dataset.tripCountry || getPageContext().countrySlug;
        const city = getCity(countrySlug, select.value);
        if (!city) return;
        const store = readStore();
        createTrip(store, countrySlug, { startingCity: city.slug, startingCityName: city.name });
        writeStore(store);
        window.location.href = city.route;
        return;
      }
      const add = target.closest('[data-trip-add], [data-add-landmark]');
      if (add instanceof HTMLButtonElement) {
        event.preventDefault();
        const item = parseTripItem(add);
        if (!item) return;
        const store = readStore();
        const trip = ensureTripForItem(store, item);
        if (!trip) return;
        if (!trip.items.some((savedItem) => savedItem.id === item.id)) trip.items.push(item);
        trip.updatedAt = new Date().toISOString();
        setActiveTrip(store, trip);
        writeStore(store);
        render();
        return;
      }
      const remove = target.closest('[data-trip-remove]');
      if (remove instanceof HTMLButtonElement) {
        event.preventDefault();
        const store = readStore();
        const trip = getActiveTrip(store);
        if (!trip) return;
        trip.items = trip.items.filter((item) => item.id !== remove.dataset.tripRemove);
        trip.updatedAt = new Date().toISOString();
        writeStore(store);
        render();
        return;
      }
      const more = target.closest('[data-trip-more]');
      if (more instanceof HTMLButtonElement) {
        event.preventDefault();
        const expanded = more.getAttribute('aria-expanded') === 'true';
        const notes = [...more.parentElement.querySelectorAll('.plan-trip-note')];
        notes.forEach((note, index) => { if (index >= 4) note.hidden = expanded; });
        more.setAttribute('aria-expanded', String(!expanded));
        const remaining = Math.max(0, notes.length - 4);
        more.textContent = expanded ? `+ ${remaining} MORE SAVED ${remaining === 1 ? 'CARD' : 'CARDS'}` : 'SHOW FEWER CARDS';
        return;
      }
      const clear = target.closest('[data-trip-clear]');
      if (clear instanceof HTMLButtonElement) {
        event.preventDefault();
        const store = readStore();
        const trip = getActiveTrip(store);
        if (!trip?.items.length || !window.confirm(`Remove every saved card from ${trip.name}?`)) return;
        trip.items = [];
        trip.updatedAt = new Date().toISOString();
        writeStore(store);
        render();
        return;
      }
      const deleteTrip = target.closest('[data-trip-delete]');
      if (deleteTrip instanceof HTMLButtonElement) {
        event.preventDefault();
        const store = readStore();
        const trip = getActiveTrip(store);
        if (!trip || !window.confirm(`Delete ${trip.name}?`)) return;
        store.trips = store.trips.filter((entry) => entry.id !== trip.id);
        if (store.activeTripByCountry?.[trip.countrySlug] === trip.id) delete store.activeTripByCountry[trip.countrySlug];
        setActiveTrip(store, getCountryActiveTrip(store, getPageContext().countrySlug) || store.trips[0] || null);
        writeStore(store);
        render();
        return;
      }
      const newTrip = target.closest('[data-trip-new]');
      if (newTrip instanceof HTMLButtonElement) {
        event.preventDefault();
        const store = readStore();
        const page = getPageContext();
        const active = getActiveTrip(store);
        const fallbackCountry = Object.entries(COUNTRIES).find(([, country]) => country.cities?.length)?.[0] || 'laos';
        const countrySlug = page.countrySlug || active?.countrySlug || fallbackCountry;
        createTrip(store, countrySlug, { startingCity: page.citySlug, startingCityName: page.cityName });
        writeStore(store);
        render();
        return;
      }
      const cardLink = target.closest('[data-trip-open-card]');
      if (cardLink instanceof HTMLAnchorElement) {
        const destination = new URL(cardLink.href, window.location.href);
        if (destination.pathname === window.location.pathname && destination.search === window.location.search) {
          event.preventDefault();
          closeDrawer();
          window.history.replaceState(null, '', `${destination.pathname}${destination.search}${destination.hash}`);
          openCardFromHash();
          return;
        }
      }
      const widget = document.querySelector('[data-trip-widget]');
      const drawer = document.querySelector('[data-trip-drawer]');
      if (widget?.classList.contains('is-open') && drawer && !widget.contains(target)) closeDrawer();
    };

    const handleChange = (event) => {
      const target = event.target;
      if (target instanceof HTMLSelectElement && target.matches('[data-trip-city-select]')) return updateStartButton();
      if (target instanceof HTMLSelectElement && target.matches('[data-trip-select]')) {
        const store = readStore();
        const trip = store.trips.find((entry) => entry.id === target.value);
        if (!trip) return;
        trip.updatedAt = new Date().toISOString();
        setActiveTrip(store, trip);
        writeStore(store);
        render();
      }
    };

    const init = () => {
      configureIntro();
      render();
      window.setTimeout(openCardFromHash, 0);
    };

    if (!window.__atlasTripManager) {
      window.__atlasTripManager = { init, render };
      document.addEventListener('click', handleClick);
      document.addEventListener('change', handleChange);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeDrawer();
      });
      window.addEventListener('storage', render);
      window.addEventListener('atlas:trips-changed', render);
      window.addEventListener('hashchange', openCardFromHash);
      document.addEventListener('astro:page-load', init);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
      else init();
    } else {
      window.__atlasTripManager.init();
    }
  })();
</script>
