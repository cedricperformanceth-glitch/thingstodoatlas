---
export type CitySpotlightItem = {
  slug: string;
  name: string;
  image: string;
  imageAlt: string;
  kicker: string;
  summary: string;
  duration: string;
  route: string;
  dialogId: string;
};

interface Props {
  cityName: string;
  eyebrow: string;
  title: string;
  items: CitySpotlightItem[];
  asideTitle: string;
  asideParagraphs: string[];
  asideNote?: string;
  panelSlug?: string;
}

const { cityName, eyebrow, title, items, asideTitle, asideParagraphs, asideNote, panelSlug = 'things-to-do' } = Astro.props;
---

<section class="city-spotlights" aria-labelledby={`${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-spotlights-title`}>
  <header class="city-spotlights__heading">
    <p>{eyebrow}</p>
    <h2 id={`${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-spotlights-title`}>{title}</h2>
  </header>

  <div class="city-spotlights__layout">
    <div class="city-spotlights__list" aria-label={`Places to explore from ${cityName}`}>
      {items.slice(0, 3).map((item, index) => (
        <button
          class:list={['city-spotlight-card', `city-spotlight-card--${index}`]}
          type="button"
          data-city-spotlight-open={item.dialogId}
          data-city-spotlight-panel={panelSlug}
          aria-label={`Open ${item.name} field note`}
        >
          <span class="city-spotlight-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="city-spotlight-card__image"><img src={item.image} alt={item.imageAlt} width="260" height="190" loading="lazy" decoding="async" /></span>
          <span class="city-spotlight-card__content">
            <span class="city-spotlight-card__kicker">{item.kicker}</span>
            <strong>{item.name}</strong>
            <span class="city-spotlight-card__summary">{item.summary}</span>
            <span class="city-spotlight-card__meta"><span>{item.duration}</span><i aria-hidden="true"></i><span>{item.route}</span></span>
          </span>
          <span class="city-spotlight-card__arrow" aria-hidden="true">↗</span>
        </button>
      ))}
    </div>

    <aside class="city-spotlights__editorial">
      <span class="city-spotlights__tape" aria-hidden="true"></span>
      <p class="city-spotlights__aside-label">FIELD ORIENTATION</p>
      <h3>{asideTitle}</h3>
      {asideParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      {asideNote && <p class="city-spotlights__note"><span aria-hidden="true">↳</span>{asideNote}</p>}
    </aside>
  </div>
</section>

<style>
  .city-spotlights{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(2.25rem,5vw,4.75rem) 0 clamp(3rem,6vw,5.5rem);border-top:1px solid rgba(31,57,45,.16)}.city-spotlights__heading{margin-bottom:clamp(1.5rem,3vw,2.4rem)}.city-spotlights__heading>p,.city-spotlights__aside-label{margin:0 0 .45rem;color:rgba(31,57,45,.58);font-size:.68rem;font-weight:700;letter-spacing:.2em}.city-spotlights__heading h2{max-width:42rem;margin:0;color:#1f392d;font:400 clamp(2.2rem,4.8vw,4.3rem)/.98 Georgia,'Times New Roman',serif;letter-spacing:-.05em}
  .city-spotlights__layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(17rem,.72fr);gap:clamp(2.2rem,6vw,6.5rem);align-items:start}.city-spotlights__list{display:grid;gap:.8rem}.city-spotlight-card{position:relative;display:grid;grid-template-columns:2.5rem 8.25rem minmax(0,1fr) 1.75rem;gap:1rem;align-items:center;width:100%;min-height:9.25rem;padding:.8rem 1rem .8rem .75rem;border:1px solid rgba(31,41,36,.18);border-radius:0;background:rgba(249,246,238,.78);color:#1c211e;box-shadow:0 5px 12px rgba(31,41,36,.035);font:inherit;text-align:left;cursor:pointer;transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease}.city-spotlight-card--0{transform:rotate(-.25deg)}.city-spotlight-card--1{transform:rotate(.18deg)}.city-spotlight-card--2{transform:rotate(-.12deg)}.city-spotlight-card:hover,.city-spotlight-card:focus-visible{z-index:2;transform:translateY(-2px) rotate(0);background:#faf7ef;box-shadow:0 10px 22px rgba(31,41,36,.075);outline:none}
  .city-spotlight-card__number{align-self:start;padding-top:.35rem;color:#a85e43;font:700 .78rem/1 'Segoe Print','Bradley Hand',cursive;transform:rotate(-5deg)}.city-spotlight-card__image{position:relative;display:block;padding:.28rem .28rem .75rem;background:#fdfbf5;box-shadow:0 4px 10px rgba(31,41,36,.09);transform:rotate(-1.2deg)}.city-spotlight-card__image::before{content:'';position:absolute;z-index:2;top:-.35rem;left:50%;width:2.8rem;height:.72rem;background:rgba(205,190,157,.55);transform:translateX(-50%) rotate(2deg)}.city-spotlight-card__image img{display:block;width:100%;height:5.35rem;object-fit:cover;filter:saturate(.78) contrast(.94)}.city-spotlight-card__content{display:flex;min-width:0;flex-direction:column}.city-spotlight-card__kicker{margin-bottom:.32rem;color:rgba(31,57,45,.58);font-size:.55rem;font-weight:800;letter-spacing:.14em}.city-spotlight-card strong{color:#1f392d;font:400 clamp(1.35rem,2.3vw,1.85rem)/1.05 Georgia,'Times New Roman',serif}.city-spotlight-card__summary{max-width:34rem;margin-top:.45rem;color:rgba(28,33,30,.76);font:400 .84rem/1.42 Georgia,'Times New Roman',serif}.city-spotlight-card__meta{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:.58rem;color:#8a4d36;font:600 .68rem/1.2 'Segoe Print','Bradley Hand',cursive}.city-spotlight-card__meta i{width:2px;height:2px;border-radius:50%;background:currentColor}.city-spotlight-card__arrow{color:#315545;font:400 1.25rem/1 Georgia,'Times New Roman',serif;transition:transform 180ms ease}.city-spotlight-card:hover .city-spotlight-card__arrow,.city-spotlight-card:focus-visible .city-spotlight-card__arrow{transform:translate(2px,-2px)}
  .city-spotlights__editorial{position:sticky;top:2rem;padding:clamp(1.8rem,3vw,2.5rem);border:1px solid rgba(31,57,45,.16);background:rgba(247,242,230,.72);box-shadow:0 8px 20px rgba(31,41,36,.04);transform:rotate(.45deg)}.city-spotlights__tape{position:absolute;top:-.55rem;right:2rem;width:4.7rem;height:1.15rem;background:rgba(205,190,157,.58);transform:rotate(4deg)}.city-spotlights__editorial h3{margin:0 0 1.2rem;color:#1f392d;font:400 clamp(1.65rem,3vw,2.35rem)/1.04 Georgia,'Times New Roman',serif;letter-spacing:-.035em}.city-spotlights__editorial>p:not(.city-spotlights__aside-label):not(.city-spotlights__note){margin:0;color:rgba(31,41,36,.78);font:400 .98rem/1.62 Georgia,'Times New Roman',serif}.city-spotlights__editorial>p+p:not(.city-spotlights__note){margin-top:.9rem}.city-spotlights__note{display:flex;gap:.5rem;margin:1.4rem 0 0;color:#8a4d36;font:400 .78rem/1.35 'Segoe Print','Bradley Hand',cursive;transform:rotate(-1.5deg)}
  @media(max-width:900px){.city-spotlights__layout{grid-template-columns:1fr;gap:2.25rem}.city-spotlights__editorial{position:relative;top:auto;max-width:40rem}}
  @media(max-width:620px){.city-spotlights{width:min(100% - 2rem,1180px);padding-top:2rem}.city-spotlight-card{grid-template-columns:1.65rem 5.75rem minmax(0,1fr);gap:.7rem;min-height:8.2rem;padding:.75rem .7rem}.city-spotlight-card__image{padding:.22rem .22rem .58rem}.city-spotlight-card__image img{height:4.6rem}.city-spotlight-card__summary{font-size:.76rem;line-height:1.35}.city-spotlight-card__meta{gap:.32rem;font-size:.6rem}.city-spotlight-card__arrow{display:none}}
  @media(max-width:430px){.city-spotlight-card{grid-template-columns:1.45rem minmax(0,1fr)}.city-spotlight-card__image{display:none}}
</style>

<script>
  const setupCitySpotlights = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-city-spotlight-open]').forEach((button) => {
      if (button.dataset.citySpotlightReady === 'true') return;
      button.dataset.citySpotlightReady = 'true';
      button.addEventListener('click', () => {
        const panelSlug = button.dataset.citySpotlightPanel || '';
        const tab = document.querySelector<HTMLButtonElement>(`[data-city-category-button="${panelSlug}"]`);
        tab?.click();
        requestAnimationFrame(() => {
          const dialog = document.getElementById(button.dataset.citySpotlightOpen || '');
          if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
        });
      });
    });
  };
  setupCitySpotlights();
  document.addEventListener('astro:page-load', setupCitySpotlights);
</script>
