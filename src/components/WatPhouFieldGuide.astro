---
import {
  watPhouFaq,
  watPhouImages as images,
  watPhouPracticalCards,
  watPhouQuickFacts,
  watPhouSources,
  watPhouStory
} from '../data/watPhouPrototype';

const watPhouTripItem = {
  id: 'laos:landmark:pakse:wat-phou-modal',
  originalId: 'wat-phou-modal',
  kind: 'landmark',
  name: 'Wat Phou',
  countrySlug: 'laos',
  countryName: 'Laos',
  citySlug: 'champasak',
  city: 'Champasak',
  group: 'landmarks',
  category: 'UNESCO temple · Cultural landmark',
  address: 'Champasak Province, Southern Laos',
  url: '/laos/pakse/things-to-do/wat-phou'
};

const watPhouRelatedLandmarks = [
  {
    title: 'Wat Phou Salao',
    kicker: 'PAKSE · GOLDEN BUDDHA · VIEWPOINT',
    note: 'A hilltop temple above Pakse with the Golden Buddha and a wide view across the Mekong plain.',
    href: '/laos/pakse',
    image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Golden_Buddha_of_Wat_Phou_Salao%2C_Pakse_20251228_%28II%29.jpg?width=1100',
    alt: 'Golden Buddha at Wat Phou Salao above Pakse',
    credit: 'Supanut Arunoprayote · CC BY 4.0'
  },
  {
    title: 'Bolaven Plateau',
    kicker: 'ROAD TRIP · WATERFALLS · COFFEE',
    note: 'Leave Pakse for a highland road of waterfalls, coffee farms and villages rather than one single stop.',
    href: '/laos/pakse#explore-board-pakse',
    image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Bolaven_Plateau.jpg?width=1100',
    alt: 'Waterfall and forest landscape on the Bolaven Plateau',
    credit: 'Dario Severi · CC BY-SA 3.0'
  },
  {
    title: 'Tad Lo',
    kicker: 'WATERFALLS · VILLAGE · SLOW DAYS',
    note: 'A slower Bolaven stop for waterfalls, village life and a few days without treating the road like a checklist.',
    href: '/laos/tad-lo',
    image: '/images/laos/tad-lo.webp',
    alt: 'Tad Lo in southern Laos'
  },
  {
    title: 'Don Det',
    kicker: 'MEKONG · ISLANDS · SOUTH',
    note: 'Continue south into Si Phan Don for bicycles, river days and the final Lao stretch before Cambodia.',
    href: '/laos/don-det',
    image: '/images/laos/don-det.webp',
    alt: 'Don Det island in Si Phan Don, southern Laos'
  }
];
---

<main class="field-guide-page">
  <nav class="field-guide-return" aria-label="Wat Phou guide navigation">
    <button type="button" data-wat-phou-page-back><span aria-hidden="true">←</span> Back to where you were</button>
    <a href="/laos/pakse#explore-board-pakse">Pakse field guide</a>
  </nav>

  <article class="field-guide-article" aria-labelledby="wat-phou-title">
    <nav class="field-guide-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Atlas</a><span aria-hidden="true">/</span>
      <a href="/laos">Laos</a><span aria-hidden="true">/</span>
      <a href="/laos/pakse">Pakse</a><span aria-hidden="true">/</span>
      <span aria-current="page">Wat Phou</span>
    </nav>

    <header class="field-guide-hero">
      <div class="field-guide-hero__copy">
        <p class="field-guide-kicker">LANDMARK · CHAMPASAK · SOUTHERN LAOS</p>
        <h1 id="wat-phou-title">Wat Phou</h1>
        <p class="field-guide-aliases">Vat Phou · Wat Phu · UNESCO World Heritage</p>
        <p class="field-guide-deck">An ancient Khmer temple where the journey matters as much as the ruins: water, causeway, stone stairs and a sanctuary drawn toward Phou Kao.</p>

        <div class="field-guide-axis" aria-label="The Wat Phou ceremonial route">
          <span class="field-guide-axis__label">FOLLOW THE LINE</span>
          <ol>
            <li><span>01</span>Barays</li>
            <li><span>02</span>Causeway</li>
            <li><span>03</span>Stairs</li>
            <li><span>04</span>Sanctuary</li>
            <li><span>05</span>Mountain</li>
          </ol>
          <p>not a checklist → a slow ascent</p>
        </div>

        <div class="field-guide-stamp" aria-label="Wat Phou field note">
          <span>FIELD NOTE</span><strong>Plan the visit</strong><small>Champasak · Laos</small>
        </div>
      </div>

      <figure class="field-guide-hero__photo">
        <span class="field-guide-tape" aria-hidden="true"></span>
        <img src={images.hero.src} alt={images.hero.alt} width="1800" height="1120" fetchpriority="high" />
        <figcaption>Photo: <a href={images.hero.source} target="_blank" rel="noreferrer">{images.hero.credit}</a> · <a href={images.hero.licenseUrl} target="_blank" rel="noreferrer">{images.hero.license}</a></figcaption>
        <span class="field-guide-photo-scribble" aria-hidden="true">the mountain is already part of the temple</span>
      </figure>
    </header>

    <section class="field-guide-quick" aria-label="Wat Phou visit overview">
      {watPhouQuickFacts.map((fact) => (
        <div>
          <span>{fact.label}</span>
          <strong>{fact.value}</strong>
          <small>{fact.note}</small>
        </div>
      ))}
    </section>

    <div class="field-guide-layout">
      <div class="field-guide-story">
        {[watPhouStory.opening, watPhouStory.history].map((section, index) => (
          <section class="field-guide-section">
            <p class="section-label">{section.label}</p>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph, paragraphIndex) => (
              <p class:list={{ 'field-guide-lead': index === 0 && paragraphIndex === 0 }}>{paragraph}</p>
            ))}
          </section>
        ))}
      </div>

      <aside class="field-guide-side-note">
        <span class="field-guide-note-tape" aria-hidden="true"></span>
        <p>READ THE SITE IN THIS ORDER</p>
        <ol>
          <li>Visitor area and museum</li>
          <li>Barays and the open axis</li>
          <li>Stone causeway and lower buildings</li>
          <li>Frangipani stairs</li>
          <li>Upper sanctuary and spring</li>
          <li>The view back toward the plain</li>
        </ol>
        <span>Do not save every photograph for the top.</span>
      </aside>
    </div>

    <section class="field-guide-photo-story">
      <figure class="field-guide-photo field-guide-photo--portrait">
        <span class="field-guide-tape" aria-hidden="true"></span>
        <img src={images.stairs.src} alt={images.stairs.alt} width="1100" height="1500" loading="lazy" />
        <figcaption>Photo: <a href={images.stairs.source} target="_blank" rel="noreferrer">{images.stairs.credit}</a> · <a href={images.stairs.licenseUrl} target="_blank" rel="noreferrer">{images.stairs.license}</a></figcaption>
      </figure>

      <div class="field-guide-section field-guide-section--climb">
        <p class="section-label">{watPhouStory.climb.label}</p>
        <h2>{watPhouStory.climb.title}</h2>
        {watPhouStory.climb.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <blockquote>{watPhouStory.climb.quote}</blockquote>
      </div>
    </section>

    <section class="field-guide-gallery" aria-label="Wat Phou photo notes">
      {[images.sanctuary, images.mountain].map((image, index) => (
        <figure class:list={{ 'field-guide-gallery__mountain': index === 1 }}>
          <img src={image.src} alt={image.alt} width="1100" height="760" loading="lazy" />
          <figcaption><a href={image.source} target="_blank" rel="noreferrer">{image.credit}</a> · <a href={image.licenseUrl} target="_blank" rel="noreferrer">{image.license}</a></figcaption>
        </figure>
      ))}
      <p class="field-guide-gallery-note" aria-hidden="true">stone below · sacred mountain behind</p>
    </section>

    <div class="field-guide-layout field-guide-layout--reverse">
      <div class="field-guide-story">
        {[watPhouStory.sanctuary, watPhouStory.returnView].map((section) => (
          <section class="field-guide-section">
            <p class="section-label">{section.label}</p>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </div>

      <aside class="field-guide-paper-note">
        <span class="field-guide-note-tape" aria-hidden="true"></span>
        <span>WORTH CARRYING</span>
        <ul>
          <li>Water</li>
          <li>Sun protection</li>
          <li>Respectful light clothing</li>
          <li>Shoes with grip</li>
          <li>Time for the museum</li>
        </ul>
        <p>Ticket prices and opening arrangements can change. Check current information before departure.</p>
      </aside>
    </div>

    <section class="field-guide-practical" aria-labelledby="wat-phou-plan-title">
      <div class="field-guide-practical__heading">
        <div>
          <p class="section-label">PLAN YOUR WAT PHOU VISIT</p>
          <h2 id="wat-phou-plan-title">From Pakse or from Champasak?</h2>
        </div>
        <p>Both approaches work. One feels like a road trip; the other gives the temple more space.</p>
      </div>

      <div class="field-guide-practical__cards">
        {watPhouPracticalCards.map((card) => (
          <article>
            <span>{card.number}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="field-guide-photo-note">
      <figure>
        <span class="field-guide-tape" aria-hidden="true"></span>
        <img src={images.detail.src} alt={images.detail.alt} width="1000" height="760" loading="lazy" />
        <figcaption>Photo: <a href={images.detail.source} target="_blank" rel="noreferrer">{images.detail.credit}</a> · <a href={images.detail.licenseUrl} target="_blank" rel="noreferrer">{images.detail.license}</a></figcaption>
      </figure>
      <div>
        <p class="section-label">{watPhouStory.livingSite.label}</p>
        <h2>{watPhouStory.livingSite.title}</h2>
        {watPhouStory.livingSite.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="field-guide-faq" aria-labelledby="wat-phou-faq-title">
      <p class="section-label">QUESTIONS PEOPLE ASK BEFORE GOING</p>
      <h2 id="wat-phou-faq-title">Wat Phou, practically</h2>
      <p class="field-guide-faq__intro">The short answers for planning a Wat Phou day trip, understanding the different spellings and knowing what the climb actually involves.</p>
      {watPhouFaq.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="field-guide-sources" aria-label="Editorial and image sources">
      <p><strong>Field note method.</strong> Historical and heritage facts were cross-checked against UNESCO and official tourism information. Independent visitor reports were used only to identify recurring practical questions.</p>
      <details>
        <summary>Sources & photo licences</summary>
        <ul>{watPhouSources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul>
        <p>Wat Phou article photographs link to their Wikimedia Commons file page and Creative Commons licence.</p>
      </details>
    </section>

    <section class="field-guide-related" aria-labelledby="wat-phou-related-title">
      <header class="field-guide-related__heading">
        <div>
          <p class="section-label">KEEP EXPLORING SOUTHERN LAOS</p>
          <h2 id="wat-phou-related-title">Where does the road go next?</h2>
        </div>
        <p>Four nearby chapters that make sense before or after Wat Phou. Pick the next card rather than jumping back into a menu.</p>
      </header>

      <div class="field-guide-related__grid">
        {watPhouRelatedLandmarks.map((landmark) => (
          <a class="field-guide-related-card" href={landmark.href}>
            <span class="field-guide-related-card__image">
              <img src={landmark.image} alt={landmark.alt} width="700" height="900" loading="lazy" decoding="async" />
            </span>
            {landmark.credit && <span class="field-guide-related-card__credit">Photo: {landmark.credit}</span>}
            <span class="field-guide-related-card__copy">
              <small>{landmark.kicker}</small>
              <strong>{landmark.title}</strong>
              <p>{landmark.note}</p>
              <span class="field-guide-related-card__arrow">Open the field note <b aria-hidden="true">↗</b></span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="field-guide-final-cta" aria-labelledby="wat-phou-final-cta-title">
      <div class="field-guide-final-cta__copy">
        <p class="section-label">KEEP IT IN THE NOTEBOOK</p>
        <h2 id="wat-phou-final-cta-title">Save Wat Phou for the road.</h2>
        <p>Add the landmark to your trip now, or open the map when you are ready to work out the route.</p>
      </div>

      <div class="field-guide-final-cta__actions">
        <button
          type="button"
          class="field-guide-primary-action"
          data-trip-add
          data-trip-place={JSON.stringify(watPhouTripItem)}
          aria-label="Add Wat Phou to My Trip"
        >Add to My Trip</button>
        <a class="field-guide-secondary-action" href="https://www.google.com/maps/search/?api=1&query=Wat%20Phou%2C%20Champasak%2C%20Laos" target="_blank" rel="noreferrer">Google Maps ↗</a>
      </div>
    </section>
  </article>
</main>

<script>
  const setupWatPhouPageBack = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-wat-phou-page-back]').forEach((button) => {
      if (button.dataset.backReady === 'true') return;
      button.dataset.backReady = 'true';
      button.addEventListener('click', () => {
        const hasStoredSource = Boolean(sessionStorage.getItem('atlas:wat-phou-return'));
        if (hasStoredSource && history.length > 1) history.back();
        else location.href = '/laos/pakse#explore-board-pakse';
      });
    });
  };

  setupWatPhouPageBack();
  document.addEventListener('astro:page-load', setupWatPhouPageBack);
</script>
