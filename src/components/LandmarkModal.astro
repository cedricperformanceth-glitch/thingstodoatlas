---
const {
  id,
  name,
  region,
  description,
  mapsUrl = '#',
  facts = [],
  gallery = [],
  country = 'Sri Lanka',
  fieldCardNumber
} = Astro.props;

const galleryItems = Array.isArray(gallery) ? gallery.filter((item) => item?.src) : [];
const primaryImage = galleryItems[0] ?? null;

const factIcons = {
  'Getting there': 'route',
  'Best time': 'weather',
  'What to wear': 'jacket',
  'Price': 'ticket',
  'Duration': 'clock',
  'Difficulty': 'stairs'
};

const annotations = {
  Sigiriya: {
    'Best time': { crossed: 'After breakfast', correction: 'No — go before the heat.' },
    'What to wear': { note: 'Sun cover + shoes with grip.' }
  },
  "Adam's Peak": {
    'What to wear': { crossed: 'A T-shirt is enough', correction: 'Bring a warm layer for the summit.' },
    'Difficulty': { crossed: 'A quick sunrise walk', correction: 'A lot of stairs. Really.' }
  },
  'Bolaven Plateau': {
    'Best time': { crossed: 'One quick stop', correction: 'Keep a full day for the loop.' },
    'What to wear': { note: 'Rain layer + shoes that can get wet.' }
  },
  'Wat Phou': {
    'Best time': { crossed: 'Middle of the afternoon', correction: 'Go early, before the stone heats up.' },
    'Difficulty': { note: 'Steady climb, uneven old steps.' }
  },
  'Khone Phapheng Falls': {
    'What to wear': { note: 'Light clothes + sun protection.' },
    'Difficulty': { crossed: 'A swimming stop', correction: 'Viewpoint only — respect the river.' }
  }
};

const storyAnnotations = {
  Sigiriya: [
    { label: 'Entry note', value: 'Paid entrance — check the official price before going.', icon: 'ticket' },
    { label: 'Best rhythm', value: 'Start early, climb slowly, keep time for the gardens.', icon: 'sun' },
    { label: 'Margin note', value: 'Almost no shade on the exposed stairs.', icon: 'shade' }
  ],
  "Adam's Peak": [
    { label: 'Entry note', value: 'The climb is free; transport and small services are not.', icon: 'ticket' },
    { label: 'Best rhythm', value: 'Leave at night and do not race the staircase.', icon: 'moon' },
    { label: 'Margin note', value: 'The summit can feel much colder than the trail below.', icon: 'jacket' }
  ],
  'Bolaven Plateau': [
    { label: 'Road note', value: 'The loop is the experience — not only one waterfall.', icon: 'route' },
    { label: 'Best rhythm', value: 'Leave Pakse early and avoid rushing the final stops.', icon: 'sun' },
    { label: 'Margin note', value: 'Weather can change quickly on the plateau.', icon: 'jacket' }
  ],
  'Wat Phou': [
    { label: 'Entry note', value: 'Paid archaeological site — confirm the current ticket.', icon: 'ticket' },
    { label: 'Best rhythm', value: 'Walk the lower complex before climbing to the sanctuary.', icon: 'sun' },
    { label: 'Margin note', value: 'Carry water; the upper terraces are exposed.', icon: 'shade' }
  ],
  'Khone Phapheng Falls': [
    { label: 'Entry note', value: 'Paid viewpoint area — check the current entrance fee.', icon: 'ticket' },
    { label: 'Best rhythm', value: 'Give yourself time to walk between the viewpoints.', icon: 'sun' },
    { label: 'Margin note', value: 'The Mekong is powerful here; stay behind barriers.', icon: 'route' }
  ]
};

const defaultCardNumbers = {
  Sigiriya: '01',
  "Adam's Peak": '02',
  'Bolaven Plateau': '03',
  'Wat Phou': '04',
  'Khone Phapheng Falls': '05'
};

const footerNotes = {
  Sigiriya: 'water before the climb',
  "Adam's Peak": 'check weather before leaving',
  'Bolaven Plateau': 'leave room for one more waterfall',
  'Wat Phou': 'slow down on the old steps',
  'Khone Phapheng Falls': 'watch the river from a distance'
};

const storyScribbles = {
  Sigiriya: 'not just the summit',
  "Adam's Peak": 'the road begins at night',
  'Bolaven Plateau': 'follow the road, not the clock',
  'Wat Phou': 'read the stones slowly',
  'Khone Phapheng Falls': 'the river sets the scale'
};

const landmarkAnnotations = annotations[name] ?? {};
const landmarkStoryAnnotations = storyAnnotations[name] ?? [];
const footerNote = footerNotes[name] ?? 'keep this field note nearby';
const cardNumber = fieldCardNumber ?? defaultCardNumbers[name] ?? '01';
const storyScribble = storyScribbles[name] ?? 'keep looking beyond the obvious';
---

<dialog class="landmark-modal" id={id} aria-labelledby={`${id}-title`}>
  <button class="landmark-modal__close" type="button" aria-label={`Close ${name}`} data-close-landmark>
    <span>close</span><b aria-hidden="true">×</b>
  </button>

  <div class="landmark-modal__grid">
    <section class="landmark-modal__story">
      <span class="landmark-story__tape" aria-hidden="true"></span>
      <p class="landmark-modal__eyebrow">{country.toUpperCase()} · LANDMARK</p>
      <h2 id={`${id}-title`}>{name}</h2>
      <p class="landmark-modal__region">{region}</p>
      <svg class="landmark-story__underline" viewBox="0 0 210 18" aria-hidden="true">
        <path d="M5 9C44 14 82 2 124 9s53 4 81-3" />
        <path d="M29 14c47 3 99-5 161-1" />
      </svg>
      <p class="landmark-story__description">{description}</p>

      <div class="landmark-story__annotations" aria-label={`${name} quick notes`}>
        {landmarkStoryAnnotations.map((note, index) => (
          <article class:list={['landmark-story-note', { 'landmark-story-note--tilted': index === 1 }]}>
            <span class="landmark-story-note__mark" aria-hidden="true">
              {note.icon === 'ticket' && <svg viewBox="0 0 36 36"><path d="M5 10c3 0 4-3 4-5h21v7c-4 0-4 5 0 5v12H9c0-4-1-5-4-5z"/><path d="M14 9v3m0 3v3m0 3v3m6-10h6m-6 6h6"/></svg>}
              {note.icon === 'sun' && <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="7"/><path d="M18 3v6m0 18v6M3 18h6m18 0h6M7.5 7.5l4.2 4.2m12.6 12.6 4.2 4.2m0-21-4.2 4.2M11.7 24.3l-4.2 4.2"/></svg>}
              {note.icon === 'shade' && <svg viewBox="0 0 36 36"><path d="M5 18C8 8 15 5 18 5c5 0 12 4 14 13zM18 18v13c-1 3-5 2-5-1M9 18c1-3 3-5 5-6m8 0c2 1 4 3 5 6"/></svg>}
              {note.icon === 'moon' && <svg viewBox="0 0 36 36"><path d="M25 27C15 30 7 22 9 13c1-5 5-8 9-9-4 8 0 17 7 23zM27 7l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/></svg>}
              {note.icon === 'jacket' && <svg viewBox="0 0 36 36"><path d="M12 6 8 9 5 18l4 2 2-5v16h14V15l2 5 4-2-3-9-4-3M12 6c1 4 4 6 6 8 2-2 5-4 6-8M18 14v17"/></svg>}
              {note.icon === 'route' && <svg viewBox="0 0 36 36"><circle cx="8" cy="27" r="3"/><circle cx="28" cy="8" r="3"/><path d="M11 26c6-2 2-9 8-9s4-5 6-7m-8 4 4 4-4 4"/></svg>}
            </span>
            <div><span>{note.label}</span><p>{note.value}</p></div>
          </article>
        ))}
      </div>

      <p class="landmark-story__scribble">
        <span>{storyScribble}</span>
        <svg viewBox="0 0 88 28" aria-hidden="true"><path d="M3 20C20 5 43 6 70 17"/><path d="m65 11 7 6-8 4"/></svg>
      </p>
    </section>

    <section class="landmark-modal__visual">
      <div class="landmark-visual__meta"><span>FIELD CARD · {cardNumber}</span><i aria-hidden="true"></i></div>

      {primaryImage ? (
        <div class="landmark-gallery" data-landmark-gallery>
          <div class="landmark-gallery__stage">
            <img src={primaryImage.src} alt={primaryImage.alt || `${name} landscape`} width="900" height="720" loading="eager" data-gallery-main />
            {galleryItems.length > 1 && (
              <>
                <button class="landmark-gallery__arrow landmark-gallery__arrow--previous" type="button" aria-label={`Previous ${name} photo`} data-gallery-previous>
                  <svg viewBox="0 0 28 20" aria-hidden="true"><path d="M24 10H5m0 0 6-6m-6 6 6 6"/></svg><span>previous view</span>
                </button>
                <button class="landmark-gallery__arrow landmark-gallery__arrow--next" type="button" aria-label={`Next ${name} photo`} data-gallery-next>
                  <svg viewBox="0 0 28 20" aria-hidden="true"><path d="M4 10h19m0 0-6-6m6 6-6 6"/></svg><span>next view</span>
                </button>
                <span class="landmark-gallery__counter" aria-live="polite" data-gallery-counter>PHOTO 01 / {String(galleryItems.length).padStart(2, '0')}</span>
              </>
            )}
          </div>

          {galleryItems.length > 1 && (
            <div class="landmark-gallery__thumbnails" role="list" aria-label={`${name} photo gallery`}>
              {galleryItems.map((image, index) => (
                <button
                  class:list={['landmark-gallery__thumbnail', { 'is-active': index === 0 }]}
                  type="button"
                  role="listitem"
                  aria-label={`Show ${name} photo ${index + 1}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-gallery-thumb
                  data-gallery-index={index}
                  data-gallery-src={image.src}
                  data-gallery-alt={image.alt || `${name} photo ${index + 1}`}
                  data-gallery-source-page={image.sourcePage || ''}
                  data-gallery-author={image.author || ''}
                  data-gallery-license={image.license || ''}
                >
                  <span class="landmark-gallery__thumb-paper"><img src={image.src} alt="" width="180" height="120" loading="lazy" /></span>
                  <small>{String(index + 1).padStart(2, '0')}</small>
                </button>
              ))}
            </div>
          )}

          <p class="landmark-gallery__credit" data-gallery-credit>
            Photo: <a href={primaryImage.sourcePage} target="_blank" rel="noreferrer" data-gallery-source>{primaryImage.author || 'Wikimedia Commons'}</a>
            {primaryImage.license && <span data-gallery-license-text> · {primaryImage.license}</span>}
          </p>
        </div>
      ) : (
        <div class="landmark-modal__placeholder" role="img" aria-label={`${name} photo placeholder`}><span>Photo coming soon</span></div>
      )}

      <div class="landmark-actions__annotation" aria-hidden="true">
        <span>save this field card for later</span>
        <svg viewBox="0 0 110 28"><path d="M3 8C34 2 64 8 99 21"/><path d="m91 15 9 6-10 3"/></svg>
      </div>

      <div class="landmark-modal__actions">
        <a class="landmark-action landmark-action--maps" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">↗</span> Open in Google Maps</a>
        <button class="landmark-action landmark-action--save" type="button" data-add-landmark data-landmark-name={name}><span aria-hidden="true">＋</span> Add to My Trip</button>
      </div>
      <p class="landmark-visual__closing">Keep it for the road.</p>
    </section>

    <aside class="landmark-modal__facts" aria-label={`${name} practical information`}>
      <span class="landmark-notes__tape" aria-hidden="true"></span>
      <header class="landmark-notes__heading">
        <span>FIELD NOTES · CHECKED ON THE ROAD</span>
        <h3>Things worth knowing</h3>
        <svg viewBox="0 0 190 16" aria-hidden="true"><path d="M4 8C42 13 74 2 112 8s50 4 74-2"/><path d="M20 12c45 3 98-4 151 0"/></svg>
      </header>

      <dl>
        {facts.map((fact) => {
          const icon = factIcons[fact.label] ?? 'route';
          const annotation = landmarkAnnotations[fact.label];
          return (
            <div class:list={['landmark-note', `landmark-note--${icon}`]}>
              <span class="landmark-note__icon" aria-hidden="true">
                {icon === 'route' && <svg viewBox="0 0 32 32"><circle cx="7" cy="23" r="2.6"/><circle cx="25" cy="8" r="2.6"/><path d="M9.5 22c4.5-2 1.5-8 6.5-8s4-4 6.5-5M17 11l3 3-3 3"/></svg>}
                {icon === 'weather' && <svg viewBox="0 0 32 32"><circle cx="12" cy="11" r="5"/><path d="M12 2.5v3m0 11v3M3.5 11h3m11 0h3M5.8 4.8l2.1 2.1m8.2 8.2 2.1 2.1M13 24c1-4 5-5 7.5-3 3.5-1.2 7.5 1 6.5 4.5H12.5M17 28l-1 2m7-2-1 2"/></svg>}
                {icon === 'jacket' && <svg viewBox="0 0 32 32"><path d="M11 5 7 8 4 17l4 2 2-5v14h12V14l2 5 4-2-3-9-4-3M11 5c1 4 3 5 5 7 2-2 4-3 5-7M16 12v16"/></svg>}
                {icon === 'ticket' && <svg viewBox="0 0 32 32"><path d="M5 9c2 0 3-2 3-4h18v6c-3 0-3 4 0 4v10H8c0-3-1-4-3-4zM12 8v2m0 3v2m0 3v2m0 3v1m5-12h5m-5 5h5"/></svg>}
                {icon === 'clock' && <svg viewBox="0 0 32 32"><circle cx="16" cy="17" r="11"/><path d="M16 10v7l5 3M12 3h8m-4 0v3"/></svg>}
                {icon === 'stairs' && <svg viewBox="0 0 32 32"><path d="M4 27h6v-5h6v-5h6v-5h6M7 10c5-5 12-6 17-3M21 4l3 3-4 2"/></svg>}
              </span>
              <div class="landmark-note__copy">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
                {annotation && (
                  <p class="landmark-note__annotation">
                    {annotation.crossed && <span class="landmark-note__crossed" aria-hidden="true">{annotation.crossed}</span>}
                    {annotation.correction && <span class="landmark-note__correction">{annotation.correction}</span>}
                    {annotation.note && <span class="landmark-note__aside">{annotation.note}</span>}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </dl>

      <p class="landmark-notes__footer">
        <svg viewBox="0 0 54 24" aria-hidden="true"><path d="M3 17C17 5 32 6 47 14"/><path d="m42 9 6 5-7 3"/></svg>
        <span>{footerNote}</span>
      </p>
    </aside>
  </div>
</dialog>

<script>
  const setupLandmarkGalleries = () => {
    document.querySelectorAll('[data-landmark-gallery]').forEach((gallery) => {
      if (!(gallery instanceof HTMLElement) || gallery.dataset.galleryReady === 'true') return;
      gallery.dataset.galleryReady = 'true';
      const main = gallery.querySelector('[data-gallery-main]');
      const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];
      const counter = gallery.querySelector('[data-gallery-counter]');
      const source = gallery.querySelector('[data-gallery-source]');
      const credit = gallery.querySelector('[data-gallery-credit]');
      const licenseText = gallery.querySelector('[data-gallery-license-text]');
      if (!(main instanceof HTMLImageElement) || !thumbs.length) return;
      let activeIndex = 0;
      let touchStartX = null;

      const activate = (requestedIndex) => {
        const index = (requestedIndex + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        if (!(thumb instanceof HTMLButtonElement)) return;
        if (thumb.dataset.gallerySrc) main.src = thumb.dataset.gallerySrc;
        main.alt = thumb.dataset.galleryAlt || main.alt;
        thumbs.forEach((item, itemIndex) => {
          item.classList.toggle('is-active', itemIndex === index);
          item.setAttribute('aria-pressed', itemIndex === index ? 'true' : 'false');
        });
        if (counter) counter.textContent = `PHOTO ${String(index + 1).padStart(2, '0')} / ${String(thumbs.length).padStart(2, '0')}`;
        if (source instanceof HTMLAnchorElement) {
          source.href = thumb.dataset.gallerySourcePage || '#';
          source.textContent = thumb.dataset.galleryAuthor || 'Wikimedia Commons';
        }
        if (licenseText) licenseText.textContent = thumb.dataset.galleryLicense ? ` · ${thumb.dataset.galleryLicense}` : '';
        if (credit instanceof HTMLElement) credit.hidden = !thumb.dataset.gallerySourcePage;
        activeIndex = index;
      };

      thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => activate(index)));
      gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => activate(activeIndex - 1));
      gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => activate(activeIndex + 1));
      main.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? null; }, { passive: true });
      main.addEventListener('touchend', (event) => {
        if (touchStartX === null) return;
        const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
        const distance = touchEndX - touchStartX;
        if (Math.abs(distance) > 45) activate(activeIndex + (distance < 0 ? 1 : -1));
        touchStartX = null;
      }, { passive: true });
    });
  };

  const setupLandmarkSaveButtons = () => {
    document.querySelectorAll('[data-add-landmark]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.saveReady === 'true') return;
      button.dataset.saveReady = 'true';
      button.addEventListener('click', () => {
        window.setTimeout(() => {
          button.textContent = '✓ Saved to My Trip';
          button.classList.add('is-saved');
          button.disabled = true;
        }, 0);
      });
    });
  };

  setupLandmarkGalleries();
  setupLandmarkSaveButtons();
  document.addEventListener('astro:page-load', () => {
    setupLandmarkGalleries();
    setupLandmarkSaveButtons();
  });
</script>

<style>
  :global(.map-overlay a.city-marker--active){color:#d97745}
  :global(.map-overlay a.city-marker--active .city-marker__label){font-size:30px}
  :global(.map-overlay g[data-open-landmark]){color:#315545}
  :global(.map-overlay g[data-open-landmark] .city-marker__label){font-size:27px}
  :global(.map-overlay .city-marker--inactive .city-marker__label){font-size:30px}

  .landmark-modal{position:relative;width:min(1260px,calc(100vw - 28px));height:min(720px,calc(100vh - 28px));max-height:none;padding:0;border:0;background:#f4ecd9;color:#1f2924;box-shadow:0 28px 80px rgba(18,24,21,.34);overflow:hidden}
  .landmark-modal::backdrop{background:rgba(20,27,24,.66);backdrop-filter:blur(4px)}
  .landmark-modal__close{position:absolute;top:13px;right:13px;z-index:8;display:flex;align-items:center;gap:5px;padding:7px 10px 6px;border:1px solid rgba(31,57,45,.35);border-radius:2px;background:#f7f0df;color:#315545;font-family:'Caveat','Segoe Print',cursive;font-size:.92rem;line-height:1;cursor:pointer;box-shadow:2px 3px 0 rgba(49,85,69,.11);transform:rotate(1.5deg);transition:transform 160ms ease,background 160ms ease}
  .landmark-modal__close b{font-size:1.15rem;font-weight:500}.landmark-modal__close:hover{background:#fffaf0;transform:rotate(-1.5deg) translateY(-1px)}
  .landmark-modal__grid{display:grid;grid-template-columns:minmax(280px,.88fr) minmax(360px,1.18fr) minmax(300px,.94fr);height:100%;min-height:0}.landmark-modal__story,.landmark-modal__visual,.landmark-modal__facts{min-width:0;min-height:0}
  .landmark-modal__story,.landmark-modal__facts{position:relative;isolation:isolate;overflow:hidden;color:#22382e;background-color:#f4ecd9;background-image:radial-gradient(circle at 17% 18%,rgba(217,119,69,.07) 0 1px,transparent 1.5px),radial-gradient(circle at 74% 62%,rgba(31,57,45,.06) 0 1px,transparent 1.5px),repeating-linear-gradient(to bottom,transparent 0 31px,rgba(49,85,69,.07) 32px,transparent 33px);background-size:23px 21px,29px 27px,100% 33px}
  .landmark-modal__story{padding:clamp(34px,3.2vw,48px) clamp(27px,2.8vw,42px);box-shadow:inset -12px 0 22px rgba(80,65,42,.045)}
  .landmark-modal__story::before,.landmark-modal__facts::before{content:'';position:absolute;z-index:-1;top:0;bottom:0;width:1px;background:rgba(217,119,69,.34);box-shadow:3px 0 0 rgba(217,119,69,.07)}.landmark-modal__story::before{left:23px}.landmark-modal__facts::before{left:24px}
  .landmark-story__tape,.landmark-notes__tape{position:absolute;top:10px;left:50%;width:92px;height:24px;background:rgba(196,174,132,.42);transform:translateX(-50%) rotate(-2deg);box-shadow:0 1px 1px rgba(70,55,34,.08)}
  .landmark-modal__eyebrow{margin:4px 0 17px;color:rgba(31,57,45,.58);font:700 .58rem/1.2 'DM Sans',sans-serif;letter-spacing:.14em}.landmark-modal__story h2{margin:0;color:#1f392d;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:clamp(3.7rem,5vw,5.9rem);font-weight:600;line-height:.8;letter-spacing:-.035em;transform:rotate(-1deg)}
  .landmark-modal__region{margin:17px 0 0!important;color:#b8653e!important;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:1.3rem!important;font-weight:600;line-height:1.05!important}.landmark-story__underline{display:block;width:min(210px,86%);margin:8px 0 15px;fill:none;stroke:#d97745;stroke-width:1.5;stroke-linecap:round;opacity:.76}
  .landmark-story__description{margin:0;color:#263b32;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:1.18rem;font-weight:500;line-height:1.28}.landmark-story__annotations{display:grid;gap:8px;margin-top:18px}.landmark-story-note{display:grid;grid-template-columns:33px minmax(0,1fr);gap:8px;align-items:start;padding:8px 9px 8px 5px;border-top:1px dashed rgba(31,57,45,.18)}.landmark-story-note--tilted{transform:rotate(-1deg)}
  .landmark-story-note__mark{display:grid;place-items:center;width:31px;height:31px;color:#315545;transform:rotate(-4deg)}.landmark-story-note:nth-child(even) .landmark-story-note__mark{color:#d97745;transform:rotate(4deg)}.landmark-story-note__mark svg{width:29px;height:29px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}
  .landmark-story-note div>span{display:block;margin-bottom:2px;color:#a45d3a;font:700 .54rem/1.2 'DM Sans',sans-serif;letter-spacing:.11em;text-transform:uppercase}.landmark-story-note p{margin:0;color:#315545;font-family:'Caveat','Segoe Print',cursive;font-size:1rem;font-weight:600;line-height:1.08}.landmark-story__scribble{display:flex;align-items:center;justify-content:flex-end;gap:3px;margin:10px 0 0;color:#b8653e;font-family:'Caveat','Segoe Print',cursive;font-size:1rem;font-weight:700;transform:rotate(-2deg)}.landmark-story__scribble svg{width:68px;height:23px;fill:none;stroke:#315545;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}

  .landmark-modal__visual{display:flex;flex-direction:column;justify-content:center;padding:24px clamp(24px,2.7vw,36px) 20px;background:#eee7d7;box-shadow:inset 11px 0 20px rgba(80,65,42,.045),inset -11px 0 20px rgba(80,65,42,.045)}.landmark-visual__meta{display:flex;align-items:center;gap:9px;margin:0 1px 8px;color:rgba(31,57,45,.64);font:700 .56rem/1 'DM Sans',sans-serif;letter-spacing:.13em}.landmark-visual__meta i{flex:1;height:1px;background:rgba(49,85,69,.2);transform:rotate(-.4deg)}
  .landmark-modal__placeholder{display:grid;place-items:center;min-height:340px;background:linear-gradient(145deg,#d9d0bc,#c4b99f);font-family:'Caveat',cursive;font-size:2rem}.landmark-gallery__stage{position:relative;min-height:340px;padding:7px;background:#f8f2e5;box-shadow:0 11px 24px rgba(31,41,36,.16),0 0 0 1px rgba(49,85,69,.13);touch-action:pan-y;transform:rotate(-.2deg)}.landmark-gallery__stage>img{display:block;width:100%;height:326px;object-fit:cover;transition:opacity 180ms ease}
