---
const { id, name, region, description, mapsUrl = '#', facts = [], gallery = [] } = Astro.props;
const galleryItems = Array.isArray(gallery) ? gallery.filter((item) => item?.src) : [];
const primaryImage = galleryItems[0] ?? null;
---
<dialog class="landmark-modal" id={id} aria-labelledby={`${id}-title`}>
  <button class="landmark-modal__close" type="button" aria-label={`Close ${name}`} data-close-landmark>×</button>
  <div class="landmark-modal__grid">
    <section class="landmark-modal__visual">
      {primaryImage ? (
        <div class="landmark-gallery" data-landmark-gallery>
          <div class="landmark-gallery__stage">
            <img
              src={primaryImage.src}
              alt={primaryImage.alt || `${name} landscape`}
              width="900"
              height="720"
              loading="eager"
              data-gallery-main
            />
            {galleryItems.length > 1 && (
              <>
                <button class="landmark-gallery__arrow landmark-gallery__arrow--previous" type="button" aria-label={`Previous ${name} photo`} data-gallery-previous>←</button>
                <button class="landmark-gallery__arrow landmark-gallery__arrow--next" type="button" aria-label={`Next ${name} photo`} data-gallery-next>→</button>
                <span class="landmark-gallery__counter" aria-live="polite" data-gallery-counter>1 / {galleryItems.length}</span>
              </>
            )}
          </div>

          {galleryItems.length > 1 && (
            <div class="landmark-gallery__thumbnails" role="list" aria-label={`${name} photo gallery`}>
              {galleryItems.map((image, index) => (
                <button
                  class:list={['landmark-gallery__thumbnail', { 'is-active': index === 0 }]}
                  type="button"
                  role="listitem"
                  aria-label={`Show ${name} photo ${index + 1}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-gallery-thumb
                  data-gallery-index={index}
                  data-gallery-src={image.src}
                  data-gallery-alt={image.alt || `${name} photo ${index + 1}`}
                  data-gallery-source-page={image.sourcePage || ''}
                  data-gallery-author={image.author || ''}
                  data-gallery-license={image.license || ''}
                >
                  <img src={image.src} alt="" width="180" height="120" loading="lazy" />
                </button>
              ))}
            </div>
          )}

          <p class="landmark-gallery__credit" data-gallery-credit>
            Photo: <a href={primaryImage.sourcePage} target="_blank" rel="noreferrer" data-gallery-source>{primaryImage.author || 'Wikimedia Commons'}</a>
            {primaryImage.license && <span data-gallery-license-text> · {primaryImage.license}</span>}
          </p>
        </div>
      ) : (
        <div class="landmark-modal__placeholder" role="img" aria-label={`${name} photo placeholder`}>
          <span>Photo coming soon</span>
        </div>
      )}

      <div class="landmark-modal__actions">
        <a href={mapsUrl} target="_blank" rel="noreferrer">Open in Google Maps</a>
        <button type="button" data-add-landmark data-landmark-name={name}>Add to my trip</button>
      </div>
    </section>

    <section class="landmark-modal__story">
      <p class="landmark-modal__eyebrow">SRI LANKA · LANDMARK</p>
      <h2 id={`${id}-title`}>{name}</h2>
      <p class="landmark-modal__region">{region}</p>
      <p>{description}</p>
    </section>

    <aside class="landmark-modal__facts" aria-label={`${name} practical information`}>
      <h3>Practical notes</h3>
      <dl>
        {facts.map((fact) => (
          <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
        ))}
      </dl>
    </aside>
  </div>
</dialog>

<script>
  const setupLandmarkGalleries = () => {
    document.querySelectorAll('[data-landmark-gallery]').forEach((gallery) => {
      if (!(gallery instanceof HTMLElement) || gallery.dataset.galleryReady === 'true') return;
      gallery.dataset.galleryReady = 'true';

      const main = gallery.querySelector('[data-gallery-main]');
      const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];
      const counter = gallery.querySelector('[data-gallery-counter]');
      const source = gallery.querySelector('[data-gallery-source]');
      const credit = gallery.querySelector('[data-gallery-credit]');
      const licenseText = gallery.querySelector('[data-gallery-license-text]');
      if (!(main instanceof HTMLImageElement) || !thumbs.length) return;

      let activeIndex = 0;
      let touchStartX = null;

      const activate = (requestedIndex) => {
        const index = (requestedIndex + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        if (!(thumb instanceof HTMLButtonElement)) return;

        const nextSrc = thumb.dataset.gallerySrc;
        if (nextSrc) main.src = nextSrc;
        main.alt = thumb.dataset.galleryAlt || main.alt;

        thumbs.forEach((item, itemIndex) => {
          item.classList.toggle('is-active', itemIndex === index);
          item.setAttribute('aria-pressed', itemIndex === index ? 'true' : 'false');
        });

        if (counter) counter.textContent = `${index + 1} / ${thumbs.length}`;
        if (source instanceof HTMLAnchorElement) {
          source.href = thumb.dataset.gallerySourcePage || '#';
          source.textContent = thumb.dataset.galleryAuthor || 'Wikimedia Commons';
        }
        if (licenseText) licenseText.textContent = thumb.dataset.galleryLicense ? ` · ${thumb.dataset.galleryLicense}` : '';
        if (credit instanceof HTMLElement) credit.hidden = !thumb.dataset.gallerySourcePage;
        activeIndex = index;
      };

      thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => activate(index)));
      gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => activate(activeIndex - 1));
      gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => activate(activeIndex + 1));

      main.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? null;
      }, { passive: true });
      main.addEventListener('touchend', (event) => {
        if (touchStartX === null) return;
        const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
        const distance = touchEndX - touchStartX;
        if (Math.abs(distance) > 45) activate(activeIndex + (distance < 0 ? 1 : -1));
        touchStartX = null;
      }, { passive: true });
    });
  };

  setupLandmarkGalleries();
  document.addEventListener('astro:page-load', setupLandmarkGalleries);
</script>

<style>
  .landmark-modal { width:min(1180px,calc(100vw - 28px)); max-height:min(860px,calc(100vh - 28px)); padding:0; border:0; background:#f7f2e6; color:#1f2924; box-shadow:0 28px 80px rgba(18,24,21,.34); overflow:auto; }
  .landmark-modal::backdrop { background:rgba(20,27,24,.66); backdrop-filter:blur(4px); }
  .landmark-modal__close { position:sticky; top:14px; float:right; z-index:5; width:44px; height:44px; margin:14px 14px -58px 0; border:1px solid rgba(31,57,45,.16); border-radius:50%; background:#fff; color:#1f392d; font-size:1.8rem; cursor:pointer; }
  .landmark-modal__grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1fr) minmax(260px,.72fr); gap:0; min-height:620px; }
  .landmark-modal__visual,.landmark-modal__story,.landmark-modal__facts { padding:clamp(28px,4vw,54px); }
  .landmark-modal__visual { background:#eee7d7; }
  .landmark-modal__placeholder { display:grid; place-items:center; min-height:390px; background:linear-gradient(145deg,#d9d0bc,#c4b99f); color:rgba(31,57,45,.65); font-family:'Caveat',cursive; font-size:2rem; box-shadow:inset 0 0 0 12px rgba(255,255,255,.5); }
  .landmark-gallery__stage { position:relative; min-height:390px; overflow:hidden; background:#c8bea8; box-shadow:0 10px 26px rgba(31,41,36,.14); touch-action:pan-y; }
  .landmark-gallery__stage > img { display:block; width:100%; height:390px; object-fit:cover; transition:opacity 180ms ease; }
  .landmark-gallery__arrow { position:absolute; z-index:2; top:50%; display:grid; place-items:center; width:42px; height:42px; padding:0; border:1px solid rgba(255,255,255,.7); border-radius:50%; background:rgba(31,57,45,.76); color:#fff; font-size:1.15rem; cursor:pointer; transform:translateY(-50%); backdrop-filter:blur(4px); }
  .landmark-gallery__arrow--previous { left:14px; }
  .landmark-gallery__arrow--next { right:14px; }
  .landmark-gallery__counter { position:absolute; right:14px; bottom:13px; padding:6px 9px; background:rgba(31,57,45,.78); color:#fff; font:700 .62rem/1 'DM Sans',sans-serif; letter-spacing:.08em; }
  .landmark-gallery__thumbnails { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; margin-top:10px; }
  .landmark-gallery__thumbnail { position:relative; min-width:0; padding:0; overflow:hidden; border:2px solid transparent; background:#d5ccba; cursor:pointer; opacity:.66; transition:opacity 160ms ease,border-color 160ms ease,transform 160ms ease; }
  .landmark-gallery__thumbnail:hover,.landmark-gallery__thumbnail.is-active { opacity:1; border-color:#315545; transform:translateY(-1px); }
  .landmark-gallery__thumbnail img { display:block; width:100%; height:66px; object-fit:cover; }
  .landmark-gallery__credit { min-height:17px; margin:10px 0 0; color:rgba(31,41,36,.58); font-size:.62rem; line-height:1.45; }
  .landmark-gallery__credit a { color:#315545; }
  .landmark-modal__actions { display:grid; gap:12px; margin-top:22px; }
  .landmark-modal__actions a,.landmark-modal__actions button { display:flex; align-items:center; justify-content:center; min-height:48px; border:1px solid #315545; background:transparent; color:#315545; font:700 .72rem/1 'DM Sans',sans-serif; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; cursor:pointer; }
  .landmark-modal__actions button { background:#315545; color:#fff; }
  .landmark-modal__story { display:flex; flex-direction:column; justify-content:center; background:#fff; }
  .landmark-modal__eyebrow { margin:0 0 18px; color:#d97745; font:700 .65rem/1.2 'DM Sans',sans-serif; letter-spacing:.15em; }
  .landmark-modal__story h2 { margin:0; color:#1f392d; font-size:clamp(3.4rem,6vw,6.8rem); line-height:.88; letter-spacing:-.05em; }
  .landmark-modal__region { margin:20px 0 30px!important; color:#315545!important; font-family:'Caveat',cursive; font-size:1.4rem!important; }
  .landmark-modal__story p:last-child { margin:0; color:rgba(31,41,36,.75); font-size:1rem; line-height:1.75; }
  .landmark-modal__facts { background:#1f392d; color:#f7f2e6; }
  .landmark-modal__facts h3 { margin:0 0 28px; color:#fff; font-size:1.55rem; }
  .landmark-modal__facts dl { display:grid; gap:0; margin:0; }
  .landmark-modal__facts div { padding:17px 0; border-top:1px solid rgba(255,255,255,.14); }
  .landmark-modal__facts dt { margin-bottom:6px; color:#d9a47f; font:700 .61rem/1.2 'DM Sans',sans-serif; letter-spacing:.12em; text-transform:uppercase; }
  .landmark-modal__facts dd { margin:0; color:rgba(255,255,255,.84); font-size:.88rem; line-height:1.55; }
  @media(max-width:900px){ .landmark-modal__grid{grid-template-columns:1fr 1fr}.landmark-modal__facts{grid-column:1/-1}.landmark-modal__facts dl{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px} }
  @media(max-width:650px){ .landmark-modal__grid{grid-template-columns:1fr}.landmark-modal__facts{grid-column:auto}.landmark-modal__facts dl{grid-template-columns:1fr}.landmark-gallery__stage{min-height:270px}.landmark-gallery__stage>img{height:270px}.landmark-gallery__thumbnail img{height:56px}.landmark-modal__story h2{font-size:3.8rem} }
</style>
