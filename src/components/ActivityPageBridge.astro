---
const route = '/laos/tad-lo/activities/cooking-class-nyay';
---

<script define:vars={{ route }}>
  const linkNyayActivityCard = () => {
    const card = document.getElementById('cooking-class-nyay');
    if (!(card instanceof HTMLElement) || card.dataset.activityPageLinked === 'true') return;

    const trigger = card.querySelector('[data-partner-card-open]');
    if (!(trigger instanceof HTMLElement)) return;

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopImmediatePropagation();
      window.location.href = route;
    }, true);

    const actionLabel = card.querySelector('.partner-card__copy b');
    if (actionLabel instanceof HTMLElement) actionLabel.textContent = 'Read the activity note ↗';

    card.dataset.activityPageLinked = 'true';
  };

  linkNyayActivityCard();
  document.addEventListener('astro:page-load', linkNyayActivityCard);
</script>
