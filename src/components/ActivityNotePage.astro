---
import type { ActivityPageEntry } from '../data/laosActivityPageRegistry';
import '../styles/activity-note-page.css';

interface Props {
  entry: ActivityPageEntry;
}

const { entry } = Astro.props;
const tripPlace = JSON.stringify({
  id: entry.slug,
  name: entry.title,
  city: entry.cityName,
  group: 'things-to-do',
  category: 'Activity',
  address: `${entry.cityName} · ${entry.countryName}`,
  url: entry.route
});
---

<main class="activity-sheet">
  <nav class="activity-sheet__return" aria-label={`${entry.title} navigation`}>
    <a href={entry.sourceRoute}>← Back to {entry.cityName}</a>
    <span>ACTIVITY NOTE · 01</span>
  </nav>

  <article class="activity-sheet__paper" aria-labelledby="activity-sheet-title">
    <nav class="activity-sheet__breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Atlas</a><span>/</span><a href="/laos">Laos</a><span>/</span><a href={entry.sourceRoute}>{entry.cityName}</a><span>/</span><span aria-current="page">Activity</span>
    </nav>

    <header class="activity-sheet__cover">
      <figure class="activity-sheet__photo">
        <img src={entry.image} alt={entry.imageAlt} width="1000" height="760" fetchpriority="high" />
        <figcaption>prepare it · understand it · share it</figcaption>
      </figure>

      <div class="activity-sheet__card">
        <p class="activity-sheet__eyebrow">{entry.eyebrow}</p>
        <h1 id="activity-sheet-title">{entry.title}</h1>
        <p class="activity-sheet__intro">{entry.intro}</p>

        <dl class="activity-sheet__facts">
          {entry.facts.map((fact) => (
            <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
          ))}
        </dl>

        <div class="activity-sheet__partner">
          <span>LOCAL PARTNER</span>
          <strong>{entry.sourceLabel}</strong>
          <small>Details marked “confirm” stay unguessed.</small>
        </div>
      </div>
    </header>

    <section class="activity-sheet__flow" aria-labelledby="activity-flow-title">
      <div class="activity-sheet__flow-heading">
        <p>THE CLASS, AT A GLANCE</p>
        <h2 id="activity-flow-title">Half a day. Three simple moments.</h2>
      </div>
      <ol>
        <li><b>01</b><strong>Choose</strong><span>Morning for lunch, or afternoon for dinner.</span></li>
        <li><b>02</b><strong>Cook</strong><span>Prepare the local meal together with Nyay.</span></li>
        <li><b>03</b><strong>Share</strong><span>Sit down and eat what you have prepared.</span></li>
      </ol>
      <p class="activity-sheet__flow-note">{entry.sessionParagraphs[1]}</p>
    </section>

    {entry.adSlots >= 1 && (
      <div class="activity-sheet__ad" data-ad-slot={`activity-${entry.slug}-1`} aria-label="Advertisement placeholder">
        <span>ADVERTISEMENT</span>
      </div>
    )}

    <section class="activity-sheet__practical" aria-labelledby="activity-practical-title">
      <div class="activity-sheet__practical-copy">
        <p class="activity-sheet__mini-label">BEFORE YOU BOOK</p>
        <h2 id="activity-practical-title">Confirm the few details that can change.</h2>
        <p>{entry.bookingParagraphs[0]}</p>
        <p>{entry.bookingParagraphs[1]}</p>
        <aside class="activity-sheet__scribble"><span>field note</span>{entry.note}</aside>
      </div>

      <dl class="activity-sheet__checklist">
        {entry.bookingFacts.map((fact) => (
          <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
        ))}
      </dl>
    </section>

    {entry.adSlots >= 2 && (
      <div class="activity-sheet__ad" data-ad-slot={`activity-${entry.slug}-2`} aria-label="Advertisement placeholder"><span>ADVERTISEMENT</span></div>
    )}

    <section class="activity-sheet__faq" aria-labelledby="activity-faq-title">
      <div class="activity-sheet__faq-heading">
        <p class="activity-sheet__mini-label">QUICK ANSWERS</p>
        <h2 id="activity-faq-title">What you may still want to know.</h2>
      </div>
      <div class="activity-sheet__faq-list">
        {entry.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {entry.adSlots >= 3 && (
      <div class="activity-sheet__ad" data-ad-slot={`activity-${entry.slug}-3`} aria-label="Advertisement placeholder"><span>ADVERTISEMENT</span></div>
    )}

    <footer class="activity-sheet__footer">
      <div class="activity-sheet__source">
        <span>SOURCE</span>
        <strong>{entry.sourceLabel}</strong>
        <a href={entry.sourceUrl} target="_blank" rel="noreferrer">Open the local activity page ↗</a>
      </div>

      <div class="activity-sheet__actions">
        <button type="button" data-trip-add data-trip-id={entry.slug} data-trip-place={tripPlace} aria-pressed="false">Add to My Trip</button>
        <a href={entry.sourceRoute}>More things to do in {entry.cityName}</a>
      </div>
    </footer>
  </article>
</main>
