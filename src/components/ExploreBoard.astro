---
import type { CityLandmark } from '../data/laosLandmarks';

interface Props {
  cityName: string;
  landmarks: CityLandmark[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  note?: string;
}

const {
  cityName,
  landmarks,
  eyebrow = `What can I actually do in ${cityName}?`,
  title = `Explore from ${cityName}`,
  intro = `Choose a landmark to open the complete field note, practical details and route information from ${cityName}.`,
  note = 'Tap a landmark to open the full field note.'
} = Astro.props;

const sectionId = `explore-board-${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const thumbnailSrc = (src?: string) => src ? src.replace(/([?&])width=\d+/i, '$1width=720') : '';
---

<section class="explore-board-section" aria-labelledby={sectionId}>
  <div class="explore-board-frame">
    <div class="explore-board">
      <div class="explore-board__decorations" aria-hidden="true">
        <span class="explore-board__airmail-mark">
          <img src="/images/timbre-laos/airmail-laos-par-avion.webp" alt="" width="360" height="168" loading="lazy" decoding="async" />
        </span>

        <span class="explore-board__route-doodle">
          <svg viewBox="0 0 180 72">
            <path d="M6 55C35 18 60 62 91 31s52-17 78-20" />
            <path d="m158 5 12 6-9 10" />
            <circle cx="7" cy="55" r="4" />
            <circle cx="91" cy="31" r="3" />
          </svg>
          <em>follow the road</em>
        </span>

        <span class="explore-board__field-stamp">
          <small>FIELD ROUTE</small>
          <strong>03</strong>
          <b>{cityName}</b>
        </span>
      </div>

      <header class="explore-board__header">
        <p class="explore-board__question">{eyebrow}</p>
        <h2 id={sectionId}>{title}</h2>
        <span class="explore-board__chalk-line" aria-hidden="true"></span>
        <p class="explore-board__intro">{intro}</p>
      </header>

      <div class="explore-board__content" aria-label={`Landmarks and journeys to explore from ${cityName}`}>
        {landmarks.map((landmark, index) => (
          <button
            class:list={['explore-board-card', `explore-board-card--${index % 3}`]}
            type="button"
            data-open-landmark={landmark.modalId}
            aria-label={`Open the complete ${landmark.name} field note`}
          >
            <span class="explore-board-card__photo">
              <span class="explore-board-card__tape" aria-hidden="true"></span>
              <img
                src={thumbnailSrc(landmark.gallery[0]?.src)}
                alt={landmark.gallery[0]?.alt || landmark.name}
                width="480"
                height="270"
                loading="lazy"
                decoding="async"
              />
              <span class="explore-board-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </span>

            <span class="explore-board-card__copy">
              <small>{landmark.cityContext.kicker}</small>
              <strong>{landmark.name}</strong>
              <span class="explore-board-card__summary">{landmark.cityContext.summary}</span>
              <span class="explore-board-card__meta">
                <span>{landmark.cityContext.duration}</span>
                <i aria-hidden="true"></i>
                <span>{landmark.cityContext.route}</span>
              </span>
              <span class="explore-board-card__action">open the field note <b aria-hidden="true">↗</b></span>
            </span>
          </button>
        ))}
      </div>

      <footer class="explore-board__footer">
        <span aria-hidden="true">↳</span>
        <p>{note}</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .explore-board-section {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.7rem) 0 clamp(2.8rem, 5vw, 4.7rem);
  }

  .explore-board-frame {
    position: relative;
    padding: clamp(.5rem, .9vw, .7rem);
    border: 1px solid rgba(57, 38, 22, .82);
    background:
      linear-gradient(90deg, rgba(255,255,255,.08), transparent 12%, transparent 88%, rgba(0,0,0,.14)),
      repeating-linear-gradient(1deg, #765436 0 5px, #68472e 5px 10px, #7b593a 10px 15px);
    box-shadow: 0 14px 30px rgba(28, 31, 27, .15), inset 0 0 0 1px rgba(255,255,255,.1);
    transform: rotate(-.04deg);
  }

  .explore-board-frame::before,
  .explore-board-frame::after {
    content: '';
    position: absolute;
    z-index: 4;
    width: clamp(3.1rem, 6vw, 4.8rem);
    height: .82rem;
    background: rgba(216, 200, 164, .56);
    box-shadow: 0 1px 2px rgba(39, 31, 22, .12);
    pointer-events: none;
  }

  .explore-board-frame::before {
    top: -.28rem;
    left: 7%;
    transform: rotate(-4deg);
  }

  .explore-board-frame::after {
    right: 7%;
    bottom: -.28rem;
    transform: rotate(3deg);
  }

  .explore-board {
    position: relative;
    overflow: hidden;
    padding: clamp(1.8rem, 3vw, 2.7rem) clamp(1.5rem, 3vw, 2.7rem) clamp(1.5rem, 2.6vw, 2.15rem);
    border: 1px solid rgba(238, 234, 216, .1);
    background:
      radial-gradient(ellipse at 18% 19%, rgba(255,255,255,.025), transparent 34%),
      radial-gradient(ellipse at 83% 76%, rgba(255,255,255,.018), transparent 31%),
      repeating-linear-gradient(176deg, rgba(255,255,255,.009) 0 1px, transparent 1px 5px),
      #050505;
    box-shadow: inset 0 0 42px rgba(0,0,0,.74), inset 0 0 0 2px rgba(255,255,255,.014);
    color: #efecdd;
  }

  .explore-board::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .22;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.11) 0 .55px, transparent .8px),
      radial-gradient(circle, rgba(255,255,255,.06) 0 .45px, transparent .7px);
    background-position: 0 0, 4px 3px;
    background-size: 9px 9px, 13px 13px;
    mix-blend-mode: screen;
  }

  .explore-board__decorations {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .explore-board__airmail-mark {
    position: absolute;
    top: 1.3rem;
    left: 1.45rem;
    width: 7.2rem;
    opacity: .22;
    filter: grayscale(1) invert(1) contrast(1.25);
    mix-blend-mode: screen;
    transform: rotate(-8deg);
  }

  .explore-board__airmail-mark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .explore-board__route-doodle {
    position: absolute;
    top: 1.05rem;
    right: 1.35rem;
    width: 10.5rem;
    color: rgba(223, 193, 137, .4);
    transform: rotate(-4deg);
  }

  .explore-board__route-doodle svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 4 5;
  }

  .explore-board__route-doodle em {
    position: absolute;
    right: .15rem;
    bottom: -.2rem;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .62rem;
    font-style: normal;
    white-space: nowrap;
  }

  .explore-board__field-stamp {
    position: absolute;
    bottom: .85rem;
    left: 1.1rem;
    display: grid;
    width: 4.8rem;
    height: 4.8rem;
    place-items: center;
    align-content: center;
    gap: .08rem;
    border: 1px solid rgba(183, 102, 69, .34);
    border-radius: 50%;
    color: rgba(223, 193, 137, .42);
    font-family: 'DM Sans', sans-serif;
    line-height: 1;
    text-align: center;
    transform: rotate(9deg);
  }

  .explore-board__field-stamp::before {
    content: '';
    position: absolute;
    inset: .28rem;
    border: 1px dashed currentColor;
    border-radius: 50%;
  }

  .explore-board__field-stamp small,
  .explore-board__field-stamp strong,
  .explore-board__field-stamp b {
    position: relative;
    z-index: 1;
  }

  .explore-board__field-stamp small {
    font-size: .4rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .explore-board__field-stamp strong {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
  }

  .explore-board__field-stamp b {
    max-width: 3.4rem;
    overflow: hidden;
    font-size: .42rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .explore-board__header,
  .explore-board__content,
  .explore-board__footer {
    position: relative;
    z-index: 2;
  }

  .explore-board__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 54rem;
    margin: 0 auto clamp(2rem, 3.4vw, 2.8rem);
    text-align: center;
  }

  .explore-board__question {
    margin: 0 0 .4rem;
    color: rgba(241, 237, 220, .8);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.78rem, 1.35vw, 1.04rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-shadow: .35px .35px 0 rgba(255,255,255,.24);
    transform: rotate(-.35deg);
  }

  .explore-board__header h2 {
    margin: 0;
    color: #f3efde;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1;
    text-shadow:
      .55px .55px 0 rgba(255,255,255,.32),
      -.35px .15px 0 rgba(255,255,255,.16),
      0 0 2px rgba(255,255,255,.15);
    transform: rotate(-.35deg);
  }

  .explore-board__chalk-line {
    display: block;
    width: min(18rem, 55%);
    height: .42rem;
    margin: .28rem 0 .65rem;
    border-top: 2px solid rgba(240, 235, 214, .64);
    border-radius: 50%;
    box-shadow: 0 2px 0 rgba(240,235,214,.07);
    transform: rotate(-1deg);
  }

  .explore-board__intro {
    max-width: 43rem;
    margin: 0;
    color: rgba(238, 234, 219, .68);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.7rem, 1.05vw, .84rem);
    line-height: 1.55;
  }

  .explore-board__content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.6rem, 3.2vw, 2.65rem);
    align-items: start;
  }

  .explore-board-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: .25rem;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .explore-board-card--0 { transform: rotate(-.2deg); }
  .explore-board-card--1 { transform: rotate(.18deg); }
  .explore-board-card--2 { transform: rotate(-.1deg); }

  .explore-board-card:hover,
  .explore-board-card:focus-visible {
    z-index: 3;
    border-color: rgba(239, 234, 214, .14);
    background: rgba(255,255,255,.02);
    outline: none;
    transform: translateY(-3px) rotate(0deg);
  }

  .explore-board-card__photo {
    position: relative;
    display: block;
    width: 100%;
    padding: .34rem;
    background: #f1ede0;
    box-shadow: 0 6px 13px rgba(0,0,0,.38);
    transform: rotate(-.75deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .explore-board-card--1 .explore-board-card__photo { transform: rotate(.6deg); }
  .explore-board-card--2 .explore-board-card__photo { transform: rotate(-.35deg); }

  .explore-board-card:hover .explore-board-card__photo,
  .explore-board-card:focus-visible .explore-board-card__photo {
    box-shadow: 0 9px 18px rgba(0,0,0,.46);
    transform: rotate(0deg) scale(1.01);
  }

  .explore-board-card__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(.68) contrast(.97) sepia(.06);
  }

  .explore-board-card__tape {
    position: absolute;
    z-index: 2;
    top: -.3rem;
    left: 50%;
    width: 2.9rem;
    height: .58rem;
    background: rgba(210, 195, 157, .62);
    transform: translateX(-50%) rotate(2deg);
  }

  .explore-board-card__number {
    position: absolute;
    right: .58rem;
    bottom: .48rem;
    padding: .08rem .28rem;
    background: rgba(5,5,5,.72);
    color: rgba(244,240,224,.82);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .56rem;
    font-weight: 700;
    transform: rotate(-3deg);
  }

  .explore-board-card__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem .35rem .15rem;
  }

  .explore-board-card__copy small {
    margin-bottom: .3rem;
    color: rgba(223, 216, 188, .54);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.46rem, .7vw, .54rem);
    font-weight: 600;
    letter-spacing: .04em;
    line-height: 1.3;
  }

  .explore-board-card__copy strong {
    color: #f1eddb;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.25rem, 2.1vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.07;
    text-shadow: .45px .45px 0 rgba(255,255,255,.22);
  }

  .explore-board-card__summary {
    margin-top: .52rem;
    color: rgba(236, 232, 216, .67);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.65rem, .92vw, .75rem);
    line-height: 1.48;
  }

  .explore-board-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .38rem;
    margin-top: .62rem;
    color: #d5b681;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.54rem, .76vw, .62rem);
    font-weight: 600;
  }

  .explore-board-card__meta i {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  .explore-board-card__action {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    align-self: flex-start;
    margin-top: .58rem;
    border-bottom: 1px dashed rgba(238, 233, 214, .35);
    color: rgba(242, 238, 222, .86);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.57rem, .8vw, .66rem);
    line-height: 1.35;
  }

  .explore-board-card__action b {
    font-size: .78rem;
    transition: transform 180ms ease;
  }

  .explore-board-card:hover .explore-board-card__action b,
  .explore-board-card:focus-visible .explore-board-card__action b {
    transform: translate(2px, -2px);
  }

  .explore-board__footer {
    display: flex;
    justify-content: center;
    gap: .42rem;
    margin-top: clamp(1.6rem, 2.7vw, 2.15rem);
    color: rgba(231, 225, 202, .56);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    transform: rotate(-.25deg);
  }

  .explore-board__footer p {
    margin: 0;
    font-size: clamp(.6rem, .88vw, .72rem);
    line-height: 1.35;
  }

  @media (max-width: 1100px) {
    .explore-board__airmail-mark {
      top: .8rem;
      left: .75rem;
      width: 5.2rem;
      opacity: .15;
    }

    .explore-board__route-doodle {
      top: .65rem;
      right: .6rem;
      width: 7.2rem;
      opacity: .72;
    }

    .explore-board__route-doodle em { display: none; }

    .explore-board__field-stamp {
      bottom: .55rem;
      left: .7rem;
      width: 4rem;
      height: 4rem;
      opacity: .72;
    }
  }

  @media (max-width: 820px) {
    .explore-board__decorations { display: none; }

    .explore-board__content {
      grid-template-columns: 1fr;
      gap: 1.65rem;
    }

    .explore-board-card {
      width: min(100%, 36rem);
      margin: 0 auto;
    }

    .explore-board-card__copy {
      padding-top: .85rem;
    }
  }

  @media (max-width: 620px) {
    .explore-board-section {
      width: min(100% - 1.25rem, 1180px);
      padding-top: 1.6rem;
    }

    .explore-board-frame { padding: .42rem; }

    .explore-board {
      padding: 1.45rem .9rem 1.25rem;
    }

    .explore-board__header {
      margin-bottom: 1.6rem;
    }

    .explore-board__question {
      font-size: clamp(.7rem, 3.6vw, .88rem);
    }

    .explore-board__header h2 {
      font-size: clamp(1.85rem, 10vw, 2.7rem);
    }

    .explore-board__intro {
      font-size: .68rem;
    }

    .explore-board-card__summary {
      font-size: .68rem;
    }
  }

  @media (max-width: 370px) {
    .explore-board__question {
      font-size: .66rem;
    }

    .explore-board-card__meta {
      display: none;
    }
  }
</style>