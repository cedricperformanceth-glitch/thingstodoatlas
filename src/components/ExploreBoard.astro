---
interface ExploreBoardImage {
  src: string;
  alt?: string;
}

interface ExploreBoardContext {
  kicker: string;
  summary: string;
  duration: string;
  route: string;
}

interface ExploreBoardLandmark {
  modalId: string;
  name: string;
  gallery: ExploreBoardImage[];
  cityContext: ExploreBoardContext;
}

interface Props {
  cityName: string;
  landmarks: ExploreBoardLandmark[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  note?: string;
  wide?: boolean;
  decorationVariant?: 'none' | 'pakse';
}

const {
  cityName,
  landmarks,
  eyebrow = `What can I actually do in ${cityName}?`,
  title = `Explore from ${cityName}`,
  intro = `Choose a landmark to open the complete field note, practical details and route information from ${cityName}.`,
  note = 'Tap a landmark to open the full field note.',
  wide = false,
  decorationVariant = 'none'
} = Astro.props;

const sectionId = `explore-board-${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const thumbnailSrc = (src?: string) => src ? src.replace(/([?&])width=\d+/i, '$1width=720') : '';
const showPakseDecorations = decorationVariant === 'pakse';
---

<section
  class:list={['explore-board-section', { 'explore-board-section--wide': wide }]}
  aria-labelledby={sectionId}
>
  <div class="explore-board-frame">
    <div class="explore-board">
      {showPakseDecorations && (
        <div class="explore-board__decorations" aria-hidden="true">
          <svg class="explore-board-decoration explore-board-decoration--compass" viewBox="0 0 120 120">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M61 19c22 0 40 17 40 40 0 23-17 42-40 43-23 1-42-17-42-41 0-23 18-42 42-42Z" stroke-width="1.8" opacity=".72" />
              <path d="M59 23c20 1 36 16 37 35M23 64c2 18 15 31 32 34" stroke-width="1.05" opacity=".42" />
              <path d="M60 31c1 11 1 19 0 28m0 4c-1 10-1 18 0 27M31 60c11-1 19-1 28 0m4 0c10 1 18 1 27 0" stroke-width="1.3" opacity=".64" />
              <path d="m60 39 8 20-9 24-7-22Z" stroke-width="1.55" />
              <path d="M60 40 65 60l-6 20-3-20Z" fill="currentColor" opacity=".18" />
              <path d="M43 30c-4 2-8 6-11 10m46-10c5 3 9 7 11 11M40 90c4 4 8 7 13 9m30-10c4-3 8-7 10-12" stroke-width="1" opacity=".5" />
            </g>
            <g fill="currentColor" font-family="'Segoe Print', 'Bradley Hand', cursive" font-size="11" text-anchor="middle">
              <text x="60" y="15">N</text>
              <text x="106" y="64">E</text>
              <text x="14" y="64">W</text>
              <text class="explore-board-decoration__accent" x="60" y="116">S</text>
            </g>
          </svg>

          <svg class="explore-board-decoration explore-board-decoration--route" viewBox="0 0 900 100" preserveAspectRatio="none">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 67C145 13 258 88 389 48c137-42 251-25 358 7 46 14 88 7 139-24" stroke-width="2" stroke-dasharray="5 12" />
              <circle cx="14" cy="67" r="4.5" stroke-width="1.7" />
              <path d="m207 36 14 14m0-14-14 14M474 39l14 14m0-14-14 14M715 50l14 14m0-14-14 14" stroke-width="2.1" />
              <path d="m876 25 11 6-10 8" stroke-width="2" />
            </g>
          </svg>

          <svg class="explore-board-decoration explore-board-decoration--boat" viewBox="0 0 180 92">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 58c35 5 76 5 122-2-8 13-31 20-71 20-25 0-42-6-51-18Z" stroke-width="1.9" />
              <path d="M45 58 63 38h47l20 19M67 38l4-13m36 13-5-13M69 25h35" stroke-width="1.45" />
              <path d="M55 51c13 2 38 2 61-1M31 65c22 8 77 10 104-1" stroke-width="1" opacity=".55" />
              <path d="M8 83c17-5 30-5 48 0 17 5 35 5 53 0 17-5 32-5 50 0" stroke-width="1.25" opacity=".62" />
              <path d="M126 24c17-7 31-7 45 0" stroke-width="1.25" stroke-dasharray="3 5" />
              <path d="m163 18 9 6-9 5" stroke-width="1.35" />
            </g>
            <text x="128" y="15" fill="currentColor" font-family="'Segoe Print', 'Bradley Hand', cursive" font-size="10" transform="rotate(-3 128 15)">south</text>
          </svg>
        </div>
      )}

      <header class="explore-board__header">
        <p class="explore-board__question">{eyebrow}</p>
        <h2 id={sectionId}>{title}</h2>
        <span class="explore-board__chalk-line" aria-hidden="true"></span>
        <p class="explore-board__intro">{intro}</p>
      </header>

      <div class="explore-board__content" aria-label={`Landmarks and journeys to explore from ${cityName}`}>
        {landmarks.map((landmark, index) => (
          <button
            class:list={['explore-board-card', `explore-board-card--${index % 3}`]}
            type="button"
            data-open-landmark={landmark.modalId}
            aria-label={`Open the complete ${landmark.name} field note`}
          >
            <span class="explore-board-card__photo">
              <span class="explore-board-card__tape" aria-hidden="true"></span>
              <img
                src={thumbnailSrc(landmark.gallery[0]?.src)}
                alt={landmark.gallery[0]?.alt || landmark.name}
                width="480"
                height="270"
                loading="lazy"
                decoding="async"
              />
              <span class="explore-board-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </span>

            <span class="explore-board-card__copy">
              <small>{landmark.cityContext.kicker}</small>
              <strong>{landmark.name}</strong>
              <span class="explore-board-card__summary">{landmark.cityContext.summary}</span>
              <span class="explore-board-card__meta">
                <span>{landmark.cityContext.duration}</span>
                <i aria-hidden="true"></i>
                <span>{landmark.cityContext.route}</span>
              </span>
              <span class="explore-board-card__action">open the field note <b aria-hidden="true">↗</b></span>
            </span>
          </button>
        ))}
      </div>

      <footer class="explore-board__footer">
        <span aria-hidden="true">↳</span>
        <p>{note}</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .explore-board-section {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.7rem) 0 clamp(2.8rem, 5vw, 4.7rem);
  }

  .explore-board-section--wide {
    width: min(1320px, calc(100% - .5rem));
  }

  .explore-board-frame {
    position: relative;
    padding: clamp(.5rem, .9vw, .7rem);
    border: 1px solid rgba(57, 38, 22, .82);
    background:
      linear-gradient(90deg, rgba(255,255,255,.08), transparent 12%, transparent 88%, rgba(0,0,0,.14)),
      repeating-linear-gradient(1deg, #765436 0 5px, #68472e 5px 10px, #7b593a 10px 15px);
    box-shadow: 0 14px 30px rgba(28, 31, 27, .15), inset 0 0 0 1px rgba(255,255,255,.1);
    transform: rotate(-.04deg);
  }

  .explore-board-frame::before,
  .explore-board-frame::after {
    content: '';
    position: absolute;
    z-index: 4;
    width: clamp(3.1rem, 6vw, 4.8rem);
    height: .82rem;
    background: rgba(216, 200, 164, .56);
    box-shadow: 0 1px 2px rgba(39, 31, 22, .12);
    pointer-events: none;
  }

  .explore-board-frame::before {
    top: -.28rem;
    left: 7%;
    transform: rotate(-4deg);
  }

  .explore-board-frame::after {
    right: 7%;
    bottom: -.28rem;
    transform: rotate(3deg);
  }

  .explore-board {
    position: relative;
    overflow: hidden;
    padding: clamp(1.8rem, 3vw, 2.7rem) clamp(1.5rem, 3vw, 2.7rem) clamp(1.5rem, 2.6vw, 2.15rem);
    border: 1px solid rgba(238, 234, 216, .1);
    background:
      radial-gradient(ellipse at 18% 19%, rgba(255,255,255,.025), transparent 34%),
      radial-gradient(ellipse at 83% 76%, rgba(255,255,255,.018), transparent 31%),
      repeating-linear-gradient(176deg, rgba(255,255,255,.009) 0 1px, transparent 1px 5px),
      #050505;
    box-shadow: inset 0 0 42px rgba(0,0,0,.74), inset 0 0 0 2px rgba(255,255,255,.014);
    color: #efecdd;
  }

  .explore-board::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .22;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.11) 0 .55px, transparent .8px),
      radial-gradient(circle, rgba(255,255,255,.06) 0 .45px, transparent .7px);
    background-position: 0 0, 4px 3px;
    background-size: 9px 9px, 13px 13px;
    mix-blend-mode: screen;
  }

  .explore-board__decorations {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .explore-board-decoration {
    position: absolute;
    display: block;
    overflow: visible;
    color: rgba(238, 232, 210, .72);
    filter: drop-shadow(.5px .5px 0 rgba(255,255,255,.08));
  }

  .explore-board-decoration--compass {
    top: clamp(1.25rem, 2.3vw, 2rem);
    right: clamp(7.5rem, 13vw, 11rem);
    width: clamp(4.6rem, 7.1vw, 6.4rem);
    opacity: .62;
    transform: rotate(5deg);
  }

  .explore-board-decoration__accent {
    fill: #d5b681;
  }

  .explore-board-decoration--route {
    left: 10%;
    bottom: clamp(4.9rem, 7vw, 6.1rem);
    width: 72%;
    height: clamp(3.4rem, 5vw, 4.7rem);
    opacity: .27;
    transform: rotate(-.7deg);
  }

  .explore-board-decoration--boat {
    right: clamp(5.6rem, 8vw, 7.2rem);
    bottom: clamp(3.2rem, 5vw, 4.15rem);
    width: clamp(5.4rem, 8vw, 7.2rem);
    opacity: .68;
    transform: rotate(-2deg);
  }

  .explore-board__header,
  .explore-board__content,
  .explore-board__footer {
    position: relative;
    z-index: 2;
  }

  .explore-board__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 54rem;
    margin: 0 auto clamp(2rem, 3.4vw, 2.8rem);
    text-align: center;
  }

  .explore-board__question {
    margin: 0 0 .4rem;
    color: rgba(241, 237, 220, .8);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.78rem, 1.35vw, 1.04rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-shadow: .35px .35px 0 rgba(255,255,255,.24);
    transform: rotate(-.35deg);
  }

  .explore-board__header h2 {
    margin: 0;
    color: #f3efde;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1;
    text-shadow:
      .55px .55px 0 rgba(255,255,255,.32),
      -.35px .15px 0 rgba(255,255,255,.16),
      0 0 2px rgba(255,255,255,.15);
    transform: rotate(-.35deg);
  }

  .explore-board__chalk-line {
    display: block;
    width: min(18rem, 55%);
    height: .42rem;
    margin: .28rem 0 .65rem;
    border-top: 2px solid rgba(240, 235, 214, .64);
    border-radius: 50%;
    box-shadow: 0 2px 0 rgba(240,235,214,.07);
    transform: rotate(-1deg);
  }

  .explore-board__intro {
    max-width: 43rem;
    margin: 0;
    color: rgba(238, 234, 219, .75);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.75rem, 1.08vw, .9rem);
    line-height: 1.55;
  }

  .explore-board__content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.6rem, 3.2vw, 2.65rem);
    align-items: start;
  }

  .explore-board-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: .25rem;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .explore-board-card--0 { transform: rotate(-.2deg); }
  .explore-board-card--1 { transform: rotate(.18deg); }
  .explore-board-card--2 { transform: rotate(-.1deg); }

  .explore-board-card:hover,
  .explore-board-card:focus-visible {
    z-index: 3;
    border-color: rgba(239, 234, 214, .14);
    background: rgba(255,255,255,.02);
    outline: none;
    transform: translateY(-3px) rotate(0deg);
  }

  .explore-board-card__photo {
    position: relative;
    display: block;
    width: 100%;
    padding: .34rem;
    background: #f1ede0;
    box-shadow: 0 6px 13px rgba(0,0,0,.38);
    transform: rotate(-.75deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .explore-board-card--1 .explore-board-card__photo { transform: rotate(.6deg); }
  .explore-board-card--2 .explore-board-card__photo { transform: rotate(-.35deg); }

  .explore-board-card:hover .explore-board-card__photo,
  .explore-board-card:focus-visible .explore-board-card__photo {
    box-shadow: 0 9px 18px rgba(0,0,0,.46);
    transform: rotate(0deg) scale(1.01);
  }

  .explore-board-card__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(.68) contrast(.97) sepia(.06);
  }

  .explore-board-card__tape {
    position: absolute;
    z-index: 2;
    top: -.3rem;
    left: 50%;
    width: 2.9rem;
    height: .58rem;
    background: rgba(210, 195, 157, .62);
    transform: translateX(-50%) rotate(2deg);
  }

  .explore-board-card__number {
    position: absolute;
    right: .58rem;
    bottom: .48rem;
    padding: .08rem .28rem;
    background: rgba(5,5,5,.72);
    color: rgba(244,240,224,.82);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .56rem;
    font-weight: 700;
    transform: rotate(-3deg);
  }

  .explore-board-card__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.05rem .4rem .2rem;
  }

  .explore-board-card__copy small {
    margin-bottom: .36rem;
    color: rgba(223, 216, 188, .64);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.52rem, .78vw, .6rem);
    font-weight: 600;
    letter-spacing: .04em;
    line-height: 1.3;
  }

  .explore-board-card__copy strong {
    color: #f1eddb;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.35rem, 2.25vw, 1.82rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.05;
    text-shadow: .45px .45px 0 rgba(255,255,255,.22);
  }

  .explore-board-card__summary {
    margin-top: .58rem;
    color: rgba(236, 232, 216, .77);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.7rem, 1vw, .82rem);
    line-height: 1.52;
  }

  .explore-board-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .42rem;
    margin-top: .72rem;
    color: #dfc18c;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.59rem, .82vw, .68rem);
    font-weight: 600;
  }

  .explore-board-card__meta i {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  .explore-board-card__action {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    align-self: flex-start;
    margin-top: .68rem;
    border-bottom: 1px dashed rgba(238, 233, 214, .48);
    color: rgba(242, 238, 222, .92);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.62rem, .86vw, .72rem);
    line-height: 1.35;
  }

  .explore-board-card__action b {
    font-size: .84rem;
    transition: transform 180ms ease;
  }

  .explore-board-card:hover .explore-board-card__action b,
  .explore-board-card:focus-visible .explore-board-card__action b {
    transform: translate(2px, -2px);
  }

  .explore-board__footer {
    display: flex;
    justify-content: center;
    gap: .42rem;
    margin-top: clamp(1.6rem, 2.7vw, 2.15rem);
    color: rgba(231, 225, 202, .64);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    transform: rotate(-.25deg);
  }

  .explore-board__footer p {
    margin: 0;
    font-size: clamp(.65rem, .94vw, .78rem);
    line-height: 1.35;
  }

  @media (min-width: 821px) {
    .explore-board-card__summary {
      min-height: 3.75em;
    }
  }

  @media (max-width: 820px) {
    .explore-board__content {
      grid-template-columns: 1fr;
      gap: 1.65rem;
    }

    .explore-board-card {
      width: min(100%, 36rem);
      margin: 0 auto;
    }

    .explore-board-card__copy {
      padding-top: .85rem;
    }
  }

  @media (max-width: 620px) {
    .explore-board-section {
      width: min(100% - 1.25rem, 1180px);
      padding-top: 1.6rem;
    }

    .explore-board-section--wide {
      width: min(100% - .5rem, 1320px);
    }

    .explore-board-frame { padding: .42rem; }

    .explore-board {
      padding: 1.45rem .9rem 1.25rem;
    }

    .explore-board__decorations {
      display: none;
    }

    .explore-board__header {
      margin-bottom: 1.6rem;
    }

    .explore-board__question {
      font-size: clamp(.7rem, 3.6vw, .88rem);
    }

    .explore-board__header h2 {
      font-size: clamp(1.85rem, 10vw, 2.7rem);
    }

    .explore-board__intro {
      font-size: .75rem;
    }
  }

  @media (max-width: 370px) {
    .explore-board__question {
      font-size: .66rem;
    }

    .explore-board-card__meta {
      display: none;
    }
  }
</style>

<style is:global>
  @media (min-width: 701px) {
    body:has(.explore-board-section) .plan-trip-fab {
      min-width: 210px;
      height: 60px;
      grid-template-columns: 46px 1fr auto;
      opacity: .92;
      box-shadow: 3px 4px 0 rgba(49, 85, 69, .08), 0 8px 20px rgba(32, 60, 49, .09);
      transform: rotate(-.35deg) scale(.96);
      transform-origin: bottom right;
    }

    body:has(.explore-board-section) .plan-trip-fab:hover {
      opacity: 1;
      box-shadow: 4px 5px 0 rgba(49, 85, 69, .1), 0 11px 24px rgba(32, 60, 49, .11);
      transform: translateY(-2px) rotate(0) scale(.98);
    }

    body:has(.explore-board-section) .plan-trip-fab__icon {
      width: 46px;
      height: 46px;
    }

    body:has(.explore-board-section) .plan-trip-fab__copy strong {
      max-width: 108px;
      font-size: .72rem;
    }

    body:has(.explore-board-section) .plan-trip-fab__count {
      min-width: 30px;
      height: 30px;
    }
  }
</style>
