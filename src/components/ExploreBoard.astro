---
import type { CityLandmark } from '../data/laosLandmarks';

interface Props {
  cityName: string;
  landmarks: CityLandmark[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  note?: string;
}

const {
  cityName,
  landmarks,
  eyebrow = 'What can I actually do here?',
  title = `Explore ${cityName}`,
  intro = `Choose a landmark to open the complete field note, practical details and route information from ${cityName}.`,
  note = 'Tap a landmark to open the full field note.'
} = Astro.props;

const sectionId = `explore-board-${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const thumbnailSrc = (src?: string) => src ? src.replace(/([?&])width=\d+/i, '$1width=520') : '';
---

<section class="explore-board-section" aria-labelledby={sectionId}>
  <div class="explore-board-frame">
    <div class="explore-board">
      <header class="explore-board__header">
        <div class="explore-board__heading">
          <p>{eyebrow}</p>
          <h2 id={sectionId}>{title}</h2>
          <span class="explore-board__chalk-line" aria-hidden="true"></span>
        </div>
        <p class="explore-board__intro">{intro}</p>
      </header>

      <div class="explore-board__content" aria-label={`Landmarks and journeys to explore from ${cityName}`}>
        {landmarks.map((landmark, index) => (
          <button
            class:list={['explore-board-card', `explore-board-card--${index % 3}`]}
            type="button"
            data-open-landmark={landmark.modalId}
            aria-label={`Open the complete ${landmark.name} field note`}
          >
            <span class="explore-board-card__photo">
              <span class="explore-board-card__tape" aria-hidden="true"></span>
              <img
                src={thumbnailSrc(landmark.gallery[0]?.src)}
                alt={landmark.gallery[0]?.alt || landmark.name}
                width="260"
                height="190"
                loading="lazy"
                decoding="async"
              />
              <span class="explore-board-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </span>

            <span class="explore-board-card__copy">
              <small>{landmark.cityContext.kicker}</small>
              <strong>{landmark.name}</strong>
              <span class="explore-board-card__summary">{landmark.cityContext.summary}</span>
              <span class="explore-board-card__meta">
                <span>{landmark.cityContext.duration}</span>
                <i aria-hidden="true"></i>
                <span>{landmark.cityContext.route}</span>
              </span>
              <span class="explore-board-card__action">open the field note <b aria-hidden="true">↗</b></span>
            </span>
          </button>
        ))}
      </div>

      <footer class="explore-board__footer">
        <p><span aria-hidden="true">↳</span>{note}</p>
        <span aria-hidden="true">choose a road · follow the chalk →</span>
      </footer>
    </div>
  </div>
</section>

<style>
  .explore-board-section {
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.7rem) 0 clamp(2.8rem, 5vw, 4.7rem);
  }

  .explore-board-frame {
    position: relative;
    padding: clamp(.48rem, .9vw, .68rem);
    border: 1px solid rgba(57, 38, 22, .8);
    background:
      linear-gradient(90deg, rgba(255,255,255,.09), transparent 11%, transparent 89%, rgba(0,0,0,.13)),
      repeating-linear-gradient(1deg, #765436 0 5px, #68472e 5px 10px, #7b593a 10px 15px);
    box-shadow: 0 14px 30px rgba(28, 31, 27, .15), inset 0 0 0 1px rgba(255,255,255,.1);
    transform: rotate(-.05deg);
  }

  .explore-board-frame::before,
  .explore-board-frame::after {
    content: '';
    position: absolute;
    z-index: 4;
    width: clamp(3.1rem, 6vw, 4.8rem);
    height: .82rem;
    background: rgba(216, 200, 164, .56);
    box-shadow: 0 1px 2px rgba(39, 31, 22, .12);
    pointer-events: none;
  }

  .explore-board-frame::before { top: -.28rem; left: 7%; transform: rotate(-4deg); }
  .explore-board-frame::after { right: 7%; bottom: -.28rem; transform: rotate(3deg); }

  .explore-board {
    position: relative;
    overflow: hidden;
    padding: clamp(1.45rem, 2.8vw, 2.25rem);
    border: 1px solid rgba(238, 234, 216, .1);
    background:
      radial-gradient(ellipse at 16% 20%, rgba(255,255,255,.028), transparent 33%),
      radial-gradient(ellipse at 82% 72%, rgba(255,255,255,.018), transparent 30%),
      repeating-linear-gradient(176deg, rgba(255,255,255,.01) 0 1px, transparent 1px 5px),
      #111b17;
    box-shadow: inset 0 0 38px rgba(0,0,0,.48), inset 0 0 0 2px rgba(255,255,255,.018);
    color: #efecdd;
  }

  .explore-board::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .22;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.11) 0 .55px, transparent .8px),
      radial-gradient(circle, rgba(255,255,255,.06) 0 .45px, transparent .7px);
    background-position: 0 0, 4px 3px;
    background-size: 9px 9px, 13px 13px;
    mix-blend-mode: screen;
  }

  .explore-board__header,
  .explore-board__content,
  .explore-board__footer {
    position: relative;
    z-index: 2;
  }

  .explore-board__header {
    display: grid;
    grid-template-columns: minmax(17rem, .88fr) minmax(18rem, 1.12fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.35rem, 2.5vw, 2rem);
  }

  .explore-board__heading p {
    margin: 0 0 .15rem .2rem;
    color: rgba(238, 233, 214, .72);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.72rem, 1.15vw, .92rem);
    font-weight: 500;
    line-height: 1.2;
    transform: rotate(-1deg);
  }

  .explore-board__heading h2 {
    margin: 0;
    color: #f2efdf;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(2.35rem, 4.7vw, 4rem);
    font-weight: 500;
    letter-spacing: -.075em;
    line-height: .96;
    text-shadow:
      .6px .6px 0 rgba(255,255,255,.34),
      -.4px .2px 0 rgba(255,255,255,.18),
      0 0 2px rgba(255,255,255,.18);
    transform: rotate(-.5deg);
  }

  .explore-board__chalk-line {
    display: block;
    width: min(21rem, 86%);
    height: .42rem;
    margin: .18rem 0 0 .55rem;
    border-top: 2px solid rgba(240, 235, 214, .66);
    border-radius: 50%;
    box-shadow: 0 2px 0 rgba(240,235,214,.08);
    transform: rotate(-1.2deg);
  }

  .explore-board__intro {
    max-width: 35rem;
    margin: 0 0 .2rem;
    color: rgba(238, 234, 219, .76);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.76rem, 1.22vw, .92rem);
    line-height: 1.52;
    transform: rotate(.15deg);
  }

  .explore-board__content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.7rem);
  }

  .explore-board-card {
    position: relative;
    display: grid;
    grid-template-columns: clamp(5.8rem, 8vw, 7.15rem) minmax(0, 1fr);
    gap: clamp(.72rem, 1.4vw, 1.05rem);
    align-items: center;
    min-width: 0;
    padding: .55rem .45rem .7rem;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .explore-board-card--0 { transform: rotate(-.28deg); }
  .explore-board-card--1 { transform: rotate(.24deg); }
  .explore-board-card--2 { transform: rotate(-.14deg); }

  .explore-board-card:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: clamp(-1.25rem, -1.7vw, -.72rem);
    top: 48%;
    color: rgba(225, 218, 188, .38);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.25rem;
    transform: translateY(-50%) rotate(-5deg);
  }

  .explore-board-card:hover,
  .explore-board-card:focus-visible {
    z-index: 3;
    border-color: rgba(239, 234, 214, .15);
    background: rgba(255,255,255,.025);
    outline: none;
    transform: translateY(-2px) rotate(0deg);
  }

  .explore-board-card__photo {
    position: relative;
    display: block;
    padding: .28rem .28rem .9rem;
    background: #f2eee1;
    box-shadow: 0 5px 11px rgba(0,0,0,.31);
    transform: rotate(-1.3deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .explore-board-card--1 .explore-board-card__photo { transform: rotate(1deg); }
  .explore-board-card--2 .explore-board-card__photo { transform: rotate(-.55deg); }

  .explore-board-card:hover .explore-board-card__photo,
  .explore-board-card:focus-visible .explore-board-card__photo {
    box-shadow: 0 8px 15px rgba(0,0,0,.38);
    transform: rotate(0deg) scale(1.015);
  }

  .explore-board-card__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(.68) contrast(.96) sepia(.08);
  }

  .explore-board-card__tape {
    position: absolute;
    z-index: 2;
    top: -.3rem;
    left: 50%;
    width: 2.7rem;
    height: .58rem;
    background: rgba(210, 195, 157, .62);
    transform: translateX(-50%) rotate(2deg);
  }

  .explore-board-card__number {
    position: absolute;
    right: .38rem;
    bottom: .16rem;
    color: #48534b;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .57rem;
    font-weight: 700;
    transform: rotate(-4deg);
  }

  .explore-board-card__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .explore-board-card__copy small {
    margin-bottom: .18rem;
    overflow: hidden;
    color: rgba(223, 216, 188, .54);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.43rem, .72vw, .52rem);
    font-weight: 600;
    letter-spacing: .045em;
    line-height: 1.28;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .explore-board-card__copy strong {
    color: #f1eddb;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.08rem, 1.9vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.06;
    text-shadow: .45px .45px 0 rgba(255,255,255,.22);
  }

  .explore-board-card__summary {
    display: -webkit-box;
    margin-top: .32rem;
    overflow: hidden;
    color: rgba(236, 232, 216, .68);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.62rem, .92vw, .72rem);
    line-height: 1.38;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .explore-board-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .33rem;
    margin-top: .38rem;
    color: #d6b887;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.52rem, .78vw, .61rem);
    font-weight: 600;
  }

  .explore-board-card__meta i {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  .explore-board-card__action {
    display: inline-flex;
    align-items: center;
    gap: .22rem;
    align-self: flex-start;
    margin-top: .38rem;
    border-bottom: 1px dashed rgba(238, 233, 214, .35);
    color: rgba(242, 238, 222, .88);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.55rem, .82vw, .64rem);
    line-height: 1.35;
  }

  .explore-board-card__action b {
    font-size: .75rem;
    transition: transform 180ms ease;
  }

  .explore-board-card:hover .explore-board-card__action b,
  .explore-board-card:focus-visible .explore-board-card__action b {
    transform: translate(2px, -2px);
  }

  .explore-board__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1rem, 2vw, 1.45rem);
    color: rgba(231, 225, 202, .62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
  }

  .explore-board__footer p {
    display: flex;
    gap: .42rem;
    max-width: 38rem;
    margin: 0;
    font-size: clamp(.62rem, .95vw, .75rem);
    line-height: 1.35;
    transform: rotate(-.45deg);
  }

  .explore-board__footer > span {
    color: rgba(205, 219, 154, .65);
    font-size: clamp(.58rem, .9vw, .7rem);
    transform: rotate(1deg);
  }

  @media (max-width: 980px) {
    .explore-board__header {
      grid-template-columns: 1fr;
      gap: .7rem;
      align-items: start;
    }

    .explore-board__intro { max-width: 44rem; }

    .explore-board__content {
      grid-template-columns: 1fr;
      gap: .7rem;
    }

    .explore-board-card {
      grid-template-columns: 6.3rem minmax(0, 1fr);
      max-width: 46rem;
      padding: .5rem;
    }

    .explore-board-card:nth-child(even) { margin-left: auto; }
    .explore-board-card:not(:last-child)::after { display: none; }
    .explore-board-card__summary { -webkit-line-clamp: 2; }
  }

  @media (max-width: 620px) {
    .explore-board-section {
      width: min(100% - 1.25rem, 1180px);
      padding-top: 1.6rem;
    }

    .explore-board-frame { padding: .42rem; }
    .explore-board { padding: 1.15rem .85rem 1.25rem; }

    .explore-board__heading h2 {
      font-size: clamp(2.15rem, 13vw, 3.15rem);
    }

    .explore-board-card {
      grid-template-columns: 5.2rem minmax(0, 1fr);
      gap: .72rem;
      width: 100%;
      max-width: none;
      margin-left: 0 !important;
    }

    .explore-board-card__copy small { white-space: normal; }
    .explore-board-card__summary { display: none; }
    .explore-board__footer > span { display: none; }
  }

  @media (max-width: 390px) {
    .explore-board-card { grid-template-columns: 4.55rem minmax(0, 1fr); }
    .explore-board-card__meta { display: none; }
  }
</style>
