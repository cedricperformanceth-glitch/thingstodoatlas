---
import { laosLandmarkPages } from '../data/laosLandmarkPageRegistry';

const tadLoConfigs = laosLandmarkPages
  .filter((entry) => entry.citySlug === 'tad-lo')
  .map((entry) => ({
    slug: entry.slug,
    modalId: entry.landmark.modalId,
    route: entry.route,
    duration: entry.landmark.cityContext.duration,
    difficulty: entry.landmark.facts.find((fact) => fact.label === 'Difficulty')?.value || '',
    bestTime: entry.landmark.facts.find((fact) => fact.label === 'Best time')?.value || ''
  }));
---

<script id="atlas-tad-lo-page-config" type="application/json" set:html={JSON.stringify(tadLoConfigs)}></script>

<style is:global>
  .partner-dialog[data-guide-page-ready='true'],
  .selection-dialog[data-guide-page-ready='true'] {
    box-sizing: border-box !important;
    width: min(640px, calc(100vw - 40px)) !important;
    height: auto !important;
    max-height: min(420px, calc(100svh - 40px)) !important;
    margin: auto !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__shell,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__shell {
    display: grid !important;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr) !important;
    align-items: stretch !important;
    height: auto !important;
    min-height: 0 !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__visual,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__visual,
  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content {
    min-width: 0 !important;
    min-height: 0 !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__visual,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__visual {
    max-height: none !important;
    overflow: hidden !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__visual img,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__visual img {
    width: 100% !important;
    height: 100% !important;
    min-height: 260px !important;
    object-fit: cover !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-gallery__control,
  .partner-dialog[data-guide-page-ready='true'] .partner-gallery__counter,
  .selection-dialog[data-guide-page-ready='true'] .selection-gallery__control,
  .selection-dialog[data-guide-page-ready='true'] .selection-gallery__counter,
  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__partner,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__stamp,
  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__recommend,
  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content > ul,
  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__practical,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__recommend,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content > ul,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__practical {
    display: none !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content {
    display: flex !important;
    flex-direction: column !important;
    padding: 24px 24px 17px !important;
    overflow: hidden !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content h2,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content h2 {
    margin-bottom: 7px !important;
    font-size: clamp(2.15rem, 4vw, 3rem) !important;
    line-height: .95 !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__description,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__description {
    display: -webkit-box !important;
    margin-bottom: 6px !important;
    overflow: hidden !important;
    font-size: .82rem !important;
    line-height: 1.3 !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 3 !important;
  }

  .tad-lo-preview-meta {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 4px !important;
    margin-top: 7px !important;
    padding-top: 7px !important;
    border-top: 1px dashed rgba(49, 85, 69, .24) !important;
  }

  .tad-lo-preview-meta span {
    min-width: 0 !important;
    color: #315545 !important;
    font: 650 .62rem/1.05 'Caveat', 'Segoe Print', cursive !important;
  }

  .tad-lo-preview-meta small {
    display: block !important;
    color: #a45d3a !important;
    font: 700 .34rem/1.15 'DM Sans', sans-serif !important;
    text-transform: uppercase !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__actions,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__actions {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 5px !important;
    width: 100% !important;
    margin: auto 0 0 !important;
    padding: 7px 0 0 !important;
  }

  .partner-dialog[data-guide-page-ready='true'] .partner-dialog__actions > *,
  .selection-dialog[data-guide-page-ready='true'] .selection-dialog__actions > * {
    box-sizing: border-box !important;
    min-width: 0 !important;
    min-height: 34px !important;
    margin: 0 !important;
    padding: 5px !important;
    font-size: .5rem !important;
    text-align: center !important;
  }

  .partner-dialog[data-guide-page-ready='true'] [data-tad-lo-page-link],
  .selection-dialog[data-guide-page-ready='true'] [data-tad-lo-page-link] {
    border: 1px solid #b8653e !important;
    background: #f4e7d2 !important;
    color: #9a5134 !important;
  }

  @media (max-width: 700px) {
    .partner-dialog[data-guide-page-ready='true'],
    .selection-dialog[data-guide-page-ready='true'] {
      width: min(360px, calc(100vw - 32px)) !important;
      max-height: min(460px, calc(100svh - 32px)) !important;
      margin: auto !important;
      overflow: auto !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__shell,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__shell {
      grid-template-columns: 1fr !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__visual,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__visual {
      max-height: 120px !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__visual img,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__visual img {
      height: 120px !important;
      min-height: 120px !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content {
      padding: 18px 20px 14px !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__content h2,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__content h2 {
      font-size: 2.3rem !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__description,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__description {
      -webkit-line-clamp: 2 !important;
    }

    .partner-dialog[data-guide-page-ready='true'] .partner-dialog__actions,
    .selection-dialog[data-guide-page-ready='true'] .selection-dialog__actions {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>

<script>
  type TadLoConfig = {
    slug: string;
    modalId: string;
    route: string;
    duration: string;
    difficulty: string;
    bestTime: string;
  };

  const readTadLoConfigs = (): TadLoConfig[] => {
    const node = document.getElementById('atlas-tad-lo-page-config');
    if (!node?.textContent) return [];
    try { return JSON.parse(node.textContent) as TadLoConfig[]; }
    catch { return []; }
  };

  const configForDialogId = (configs: TadLoConfig[], dialogId: string) => (
    configs.find((config) => dialogId === config.modalId || dialogId.startsWith(`${config.modalId}-`))
  );

  const prepareTadLoSources = (configs: TadLoConfig[]) => {
    document.querySelectorAll<HTMLElement>('[data-partner-card-open], [data-selection-card-open]').forEach((trigger, index) => {
      const dialogId = trigger.dataset.partnerCardOpen || trigger.dataset.selectionCardOpen || '';
      const config = configForDialogId(configs, dialogId);
      if (!config) return;
      const source = trigger.closest<HTMLElement>('.partner-card, .selection-card, [data-selection-alias]') || trigger;
      if (!source.id) source.id = `tad-lo-landmark-source-${config.slug}-${index + 1}`;
      trigger.dataset.landmarkPageSourceId = source.id;
    });
  };

  const bindTadLoSourceTracking = (configs: TadLoConfig[]) => {
    if (document.documentElement.dataset.tadLoLandmarkTrackingReady === 'true') return;
    document.documentElement.dataset.tadLoLandmarkTrackingReady = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>('[data-partner-card-open], [data-selection-card-open]');
      if (!trigger) return;
      const dialogId = trigger.dataset.partnerCardOpen || trigger.dataset.selectionCardOpen || '';
      const config = configForDialogId(configs, dialogId);
      if (!config) return;
      const dialog = document.getElementById(dialogId);
      if (dialog instanceof HTMLDialogElement) dialog.dataset.landmarkPageSourceId = trigger.dataset.landmarkPageSourceId || '';
    }, true);
  };

  const addTadLoMeta = (dialog: HTMLDialogElement, config: TadLoConfig) => {
    const content = dialog.querySelector<HTMLElement>('.partner-dialog__content, .selection-dialog__content');
    if (!content || content.querySelector('.tad-lo-preview-meta')) return;
    const description = content.querySelector('.partner-dialog__description, .selection-dialog__description');
    const meta = document.createElement('div');
    meta.className = 'tad-lo-preview-meta';
    meta.innerHTML = `
      <span><small>Time</small>${config.duration}</span>
      <span><small>Effort</small>${config.difficulty}</span>
      <span><small>Best rhythm</small>${config.bestTime}</span>
    `;
    description?.insertAdjacentElement('afterend', meta);
  };

  const wireTadLoDialog = (dialog: HTMLDialogElement, config: TadLoConfig) => {
    dialog.dataset.guidePageReady = 'true';
    addTadLoMeta(dialog, config);

    const actions = dialog.querySelector<HTMLElement>('.partner-dialog__actions, .selection-dialog__actions');
    if (!actions) return;
    let link = actions.querySelector<HTMLAnchorElement>('[data-tad-lo-page-link]');
    if (!link) {
      const firstLink = actions.querySelector<HTMLAnchorElement>('a');
      link = document.createElement('a');
      link.href = config.route;
      link.dataset.tadLoPageLink = config.slug;
      link.className = firstLink?.className || '';
      link.removeAttribute('target');
      link.removeAttribute('rel');
      link.innerHTML = 'Plan my visit <span aria-hidden="true">↗</span>';
      if (firstLink) firstLink.replaceWith(link);
      else actions.prepend(link);
    }

    if (link.dataset.returnReady === 'true') return;
    link.dataset.returnReady = 'true';
    link.addEventListener('click', () => {
      const sourceId = dialog.dataset.landmarkPageSourceId || '';
      if (sourceId) {
        const fixedTop = Number.parseFloat(document.body.style.top || '');
        const scrollY = Number.isFinite(fixedTop) && fixedTop < 0 ? Math.abs(fixedTop) : window.scrollY;
        const state = {
          slug: config.slug,
          sourcePath: `${location.pathname}${location.search}${location.hash}`,
          sourceId,
          categorySlug: document.querySelector<HTMLElement>('[data-city-category-button][aria-selected="true"]')?.dataset.cityCategoryButton,
          scrollY
        };
        sessionStorage.setItem('atlas:landmark-return', JSON.stringify(state));
      }
      if (dialog.open) dialog.close();
    });
  };

  const configureTadLoDialogs = (configs: TadLoConfig[]) => {
    document.querySelectorAll<HTMLDialogElement>('dialog.partner-dialog, dialog.selection-dialog').forEach((dialog) => {
      const config = configForDialogId(configs, dialog.id);
      if (config) wireTadLoDialog(dialog, config);
    });
  };

  const setupTadLoPageBridge = () => {
    const configs = readTadLoConfigs();
    if (!configs.length) return;
    prepareTadLoSources(configs);
    bindTadLoSourceTracking(configs);
    configureTadLoDialogs(configs);
  };

  setupTadLoPageBridge();
  document.addEventListener('astro:page-load', setupTadLoPageBridge);
  [40, 120, 300].forEach((delay) => window.setTimeout(setupTadLoPageBridge, delay));
</script>
