---
const { country, countrySlug, city, citySlug, categorySlug } = Astro.props;
const categoryMap = {
  restaurants: { name: 'Restaurants', noun: 'restaurants', intro: 'Local kitchens, reliable tables and places worth saving for later.' },
  cafes: { name: 'Cafés', noun: 'cafés', intro: 'Good coffee, quiet corners and easy places to pause.' },
  accommodation: { name: 'Guesthouses', noun: 'stays', intro: 'Guesthouses, hotels and practical bases around the city.' },
  'scooter-rental': { name: 'Scooter Rental', noun: 'rental addresses', intro: 'Useful transport options and practical checks before taking the road.' },
  'things-to-do': { name: 'Things to do', noun: 'things to do', intro: 'Experiences, walks and local places to add to your route.' },
  'gyms-fitness': { name: 'Gyms & Fitness', noun: 'places to train', intro: 'Gyms and training spaces worth keeping in your notebook.' },
  'markets-shopping': { name: 'Markets & Shopping', noun: 'markets and shops', intro: 'Markets, useful stores and local shopping stops.' },
  'essential-information': { name: 'Essential Information', noun: 'useful addresses', intro: 'Healthcare, money, connectivity and practical city essentials.' },
};
const category = categoryMap[categorySlug] ?? categoryMap['things-to-do'];
---

<section class="listing container" aria-labelledby="listing-title">
  <header class="chapter-sheet">
    <div class="chapter-sheet__meta">
      <div><span>{country}</span><strong>{category.name}</strong></div>
      <div><span>{city}</span><strong>Guide in preparation</strong></div>
    </div>
    <div class="chapter-sheet__title">
      <h1 id="listing-title"><span>0 {category.noun} in {city}</span><em>field guide.</em></h1>
      <p>{category.intro}</p>
    </div>
  </header>

  <div class="listing__empty">
    <p class="eyebrow">Coming together</p>
    <h2>The useful stops are being documented.</h2>
    <p>The page and card system are ready. Addresses will appear here once the shortlist and field notes have been checked.</p>
    <a href={`/${countrySlug}/${citySlug}`}>Back to the {city} notebook →</a>
  </div>
</section>

<style>
  .listing { padding: 88px 20px 140px; }
  .chapter-sheet { padding-bottom: clamp(38px,4.5vw,58px); }
  .chapter-sheet__meta { position: relative; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 30px; margin-bottom: clamp(42px,5vw,66px); padding: 18px clamp(20px,2.6vw,34px) 24px; background: #fff; box-shadow: 0 9px 24px rgba(49,85,69,.055); }
  .chapter-sheet__meta::after { content:''; position:absolute; right:0; bottom:-9px; left:0; height:10px; background:#fff; clip-path:polygon(0 0,100% 0,100% 42%,96% 72%,91% 48%,86% 80%,81% 52%,75% 76%,69% 46%,63% 82%,57% 54%,51% 74%,45% 48%,39% 80%,33% 51%,27% 77%,21% 47%,15% 82%,9% 52%,4% 74%,0 48%); }
  .chapter-sheet__meta div { display:grid; gap:5px; }
  .chapter-sheet__meta div:last-child { text-align:right; }
  .chapter-sheet__meta span,.chapter-sheet__meta strong { color:var(--green); font-size:.56rem; font-weight:700; letter-spacing:.13em; line-height:1.25; text-transform:uppercase; }
  .chapter-sheet__meta strong { color:var(--terracotta); }
  .chapter-sheet__title { display:grid; grid-template-columns:minmax(0,2fr) minmax(275px,.72fr); gap:clamp(38px,5vw,78px); align-items:end; padding:0 clamp(4px,1vw,14px); }
  .chapter-sheet__title h1 { margin:0; font-size:clamp(3.15rem,4.55vw,4.85rem); line-height:.95; letter-spacing:-.025em; }
  .chapter-sheet__title h1 span,.chapter-sheet__title h1 em { display:block; }
  .chapter-sheet__title h1 em { color:var(--green); }
  .chapter-sheet__title p { margin:0; color:var(--muted); font-size:clamp(.78rem,1vw,.9rem); line-height:1.65; }
  .listing__empty { max-width:760px; margin:35px auto 0; padding:clamp(38px,6vw,70px); background:#f7f2e6; text-align:center; box-shadow:0 16px 38px rgba(31,41,36,.08); }
  .listing__empty .eyebrow { color:var(--terracotta); font-size:.66rem; font-weight:700; letter-spacing:.15em; text-transform:uppercase; }
  .listing__empty h2 { margin:14px 0 18px; color:var(--green); font-size:clamp(2rem,4vw,3.4rem); line-height:1; }
  .listing__empty p { color:var(--muted); line-height:1.7; }
  .listing__empty a { display:inline-block; margin-top:22px; color:var(--green); font-weight:700; text-decoration:none; }
  @media(max-width:760px){ .chapter-sheet__title{grid-template-columns:1fr}.chapter-sheet__meta{grid-template-columns:1fr}.chapter-sheet__meta div:last-child{text-align:left} }
</style>
