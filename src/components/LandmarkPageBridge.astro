---
import { laosLandmarkPages } from '../data/laosLandmarkPageRegistry';

const bridgeConfig = laosLandmarkPages.map((entry) => {
  const getFact = (label: string) => entry.landmark.facts.find((fact) => fact.label.toLowerCase() === label.toLowerCase())?.value || '';
  return {
    slug: entry.slug,
    modalId: entry.landmark.modalId,
    route: entry.route,
    duration: entry.landmark.cityContext.duration || getFact('Duration'),
    difficulty: getFact('Difficulty') || 'Check the field guide',
    bestTime: getFact('Best time') || 'Check current conditions'
  };
});
---

<script id="atlas-landmark-page-config" type="application/json" set:html={JSON.stringify(bridgeConfig)}></script>

<style is:global>
  /*
   * Compact landmark preview.
   * This deliberately owns the complete geometry of the preview instead of
   * partially overriding the old three-column field-card modal.
   */
  .landmark-modal[data-guide-page-ready='true'] {
    box-sizing: border-box;
    width: min(820px, calc(100vw - 48px));
    height: auto !important;
    max-height: min(470px, calc(100svh - 48px));
    padding: 0;
    overflow: hidden;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    align-items: stretch;
    height: auto !important;
    min-height: 0;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__story,
  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__visual {
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
    align-self: stretch;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__story {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 24px 20px 31px;
    overflow: hidden;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__story h2 {
    margin-top: 0;
    font-size: clamp(2.75rem, 4.4vw, 3.8rem);
    line-height: .84;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__eyebrow {
    margin-bottom: 8px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__region {
    margin-top: 7px !important;
    font-size: .98rem !important;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-story__underline {
    width: min(170px, 72%);
    margin: 3px 0 6px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-story__description {
    display: -webkit-box;
    max-width: 25rem;
    margin: 0;
    overflow: hidden;
    font-size: .9rem;
    line-height: 1.24;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-story__annotations,
  .landmark-modal[data-guide-page-ready='true'] .landmark-story__scribble,
  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__facts,
  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__thumbnails,
  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__arrow,
  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__counter,
  .landmark-modal[data-guide-page-ready='true'] .landmark-actions__annotation,
  .landmark-modal[data-guide-page-ready='true'] .landmark-visual__closing,
  .landmark-modal[data-guide-page-ready='true'] .landmark-partner-note {
    display: none !important;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__visual {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 15px 18px 12px;
    overflow: hidden;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-visual__meta {
    flex: 0 0 auto;
    margin-bottom: 5px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery {
    flex: 0 0 auto;
    min-width: 0;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__stage {
    min-height: 184px;
    padding: 5px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__stage > img {
    height: 184px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__placeholder {
    min-height: 184px;
    font-size: 1.35rem;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-gallery__credit {
    min-height: 11px;
    margin: 4px 0 0;
    overflow: hidden;
    font-size: .5rem;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-modal__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 6px;
    width: 100%;
    margin: auto 0 0;
    padding-top: 8px;
  }

  .landmark-modal[data-guide-page-ready='true'] .landmark-action {
    box-sizing: border-box;
    min-width: 0;
    min-height: 37px;
    padding: 6px 6px;
    overflow: hidden;
    font-size: .78rem;
    line-height: 1.05;
  }

  .landmark-preview-meta,
  .place-landmark-preview-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed rgba(49, 85, 69, .28);
  }

  .landmark-preview-meta span,
  .place-landmark-preview-meta span {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
    color: #315545;
    font: 650 .72rem/1.03 'Caveat', 'Segoe Print', cursive;
  }

  .landmark-preview-meta small,
  .place-landmark-preview-meta small {
    color: #a45d3a;
    font: 700 .39rem/1.15 'DM Sans', sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .landmark-modal[data-guide-page-ready='true'] [data-landmark-page-link],
  .place-dialog[data-guide-page-ready='true'] [data-landmark-page-link] {
    border: 1px solid #b8653e !important;
    background: #f4e7d2 !important;
    color: #9a5134 !important;
    font-weight: 700;
    box-shadow: 2px 3px 0 rgba(184, 101, 62, .14);
  }

  /* Category Things-to-do cards use PlaceCard dialogs. Keep them visually aligned. */
  .place-dialog[data-guide-page-ready='true'] {
    box-sizing: border-box;
    width: min(820px, calc(100vw - 48px));
    height: auto !important;
    max-height: min(470px, calc(100svh - 48px));
    overflow: hidden;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__shell {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
    align-items: stretch;
    height: auto !important;
    min-height: 0;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__visual,
  .place-dialog[data-guide-page-ready='true'] .place-dialog__content {
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
    align-self: stretch;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__visual {
    max-height: none;
    overflow: hidden;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__visual img {
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__content {
    display: flex;
    flex-direction: column;
    padding: 28px 28px 20px;
    overflow: hidden;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__content h2 {
    margin-bottom: 9px;
    font-size: clamp(2.45rem, 4vw, 3.5rem);
    line-height: .95;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__description {
    display: -webkit-box;
    margin-bottom: 8px;
    overflow: hidden;
    font-size: .94rem;
    line-height: 1.37;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__recommend,
  .place-dialog[data-guide-page-ready='true'] .place-dialog__highlights,
  .place-dialog[data-guide-page-ready='true'] .place-dialog__practical,
  .place-dialog[data-guide-page-ready='true'] .place-dialog__phone,
  .place-dialog[data-guide-page-ready='true'] .place-dialog__image-attribution {
    display: none !important;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    margin: auto 0 0;
    padding-top: 9px;
  }

  .place-dialog[data-guide-page-ready='true'] .place-dialog__actions > * {
    box-sizing: border-box;
    min-width: 0;
    min-height: 38px;
    margin: 0;
    padding: 7px;
    font-size: .55rem;
    text-align: center;
  }

  .landmark-return-target {
    position: relative;
    z-index: 6;
    outline: 3px solid rgba(217, 119, 69, .88) !important;
    outline-offset: 7px !important;
    box-shadow: 0 0 0 12px rgba(217, 119, 69, .12), 0 16px 35px rgba(31, 57, 45, .16) !important;
  }

  @media (max-width: 850px) {
    .landmark-modal[data-guide-page-ready='true'],
    .place-dialog[data-guide-page-ready='true'] {
      width: min(730px, calc(100vw - 28px));
      max-height: min(490px, calc(100svh - 28px));
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-modal__grid,
    .place-dialog[data-guide-page-ready='true'] .place-dialog__shell {
      grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    }
  }

  @media (max-width: 650px) {
    .landmark-modal[data-guide-page-ready='true'],
    .place-dialog[data-guide-page-ready='true'] {
      width: calc(100vw - 14px);
      max-height: calc(100svh - 14px);
      overflow: auto;
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-modal__grid,
    .place-dialog[data-guide-page-ready='true'] .place-dialog__shell {
      grid-template-columns: 1fr;
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-modal__story {
      padding: 28px 25px 19px;
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-story__description {
      -webkit-line-clamp: 4;
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-modal__visual {
      padding: 12px 16px 15px;
    }

    .landmark-modal[data-guide-page-ready='true'] .landmark-modal__actions,
    .place-dialog[data-guide-page-ready='true'] .place-dialog__actions {
      grid-template-columns: 1fr;
    }

    .place-dialog[data-guide-page-ready='true'] .place-dialog__visual img {
      min-height: 220px;
      max-height: 260px;
    }
  }
</style>

<script>
  type LandmarkBridgeConfig = {
    slug: string;
    modalId: string;
    route: string;
    duration: string;
    difficulty: string;
    bestTime: string;
  };

  type LandmarkReturnState = {
    slug: string;
    sourcePath: string;
    sourceId: string;
    categorySlug?: string;
    scrollY: number;
  };

  const RETURN_KEY = 'atlas:landmark-return';

  const readConfig = (): LandmarkBridgeConfig[] => {
    const node = document.getElementById('atlas-landmark-page-config');
    if (!node?.textContent) return [];
    try { return JSON.parse(node.textContent) as LandmarkBridgeConfig[]; }
    catch { return []; }
  };

  const currentScroll = () => {
    const fixedTop = Number.parseFloat(document.body.style.top || '');
    return Number.isFinite(fixedTop) && fixedTop < 0 ? Math.abs(fixedTop) : window.scrollY;
  };

  const activeCategory = () => (
    document.querySelector<HTMLElement>('[data-city-category-button][aria-selected="true"]')?.dataset.cityCategoryButton || undefined
  );

  const sourceElementFor = (trigger: HTMLElement, slug: string) => (
    trigger.closest<HTMLElement>(`.explore-board-card, .city-landmark-card, #category-${CSS.escape(slug)}, .place-card, article`) || trigger
  );

  const prepareSources = (configs: LandmarkBridgeConfig[]) => {
    configs.forEach((config) => {
      document.querySelectorAll<HTMLElement>(`[data-open-landmark="${config.modalId}"]`).forEach((trigger, index) => {
        const source = sourceElementFor(trigger, config.slug);
        if (!source.id) source.id = `landmark-source-${config.slug}-${index + 1}`;
        trigger.dataset.landmarkPageSourceId = source.id;
      });

      document.querySelectorAll<HTMLElement>(`[data-place-dialog="place-dialog-${config.slug}"]`).forEach((trigger, index) => {
        const source = sourceElementFor(trigger, config.slug);
        if (!source.id) source.id = `landmark-category-source-${config.slug}-${index + 1}`;
        trigger.dataset.landmarkPageSourceId = source.id;
      });
    });
  };

  const metaMarkup = (config: LandmarkBridgeConfig) => `
    <span><small>Time</small>${config.duration}</span>
    <span><small>Effort</small>${config.difficulty}</span>
    <span><small>Best rhythm</small>${config.bestTime}</span>
  `;

  const addLandmarkMeta = (dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    const story = dialog.querySelector<HTMLElement>('.landmark-modal__story');
    if (!story || story.querySelector('.landmark-preview-meta')) return;
    const meta = document.createElement('div');
    meta.className = 'landmark-preview-meta';
    meta.innerHTML = metaMarkup(config);
    story.append(meta);
  };

  const addPlaceMeta = (dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    const content = dialog.querySelector<HTMLElement>('.place-dialog__content');
    if (!content || content.querySelector('.place-landmark-preview-meta')) return;
    const meta = document.createElement('div');
    meta.className = 'place-landmark-preview-meta';
    meta.innerHTML = metaMarkup(config);
    content.querySelector('.place-dialog__description')?.insertAdjacentElement('afterend', meta);
  };

  const rememberReturn = (dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    const sourceId = dialog.dataset.landmarkPageSourceId || '';
    if (!sourceId) return;
    const state: LandmarkReturnState = {
      slug: config.slug,
      sourcePath: `${location.pathname}${location.search}${location.hash}`,
      sourceId,
      categorySlug: activeCategory(),
      scrollY: currentScroll()
    };
    sessionStorage.setItem(RETURN_KEY, JSON.stringify(state));
    if (config.slug === 'wat-phou') sessionStorage.setItem('atlas:wat-phou-return', JSON.stringify(state));
  };

  const bindReturnToLink = (link: HTMLAnchorElement, dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    if (link.dataset.returnReady === 'true') return;
    link.dataset.returnReady = 'true';
    link.addEventListener('click', () => {
      rememberReturn(dialog, config);
      if (dialog.open) dialog.close();
    });
  };

  const installLandmarkPageLink = (dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    const actions = dialog.querySelector<HTMLElement>('.landmark-modal__actions');
    if (!actions) return;

    let link = actions.querySelector<HTMLAnchorElement>('[data-landmark-page-link]');
    if (!link) {
      link = document.createElement('a');
      link.className = 'landmark-action landmark-action--guide';
      link.dataset.landmarkPageLink = config.slug;
      link.href = config.route;
      link.innerHTML = '<span aria-hidden="true">✎</span> Plan my visit';
      link.setAttribute('aria-label', `Open the complete ${dialog.querySelector('h2')?.textContent?.trim() || 'landmark'} guide`);
      const saveButton = actions.querySelector('[data-add-landmark]');
      actions.insertBefore(link, saveButton || null);
    }
    bindReturnToLink(link, dialog, config);
  };

  const installPlacePageLink = (dialog: HTMLDialogElement, config: LandmarkBridgeConfig) => {
    const actions = dialog.querySelector<HTMLElement>('.place-dialog__actions');
    if (!actions) return;

    let link = actions.querySelector<HTMLAnchorElement>('[data-landmark-page-link]');
    if (!link) {
      link = document.createElement('a');
      link.className = 'place-dialog__guide';
      link.dataset.landmarkPageLink = config.slug;
      link.href = config.route;
      link.innerHTML = 'Plan my visit <span aria-hidden="true">↗</span>';
      const mapLink = actions.querySelector('.place-dialog__map');
      actions.insertBefore(link, mapLink || actions.firstChild);
    }
    bindReturnToLink(link, dialog, config);
  };

  const configureDialogs = (configs: LandmarkBridgeConfig[]) => {
    prepareSources(configs);
    configs.forEach((config) => {
      const landmarkDialog = document.getElementById(config.modalId);
      if (landmarkDialog instanceof HTMLDialogElement && landmarkDialog.classList.contains('landmark-modal')) {
        landmarkDialog.dataset.guidePageReady = 'true';
        const eyebrow = landmarkDialog.querySelector<HTMLElement>('.landmark-modal__eyebrow');
        if (eyebrow) eyebrow.textContent = 'LAOS · QUICK FIELD CARD';
        addLandmarkMeta(landmarkDialog, config);
        installLandmarkPageLink(landmarkDialog, config);
      }

      const placeDialog = document.getElementById(`place-dialog-${config.slug}`);
      if (placeDialog instanceof HTMLDialogElement) {
        placeDialog.dataset.guidePageReady = 'true';
        addPlaceMeta(placeDialog, config);
        installPlacePageLink(placeDialog, config);
      }
    });
  };

  const bindSourceTracking = (configs: LandmarkBridgeConfig[]) => {
    if (document.documentElement.dataset.landmarkPageTrackingReady === 'true') return;
    document.documentElement.dataset.landmarkPageTrackingReady = 'true';
    const byDialog = new Map<string, LandmarkBridgeConfig>();
    configs.forEach((config) => {
      byDialog.set(config.modalId, config);
      byDialog.set(`place-dialog-${config.slug}`, config);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const landmarkTrigger = target.closest<HTMLElement>('[data-open-landmark]');
      const placeTrigger = target.closest<HTMLElement>('[data-place-dialog]');
      const trigger = landmarkTrigger || placeTrigger;
      if (!trigger) return;

      const dialogId = landmarkTrigger?.dataset.openLandmark || placeTrigger?.dataset.placeDialog || '';
      const config = byDialog.get(dialogId);
      if (!config) return;
      const dialog = document.getElementById(dialogId);
      if (dialog instanceof HTMLDialogElement) dialog.dataset.landmarkPageSourceId = trigger.dataset.landmarkPageSourceId || '';
    }, true);
  };

  const restoreSource = () => {
    const raw = sessionStorage.getItem(RETURN_KEY);
    if (!raw) return;
    let state: LandmarkReturnState | null = null;
    try { state = JSON.parse(raw) as LandmarkReturnState; }
    catch { sessionStorage.removeItem(RETURN_KEY); }
    if (!state || location.pathname !== state.sourcePath.split(/[?#]/)[0]) return;

    if (state.categorySlug) {
      const tab = document.querySelector<HTMLButtonElement>(`[data-city-category-button="${CSS.escape(state.categorySlug)}"]`);
      if (tab && tab.getAttribute('aria-selected') !== 'true') tab.click();
    }

    window.setTimeout(() => {
      const source = document.getElementById(state!.sourceId);
      if (source) {
        source.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'auto' });
        source.classList.add('landmark-return-target');
        window.setTimeout(() => source.classList.remove('landmark-return-target'), 1600);
      } else {
        window.scrollTo({ top: state!.scrollY, left: 0, behavior: 'auto' });
      }
      sessionStorage.removeItem(RETURN_KEY);
      if (state!.slug === 'wat-phou') sessionStorage.removeItem('atlas:wat-phou-return');
    }, 80);
  };

  const setupLandmarkPageBridge = () => {
    const configs = readConfig();
    if (!configs.length) return;
    bindSourceTracking(configs);
    restoreSource();
    [0, 40, 120, 300].forEach((delay) => window.setTimeout(() => configureDialogs(configs), delay));
  };

  setupLandmarkPageBridge();
  document.addEventListener('astro:page-load', setupLandmarkPageBridge);
  window.addEventListener('pageshow', setupLandmarkPageBridge);
</script>
