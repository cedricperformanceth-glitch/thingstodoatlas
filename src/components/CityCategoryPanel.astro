---
interface Props {
  slug: string;
  cityName: string;
  title: string;
  count: number;
  noun: string;
  intro: string;
  fieldNote?: string;
  active?: boolean;
  updated?: string;
}

const {
  slug,
  cityName,
  count,
  noun,
  intro,
  active = false
} = Astro.props;
const panelId = `city-panel-${cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${slug}`;
---

<article
  class:list={['city-category-panel', { 'is-active': active }]}
  id={panelId}
  role="tabpanel"
  tabindex="-1"
  data-city-category-panel={slug}
  hidden={!active}
>
  <header class="city-category-panel__header">
    <div class="city-category-panel__title">
      <div>
        <h3><span>{count} {noun} in {cityName}</span><em>{count ? 'to begin with.' : 'field guide.'}</em></h3>
      </div>
      <aside>
        <p>{intro}</p>
        <slot name="filters" />
      </aside>
    </div>
  </header>
  <div class="city-category-panel__content"><slot /></div>
</article>

<style>
  .city-category-panel[hidden]{display:none}.city-category-panel{outline:none}.city-category-panel__header{position:relative;padding-bottom:clamp(2rem,3.5vw,3.1rem)}
  .city-category-panel__title{display:grid;grid-template-columns:minmax(0,2fr) minmax(275px,.72fr);gap:clamp(2.4rem,5vw,4.8rem);align-items:end;padding:0 clamp(4px,1vw,14px)}.city-category-panel__title h3{max-width:980px;margin:0;color:var(--ink);font:400 clamp(2.65rem,4.3vw,4.45rem)/.96 Fraunces,Georgia,serif;letter-spacing:-.035em}.city-category-panel__title h3 span,.city-category-panel__title h3 em{display:block}.city-category-panel__title h3 em{color:var(--green)}.city-category-panel__title aside{max-width:410px;padding-bottom:4px}.city-category-panel__title aside>p{margin:0 0 20px;color:var(--muted);font-size:clamp(.78rem,1vw,.9rem);line-height:1.65}
  .city-category-panel__content :global(.city-panel-list){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,2vw,1.45rem)}.city-category-panel__content :global(.city-panel-empty){padding:clamp(2.5rem,5vw,4rem);border:1px dashed rgba(49,85,69,.25);background:rgba(247,242,230,.64);text-align:center}.city-category-panel__content :global(.city-panel-empty h4){margin:0 0 .8rem;color:var(--green);font-size:clamp(1.7rem,3vw,2.5rem)}.city-category-panel__content :global(.city-panel-empty p){max-width:36rem;margin:0 auto;color:var(--muted);line-height:1.65}
  @media(max-width:980px){.city-category-panel__content :global(.city-panel-list){grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:820px){.city-category-panel__title{grid-template-columns:1fr}.city-category-panel__title aside{max-width:36rem}}
  @media(max-width:640px){.city-category-panel__content :global(.city-panel-list){grid-template-columns:1fr}.city-category-panel__title h3{font-size:clamp(2.35rem,12vw,3.35rem)}}
</style>