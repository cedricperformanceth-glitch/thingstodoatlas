---
import type { CityLandmark } from '../data/laosLandmarks';

interface Props {
  cityName: string;
  eyebrow: string;
  title: string;
  landmarks: CityLandmark[];
  asideTitle: string;
  asideParagraphs: string[];
  asideNote?: string;
}

const { cityName, eyebrow, title, landmarks, asideTitle, asideParagraphs, asideNote } = Astro.props;
const thumbnailSrc = (src?: string) => src ? src.replace(/([?&])width=\d+/i, '$1width=640') : '';
---

<section class="city-landmarks" aria-labelledby="city-landmarks-title">
  <header class="city-landmarks__heading">
    <p>{eyebrow}</p>
    <h2 id="city-landmarks-title">{title}</h2>
  </header>

  <div class="city-landmarks__layout">
    <div class="city-landmarks__list" aria-label={`Places to explore from ${cityName}`}>
      {landmarks.map((landmark, index) => (
        <button
          class:list={['city-landmark-card', `city-landmark-card--${index % 3}`]}
          type="button"
          data-open-landmark={landmark.modalId}
          aria-label={`Open ${landmark.name} field note`}
        >
          <span class="city-landmark-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="city-landmark-card__image">
            <img src={thumbnailSrc(landmark.gallery[0]?.src)} alt={landmark.gallery[0]?.alt || landmark.name} width="260" height="190" loading="lazy" decoding="async" />
          </span>
          <span class="city-landmark-card__content">
            <span class="city-landmark-card__kicker">{landmark.cityContext.kicker}</span>
            <strong>{landmark.name}</strong>
            <span class="city-landmark-card__summary">{landmark.cityContext.summary}</span>
            <span class="city-landmark-card__meta"><span>{landmark.cityContext.duration}</span><i aria-hidden="true"></i><span>{landmark.cityContext.route}</span></span>
          </span>
          <span class="city-landmark-card__arrow" aria-hidden="true">↗</span>
        </button>
      ))}
    </div>

    <aside class="city-landmarks__editorial">
      <span class="city-landmarks__tape" aria-hidden="true"></span>
      <p class="city-landmarks__aside-label">FIELD ORIENTATION</p>
      <h3>{asideTitle}</h3>
      {asideParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      {asideNote && <p class="city-landmarks__note"><span aria-hidden="true">↳</span>{asideNote}</p>}
    </aside>
  </div>
</section>

<style>
  .city-landmarks{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(2.25rem,5vw,4.75rem) 0 clamp(3rem,6vw,5.5rem);border-top:1px solid rgba(31,57,45,.16)}
  .city-landmarks__heading{margin-bottom:clamp(1.5rem,3vw,2.4rem)}
  .city-landmarks__heading>p,.city-landmarks__aside-label{margin:0 0 .45rem;color:rgba(31,57,45,.58);font-size:.68rem;font-weight:700;letter-spacing:.2em}
  .city-landmarks__heading h2{max-width:42rem;margin:0;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.2rem,4.8vw,4.3rem);font-weight:400;letter-spacing:-.05em;line-height:.98}
  .city-landmarks__layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(17rem,.72fr);gap:clamp(2.2rem,6vw,6.5rem);align-items:start}
  .city-landmarks__list{display:grid;gap:.8rem}
  .city-landmark-card{position:relative;display:grid;grid-template-columns:2.5rem 8.25rem minmax(0,1fr) 1.75rem;gap:1rem;align-items:center;width:100%;min-height:9.25rem;padding:.8rem 1rem .8rem .75rem;border:1px solid rgba(31,41,36,.18);border-radius:0;background:rgba(249,246,238,.78);color:#1c211e;box-shadow:0 5px 12px rgba(31,41,36,.035);font:inherit;text-align:left;cursor:pointer;transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease}
  .city-landmark-card--0{transform:rotate(-.25deg)}.city-landmark-card--1{transform:rotate(.18deg)}.city-landmark-card--2{transform:rotate(-.12deg)}
  .city-landmark-card:hover,.city-landmark-card:focus-visible{z-index:2;transform:translateY(-2px) rotate(0);background:#faf7ef;box-shadow:0 10px 22px rgba(31,41,36,.075);outline:none}
  .city-landmark-card__number{align-self:start;padding-top:.35rem;color:#a85e43;font-family:'Segoe Print','Bradley Hand',cursive;font-size:.78rem;font-weight:700;transform:rotate(-5deg)}
  .city-landmark-card__image{position:relative;display:block;padding:.28rem .28rem .75rem;background:#fdfbf5;box-shadow:0 4px 10px rgba(31,41,36,.09);transform:rotate(-1.2deg)}
  .city-landmark-card__image::before{content:'';position:absolute;z-index:2;top:-.35rem;left:50%;width:2.8rem;height:.72rem;background:rgba(205,190,157,.55);transform:translateX(-50%) rotate(2deg)}
  .city-landmark-card__image img{display:block;width:100%;height:5.35rem;object-fit:cover;filter:saturate(.78) contrast(.94)}
  .city-landmark-card__content{display:flex;flex-direction:column;min-width:0}
  .city-landmark-card__kicker{margin-bottom:.32rem;color:rgba(31,57,45,.58);font-size:.55rem;font-weight:800;letter-spacing:.14em}
  .city-landmark-card strong{color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.35rem,2.3vw,1.85rem);font-weight:400;line-height:1.05}
  .city-landmark-card__summary{max-width:34rem;margin-top:.45rem;color:rgba(28,33,30,.76);font-family:Georgia,'Times New Roman',serif;font-size:.84rem;line-height:1.42}
  .city-landmark-card__meta{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:.58rem;color:#8a4d36;font-family:'Segoe Print','Bradley Hand',cursive;font-size:.68rem;font-weight:600}
  .city-landmark-card__meta i{width:2px;height:2px;border-radius:50%;background:currentColor}
  .city-landmark-card__arrow{color:#315545;font-family:Georgia,'Times New Roman',serif;font-size:1.25rem;transition:transform 180ms ease}
  .city-landmark-card:hover .city-landmark-card__arrow,.city-landmark-card:focus-visible .city-landmark-card__arrow{transform:translate(2px,-2px)}
  .city-landmarks__editorial{position:sticky;top:2rem;padding:clamp(1.8rem,3vw,2.5rem);border:1px solid rgba(31,57,45,.16);background:rgba(247,242,230,.72);box-shadow:0 8px 20px rgba(31,41,36,.04);transform:rotate(.45deg)}
  .city-landmarks__tape{position:absolute;top:-.55rem;right:2rem;width:4.7rem;height:1.15rem;background:rgba(205,190,157,.58);transform:rotate(4deg)}
  .city-landmarks__editorial h3{margin:0 0 1.2rem;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.65rem,3vw,2.35rem);font-weight:400;letter-spacing:-.035em;line-height:1.04}
  .city-landmarks__editorial>p:not(.city-landmarks__aside-label):not(.city-landmarks__note){margin:0;color:rgba(31,41,36,.78);font-family:Georgia,'Times New Roman',serif;font-size:.98rem;line-height:1.62}
  .city-landmarks__editorial>p+p:not(.city-landmarks__note){margin-top:.9rem}
  .city-landmarks__note{display:flex;gap:.5rem;margin:1.4rem 0 0;color:#8a4d36;font-family:'Segoe Print','Bradley Hand',cursive;font-size:.78rem;line-height:1.35;transform:rotate(-1.5deg)}
  @media(max-width:900px){.city-landmarks__layout{grid-template-columns:1fr;gap:2.25rem}.city-landmarks__editorial{position:relative;top:auto;max-width:40rem}}
  @media(max-width:620px){.city-landmarks{width:min(100% - 2rem,1180px);padding-top:2rem}.city-landmark-card{grid-template-columns:1.65rem 5.75rem minmax(0,1fr);gap:.7rem;min-height:8.2rem;padding:.75rem .7rem}.city-landmark-card__image{padding:.22rem .22rem .58rem}.city-landmark-card__image img{height:4.6rem}.city-landmark-card__summary{font-size:.76rem;line-height:1.35}.city-landmark-card__meta{gap:.32rem;font-size:.6rem}.city-landmark-card__arrow{display:none}}
  @media(max-width:430px){.city-landmark-card{grid-template-columns:1.45rem minmax(0,1fr)}.city-landmark-card__image{display:none}}
</style>
