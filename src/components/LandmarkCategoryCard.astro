---
import type { CityLandmark } from '../data/laosLandmarks';

interface Props {
  landmark: CityLandmark;
  index?: number;
}

const { landmark, index = 0 } = Astro.props;
const cardNumber = String(index + 1).padStart(2, '0');
const image = landmark.gallery[0];
---

<article class="landmark-category-card" id={`category-${landmark.slug}`}>
  <button
    class="landmark-category-card__visual"
    type="button"
    data-open-landmark={landmark.modalId}
    aria-label={`Open the ${landmark.name} field note`}
  >
    {image && (
      <img
        src={image.src}
        alt={image.alt}
        width="720"
        height="520"
        loading="lazy"
        decoding="async"
      />
    )}
    <span class="landmark-category-card__number" aria-hidden="true">{cardNumber}</span>
    <span class="landmark-category-card__source">FIELD NOTE</span>
  </button>

  <div class="landmark-category-card__copy">
    <p>{landmark.cityContext.kicker}</p>
    <h3>{landmark.name}</h3>
    <span>{landmark.cityContext.summary}</span>

    <div class="landmark-category-card__meta">
      <small>{landmark.cityContext.duration}</small>
      <i aria-hidden="true"></i>
      <small>{landmark.cityContext.route}</small>
    </div>

    <div class="landmark-category-card__actions">
      <button type="button" data-open-landmark={landmark.modalId}>Open field note <span aria-hidden="true">↗</span></button>
      <a href={landmark.mapsUrl} target="_blank" rel="noreferrer">Google Maps</a>
    </div>
  </div>
</article>

<style>
  .landmark-category-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(75, 81, 70, .22);
    background: #eee8dc;
    box-shadow: 5px 7px 0 rgba(49, 85, 69, .07);
  }

  .landmark-category-card__visual {
    position: relative;
    display: block;
    width: 100%;
    height: 215px;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--paper-deep);
    cursor: pointer;
  }

  .landmark-category-card__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgba(24, 31, 26, .48));
    pointer-events: none;
  }

  .landmark-category-card__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.76) contrast(.96);
    transition: transform 180ms ease, filter 180ms ease;
  }

  .landmark-category-card:hover .landmark-category-card__visual img,
  .landmark-category-card:focus-within .landmark-category-card__visual img {
    filter: saturate(.88) contrast(1);
    transform: scale(1.015);
  }

  .landmark-category-card__number {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 253, 248, .8);
    border-radius: 50%;
    background: rgba(32, 60, 49, .82);
    color: #fffdf8;
    font: 500 .95rem/1 Fraunces, serif;
  }

  .landmark-category-card__source {
    position: absolute;
    z-index: 2;
    right: 13px;
    bottom: 12px;
    padding: 6px 8px;
    border: 1px solid rgba(255, 253, 248, .72);
    background: rgba(183, 102, 69, .82);
    color: #fffdf8;
    font: 700 .48rem/1 'DM Sans', sans-serif;
    letter-spacing: .12em;
  }

  .landmark-category-card__copy {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 24px 23px 22px;
  }

  .landmark-category-card__copy > p {
    margin: 0 0 10px;
    color: var(--terracotta);
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .landmark-category-card__copy h3 {
    margin: 0 0 11px;
    color: var(--green);
    font: 500 clamp(1.55rem, 2.2vw, 2.05rem)/1.06 Fraunces, serif;
  }

  .landmark-category-card__copy > span {
    color: var(--muted);
    font-size: .79rem;
    line-height: 1.55;
  }

  .landmark-category-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    color: var(--terracotta);
  }

  .landmark-category-card__meta small {
    font-size: .54rem;
    font-weight: 700;
    letter-spacing: .07em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .landmark-category-card__meta i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .landmark-category-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
  }

  .landmark-category-card__actions button,
  .landmark-category-card__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 13px;
    font: 700 .6rem/1 'DM Sans', sans-serif;
    cursor: pointer;
  }

  .landmark-category-card__actions button {
    border: 0;
    background: var(--terracotta);
    color: var(--white);
  }

  .landmark-category-card__actions a {
    border: 1px solid var(--green);
    color: var(--green);
  }

  @media (max-width: 700px) {
    .landmark-category-card__visual { height: 220px; }
    .landmark-category-card__copy { min-height: 0; }
    .landmark-category-card__actions > * { flex: 1 1 145px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .landmark-category-card__visual img { transition: none; }
  }
</style>
