---
import type { LandmarkGalleryItem, LandmarkFact } from '../data/laosLandmarks';

interface Props {
  id: string;
  slug: string;
  name: string;
  region: string;
  description: string;
  mapsUrl: string;
  guideUrl?: string;
  gallery?: LandmarkGalleryItem[];
  facts?: LandmarkFact[];
}

const {
  id,
  slug,
  name,
  region,
  description,
  mapsUrl,
  guideUrl,
  gallery = [],
  facts = []
} = Astro.props;

const photo = gallery.find((item) => item?.src);
const fact = (label: string) => facts.find((item) => item.label.toLowerCase() === label.toLowerCase())?.value || '';
const duration = fact('Duration') || 'See the full guide';
const bestTime = fact('Best time') || 'Check current conditions';
const difficulty = fact('Difficulty') || 'See the full guide';
---

<dialog
  id={id}
  class="atlas-landmark-preview"
  data-landmark-preview
  data-landmark-slug={slug}
  aria-labelledby={`${id}-title`}
>
  <article class="atlas-landmark-preview__card">
    <button class="atlas-landmark-preview__close" type="button" data-close-landmark aria-label={`Close ${name}`}>
      <span aria-hidden="true">×</span>
    </button>

    <div class="atlas-landmark-preview__photo">
      {photo ? (
        <>
          <img src={photo.src} alt={photo.alt || name} width="900" height="720" loading="lazy" decoding="async" />
          {(photo.author || photo.sourcePage) && (
            <p class="atlas-landmark-preview__credit">
              {photo.sourcePage ? (
                <a href={photo.sourcePage} target="_blank" rel="noreferrer">Photo: {photo.author || 'Wikimedia Commons'}</a>
              ) : (
                <>Photo: {photo.author}</>
              )}
              {photo.license && <> · {photo.license}</>}
            </p>
          )}
        </>
      ) : (
        <div class="atlas-landmark-preview__placeholder" aria-hidden="true">Field photo</div>
      )}
    </div>

    <div class="atlas-landmark-preview__body">
      <p class="atlas-landmark-preview__eyebrow">LAOS · QUICK FIELD CARD</p>
      <h2 id={`${id}-title`}>{name}</h2>
      <p class="atlas-landmark-preview__region">{region}</p>
      <p class="atlas-landmark-preview__description">{description}</p>

      <dl class="atlas-landmark-preview__facts">
        <div><dt>Time</dt><dd>{duration}</dd></div>
        <div><dt>Best time</dt><dd>{bestTime}</dd></div>
        <div><dt>Effort</dt><dd>{difficulty}</dd></div>
      </dl>

      <div class="atlas-landmark-preview__actions">
        <a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
        {guideUrl && (
          <a class="atlas-landmark-preview__plan" href={guideUrl} data-landmark-page-link={slug}>Plan my visit</a>
        )}
        <button type="button" data-add-landmark data-landmark-name={name}>Add to My Trip</button>
      </div>
    </div>
  </article>
</dialog>

<style>
  .atlas-landmark-preview {
    width: min(760px, calc(100vw - 40px));
    max-width: 760px;
    max-height: calc(100svh - 40px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: #22382e;
    overflow: auto;
    box-shadow: none;
  }

  .atlas-landmark-preview::backdrop {
    background: rgba(19, 27, 23, .60);
    backdrop-filter: blur(3px);
  }

  .atlas-landmark-preview__card {
    position: relative;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    width: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(49, 85, 69, .22);
    background: #f4ecd9;
    box-shadow: 0 24px 65px rgba(18, 24, 21, .32);
    overflow: hidden;
  }

  .atlas-landmark-preview__close {
    position: absolute;
    top: 11px;
    right: 11px;
    z-index: 5;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(49, 85, 69, .28);
    border-radius: 50%;
    background: rgba(248, 243, 231, .94);
    color: #315545;
    font: 500 1.35rem/1 'DM Sans', sans-serif;
    cursor: pointer;
  }

  .atlas-landmark-preview__photo {
    position: relative;
    min-width: 0;
    background: #e8dfcc;
  }

  .atlas-landmark-preview__photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 350px;
    object-fit: cover;
  }

  .atlas-landmark-preview__credit {
    position: absolute;
    right: 8px;
    bottom: 7px;
    left: 8px;
    margin: 0;
    padding: 4px 6px;
    background: rgba(244, 236, 217, .90);
    color: rgba(31, 57, 45, .72);
    font: 600 .57rem/1.2 'DM Sans', sans-serif;
  }

  .atlas-landmark-preview__credit a {
    color: inherit;
  }

  .atlas-landmark-preview__placeholder {
    display: grid;
    min-height: 350px;
    place-items: center;
    color: rgba(49, 85, 69, .6);
    font: 600 1.4rem/1 'Caveat', cursive;
  }

  .atlas-landmark-preview__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 30px 30px 24px;
    background-color: #f4ecd9;
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgba(49, 85, 69, .055) 32px, transparent 33px);
  }

  .atlas-landmark-preview__eyebrow {
    margin: 0 40px 8px 0;
    color: rgba(49, 85, 69, .62);
    font: 800 .58rem/1.2 'DM Sans', sans-serif;
    letter-spacing: .14em;
  }

  .atlas-landmark-preview h2 {
    margin: 0;
    color: #1f392d;
    font: 600 clamp(2.8rem, 5vw, 4rem)/.88 'Caveat', 'Segoe Print', cursive;
    letter-spacing: -.025em;
  }

  .atlas-landmark-preview__region {
    margin: 9px 0 10px;
    color: #b8653e;
    font: 650 1.04rem/1.12 'Caveat', 'Segoe Print', cursive;
  }

  .atlas-landmark-preview__description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #263b32;
    font: 500 1.02rem/1.35 'Caveat', 'Segoe Print', cursive;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .atlas-landmark-preview__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 17px 0 0;
    padding: 13px 0 0;
    border-top: 1px dashed rgba(49, 85, 69, .25);
  }

  .atlas-landmark-preview__facts div {
    min-width: 0;
  }

  .atlas-landmark-preview__facts dt {
    margin: 0 0 4px;
    color: #a45d3a;
    font: 800 .48rem/1.1 'DM Sans', sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .atlas-landmark-preview__facts dd {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #315545;
    font: 650 .88rem/1.15 'Caveat', 'Segoe Print', cursive;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .atlas-landmark-preview__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
    margin-top: 19px;
  }

  .atlas-landmark-preview__actions > * {
    display: flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 8px 7px;
    border: 1px solid #315545;
    background: transparent;
    color: #315545;
    font: 700 .78rem/1.1 'DM Sans', sans-serif;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .atlas-landmark-preview__actions button {
    background: #315545;
    color: #f7f2e6;
  }

  .atlas-landmark-preview__actions .atlas-landmark-preview__plan {
    border-color: #b8653e;
    background: #f4e2cd;
    color: #9a5134;
  }

  @media (max-width: 680px) {
    .atlas-landmark-preview {
      width: min(520px, calc(100vw - 28px));
      max-height: calc(100svh - 28px);
    }

    .atlas-landmark-preview__card {
      grid-template-columns: 1fr;
    }

    .atlas-landmark-preview__photo img,
    .atlas-landmark-preview__placeholder {
      height: 155px;
      min-height: 155px;
    }

    .atlas-landmark-preview__body {
      padding: 22px 20px 18px;
    }

    .atlas-landmark-preview h2 {
      font-size: clamp(2.5rem, 12vw, 3.45rem);
    }

    .atlas-landmark-preview__description {
      font-size: 1rem;
      -webkit-line-clamp: 3;
    }

    .atlas-landmark-preview__facts {
      margin-top: 13px;
      padding-top: 10px;
    }

    .atlas-landmark-preview__actions {
      margin-top: 14px;
    }

    .atlas-landmark-preview__actions > * {
      min-height: 40px;
      font-size: .7rem;
    }
  }

  @media (max-width: 430px) {
    .atlas-landmark-preview {
      width: calc(100vw - 24px);
    }

    .atlas-landmark-preview__photo img,
    .atlas-landmark-preview__placeholder {
      height: 130px;
      min-height: 130px;
    }

    .atlas-landmark-preview__body {
      padding: 19px 16px 15px;
    }

    .atlas-landmark-preview__facts {
      gap: 6px;
    }

    .atlas-landmark-preview__actions {
      gap: 5px;
    }

    .atlas-landmark-preview__actions > * {
      padding-inline: 4px;
      font-size: .64rem;
    }
  }
</style>
