---
import { countryNavigation } from '../data/atlasConfig';
import '../styles/site-header.css';

const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="atlas-header">
  <div class="atlas-header__navigation">
    <div class="language-menu">
      <button
        class="language-switcher"
        type="button"
        aria-label="Choose language"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="language-dropdown"
      >
        <svg class="language-switcher__flag" viewBox="0 0 60 30" aria-hidden="true">
          <clipPath id="uk-flag-clip"><path d="M0 0v30h60V0z" /></clipPath>
          <g clip-path="url(#uk-flag-clip)">
            <path fill="#012169" d="M0 0v30h60V0z" />
            <path stroke="#fff" stroke-width="6" d="M0 0l60 30M60 0L0 30" />
            <path stroke="#c8102e" stroke-width="4" d="M0 0l60 30M60 0L0 30" />
            <path stroke="#fff" stroke-width="10" d="M30 0v30M0 15h60" />
            <path stroke="#c8102e" stroke-width="6" d="M30 0v30M0 15h60" />
          </g>
        </svg>
        <svg class="language-switcher__arrow" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
      </button>

      <div class="language-dropdown" id="language-dropdown" hidden>
        <a class="language-dropdown__item" href="/fr/" hreflang="fr" lang="fr">
          <svg class="language-dropdown__flag" viewBox="0 0 3 2" aria-hidden="true"><path fill="#002395" d="M0 0h1v2H0z"/><path fill="#fff" d="M1 0h1v2H1z"/><path fill="#ed2939" d="M2 0h1v2H2z"/></svg>
          <span>Français</span>
        </a>
        <a class="language-dropdown__item" href="/es/" hreflang="es" lang="es">
          <svg class="language-dropdown__flag" viewBox="0 0 3 2" aria-hidden="true"><path fill="#aa151b" d="M0 0h3v2H0z"/><path fill="#f1bf00" d="M0 .5h3v1H0z"/></svg>
          <span>Español</span>
        </a>
      </div>
    </div>

    <div class="site-menu">
      <button
        class="site-menu__trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="site-menu-dropdown"
      >
        Menu
      </button>

      <div class="site-menu__dropdown" id="site-menu-dropdown" hidden>
        <nav class="site-menu__destinations" aria-label="Choose a country">
          {countryNavigation.map((country) => (
            <a
              class:list={[
                'site-menu__destination',
                `site-menu__destination--${country.slug}`,
                {
                  'is-active': currentPath.startsWith(`/${country.slug}`),
                  'is-coming-soon': country.status !== 'open'
                }
              ]}
              href={country.href}
              aria-current={currentPath.startsWith(`/${country.slug}`) ? 'page' : undefined}
            >
              {country.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>

  <a class="atlas-header__logo" href="/" aria-label="ThingsToDoAtlas home">
    <img
      src="/images/branding/things-to-do-atlas-stamp-transparent.webp"
      alt="ThingsToDoAtlas"
      width="512"
      height="512"
    />
  </a>
</header>

<nav class="atlas-mobile-nav" aria-label="Country chapters">
  {countryNavigation.map((country) => (
    <a
      class:list={[
        `atlas-mobile-nav__link--${country.slug}`,
        {
          'is-active': currentPath.startsWith(`/${country.slug}`),
          'is-coming-soon': country.status !== 'open'
        }
      ]}
      href={country.href}
      aria-current={currentPath.startsWith(`/${country.slug}`) ? 'page' : undefined}
    >
      {country.name}
    </a>
  ))}
</nav>

<script is:inline>
  const setupDropdown = (buttonSelector, dropdownSelector, wrapperSelector) => {
    const button = document.querySelector(buttonSelector);
    const dropdown = document.querySelector(dropdownSelector);

    if (!(button instanceof HTMLButtonElement) || !(dropdown instanceof HTMLElement)) return;

    const close = () => {
      dropdown.hidden = true;
      button.setAttribute('aria-expanded', 'false');
    };

    button.addEventListener('click', (event) => {
      event.stopPropagation();
      const willOpen = dropdown.hidden;
      dropdown.hidden = !willOpen;
      button.setAttribute('aria-expanded', String(willOpen));
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest(wrapperSelector)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  };

  setupDropdown('.language-switcher', '.language-dropdown', '.language-menu');
  setupDropdown('.site-menu__trigger', '.site-menu__dropdown', '.site-menu');
</script>
