---
const { place } = Astro.props;
---
<article class="place-card"><img src={place.image} alt={`Demo photograph for ${place.name}`} loading="lazy" /><div class="place-card__body"><div class="place-card__meta"><span>{place.subcategory}</span><span class={`status status--${place.status}`}>{place.status === 'demo' ? 'Demo listing' : place.status}</span></div><h2>{place.name}</h2><p>{place.description}</p><p class="recommend">{place.whyWeRecommend}</p><dl><div><dt>Hours</dt><dd>{place.hours}</dd></div><div><dt>Budget</dt><dd>{place.price}</dd></div></dl><a class="text-link" href={place.mapsUrl} target="_blank" rel="noreferrer">Open Google Maps ↗</a></div></article>
