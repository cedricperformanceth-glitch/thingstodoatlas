---
const { place } = Astro.props;
const tripPlace = JSON.stringify({
  id: place.slug,
  name: place.name,
  city: place.city,
  category: place.subcategory,
  address: place.price,
  url: `${Astro.url.pathname}#${place.slug}`
});
---
<article class="place-card" id={place.slug}>
  <img src={place.image} alt={`Demo photograph for ${place.name}`} loading="lazy" />
  <div class="place-card__body">
    <div class="place-card__meta"><span>{place.subcategory}</span><span class={`status status--${place.status}`}>{place.status === 'demo' ? 'Demo listing' : place.status}</span></div>
    <h2>{place.name}</h2>
    <p>{place.description}</p>
    <p class="recommend">{place.whyWeRecommend}</p>
    <dl><div><dt>Hours</dt><dd>{place.hours}</dd></div><div><dt>Budget</dt><dd>{place.price}</dd></div></dl>
    <div class="place-card__actions">
      <a class="text-link" href={place.mapsUrl} target="_blank" rel="noreferrer">Open Google Maps ↗</a>
      <button class="trip-save-button" type="button" data-trip-add data-trip-id={place.slug} data-trip-place={tripPlace} aria-pressed="false">Add to My Trip</button>
    </div>
  </div>
</article>

<style>
  .place-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; }
  .trip-save-button { padding: .55rem 0; border: 0; border-bottom: 1px solid var(--terracotta); background: transparent; color: var(--green); font: 700 .7rem 'DM Sans', sans-serif; cursor: pointer; }
  .trip-save-button:disabled { color: var(--muted); border-bottom-color: var(--line); cursor: default; }
</style>
