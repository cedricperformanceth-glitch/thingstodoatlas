---
import EditorialGuide from './EditorialGuide.astro';
import { pakseEditorialGuide } from '../data/pakseEditorialGuide';
---

<EditorialGuide guide={pakseEditorialGuide} mountSelector=".city-postcard__media" />

<style is:global>
  .city-postcard__media > .editorial-guide__trigger {
    position: relative;
    inset: auto;
    display: grid;
    flex: 0 0 auto;
    width: min(19.25rem, calc(100% - 1.25rem));
    margin: calc(1.02rem + 25px) 0 0 .08rem;
    padding: .52rem .68rem .48rem;
    border-color: rgba(49, 85, 69, .18);
    background: rgba(247, 242, 230, .78);
    box-shadow: 3px 4px 0 rgba(49, 85, 69, .055);
    transform: rotate(-.65deg);
  }

  .city-postcard__media > .editorial-guide__trigger:hover,
  .city-postcard__media > .editorial-guide__trigger:focus-visible {
    background: rgba(251, 247, 237, .96);
    box-shadow: 4px 5px 0 rgba(49, 85, 69, .075);
    transform: translateY(-1px) rotate(-.2deg);
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-tape {
    top: -.38rem;
    left: 1rem;
    width: 2.8rem;
    height: .72rem;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-eyebrow {
    position: absolute;
    left: .08rem;
    bottom: calc(100% + .38rem);
    margin: 0;
    color: #667068;
    font-size: .72rem;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-title {
    font-size: 1.26rem;
    line-height: 1.02;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-arrow {
    align-self: center;
    margin-left: .45rem;
    font-size: 1.34rem;
  }

  /* Pakse only: give the envelope priority and quieten the secondary drawing column. */
  @media (min-width: 981px) {
    #main-content .pakse-page .city-postcard-hero__layout {
      grid-template-columns: clamp(43rem, calc(132vw - 45rem), 58rem) minmax(17rem, 18.25rem);
      gap: clamp(.8rem, 1.35vw, 1.25rem);
    }

    #main-content .pakse-page .city-postcard-shell {
      width: 100%;
    }

    #main-content .pakse-page .city-postcard__media {
      transform: translate(3.15rem, 1.85rem);
    }

    #main-content .pakse-page .city-postcard__message {
      --envelope-line-gap: 3.42rem;
    }

    #main-content .pakse-page .city-postcard h1 {
      top: calc(46.5% + .62rem);
      left: calc(var(--pakse-envelope-rule-start) + 1.25rem);
      font-size: 3.58rem;
    }

    #main-content .pakse-page .city-postcard__description {
      top: calc(46.5% + .62rem + var(--envelope-line-gap));
      left: calc(var(--pakse-envelope-rule-start) + 1.25rem);
      width: calc(94% - var(--pakse-envelope-rule-start));
      font-size: 1.11rem;
    }

    #main-content .pakse-page .city-postcard__photo img {
      height: 19.15rem;
    }

    #main-content .pakse-page .city-postcard__facts {
      gap: .72rem 1.3rem;
      font-size: 1.18rem;
    }

    #main-content .pakse-page .city-postcard__facts svg {
      width: 1.36rem;
      height: 1.36rem;
    }

    #main-content .pakse-page .city-postcard-hero__aside {
      width: 18.25rem;
      align-items: center;
      transform: none;
    }

    #main-content .pakse-page .city-postcard-hero__drawing {
      width: 18rem;
      margin: 0 auto;
    }

    #main-content .pakse-page .city-postcard-hero__drawing figcaption {
      font-size: .59rem;
    }

    #main-content .pakse-page .city-postcard-hero__partner {
      align-self: center;
      width: 18rem;
      margin-top: .62rem;
      padding: 9px 11px;
      gap: 6px;
    }

    #main-content .pakse-page .city-postcard-hero__partner span {
      font-size: .4rem;
      letter-spacing: .13em;
    }

    #main-content .pakse-page .city-postcard-hero__partner strong {
      font-size: .66rem;
    }

    #main-content .pakse-page .city-postcard-hero__partner b {
      font-size: .92rem;
    }
  }

  @media (max-width: 980px) and (min-width: 761px) {
    #main-content .pakse-page .city-postcard-shell {
      width: 100%;
    }

    #main-content .pakse-page .city-postcard__media {
      transform: translate(2.25rem, 1.3rem);
    }

    #main-content .pakse-page .city-postcard__message {
      --envelope-line-gap: 3.28rem;
    }

    #main-content .pakse-page .city-postcard h1 {
      top: calc(46.5% + .52rem);
      left: calc(var(--pakse-envelope-rule-start) + .82rem);
      font-size: 3.42rem;
    }

    #main-content .pakse-page .city-postcard__description {
      top: calc(46.5% + .52rem + var(--envelope-line-gap));
      left: calc(var(--pakse-envelope-rule-start) + .82rem);
      width: calc(94.5% - var(--pakse-envelope-rule-start));
      font-size: 1.08rem;
    }

    #main-content .pakse-page .city-postcard__photo img {
      height: 16.2rem;
    }

    #main-content .pakse-page .city-postcard__facts {
      font-size: 1rem;
    }

    #main-content .pakse-page .city-postcard-hero__aside {
      width: 18.5rem;
    }

    #main-content .pakse-page .city-postcard-hero__drawing {
      width: 18rem;
    }

    #main-content .pakse-page .city-postcard-hero__partner {
      width: 18rem;
      padding: 9px 11px;
    }
  }

  @media (max-width: 700px) {
    .city-postcard__media > .editorial-guide__trigger {
      bottom: auto;
      left: auto;
      width: min(17.75rem, calc(100% - .75rem));
      margin-top: calc(.72rem + 25px);
      padding: .48rem .6rem .44rem;
    }

    .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-eyebrow {
      bottom: calc(100% + .32rem);
      font-size: .66rem;
    }

    .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-title {
      font-size: 1.14rem;
    }

    #main-content .pakse-page .city-postcard-hero__drawing {
      width: min(16.5rem, 88vw);
    }

    #main-content .pakse-page .city-postcard-hero__partner {
      width: min(17rem, calc(100% - 1rem));
      padding: 9px 11px;
    }
  }
</style>
