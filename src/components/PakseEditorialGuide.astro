---
import EditorialGuide from './EditorialGuide.astro';
import { pakseEditorialGuide } from '../data/pakseEditorialGuide';
---

<EditorialGuide guide={pakseEditorialGuide} mountSelector=".city-postcard__media" />

<style is:global>
  .city-postcard__media > .editorial-guide__trigger {
    position: relative;
    inset: auto;
    display: grid;
    flex: 0 0 auto;
    width: min(18.5rem, calc(100% - 1.8rem));
    margin: calc(1.02rem + 25px) 0 0 .08rem;
    padding: .5rem .62rem .46rem;
    border-color: rgba(49, 85, 69, .18);
    background: rgba(247, 242, 230, .78);
    box-shadow: 3px 4px 0 rgba(49, 85, 69, .055);
    transform: rotate(-.65deg);
  }

  .city-postcard__media > .editorial-guide__trigger:hover,
  .city-postcard__media > .editorial-guide__trigger:focus-visible {
    background: rgba(251, 247, 237, .96);
    box-shadow: 4px 5px 0 rgba(49, 85, 69, .075);
    transform: translateY(-1px) rotate(-.2deg);
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-tape {
    top: -.38rem;
    left: 1rem;
    width: 2.8rem;
    height: .72rem;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-eyebrow {
    position: absolute;
    left: .08rem;
    bottom: calc(100% + .38rem);
    margin: 0;
    color: #667068;
    font-size: .72rem;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-title {
    font-size: 1.18rem;
    line-height: 1.02;
  }

  .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-arrow {
    align-self: center;
    margin-left: .4rem;
    font-size: 1.28rem;
  }

  @media (max-width: 700px) {
    .city-postcard__media > .editorial-guide__trigger {
      bottom: auto;
      left: auto;
      width: min(17rem, calc(100% - 1rem));
      margin-top: calc(.72rem + 25px);
      padding: .46rem .55rem .42rem;
    }

    .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-eyebrow {
      bottom: calc(100% + .32rem);
      font-size: .66rem;
    }

    .city-postcard__media > .editorial-guide__trigger .editorial-guide__trigger-title {
      font-size: 1.08rem;
    }
  }
</style>
