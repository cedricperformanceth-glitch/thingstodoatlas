---
import LandmarkModal from './LandmarkModal.astro';
import LandmarkGuideModal from './LandmarkGuideModal.astro';
import type { LaosLandmark } from '../data/laosLandmarks';
import { laosLandmarkGuides } from '../data/laosLandmarkGuides';

interface Props {
  landmarks?: LaosLandmark[];
}

const { landmarks = [] } = Astro.props;
const bolavenPartner = {
  name: 'Visit Tad Lo',
  domain: 'visit-tadlo.com',
  url: 'https://visit-tadlo.com'
};
---

{landmarks.map((landmark) => {
  const guide = laosLandmarkGuides[landmark.slug];
  const guideModalId = `${landmark.slug}-visit-guide`;
  const partner = landmark.slug === 'bolaven-plateau' ? bolavenPartner : null;

  return (
    <>
      <LandmarkModal
        id={landmark.modalId}
        name={landmark.name}
        country={landmark.country}
        fieldCardNumber={landmark.fieldCardNumber}
        region={landmark.region}
        description={landmark.description}
        mapsUrl={landmark.mapsUrl}
        gallery={landmark.gallery}
        facts={landmark.facts}
      />

      {partner && (
        <span
          hidden
          data-landmark-partner-config
          data-parent-landmark-modal={landmark.modalId}
          data-partner-name={partner.name}
          data-partner-domain={partner.domain}
          data-partner-url={partner.url}
        ></span>
      )}

      {guide && (
        <>
          <span
            hidden
            data-landmark-guide-config
            data-parent-landmark-modal={landmark.modalId}
            data-landmark-guide-modal={guideModalId}
          ></span>
          <LandmarkGuideModal
            id={guideModalId}
            parentModalId={landmark.modalId}
            name={landmark.name}
            region={landmark.region}
            guide={guide}
            image={landmark.gallery[0]}
          />
        </>
      )}
    </>
  );
})}

<style is:global>
  .landmark-partner-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0 .8rem;
    padding: .8rem .9rem;
    border: 1px solid rgba(49, 85, 69, .28);
    background: rgba(49, 85, 69, .065);
    color: #315545;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .landmark-partner-note:hover,
  .landmark-partner-note:focus-visible {
    border-color: rgba(49, 85, 69, .5);
    background: rgba(49, 85, 69, .12);
    box-shadow: 2px 3px 0 rgba(49, 85, 69, .1);
    transform: translateY(-1px);
    outline: none;
  }
  .landmark-partner-note span { display: grid; gap: .22rem; }
  .landmark-partner-note small { color: #b76645; font: 700 .46rem/1 'DM Sans', sans-serif; letter-spacing: .15em; }
  .landmark-partner-note strong { font: 600 .76rem/1.2 'DM Sans', sans-serif; }
  .landmark-partner-note b { color: #b76645; font: 600 .72rem/1 Fraunces, serif; }
  .city-note__partner {
    display: inline-block;
    margin: 2px 0 7px;
    padding: 4px 7px;
    border: 1px solid rgba(31, 63, 86, .5);
    color: #1f3f56;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }
  @media (max-width: 650px) { .landmark-partner-note { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .landmark-partner-note { transition: none; } }
</style>

<script>
  let landmarkScrollY = 0;

  const hasOpenLandmarkDialog = () => Boolean(
    document.querySelector('.landmark-modal[open], [data-landmark-guide-dialog][open]')
  );

  const lockLandmarkPage = () => {
    const root = document.documentElement;
    if (root.dataset.landmarkScrollLocked === 'true') return;

    landmarkScrollY = window.scrollY;
    root.dataset.landmarkScrollLocked = 'true';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${landmarkScrollY}px`;
    document.body.style.right = '0';
    document.body.style.left = '0';
    document.body.style.width = '100%';
  };

  const unlockLandmarkPage = () => {
    const root = document.documentElement;
    if (root.dataset.landmarkScrollLocked !== 'true') return;

    delete root.dataset.landmarkScrollLocked;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.right = '';
    document.body.style.left = '';
    document.body.style.width = '';
    window.scrollTo({ top: landmarkScrollY, left: 0, behavior: 'auto' });
  };

  const scheduleLandmarkPageUnlock = () => {
    requestAnimationFrame(() => {
      if (!hasOpenLandmarkDialog()) unlockLandmarkPage();
    });
  };

  const bindLandmarkModals = () => {
    const openLandmark = (trigger: HTMLElement) => {
      const id = trigger.dataset.openLandmark;
      const dialog = id ? document.getElementById(id) : null;
      if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
      lockLandmarkPage();
      dialog.showModal();
    };

    document.querySelectorAll<HTMLElement>('[data-open-landmark]').forEach((trigger) => {
      if (trigger.dataset.landmarkTriggerBound === 'true') return;
      trigger.dataset.landmarkTriggerBound = 'true';
      trigger.addEventListener('click', () => openLandmark(trigger));
      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLandmark(trigger);
        }
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.landmark-modal').forEach((dialog) => {
      if (dialog.dataset.landmarkDialogBound === 'true') return;
      dialog.dataset.landmarkDialogBound = 'true';
      dialog.querySelector<HTMLElement>('[data-close-landmark]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', scheduleLandmarkPageUnlock);
    });
  };

  const bindTadLoMapPartner = () => {
    const body = document.querySelector<HTMLElement>('.city-note--tadlo .city-note__body');
    if (!body || body.querySelector('.city-note__partner')) return;
    const label = document.createElement('span');
    label.className = 'city-note__partner';
    label.textContent = 'In partnership with visit-tadlo.com';
    const closing = body.querySelector('small');
    body.insertBefore(label, closing || null);
  };

  const bindLandmarkPartners = () => {
    document.querySelectorAll<HTMLElement>('[data-landmark-partner-config]').forEach((config) => {
      if (config.dataset.partnerConfigBound === 'true') return;
      config.dataset.partnerConfigBound = 'true';
      const parentId = config.dataset.parentLandmarkModal;
      const partnerUrl = config.dataset.partnerUrl;
      const partnerName = config.dataset.partnerName || 'local partner';
      const dialog = parentId ? document.getElementById(parentId) : null;
      if (!(dialog instanceof HTMLDialogElement) || !partnerUrl) return;
      const actions = dialog.querySelector<HTMLElement>('.landmark-modal__actions');
      const visual = dialog.querySelector<HTMLElement>('.landmark-modal__visual');
      if (!actions || !visual || visual.querySelector('[data-landmark-partner-note]')) return;

      const note = document.createElement('a');
      note.className = 'landmark-partner-note';
      note.dataset.landmarkPartnerNote = '';
      note.href = partnerUrl;
      note.target = '_blank';
      note.rel = 'noreferrer';
      note.setAttribute('aria-label', `Visit the ${partnerName} website`);
      note.innerHTML = `<span><small>LOCAL PARTNER</small><strong>In partnership with ${partnerName}</strong></span><b>${config.dataset.partnerDomain} ↗</b>`;
      visual.insertBefore(note, actions);
    });
  };

  const bindLandmarkGuideButtons = () => {
    document.querySelectorAll<HTMLElement>('[data-landmark-guide-config]').forEach((config) => {
      if (config.dataset.guideConfigBound === 'true') return;
      config.dataset.guideConfigBound = 'true';
      const parentId = config.dataset.parentLandmarkModal;
      const guideId = config.dataset.landmarkGuideModal;
      const parentDialog = parentId ? document.getElementById(parentId) : null;
      const guideDialog = guideId ? document.getElementById(guideId) : null;
      if (!(parentDialog instanceof HTMLDialogElement) || !(guideDialog instanceof HTMLDialogElement)) return;
      const actions = parentDialog.querySelector<HTMLElement>('.landmark-modal__actions');
      if (!actions || actions.querySelector('[data-open-landmark-guide]')) return;
      const button = document.createElement('button');
      button.className = 'landmark-action landmark-action--guide';
      button.type = 'button';
      button.dataset.openLandmarkGuide = guideId;
      button.setAttribute('aria-controls', guideId);
      button.innerHTML = '<span aria-hidden="true">✎</span> Plan the visit';
      const saveButton = actions.querySelector('[data-add-landmark]');
      actions.insertBefore(button, saveButton);
      actions.classList.add('has-guide-action');
      button.addEventListener('click', () => {
        lockLandmarkPage();
        if (parentDialog.open) parentDialog.close();
        if (!guideDialog.open) guideDialog.showModal();
      });
    });
  };

  const bindLandmarkGuideDialogs = () => {
    document.querySelectorAll<HTMLDialogElement>('[data-landmark-guide-dialog]').forEach((dialog) => {
      if (dialog.dataset.landmarkGuideBound === 'true') return;
      dialog.dataset.landmarkGuideBound = 'true';
      dialog.querySelector<HTMLElement>('[data-close-landmark-guide]')?.addEventListener('click', () => dialog.close());
      dialog.querySelector<HTMLElement>('[data-back-to-landmark]')?.addEventListener('click', () => {
        const parentId = dialog.dataset.parentLandmarkModal;
        const parentDialog = parentId ? document.getElementById(parentId) : null;
        lockLandmarkPage();
        dialog.close();
        if (parentDialog instanceof HTMLDialogElement && !parentDialog.open) parentDialog.showModal();
      });
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', scheduleLandmarkPageUnlock);
    });
  };

  const setupLandmarkExperience = () => {
    bindLandmarkModals();
    bindTadLoMapPartner();
    bindLandmarkPartners();
    bindLandmarkGuideButtons();
    bindLandmarkGuideDialogs();
  };

  setupLandmarkExperience();
  document.addEventListener('astro:page-load', setupLandmarkExperience);
</script>