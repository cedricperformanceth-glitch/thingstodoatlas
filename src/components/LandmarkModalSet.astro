---
import LaosLandmarkPreviewModalV2 from './LaosLandmarkPreviewModalV2.astro';
import type { LaosLandmark } from '../data/laosLandmarks';
import { getLicensedLandmarkGallery } from '../data/laosLandmarkLicensedMedia';
import { laosLandmarkPageByModalId } from '../data/laosLandmarkPageRegistry';

interface Props {
  landmarks?: LaosLandmark[];
}

const { landmarks = [] } = Astro.props;
---

{landmarks.map((landmark) => {
  const gallery = getLicensedLandmarkGallery(landmark.slug, landmark.gallery);
  const entry = laosLandmarkPageByModalId[landmark.modalId];

  return (
    <LaosLandmarkPreviewModalV2
      id={landmark.modalId}
      slug={landmark.slug}
      name={landmark.name}
      region={landmark.region}
      description={landmark.description}
      mapsUrl={landmark.mapsUrl}
      guideUrl={entry?.route}
      gallery={gallery}
      facts={landmark.facts}
      duration={entry?.landmark.cityContext.duration}
    />
  );
})}

<style is:global>
  .city-note__partner {
    display: inline-block;
    margin: 2px 0 7px;
    padding: 4px 7px;
    border: 1px solid rgba(31, 63, 86, .5);
    color: #1f3f56;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }
</style>

<script>
  let landmarkScrollY = 0;
  const RETURN_KEY = 'atlas:landmark-return';

  const hasOpenLandmarkDialog = () => Boolean(
    document.querySelector('.landmark-preview-v2[open], [data-landmark-guide-dialog][open]')
  );

  const currentScroll = () => {
    const fixedTop = Number.parseFloat(document.body.style.top || '');
    return Number.isFinite(fixedTop) && fixedTop < 0 ? Math.abs(fixedTop) : window.scrollY;
  };

  const activeCategory = () => (
    document.querySelector<HTMLElement>('[data-city-category-button][aria-selected="true"]')?.dataset.cityCategoryButton || undefined
  );

  const lockLandmarkPage = () => {
    const root = document.documentElement;
    if (root.dataset.landmarkScrollLocked === 'true') return;
    landmarkScrollY = window.scrollY;
    root.dataset.landmarkScrollLocked = 'true';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${landmarkScrollY}px`;
    document.body.style.right = '0';
    document.body.style.left = '0';
    document.body.style.width = '100%';
  };

  const unlockLandmarkPage = () => {
    const root = document.documentElement;
    if (root.dataset.landmarkScrollLocked !== 'true') return;
    delete root.dataset.landmarkScrollLocked;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.right = '';
    document.body.style.left = '';
    document.body.style.width = '';
    window.scrollTo({ top: landmarkScrollY, left: 0, behavior: 'auto' });
  };

  const scheduleLandmarkPageUnlock = () => {
    requestAnimationFrame(() => {
      if (!hasOpenLandmarkDialog()) unlockLandmarkPage();
    });
  };

  const sourceFor = (trigger: HTMLElement) => (
    trigger.closest<HTMLElement>('.explore-board-card, .city-landmark-card, .place-card, article') || trigger
  );

  const rememberReturn = (dialog: HTMLDialogElement) => {
    const sourceId = dialog.dataset.landmarkPageSourceId || '';
    const slug = dialog.dataset.landmarkSlug || '';
    if (!sourceId || !slug) return;

    const state = {
      slug,
      sourcePath: `${location.pathname}${location.search}${location.hash}`,
      sourceId,
      categorySlug: activeCategory(),
      scrollY: currentScroll()
    };

    sessionStorage.setItem(RETURN_KEY, JSON.stringify(state));
    if (slug === 'wat-phou') sessionStorage.setItem('atlas:wat-phou-return', JSON.stringify(state));
  };

  const bindLandmarkModals = () => {
    document.querySelectorAll<HTMLElement>('[data-open-landmark]').forEach((trigger, index) => {
      if (trigger.dataset.landmarkTriggerBound === 'true') return;
      trigger.dataset.landmarkTriggerBound = 'true';

      const openLandmark = () => {
        const id = trigger.dataset.openLandmark;
        const dialog = id ? document.getElementById(id) : null;
        if (!(dialog instanceof HTMLDialogElement) || !dialog.classList.contains('landmark-preview-v2') || dialog.open) return;

        const source = sourceFor(trigger);
        if (!source.id) {
          const slug = dialog.dataset.landmarkSlug || 'landmark';
          source.id = `landmark-source-${slug}-${index + 1}`;
        }
        dialog.dataset.landmarkPageSourceId = source.id;
        lockLandmarkPage();
        dialog.showModal();
      };

      trigger.addEventListener('click', openLandmark);
      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLandmark();
        }
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.landmark-preview-v2').forEach((dialog) => {
      if (dialog.dataset.landmarkDialogBound === 'true') return;
      dialog.dataset.landmarkDialogBound = 'true';
      dialog.querySelector<HTMLElement>('[data-close-landmark]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', scheduleLandmarkPageUnlock);
      dialog.querySelector<HTMLAnchorElement>('[data-landmark-page-link]')?.addEventListener('click', () => {
        rememberReturn(dialog);
        if (dialog.open) dialog.close();
      });
    });
  };

  const bindTadLoMapPartner = () => {
    const body = document.querySelector<HTMLElement>('.city-note--tadlo .city-note__body');
    if (!body || body.querySelector('.city-note__partner')) return;
    const label = document.createElement('span');
    label.className = 'city-note__partner';
    label.textContent = 'In partnership with visit-tadlo.com';
    const closing = body.querySelector('small');
    body.insertBefore(label, closing || null);
  };

  const setupLandmarkExperience = () => {
    bindLandmarkModals();
    bindTadLoMapPartner();
  };

  setupLandmarkExperience();
  document.addEventListener('astro:page-load', setupLandmarkExperience);
</script>