---
type MapAddressPlace = {
  slug: string;
  name: string;
  category: string;
  subcategory: string;
  image: string;
  imageAlt: string;
  imageSourceLabel?: string;
  shortDescription: string;
  mapsUrl: string;
  address: string;
  statusNote: string;
};

interface Props {
  place: MapAddressPlace;
  cityName: string;
  index?: number;
}

const { place, cityName, index = 0 } = Astro.props;
const cardNumber = String(index + 1).padStart(2, '0');
const tripPlace = JSON.stringify({
  id: place.slug,
  name: place.name,
  city: cityName,
  group: place.category,
  category: place.subcategory,
  address: place.address,
  url: place.mapsUrl
});
---

<article class="map-address-card" id={place.slug}>
  <div class="map-address-card__image">
    <img src={place.image} alt={place.imageAlt} width="720" height="520" loading="lazy" decoding="async" />
    <span class="map-address-card__number" aria-hidden="true">{cardNumber}</span>
    <span class="map-address-card__source">{place.imageSourceLabel || 'MAP ADDRESS'}</span>
  </div>

  <div class="map-address-card__copy">
    <p>{place.subcategory}</p>
    <h3>{place.name}</h3>
    <span>{place.shortDescription}</span>
    <small>{place.statusNote}</small>

    <div class="map-address-card__actions">
      <a href={place.mapsUrl} target="_blank" rel="noreferrer">Open Google Maps <span aria-hidden="true">↗</span></a>
      <button type="button" data-trip-add data-trip-id={place.slug} data-trip-place={tripPlace} aria-pressed="false">Add to My Trip</button>
    </div>
  </div>
</article>

<style>
  .map-address-card{min-width:0;overflow:hidden;border:1px solid rgba(75,81,70,.22);background:#eee8dc;box-shadow:5px 7px 0 rgba(49,85,69,.07)}
  .map-address-card__image{position:relative;height:215px;overflow:hidden;background:var(--paper-deep)}
  .map-address-card__image::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(24,31,26,.48));pointer-events:none}
  .map-address-card__image img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.76) contrast(.96)}
  .map-address-card__number{position:absolute;z-index:2;top:14px;left:14px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(255,253,248,.8);border-radius:50%;background:rgba(32,60,49,.82);color:#fffdf8;font:500 .95rem/1 Fraunces,serif}
  .map-address-card__source{position:absolute;z-index:2;right:13px;bottom:12px;max-width:calc(100% - 26px);padding:6px 8px;border:1px solid rgba(255,253,248,.72);background:rgba(32,60,49,.74);color:#fffdf8;font:700 .48rem/1 'DM Sans',sans-serif;letter-spacing:.12em;text-align:right}
  .map-address-card__copy{display:flex;min-height:250px;flex-direction:column;padding:24px 23px 22px}
  .map-address-card__copy>p{margin:0 0 10px;color:var(--terracotta);font-size:.57rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .map-address-card__copy h3{margin:0 0 11px;color:var(--green);font:500 clamp(1.55rem,2.2vw,2.05rem)/1.06 Fraunces,serif}
  .map-address-card__copy>span{color:var(--muted);font-size:.79rem;line-height:1.55}
  .map-address-card__copy small{display:block;margin-top:16px;color:var(--terracotta);font-size:.54rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .map-address-card__actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:20px}
  .map-address-card__actions a,.map-address-card__actions button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:10px 13px;border:0;font:700 .6rem/1 'DM Sans',sans-serif;cursor:pointer}
  .map-address-card__actions a{border:1px solid var(--green);color:var(--green)}
  .map-address-card__actions button{background:var(--terracotta);color:var(--white)}
  .map-address-card__actions button:disabled{background:#b8afa0;cursor:default}
  @media(max-width:700px){.map-address-card__image{height:220px}.map-address-card__copy{min-height:0}.map-address-card__actions>*{flex:1 1 145px}}
</style>
