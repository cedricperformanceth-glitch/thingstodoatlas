---
const {
  country,
  countrySlug,
  city,
  citySlug,
  chapter,
  description,
  fieldNote,
  image = '/images/placeholder-travel.webp',
  imageAlt = `${city}, ${country}`,
} = Astro.props;

const categories = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', text: 'Local favourites, street-side tables and reliable places worth saving.', icon: 'restaurants' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · PAUSE · SHADE', text: 'Quiet corners, good coffee and easy places to slow down for an hour.', icon: 'cafes' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · SIMPLE · CENTRAL', text: 'Comfortable stays, local guesthouses and practical bases around town.', icon: 'guesthouses' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · HELMET · ROAD', text: 'Trusted rentals, useful checks and the right bike for the roads ahead.', icon: 'scooter' },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', text: 'Experiences, local landmarks and useful ideas for your stay.', icon: 'things' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · SWEAT', text: 'Gyms, training spaces and practical places to keep moving.', icon: 'gyms' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', text: 'Fresh markets, useful shops and small things worth bringing home.', icon: 'markets' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'HEALTH · MONEY · BASICS', text: 'Hospitals, pharmacies, ATMs, SIM cards and useful contacts.', icon: 'essential' },
];
---

<main class="pakse-page">
  <section class="pakse-hero" aria-labelledby="city-title">
    <div class="pakse-hero__copy">
      <p class="pakse-hero__eyebrow">{country.toUpperCase()} · CHAPTER {chapter}</p>
      <h1 id="city-title">{city}</h1>
      <p class="pakse-hero__lede">{description}</p>
      <span class="pakse-hero__field-note">FIELD NOTE — {fieldNote}</span>
    </div>

    <figure class="pakse-hero__visual">
      <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
      <img src={image} alt={imageAlt} width="1600" height="1100" fetchpriority="high" />
      <figcaption>{city} · first notes from the road</figcaption>
      <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
    </figure>
  </section>

  <section class="pakse-categories" aria-labelledby="city-categories-title">
    <div class="pakse-categories__heading">
      <p>{city.toUpperCase()} DIRECTORY</p>
      <h2 id="city-categories-title">Open the notebook</h2>
    </div>

    <div class="category-grid">
      {categories.map((category, index) => (
        <a
          class={`category-note category-note--${index % 4}`}
          href={`/${countrySlug}/${citySlug}/${category.slug}`}
          aria-label={`Explore ${category.title} in ${city}`}
        >
          <span class="category-note__tape" aria-hidden="true"></span>
          <span class="category-note__illustration" aria-hidden="true">
            {category.icon === 'restaurants' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M25 55c4 29 20 44 50 44s46-15 50-44" stroke-width="3.2"/><path d="M21 52c8-10 24-14 54-14s46 4 54 14c-8 10-24 14-54 14S29 62 21 52Z" stroke-width="3.2"/><path d="M36 55c10-6 20-7 39-7s31 2 42 8M42 60c8-10 16-9 25 0 8-10 16-10 25 0 7-8 15-8 22-1" stroke-width="2"/><path d="M93 42 130 9M101 46l37-28" stroke-width="4"/></g></svg>}
            {category.icon === 'cafes' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M35 43h68v35c0 14-11 25-25 25H60c-14 0-25-11-25-25Z" stroke-width="3"/><path d="M103 51h12c11 0 18 7 18 16s-7 16-18 16h-12" stroke-width="3"/><path d="M31 43h77M43 107h72" stroke-width="2"/><path d="M57 32c-7-9 4-14-1-23M76 32c-8-10 5-15 0-25M94 32c-6-8 4-13 1-21" stroke-width="2.3"/></g></svg>}
            {category.icon === 'guesthouses' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M25 55 80 16l55 39" stroke-width="3.2"/><path d="M34 49v58h92V49" stroke-width="3"/><path d="M66 107V72h28v35M46 62h15v17H46zM100 62h15v17h-15z" stroke-width="2.4"/></g></svg>}
            {category.icon === 'scooter' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="43" cy="87" r="18" stroke-width="3"/><circle cx="118" cy="87" r="18" stroke-width="3"/><path d="M43 87h34l17-31h20l11 31M77 87 63 43H49l-6 13M91 56l13 31" stroke-width="3"/><path d="M107 43h15" stroke-width="3"/></g></svg>}
            {category.icon === 'things' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m22 28 34-10 47 12 35-10v73l-35 10-47-12-34 10Z" stroke-width="3"/><path d="M56 18v73M103 30v73" stroke-width="2"/><path d="M37 78c12-31 28-9 42-29 12-17 22 4 38-10" stroke-width="2.6" stroke-dasharray="5 5"/><circle cx="37" cy="78" r="4" stroke-width="2"/><circle cx="117" cy="39" r="4" stroke-width="2"/></g></svg>}
            {category.icon === 'gyms' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M28 45v31M39 37v47M51 32v57M109 32v57M121 37v47M132 45v31" stroke-width="4"/><path d="M51 60h58" stroke-width="5"/><path d="M19 60h9M132 60h9" stroke-width="3"/></g></svg>}
            {category.icon === 'markets' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M34 48h92l-12 58H46Z" stroke-width="3"/><path d="M55 49c2-22 12-34 25-34s23 12 25 34" stroke-width="3"/><path d="M49 63h66M46 78h72M43 93h73" stroke-width="1.8"/></g></svg>}
            {category.icon === 'essential' && <svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M25 46c0-9 7-16 16-16h71c9 0 16 7 16 16v50c0 9-7 16-16 16H41c-9 0-16-7-16-16Z" stroke-width="3"/><path d="M51 30c2-12 10-18 25-18s23 6 25 18" stroke-width="3"/><path d="M55 70h17V57h15v13h17v15H87v14H72V85H55Z" stroke-width="2.8"/></g></svg>}
          </span>

          <span class="category-note__copy">
            <span class="category-note__kicker">{category.kicker}</span>
            <span class="category-note__title">{category.title}</span>
            <span class="category-note__text">{category.text}</span>
            <span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span>
          </span>
          <span class="category-note__corner" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </section>
</main>

<style>
  .pakse-page { min-height: 100vh; background: #f2eee3; color: #1f2924; }
  .pakse-hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(390px, 1.08fr); gap: clamp(44px, 7vw, 100px); align-items: center; width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: clamp(90px, 11vw, 150px) 0 clamp(76px, 9vw, 118px); }
  .pakse-hero__eyebrow, .pakse-categories__heading p { margin: 0 0 16px; color: #d97745; font: 700 .68rem/1.2 'DM Sans', sans-serif; letter-spacing: .16em; }
  .pakse-hero h1 { margin: 0; color: #1f392d; font-size: clamp(4.2rem, 8vw, 8.3rem); line-height: .85; letter-spacing: -.055em; }
  .pakse-hero__lede { max-width: 620px; margin: 34px 0 20px; color: rgba(31,41,36,.76); font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.75; }
  .pakse-hero__field-note { color: #315545; font-family: 'Caveat', cursive; font-size: 1.25rem; }
  .pakse-hero__visual { position: relative; margin: 0; padding: 16px 16px 46px; background: #fff; box-shadow: 0 18px 45px rgba(31,41,36,.13); transform: rotate(1.2deg); }
  .pakse-hero__visual img { display: block; width: 100%; aspect-ratio: 1.4545; object-fit: cover; background: #ddd7c8; }
  .pakse-hero__visual figcaption { position: absolute; left: 22px; bottom: 15px; color: rgba(31,41,36,.68); font-family: 'Caveat', cursive; font-size: 1.08rem; }
  .pakse-hero__tape { position: absolute; z-index: 2; width: 108px; height: 26px; background: rgba(213,198,162,.68); }
  .pakse-hero__tape--top { top: -11px; left: 14%; transform: rotate(-6deg); }
  .pakse-hero__tape--bottom { right: 12%; bottom: -9px; transform: rotate(4deg); }
  .pakse-categories { width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: 0 0 140px; }
  .pakse-categories__heading { margin-bottom: 44px; }
  .pakse-categories__heading h2 { margin: 0; color: #1f392d; font-size: clamp(2.8rem, 5vw, 5rem); line-height: .95; }
  .category-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 26px; }
  .category-note { position: relative; display: grid; grid-template-columns: 142px 1fr; gap: 24px; min-height: 260px; padding: 34px; overflow: hidden; background: #f7f2e6; color: inherit; text-decoration: none; box-shadow: 0 13px 30px rgba(31,41,36,.08); transition: transform 180ms ease, box-shadow 180ms ease; }
  .category-note:hover { transform: translateY(-4px) rotate(-.25deg); box-shadow: 0 18px 38px rgba(31,41,36,.13); }
  .category-note__illustration { display: grid; place-items: center; color: #315545; }
  .category-note__illustration svg { width: 100%; height: auto; }
  .category-note__copy { display: flex; flex-direction: column; align-items: flex-start; }
  .category-note__kicker { margin-bottom: 10px; color: #d97745; font: 700 .62rem/1.2 'DM Sans', sans-serif; letter-spacing: .14em; }
  .category-note__title { color: #1f392d; font-family: Georgia, serif; font-size: clamp(1.6rem, 2.4vw, 2.25rem); font-weight: 700; }
  .category-note__text { max-width: 430px; margin-top: 14px; color: rgba(31,41,36,.72); font-size: .92rem; line-height: 1.6; }
  .category-note__meta { margin-top: auto; padding-top: 22px; color: #315545; font-weight: 700; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .category-note__tape { position: absolute; top: -8px; left: 44%; width: 90px; height: 22px; background: rgba(202,186,151,.46); transform: rotate(-2deg); }
  .category-note__corner { position: absolute; right: 0; bottom: 0; width: 32px; height: 32px; background: linear-gradient(135deg, transparent 49%, rgba(49,85,69,.1) 50%); }
  @media (max-width: 820px) { .pakse-hero { grid-template-columns: 1fr; } .category-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .pakse-hero, .pakse-categories { width: min(100% - 28px, 1180px); } .category-note { grid-template-columns: 92px 1fr; padding: 26px 22px; gap: 14px; } }
</style>