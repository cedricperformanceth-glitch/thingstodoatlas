---
const {
  country,
  countrySlug,
  city,
  citySlug,
  chapter,
  description,
  fieldNote,
  image = '/images/placeholder-travel.webp',
  imageAlt = `${city}, ${country}`,
} = Astro.props;

const categories = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', text: 'Local favourites, street-side tables and reliable places worth saving.' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · PAUSE · SHADE', text: 'Quiet corners, good coffee and easy places to slow down for an hour.' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · SIMPLE · CENTRAL', text: 'Comfortable stays, local guesthouses and practical bases around town.' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · HELMET · ROAD', text: 'Trusted rentals, useful checks and practical transport notes.' },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', text: 'Experiences, local landmarks and useful ideas for your stay.' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · SWEAT', text: 'Gyms, training spaces and practical places to keep moving.' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', text: 'Fresh markets, useful shops and small things worth bringing home.' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'HEALTH · MONEY · BASICS', text: 'Hospitals, pharmacies, ATMs, SIM cards and useful contacts.' },
];
---

<main class="city-page">
  <section class="city-hero" aria-labelledby="city-title">
    <div class="city-hero__copy">
      <p class="city-hero__eyebrow">{country.toUpperCase()} · CHAPTER {chapter}</p>
      <h1 id="city-title">{city}</h1>
      <p class="city-hero__lede">{description}</p>
      <span class="city-hero__field-note">FIELD NOTE — {fieldNote}</span>
    </div>

    <figure class="city-hero__visual">
      <span class="city-hero__tape city-hero__tape--top" aria-hidden="true"></span>
      <img src={image} alt={imageAlt} width="1600" height="1100" fetchpriority="high" />
      <figcaption>{city} · first notes from the road</figcaption>
      <span class="city-hero__tape city-hero__tape--bottom" aria-hidden="true"></span>
    </figure>
  </section>

  <section class="city-categories" aria-labelledby="city-categories-title">
    <div class="city-categories__heading">
      <p>{city.toUpperCase()} DIRECTORY</p>
      <h2 id="city-categories-title">Open the notebook</h2>
    </div>

    <div class="category-grid">
      {categories.map((category, index) => (
        <a class={`category-note category-note--${index % 4}`} href={`/${countrySlug}/${citySlug}/${category.slug}`} aria-label={`Explore ${category.title} in ${city}`}>
          <span class="category-note__tape" aria-hidden="true"></span>
          <span class="category-note__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="category-note__copy">
            <span class="category-note__kicker">{category.kicker}</span>
            <span class="category-note__title">{category.title}</span>
            <span class="category-note__text">{category.text}</span>
            <span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span>
          </span>
          <span class="category-note__corner" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </section>
</main>

<style>
  .city-page { min-height: 100vh; background: #f2eee3; color: #1f2924; }
  .city-hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(380px, 1.1fr); gap: clamp(44px, 7vw, 110px); align-items: center; width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: clamp(90px, 11vw, 150px) 0 clamp(76px, 9vw, 118px); }
  .city-hero__eyebrow, .city-categories__heading p { margin: 0 0 16px; color: #d97745; font: 700 .68rem/1.2 'DM Sans', sans-serif; letter-spacing: .16em; }
  .city-hero h1 { margin: 0; color: #1f392d; font-size: clamp(4.2rem, 8vw, 8.3rem); line-height: .85; letter-spacing: -.055em; }
  .city-hero__lede { max-width: 620px; margin: 34px 0 20px; color: rgba(31,41,36,.76); font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.75; }
  .city-hero__field-note { color: #315545; font-family: 'Caveat', cursive; font-size: 1.25rem; }
  .city-hero__visual { position: relative; margin: 0; padding: 16px 16px 46px; background: #fff; box-shadow: 0 18px 45px rgba(31,41,36,.13); transform: rotate(1.2deg); }
  .city-hero__visual img { display: block; width: 100%; aspect-ratio: 1.45; object-fit: cover; background: #ddd7c8; }
  .city-hero__visual figcaption { position: absolute; left: 22px; bottom: 15px; color: rgba(31,41,36,.68); font-family: 'Caveat', cursive; font-size: 1.08rem; }
  .city-hero__tape { position: absolute; z-index: 2; width: 108px; height: 26px; background: rgba(213,198,162,.68); }
  .city-hero__tape--top { top: -11px; left: 14%; transform: rotate(-6deg); }
  .city-hero__tape--bottom { right: 12%; bottom: -9px; transform: rotate(4deg); }
  .city-categories { width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: 0 0 140px; }
  .city-categories__heading { margin-bottom: 44px; }
  .city-categories__heading h2 { margin: 0; color: #1f392d; font-size: clamp(2.8rem, 5vw, 5rem); line-height: .95; }
  .category-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 26px; }
  .category-note { position: relative; display: grid; grid-template-columns: 92px 1fr; gap: 24px; min-height: 235px; padding: 34px; overflow: hidden; background: #f7f2e6; color: inherit; text-decoration: none; box-shadow: 0 13px 30px rgba(31,41,36,.08); transition: transform 180ms ease, box-shadow 180ms ease; }
  .category-note:hover { transform: translateY(-4px) rotate(-.25deg); box-shadow: 0 18px 38px rgba(31,41,36,.13); }
  .category-note__number { color: rgba(49,85,69,.3); font-family: Georgia, serif; font-size: 3.5rem; line-height: 1; }
  .category-note__copy { display: flex; flex-direction: column; align-items: flex-start; }
  .category-note__kicker { margin-bottom: 10px; color: #d97745; font: 700 .62rem/1.2 'DM Sans', sans-serif; letter-spacing: .14em; }
  .category-note__title { color: #1f392d; font-family: Georgia, serif; font-size: clamp(1.6rem, 2.4vw, 2.25rem); font-weight: 700; }
  .category-note__text { max-width: 430px; margin-top: 14px; color: rgba(31,41,36,.72); font-size: .92rem; line-height: 1.6; }
  .category-note__meta { margin-top: auto; padding-top: 22px; color: #315545; font-weight: 700; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .category-note__tape { position: absolute; top: -8px; left: 44%; width: 90px; height: 22px; background: rgba(202,186,151,.46); transform: rotate(-2deg); }
  .category-note__corner { position: absolute; right: 0; bottom: 0; width: 32px; height: 32px; background: linear-gradient(135deg, transparent 49%, rgba(49,85,69,.1) 50%); }
  @media (max-width: 820px) { .city-hero { grid-template-columns: 1fr; } .category-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .city-hero, .city-categories { width: min(100% - 28px, 1180px); } .category-note { grid-template-columns: 58px 1fr; padding: 26px 22px; gap: 14px; } .category-note__number { font-size: 2.7rem; } }
</style>
