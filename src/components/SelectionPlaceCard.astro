---
const { place, index = 0 } = Astro.props;
const cardNumber = String(index + 1).padStart(2, '0');
const dialogId = `selection-place-${place.slug}`;
const titleId = `${dialogId}-title`;
const tripPlace = JSON.stringify({
  id: place.slug,
  name: place.name,
  city: place.city,
  group: place.category,
  category: place.subcategory,
  address: place.address,
  url: `${Astro.url.pathname}#${place.slug}`
});
---

<article class="selection-card" id={place.slug}>
  <span class="selection-card__gold-corner selection-card__gold-corner--top" aria-hidden="true"></span>
  <span class="selection-card__gold-corner selection-card__gold-corner--bottom" aria-hidden="true"></span>
  <div class="selection-card__image">
    <img src={place.image} alt={place.imageAlt} width="720" height="520" loading="lazy" decoding="async" />
    <span class="selection-card__number" aria-hidden="true">{cardNumber}</span>
    <span class="selection-card__badge">{place.selectionLabel}</span>
  </div>
  <div class="selection-card__copy">
    <p>{place.subcategory}</p>
    <h3>{place.name}</h3>
    <span>{place.shortDescription}</span>
    <b>Open my selection <i aria-hidden="true">↗</i></b>
  </div>
  <button class="selection-card__open" type="button" aria-haspopup="dialog" aria-controls={dialogId} data-selection-card-open={dialogId} aria-label={`Open details for ${place.name}`}></button>

  <dialog class="selection-dialog" id={dialogId} aria-labelledby={titleId}>
    <div class="selection-dialog__shell">
      <button class="selection-dialog__close" type="button" data-selection-card-close aria-label={`Close ${place.name}`}>×</button>
      <div class="selection-dialog__visual">
        <img src={place.image} alt={place.imageAlt} width="900" height="1200" loading="lazy" decoding="async" />
        <span class="selection-dialog__number">{cardNumber}</span>
        <div class="selection-dialog__stamp"><small>THINGS TO DO ATLAS</small><strong>{place.selectionLabel}</strong></div>
      </div>
      <div class="selection-dialog__content">
        <p class="eyebrow">{place.subcategory} · {place.city}</p>
        <h2 id={titleId}>{place.name}</h2>
        <p class="selection-dialog__description">{place.description}</p>
        <div class="selection-dialog__recommend"><span>WHY IT IS IN MY SELECTION</span><p>{place.whyWeRecommend}</p></div>
        <ul>{place.highlights.map((highlight: string) => <li>{highlight}</li>)}</ul>
        <div class="selection-dialog__practical">
          <span>Official information checked · {place.lastChecked}</span>
          <dl>
            <div><dt>Location</dt><dd>{place.address}</dd></div>
            <div><dt>Hours</dt><dd>{place.hours}</dd></div>
            <div><dt>Budget</dt><dd>{place.price}</dd></div>
            <div><dt>Best for</dt><dd>{place.bestFor}</dd></div>
          </dl>
        </div>
        <div class="selection-dialog__actions">
          <a class="selection-dialog__official" href={place.officialUrl} target="_blank" rel="noreferrer">Official website <span aria-hidden="true">↗</span></a>
          <a class="selection-dialog__map" href={place.mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
          <button type="button" data-trip-add data-trip-id={place.slug} data-trip-place={tripPlace} aria-pressed="false">Add to My Trip</button>
        </div>
      </div>
    </div>
  </dialog>
</article>

<style>
  .selection-card{--gold:#b38a3d;--gold-soft:#e3cf9d;position:relative;min-width:0;overflow:hidden;border:1px solid var(--gold);background:linear-gradient(145deg,#f8f1df,#eee3c9);box-shadow:0 0 0 4px rgba(179,138,61,.12),7px 9px 0 rgba(125,91,33,.1);transition:transform .22s ease,box-shadow .22s ease}
  .selection-card:hover{transform:translateY(-5px);box-shadow:0 0 0 5px rgba(179,138,61,.16),10px 13px 0 rgba(125,91,33,.12)}
  .selection-card__gold-corner{position:absolute;z-index:4;width:56px;height:56px;pointer-events:none}.selection-card__gold-corner:before,.selection-card__gold-corner:after{content:'';position:absolute;background:var(--gold)}
  .selection-card__gold-corner--top{top:7px;right:7px}.selection-card__gold-corner--bottom{bottom:7px;left:7px;transform:rotate(180deg)}.selection-card__gold-corner:before{top:0;right:0;width:38px;height:1px}.selection-card__gold-corner:after{top:0;right:0;width:1px;height:38px}
  .selection-card__image{position:relative;height:230px;overflow:hidden;background:#d8c69c}.selection-card__image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(43,31,13,.58));pointer-events:none}.selection-card__image img{width:100%;height:100%;object-fit:cover;filter:saturate(.84) contrast(.98)}
  .selection-card__number,.selection-dialog__number{position:absolute;z-index:2;top:14px;left:14px;display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--gold-soft);border-radius:50%;background:rgba(55,40,15,.82);color:#fff8e8;font:500 .95rem/1 Fraunces,serif}
  .selection-card__badge{position:absolute;z-index:2;right:14px;bottom:13px;padding:7px 10px;border:1px solid #e7d19c;background:rgba(63,45,14,.84);color:#fff5dc;font:800 .5rem/1 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;transform:rotate(-1deg)}
  .selection-card__copy{display:flex;min-height:226px;flex-direction:column;padding:25px 24px 23px}.selection-card__copy p{margin:0 0 10px;color:#8d6928;font-size:.57rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.selection-card__copy h3{margin:0 0 11px;color:#3c311b;font:500 clamp(1.65rem,2.3vw,2.15rem)/1.04 Fraunces,serif}.selection-card__copy>span{color:#68604f;font-size:.79rem;line-height:1.58}.selection-card__copy b{width:max-content;margin-top:auto;padding-top:20px;border-bottom:1px solid var(--gold);color:#6f531f;font-size:.6rem;letter-spacing:.09em;text-transform:uppercase}.selection-card__copy i{color:#a77928;font-style:normal}
  .selection-card__open{position:absolute;z-index:3;inset:0;width:100%;border:0;background:transparent;cursor:pointer}.selection-card:has(.selection-card__open:focus-visible){outline:3px solid var(--gold);outline-offset:5px}
  .selection-dialog{--gold:#b38a3d;width:min(1040px,calc(100vw - 42px));max-width:none;max-height:none;margin:auto;padding:0;overflow:hidden;border:1px solid var(--gold);background:#f7f0df;color:var(--ink);box-shadow:0 0 0 5px rgba(179,138,61,.15),0 30px 90px rgba(22,18,10,.45)}.selection-dialog::backdrop{background:rgba(25,22,15,.79);backdrop-filter:blur(3px)}
  .selection-dialog__shell{position:relative;display:grid;grid-template-columns:minmax(310px,.82fr) minmax(0,1.18fr);height:min(740px,88svh)}.selection-dialog__close{position:absolute;z-index:5;top:17px;right:17px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(179,138,61,.5);border-radius:50%;background:rgba(250,244,228,.95);color:#76591f;font:400 1.7rem/1 'DM Sans',sans-serif;cursor:pointer}
  .selection-dialog__visual{position:relative;min-height:0;overflow:hidden;background:#4c3a18}.selection-dialog__visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(28,20,7,.02) 34%,rgba(38,27,8,.68));pointer-events:none}.selection-dialog__visual img{width:100%;height:100%;object-fit:cover;filter:saturate(.86)}.selection-dialog__number{top:20px;left:20px;width:48px;height:48px}
  .selection-dialog__stamp{position:absolute;z-index:3;right:20px;bottom:20px;left:20px;padding:13px 15px;border:1px solid #e3cc93;background:rgba(58,42,13,.82);color:#fff5dc}.selection-dialog__stamp small{display:block;margin-bottom:5px;color:#e7cc8b;font-size:.48rem;font-weight:800;letter-spacing:.17em}.selection-dialog__stamp strong{font:500 1.2rem/1 Fraunces,serif;text-transform:uppercase;letter-spacing:.04em}
  .selection-dialog__content{min-width:0;overflow-y:auto;padding:52px clamp(34px,5vw,62px) 42px}.selection-dialog__content h2{max-width:calc(100% - 38px);margin:0 0 18px;color:#493817;font-size:clamp(2.5rem,4.2vw,4.1rem)}.selection-dialog__description{margin:0 0 20px;color:#4e432e;font:500 clamp(1.08rem,1.7vw,1.4rem)/1.42 Fraunces,serif}.selection-dialog__recommend{margin:0 0 23px;padding:16px 18px;border-left:3px solid var(--gold);background:rgba(179,138,61,.08)}.selection-dialog__recommend span{display:block;margin-bottom:7px;color:#8a682a;font-size:.51rem;font-weight:800;letter-spacing:.13em}.selection-dialog__recommend p{margin:0;color:#69604f;font-size:.8rem;line-height:1.65}
  .selection-dialog__content ul{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 28px;padding:0;list-style:none}.selection-dialog__content li{padding:6px 9px;border:1px solid rgba(179,138,61,.42);color:#654d20;font-size:.61rem}.selection-dialog__practical{padding-top:21px;border-top:1px solid rgba(179,138,61,.32)}.selection-dialog__practical>span{display:block;margin-bottom:12px;color:#8d6928;font-size:.54rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.selection-dialog__practical dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;border-top:1px solid rgba(179,138,61,.2)}.selection-dialog__practical dl div{padding:12px 14px 12px 0;border-bottom:1px solid rgba(179,138,61,.2)}.selection-dialog__practical dl div:nth-child(even){padding-left:16px;border-left:1px solid rgba(179,138,61,.2)}.selection-dialog__practical dt{margin-bottom:4px;color:#82755e;font-size:.54rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.selection-dialog__practical dd{margin:0;color:#3f382a;font-size:.71rem;line-height:1.45}
  .selection-dialog__actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.selection-dialog__actions a,.selection-dialog__actions button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:10px 13px;font:700 .6rem/1 'DM Sans',sans-serif;cursor:pointer}.selection-dialog__official{border:1px solid #8f6b29;background:#8f6b29;color:#fff8e8}.selection-dialog__map{border:1px solid #8f6b29;background:transparent;color:#71531d}.selection-dialog__actions button{border:0;background:var(--terracotta);color:var(--white)}.selection-dialog__actions button:disabled{background:#b8afa0;cursor:default}
  :global(html.selection-dialog-open){overflow:hidden}
  @media(max-width:700px){.selection-card__image{height:225px}.selection-card__copy{min-height:0}.selection-dialog{width:calc(100vw - 20px);height:min(92svh,820px)}.selection-dialog__shell{grid-template-columns:1fr;grid-template-rows:225px minmax(0,1fr);height:100%}.selection-dialog__close{position:fixed;top:max(16px,env(safe-area-inset-top));right:16px}.selection-dialog__content{padding:30px 22px 32px}.selection-dialog__practical dl{grid-template-columns:1fr}.selection-dialog__practical dl div,.selection-dialog__practical dl div:nth-child(even){padding:10px 0;border-left:0}.selection-dialog__actions>*{flex:1 1 145px}}
  @media(prefers-reduced-motion:reduce){.selection-card{transition:none}}
</style>

<script>
  const bindSelectionCards = () => {
    document.querySelectorAll<HTMLElement>('[data-selection-card-open]').forEach((trigger) => {
      if (trigger.dataset.selectionBound === 'true') return;
      trigger.dataset.selectionBound = 'true';
      trigger.addEventListener('click', () => {
        const dialog = document.getElementById(trigger.dataset.selectionCardOpen || '');
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
          document.documentElement.classList.add('selection-dialog-open');
        }
      });
    });
    document.querySelectorAll<HTMLDialogElement>('.selection-dialog').forEach((dialog) => {
      if (dialog.dataset.selectionBound === 'true') return;
      dialog.dataset.selectionBound = 'true';
      dialog.querySelector('[data-selection-card-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => document.documentElement.classList.remove('selection-dialog-open'));
    });
  };
  bindSelectionCards();
  document.addEventListener('astro:page-load', bindSelectionCards);
</script>
