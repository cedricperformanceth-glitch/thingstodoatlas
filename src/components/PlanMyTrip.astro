  }
  .plan-trip-drawer__kicker span { padding: 0 .24rem; color: #315545; }
  .plan-trip-drawer__head h2 {
    margin: 0 0 .6rem;
    color: #315545;
    font: 500 clamp(1.85rem, 6vw, 2.35rem)/1 Fraunces, serif;
    letter-spacing: -.045em;
  }
  .plan-trip-drawer__summary {
    margin: 0;
    padding-bottom: .75rem;
    color: #6f746d;
    font: 500 1.05rem/1 Caveat, cursive;
    transform: rotate(-.7deg);
  }
  .plan-trip-drawer__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(49, 85, 69, .24);
    border-radius: 50%;
    background: rgba(247, 242, 230, .6);
    color: #315545;
    font: 400 1.35rem/1 'DM Sans', sans-serif;
    cursor: pointer;
  }
  .plan-trip-drawer__close:hover { border-color: #b76645; color: #b76645; }
  .plan-trip-drawer__body {
    min-height: 132px;
    max-height: 470px;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 1.15rem 1.35rem 1.5rem;
    scrollbar-color: rgba(49, 85, 69, .38) transparent;
    scrollbar-width: thin;
  }
  .plan-trip-empty {
    margin: .2rem 0 0;
    padding: 1rem 1.05rem;
    border: 1px dashed rgba(49, 85, 69, .26);
    background: rgba(247, 242, 230, .62);
    color: #667068;
    font-size: .8rem;
    line-height: 1.6;
    transform: rotate(-.35deg);
  }
  .plan-trip-empty strong {
    display: block;
    margin-bottom: .5rem;
    color: #315545;
    font: 500 1.35rem/1.1 Fraunces, serif;
  }
  .plan-trip-notes {
    display: grid;
    padding: .15rem .2rem .35rem;
  }
  .plan-trip-note {
    --note-accent: #b58442;
    --note-rotation: -.45deg;
    position: relative;
    z-index: 1;
    min-height: 134px;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: .8rem;
    margin: 0 2px .58rem;
    padding: .92rem 2.6rem .9rem .85rem;
    border: 1px solid rgba(70, 75, 65, .2);
    background:
      linear-gradient(90deg, transparent 45px, rgba(183, 102, 69, .12) 45px 46px, transparent 46px),
      repeating-linear-gradient(0deg, transparent 0 25px, rgba(49, 85, 69, .055) 25px 26px),
      #f8f3e8;
    box-shadow: 3px 4px 0 rgba(49, 85, 69, .08), 0 8px 16px rgba(32, 60, 49, .07);
    transform: translateX(-2px) rotate(var(--note-rotation));
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .plan-trip-note:nth-child(3n + 2) { --note-rotation: .6deg; transform: translateX(3px) rotate(var(--note-rotation)); }
  .plan-trip-note:nth-child(3n) { --note-rotation: -.2deg; transform: translateX(0) rotate(var(--note-rotation)); }
  .plan-trip-note:hover,
  .plan-trip-note:focus-within {
    z-index: 3;
    border-color: rgba(49, 85, 69, .34);
    box-shadow: 5px 7px 0 rgba(49, 85, 69, .09), 0 12px 23px rgba(32, 60, 49, .11);
    transform: translateX(0) translateY(-3px) rotate(0);
  }
  .plan-trip-note--stay { --note-accent: #315545; }
  .plan-trip-note--eat { --note-accent: #b76645; }
  .plan-trip-note--bar { --note-accent: #7f3d3f; }
  .plan-trip-note--explore { --note-accent: #b58442; }
  .plan-trip-note__number {
    padding-top: .17rem;
    color: #315545;
    font: 500 1.28rem/1 Fraunces, serif;
    letter-spacing: -.05em;
  }
  .plan-trip-note__details { min-width: 0; }
  .plan-trip-note__stamp {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    margin-bottom: .42rem;
    padding: 0 .48rem;
    border: 1px solid var(--note-accent);
    color: var(--note-accent);
    font: 700 .48rem/1 'DM Sans', sans-serif;
    letter-spacing: .15em;
    transform: rotate(-1.5deg);
  }
  .plan-trip-note strong {
    display: block;
    overflow-wrap: anywhere;
    color: #315545;
    font: 500 1.12rem/1.08 Fraunces, serif;
    letter-spacing: -.03em;
  }
  .plan-trip-note small {
    display: block;
    margin-top: .32rem;
    overflow: hidden;
    color: #70766d;
    font: 400 .65rem/1.35 'DM Sans', sans-serif;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plan-trip-note__link {
    position: relative;
    display: inline-block;
    margin-top: .55rem;
    color: #315545;
    font: 600 .64rem/1 'DM Sans', sans-serif;
  }
  .plan-trip-note__link:after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -.25rem;
    left: 0;
    border-top: 1px solid rgba(183, 102, 69, .48);
    transform: scaleX(.4) rotate(-1deg);
    transform-origin: left;
    transition: transform 180ms ease;
  }
  .plan-trip-note:hover .plan-trip-note__link:after,
  .plan-trip-note__link:focus-visible:after { transform: scaleX(1) rotate(-1deg); }
  .plan-trip-note__remove {
    position: absolute;
    top: .6rem;
    right: .65rem;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #7c8078;
    font: 500 1.25rem/1 Caveat, cursive;
    cursor: pointer;
    transform: rotate(5deg);
  }
  .plan-trip-note__remove:hover { color: #b76645; }
  .plan-trip-note[hidden] { display: none; }
  .plan-trip-more {
    justify-self: center;
    margin: .45rem 0 0;
    padding: .65rem .85rem;
    border: 1px dashed rgba(49, 85, 69, .4);
    background: rgba(247, 242, 230, .72);
    color: #315545;
    font: 700 .58rem/1 'DM Sans', sans-serif;
    letter-spacing: .12em;
    cursor: pointer;
  }
  .plan-trip-more:hover { border-color: #b76645; color: #b76645; }
  .plan-trip-drawer__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .95rem 1.35rem 1.05rem;
    border-top: 1px dashed rgba(49, 85, 69, .28);
    background: rgba(247, 242, 230, .65);
  }
  .plan-trip-drawer__foot[hidden] { display: none; }
  .plan-trip-drawer__foot a {
    color: #315545;
    font: 700 .6rem/1 'DM Sans', sans-serif;
    letter-spacing: .075em;
  }
  .plan-trip-drawer__foot a span { margin-left: .25rem; color: #b76645; font-size: .85rem; }
  .plan-trip-drawer__foot a:hover { color: #b76645; }
  .plan-trip-drawer__foot button {
    padding: 0;
    border: 0;
    border-bottom: 1px solid rgba(112, 118, 109, .38);
    background: transparent;
    color: #70766d;
    font: 600 .53rem/1.5 'DM Sans', sans-serif;
    letter-spacing: .08em;
    cursor: pointer;
  }
  .plan-trip-drawer__foot button:hover { color: #9d4938; border-color: #9d4938; }
  @keyframes plan-trip-open {
    from { opacity: 0; transform: translateY(10px) scale(.98) rotate(.25deg); }
    to { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
  }
  @media (max-width: 700px) {
    .plan-trip-widget { right: .75rem; bottom: 4.9rem; }
    .plan-trip-fab { min-width: 202px; height: 60px; grid-template-columns: 46px 1fr auto; }
    .plan-trip-fab__icon { width: 46px; height: 46px; }
    .plan-trip-fab__count { min-width: 29px; height: 29px; }
    .plan-trip-drawer { width: calc(100vw - 1.5rem); max-height: calc(100vh - 6rem); }
    .plan-trip-drawer__head { padding: 1.2rem 3.35rem 1rem 1.1rem; }
    .plan-trip-drawer__head:after { left: 1.1rem; bottom: .8rem; }
    .plan-trip-drawer__body { max-height: none; padding: 1rem .9rem 1.2rem; }
    .plan-trip-note { grid-template-columns: 40px minmax(0, 1fr); gap: .65rem; min-height: 126px; padding-right: 2.35rem; }
    .plan-trip-drawer__foot { padding: .85rem 1rem .95rem; }
  }
  @media (max-width: 380px) {
    .plan-trip-fab { min-width: 184px; }
    .plan-trip-fab__copy small { display: none; }
    .plan-trip-drawer__foot { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-trip-drawer { animation: none; }
    .plan-trip-fab,
    .plan-trip-note,
    .plan-trip-note__link:after { transition: none; }
  }
</style>

<script>
  const TRIP_STORAGE_KEY = 'thingsToDoAtlas.trip.v1';
  const cityRoutes = { pakse: '/laos/pakse', 'tad-lo': '/laos/tad-lo' };
  const cityNames = { pakse: 'Pakse', 'tad-lo': 'Tad Lo' };
  const numberWords = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];

  const readTrip = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(TRIP_STORAGE_KEY) || 'null');
      return parsed?.version === 1 && Array.isArray(parsed.items) ? parsed : null;
    } catch { return null; }
  };
  const writeTrip = (trip) => localStorage.setItem(TRIP_STORAGE_KEY, JSON.stringify(trip));
  const tripWidget = document.querySelector('[data-trip-widget]');
  const tripFab = document.querySelector('[data-trip-toggle]');
  const tripDrawer = document.querySelector('[data-trip-drawer]');
  const tripContent = document.querySelector('[data-trip-content]');
  const tripCount = document.querySelector('[data-trip-count]');
  const tripSummary = document.querySelector('[data-trip-summary]');
  const tripTitle = document.querySelector('[data-trip-title]');
  const tripFabTitle = document.querySelector('[data-trip-fab-title]');
  const tripFooter = document.querySelector('[data-trip-footer]');
  const tripExplore = document.querySelector('[data-trip-explore]');

  const getNoteType = (item) => {
    const group = String(item.group || '').toLowerCase();
    const category = String(item.category || '').toLowerCase();
    if (group === 'accommodation' || /hostel|hotel|guesthouse|stay/.test(category)) return { key: 'stay', label: 'STAY' };
    if (/bar|beer|wine/.test(category)) return { key: 'bar', label: 'BAR' };
    if (group === 'restaurants' || group === 'cafes' || /restaurant|café|cafe|coffee|bakery|food|noodle|grill|bistro|trattoria/.test(category)) return { key: 'eat', label: 'EAT' };
    return { key: 'explore', label: 'EXPLORE' };
  };

  const getWaitingCopy = (count) => {
    if (!count) return 'Your first field note is waiting.';
    const amount = numberWords[count] || String(count);
    return `${amount} ${count === 1 ? 'place' : 'places'} waiting for you.`;
  };

  const renderTrip = () => {
    const trip = readTrip();
    if (!trip?.started) { tripWidget.hidden = true; return; }
    const cityName = cityNames[trip.startingCity] || trip.startingCity || 'Your';
    const cityRoute = cityRoutes[trip.startingCity] || '/';
    tripWidget.hidden = false;
    tripCount.textContent = String(trip.items.length).padStart(2, '0');
    tripFabTitle.textContent = `MY ${cityName.toUpperCase()} TRIP`;
    tripTitle.textContent = `My ${cityName} Trip`;
    tripSummary.textContent = getWaitingCopy(trip.items.length);
    tripFab.setAttribute('aria-label', `Open My ${cityName} Trip with ${trip.items.length} saved ${trip.items.length === 1 ? 'place' : 'places'}`);
    tripDrawer.setAttribute('aria-label', `My ${cityName} Trip`);
    tripExplore.href = cityRoute;
    tripExplore.firstChild.textContent = `CONTINUE EXPLORING ${cityName.toUpperCase()} `;
    tripFooter.hidden = trip.items.length === 0;
    tripContent.replaceChildren();
    if (!trip.items.length) {
      const empty = document.createElement('p');
      empty.className = 'plan-trip-empty';
      const emptyTitle = document.createElement('strong');
      emptyTitle.textContent = `Your trip starts in ${cityName}.`;
      empty.append(emptyTitle, document.createTextNode('Explore the city guide and keep the places that catch your attention. Each one will become a field note here.'));
      tripContent.append(empty);
    } else {
      const stack = document.createElement('section');
      stack.className = 'plan-trip-notes';
      stack.setAttribute('aria-label', 'Saved field notes');
      trip.items.forEach((item, index) => {
        const noteType = getNoteType(item);
        const row = document.createElement('article');
        row.className = `plan-trip-note plan-trip-note--${noteType.key}`;
        if (index >= 4) row.hidden = true;

        const number = document.createElement('span');
        number.className = 'plan-trip-note__number';
        number.setAttribute('aria-hidden', 'true');
        number.textContent = String(index + 1).padStart(2, '0');

        const details = document.createElement('div');
        details.className = 'plan-trip-note__details';
        const stamp = document.createElement('span');
        stamp.className = 'plan-trip-note__stamp';
        stamp.textContent = noteType.label;
        const name = document.createElement('strong');
        name.textContent = item.name;
        const meta = document.createElement('small');
        meta.textContent = `${item.city || cityName}${item.address ? ` · ${item.address}` : ''}`;
        details.append(stamp, name, meta);
        if (item.url) {
          const link = document.createElement('a');
          link.className = 'plan-trip-note__link';
          link.href = item.url;
          link.textContent = 'Open the field note →';
          details.append(link);
        }
        const remove = document.createElement('button');
        remove.className = 'plan-trip-note__remove';
        remove.type = 'button';
        remove.dataset.tripRemove = item.id;
        remove.setAttribute('aria-label', `Remove ${item.name}`);
        remove.textContent = '×';
        row.append(number, details, remove);
        stack.append(row);
      });
      if (trip.items.length > 4) {
        const more = document.createElement('button');
        more.className = 'plan-trip-more';
        more.type = 'button';
        more.dataset.tripMore = '';
        more.textContent = `+ ${trip.items.length - 4} MORE FIELD ${trip.items.length - 4 === 1 ? 'NOTE' : 'NOTES'}`;
        more.setAttribute('aria-expanded', 'false');
        stack.append(more);
      }
      tripContent.append(stack);
    }
    document.querySelectorAll('[data-trip-add]').forEach((button) => {
      const saved = trip.items.some((item) => item.id === button.dataset.tripId);
      button.textContent = saved ? 'Saved to My Trip' : 'Add to My Trip';
      button.toggleAttribute('disabled', saved);
      button.setAttribute('aria-pressed', String(saved));
    });
  };

  document.querySelector('[data-trip-city-select]')?.addEventListener('change', (event) => {
    const city = event.currentTarget.value;
    const button = document.querySelector('[data-trip-start]');
    const label = document.querySelector('[data-trip-start-label]');
    button.disabled = !city;
    label.textContent = city ? `Begin in ${cityNames[city]}` : 'Choose a city first';
  });
  document.querySelector('[data-trip-start]')?.addEventListener('click', () => {
    const city = document.querySelector('[data-trip-city-select]').value;
    if (!city) return;
    const existing = readTrip();
    writeTrip({ version: 1, started: true, startingCity: city, items: existing?.items || [] });
    window.location.href = cityRoutes[city];
  });
  const setDrawerOpen = (isOpen) => {
    tripDrawer.hidden = !isOpen;
    tripFab.setAttribute('aria-expanded', String(isOpen));
    tripWidget.classList.toggle('is-open', isOpen);
  };
  tripFab?.addEventListener('click', () => setDrawerOpen(tripDrawer.hidden));
  document.querySelector('[data-trip-close]')?.addEventListener('click', () => { setDrawerOpen(false); tripFab.focus(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !tripDrawer.hidden) { setDrawerOpen(false); tripFab.focus(); } });
  document.addEventListener('click', (event) => {
    const add = event.target.closest('[data-trip-add]');
    if (add) {
      const trip = readTrip(); if (!trip?.started) return;
      const item = JSON.parse(add.dataset.tripPlace); if (!trip.items.some((saved) => saved.id === item.id)) trip.items.push(item);
      writeTrip(trip); renderTrip(); return;
    }
    const remove = event.target.closest('[data-trip-remove]');
    if (remove) { const trip = readTrip(); trip.items = trip.items.filter((item) => item.id !== remove.dataset.tripRemove); writeTrip(trip); renderTrip(); }
    const more = event.target.closest('[data-trip-more]');
    if (more) {
      const isExpanded = more.getAttribute('aria-expanded') === 'true';
      const noteCount = more.parentElement.querySelectorAll('.plan-trip-note').length;
      const remainingCount = noteCount - 4;
      more.parentElement.querySelectorAll('.plan-trip-note').forEach((note, index) => { if (index >= 4) note.hidden = isExpanded; });
      more.setAttribute('aria-expanded', String(!isExpanded));
      more.textContent = isExpanded ? `+ ${remainingCount} MORE FIELD ${remainingCount === 1 ? 'NOTE' : 'NOTES'}` : 'SHOW FEWER NOTES';
    }
  });
  document.querySelector('[data-trip-clear]')?.addEventListener('click', () => {
    const trip = readTrip();
    if (!trip?.items.length || !window.confirm('Remove every saved field note from this trip?')) return;
    trip.items = [];
    writeTrip(trip);
    renderTrip();
  });
  window.addEventListener('storage', renderTrip);
  renderTrip();
</script>
