      repeating-linear-gradient(0deg, transparent 0 10px, rgba(49, 85, 69, .025) 10px 11px),
      #eee8dc;
    color: #252923;
    border: 1px solid rgba(49, 85, 69, .32);
    box-shadow: 7px 9px 0 rgba(49, 85, 69, .09), 0 24px 60px rgba(32, 60, 49, .24);
    transform-origin: bottom right;
    animation: plan-trip-open 200ms ease-out both;
  }
  .plan-trip-drawer__head {
    position: relative;
    padding: 1.45rem 3.7rem 1.2rem 1.45rem;
