---
import { resolvePlaceImage } from '../data/placeImageResolver';

const { place: rawPlace, index = 0 } = Astro.props;
const place = resolvePlaceImage(rawPlace);
const cardNumber = String(index + 1).padStart(2, '0');
const dialogId = `partner-place-${place.slug}`;
const titleId = `${dialogId}-title`;
const tripPlace = JSON.stringify({
  id: place.slug,
  name: place.name,
  city: place.city,
  group: place.category,
  category: place.subcategory,
  address: place.address,
  url: `${Astro.url.pathname}#${place.slug}`
});
const verificationLabel = place.status === 'verified' ? 'Checked by local partner' : 'Partner information to reconfirm';
---

<article class="partner-card" id={place.slug}>
  <div class="partner-card__image">
    <img src={place.image} alt={place.imageAlt} width="720" height="520" loading="lazy" decoding="async" />
    <span class="partner-card__number" aria-hidden="true">{cardNumber}</span>
    <span class="partner-card__source">WITH {place.partnerName.toUpperCase()}</span>
  </div>
  <div class="partner-card__copy">
    <p>{place.subcategory}</p>
    <h3>{place.name}</h3>
    <span>{place.shortDescription}</span>
    <b>Open the field card <i aria-hidden="true">↗</i></b>
  </div>
  <button class="partner-card__open" type="button" aria-haspopup="dialog" aria-controls={dialogId} data-partner-card-open={dialogId} aria-label={`Open details for ${place.name}`}></button>

  <dialog class="partner-dialog" id={dialogId} aria-labelledby={titleId}>
    <div class="partner-dialog__shell">
      <button class="partner-dialog__close" type="button" data-partner-card-close aria-label={`Close ${place.name}`}>×</button>
      <div class="partner-dialog__visual">
        <img src={place.image} alt={place.imageAlt} width="900" height="1200" loading="lazy" decoding="async" />
        <span class="partner-dialog__number">{cardNumber}</span>
        <a class="partner-dialog__partner" href={place.partnerUrl} target="_blank" rel="noreferrer">In partnership with <strong>{place.partnerName}</strong> ↗</a>
      </div>
      <div class="partner-dialog__content">
        <p class="eyebrow">{place.subcategory} · {place.city}</p>
        <h2 id={titleId}>{place.name}</h2>
        <p class="partner-dialog__description">{place.description}</p>
        <p class="partner-dialog__recommend">{place.whyWeRecommend}</p>
        <ul>{place.highlights.map((highlight: string) => <li>{highlight}</li>)}</ul>
        <div class="partner-dialog__practical">
          <span>{verificationLabel} · {place.lastChecked}</span>
          <dl>
            <div><dt>Location</dt><dd>{place.address}</dd></div>
            <div><dt>Hours</dt><dd>{place.hours}</dd></div>
            <div><dt>Budget</dt><dd>{place.price}</dd></div>
            <div><dt>Best for</dt><dd>{place.bestFor}</dd></div>
          </dl>
        </div>
        <div class="partner-dialog__actions">
          <a class="partner-dialog__guide" href={place.partnerUrl} target="_blank" rel="noreferrer">Full local guide on {place.partnerName} <span aria-hidden="true">↗</span></a>
          <a class="partner-dialog__map" href={place.mapsUrl} target="_blank" rel="noreferrer">{place.mapLabel} <span aria-hidden="true">↗</span></a>
          <button type="button" data-trip-add data-trip-id={place.slug} data-trip-place={tripPlace} aria-pressed="false">Add to My Trip</button>
        </div>
      </div>
    </div>
  </dialog>
</article>

<style>
  .partner-card{position:relative;min-width:0;overflow:hidden;border:1px solid rgba(75,81,70,.22);background:#eee8dc;box-shadow:5px 7px 0 rgba(49,85,69,.07);transition:transform .22s ease,box-shadow .22s ease}
  .partner-card:hover{transform:translateY(-4px);box-shadow:8px 11px 0 rgba(49,85,69,.1)}
  .partner-card__image{position:relative;height:215px;overflow:hidden;background:var(--paper-deep)}
  .partner-card__image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(24,31,26,.48));pointer-events:none}
  .partner-card__image img{width:100%;height:100%;object-fit:cover;filter:saturate(.76) contrast(.96)}
  .partner-card__number,.partner-dialog__number{position:absolute;z-index:2;top:14px;left:14px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(255,253,248,.8);border-radius:50%;background:rgba(32,60,49,.82);color:#fffdf8;font:500 .95rem/1 Fraunces,serif}
  .partner-card__source{position:absolute;z-index:2;right:13px;bottom:12px;padding:6px 8px;border:1px solid rgba(255,253,248,.72);background:rgba(32,60,49,.74);color:#fffdf8;font:700 .48rem/1 'DM Sans',sans-serif;letter-spacing:.12em}
  .partner-card__copy{display:flex;min-height:220px;flex-direction:column;padding:24px 23px 22px}
  .partner-card__copy p{margin:0 0 10px;color:var(--terracotta);font-size:.57rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .partner-card__copy h3{margin:0 0 11px;color:var(--green);font:500 clamp(1.55rem,2.2vw,2.05rem)/1.06 Fraunces,serif}
  .partner-card__copy>span{color:var(--muted);font-size:.79rem;line-height:1.55}
  .partner-card__copy b{width:max-content;margin-top:auto;padding-top:20px;border-bottom:1px solid var(--green);color:var(--green);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase}
  .partner-card__copy i{color:var(--terracotta);font-style:normal}
  .partner-card__open{position:absolute;z-index:3;inset:0;width:100%;border:0;background:transparent;cursor:pointer}
  .partner-card:has(.partner-card__open:focus-visible){outline:2px solid var(--terracotta);outline-offset:4px}
  .partner-dialog{width:min(1040px,calc(100vw - 42px));max-width:none;max-height:none;margin:auto;padding:0;overflow:hidden;border:1px solid rgba(49,85,69,.28);background:var(--paper);color:var(--ink);box-shadow:0 28px 85px rgba(17,29,23,.35)}
  .partner-dialog::backdrop{background:rgba(20,29,24,.76);backdrop-filter:blur(3px)}
  .partner-dialog__shell{position:relative;display:grid;grid-template-columns:minmax(300px,.8fr) minmax(0,1.2fr);height:min(730px,88svh)}
  .partner-dialog__close{position:absolute;z-index:5;top:17px;right:17px;display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(49,85,69,.2);border-radius:50%;background:rgba(247,242,230,.94);color:var(--green);font:400 1.7rem/1 'DM Sans',sans-serif;cursor:pointer}
  .partner-dialog__visual{position:relative;min-height:0;overflow:hidden;background:var(--green)}
  .partner-dialog__visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(17,29,23,.06) 35%,rgba(17,29,23,.58));pointer-events:none}
  .partner-dialog__visual img{width:100%;height:100%;object-fit:cover;filter:saturate(.78)}
  .partner-dialog__number{top:20px;left:20px;width:48px;height:48px}
  .partner-dialog__partner{position:absolute;z-index:3;right:20px;bottom:20px;left:20px;padding:12px 14px;border:1px solid rgba(255,253,248,.62);background:rgba(32,60,49,.76);color:#fffdf8;font-size:.68rem;letter-spacing:.03em}
  .partner-dialog__partner strong{font-weight:700}
  .partner-dialog__content{min-width:0;overflow-y:auto;padding:52px clamp(34px,5vw,62px) 42px}
  .partner-dialog__content h2{max-width:calc(100% - 38px);margin:0 0 18px;color:var(--green);font-size:clamp(2.4rem,4.1vw,4rem)}
  .partner-dialog__description{margin:0 0 17px;color:var(--green);font:500 clamp(1.08rem,1.7vw,1.4rem)/1.4 Fraunces,serif}
  .partner-dialog__recommend{margin:0 0 22px;color:var(--muted);font-size:.82rem;line-height:1.68}
  .partner-dialog__content ul{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 28px;padding:0;list-style:none}
  .partner-dialog__content li{padding:6px 9px;border:1px solid var(--line);color:var(--green);font-size:.61rem}
  .partner-dialog__practical{padding-top:21px;border-top:1px solid var(--line)}
  .partner-dialog__practical>span{display:block;margin-bottom:12px;color:var(--terracotta);font-size:.54rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
  .partner-dialog__practical dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;border-top:1px solid rgba(75,81,70,.16)}
  .partner-dialog__practical dl div{padding:12px 14px 12px 0;border-bottom:1px solid rgba(75,81,70,.16)}
  .partner-dialog__practical dl div:nth-child(even){padding-left:16px;border-left:1px solid rgba(75,81,70,.16)}
  .partner-dialog__practical dt{margin-bottom:4px;color:var(--muted);font-size:.54rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}
  .partner-dialog__practical dd{margin:0;font-size:.71rem;line-height:1.45}
  .partner-dialog__actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}
  .partner-dialog__actions a,.partner-dialog__actions button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:10px 13px;border:0;font:700 .6rem/1 'DM Sans',sans-serif;cursor:pointer}
  .partner-dialog__guide{background:var(--green);color:var(--white)}
  .partner-dialog__map{border:1px solid var(--green)!important;background:transparent;color:var(--green)}
  .partner-dialog__actions button{background:var(--terracotta);color:var(--white)}
  .partner-dialog__actions button:disabled{background:#b8afa0;cursor:default}
  :global(html.partner-dialog-open){overflow:hidden}
  @media(max-width:700px){.partner-card__image{height:220px}.partner-card__copy{min-height:0}.partner-dialog{width:calc(100vw - 20px);height:min(92svh,820px)}.partner-dialog__shell{grid-template-columns:1fr;grid-template-rows:220px minmax(0,1fr);height:100%}.partner-dialog__close{position:fixed;top:max(16px,env(safe-area-inset-top));right:16px}.partner-dialog__content{padding:30px 22px 32px}.partner-dialog__practical dl{grid-template-columns:1fr}.partner-dialog__practical dl div,.partner-dialog__practical dl div:nth-child(even){padding:10px 0;border-left:0}.partner-dialog__actions>*{flex:1 1 145px}}
  @media(prefers-reduced-motion:reduce){.partner-card{transition:none}}
</style>

<script>
  const bindPartnerCards = () => {
    document.querySelectorAll<HTMLElement>('[data-partner-card-open]').forEach((trigger) => {
      if (trigger.dataset.partnerBound === 'true') return;
      trigger.dataset.partnerBound = 'true';
      trigger.addEventListener('click', () => {
        const dialog = document.getElementById(trigger.dataset.partnerCardOpen || '');
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
          document.documentElement.classList.add('partner-dialog-open');
        }
      });
    });
    document.querySelectorAll<HTMLDialogElement>('.partner-dialog').forEach((dialog) => {
      if (dialog.dataset.partnerBound === 'true') return;
      dialog.dataset.partnerBound = 'true';
      dialog.querySelector('[data-partner-card-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => document.documentElement.classList.remove('partner-dialog-open'));
    });
  };
  bindPartnerCards();
  document.addEventListener('astro:page-load', bindPartnerCards);
</script>
