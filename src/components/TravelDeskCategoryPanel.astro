---
interface Props {
  slug: string;
  cityName: string;
  title: string;
  count: number;
  noun: string;
  intro: string;
  fieldNote?: string;
  active?: boolean;
}

const {
  slug,
  cityName,
  title,
  count,
  noun,
  intro,
  fieldNote = '01',
  active = false
} = Astro.props;

const cityId = cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const panelId = `travel-desk-panel-${cityId}-${slug}`;
---

<article
  class:list={['travel-desk-panel', { 'is-active': active }]}
  id={panelId}
  role="tabpanel"
  tabindex="-1"
  data-travel-desk-panel={slug}
  hidden={!active}
>
  <header class="travel-desk-panel__header">
    <div class="travel-desk-panel__chapter">
      <span>FIELD NOTE</span>
      <strong>{fieldNote}</strong>
    </div>

    <div class="travel-desk-panel__heading">
      <p>{title}</p>
      <h3><span>{count} {noun}</span><em>in {cityName}.</em></h3>
    </div>

    <aside>
      <p>{intro}</p>
      <slot name="filters" />
    </aside>
  </header>

  <div class="travel-desk-panel__divider" aria-hidden="true">
    <span></span><small>OPEN THE CARDS FOR THE FULL FIELD NOTE</small><span></span>
  </div>

  <div class="travel-desk-panel__content"><slot /></div>
</article>

<style>
  .travel-desk-panel[hidden] { display: none; }

  .travel-desk-panel {
    outline: none;
    animation: travel-desk-panel-in 260ms cubic-bezier(.22,.75,.2,1) both;
  }

  .travel-desk-panel__header {
    display: grid;
    grid-template-columns: 5.3rem minmax(0, 1.65fr) minmax(250px, .72fr);
    gap: clamp(1.4rem, 3.5vw, 3.8rem);
    align-items: end;
  }

  .travel-desk-panel__chapter {
    align-self: start;
    padding-top: .25rem;
    color: #315545;
  }

  .travel-desk-panel__chapter span,
  .travel-desk-panel__chapter strong {
    display: block;
  }

  .travel-desk-panel__chapter span {
    margin-bottom: .45rem;
    color: rgba(31,57,45,.5);
    font: 700 .5rem/1 'DM Sans', sans-serif;
    letter-spacing: .16em;
  }

  .travel-desk-panel__chapter strong {
    font: 400 clamp(2rem, 3vw, 3rem)/1 Fraunces, Georgia, serif;
  }

  .travel-desk-panel__heading > p {
    margin: 0 0 .7rem;
    color: #b76645;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .travel-desk-panel__heading h3 {
    margin: 0;
    color: #202c26;
    font: 400 clamp(2.45rem, 4.3vw, 4.25rem)/.95 Fraunces, Georgia, serif;
    letter-spacing: -.04em;
  }

  .travel-desk-panel__heading h3 span,
  .travel-desk-panel__heading h3 em {
    display: block;
  }

  .travel-desk-panel__heading h3 em {
    color: #315545;
    font-style: normal;
  }

  .travel-desk-panel__header aside {
    max-width: 390px;
    padding-bottom: .3rem;
  }

  .travel-desk-panel__header aside > p {
    margin: 0;
    color: rgba(31,41,36,.68);
    font-size: .78rem;
    line-height: 1.7;
  }

  .travel-desk-panel__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: .75rem;
    align-items: center;
    margin: clamp(2.2rem, 4.5vw, 4rem) 0 clamp(1.7rem, 3vw, 2.6rem);
  }

  .travel-desk-panel__divider span {
    height: 1px;
    background: rgba(49,85,69,.18);
  }

  .travel-desk-panel__divider small {
    color: rgba(31,57,45,.44);
    font: 700 .48rem/1 'DM Sans', sans-serif;
    letter-spacing: .14em;
  }

  .travel-desk-panel__content :global(.city-panel-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: stretch;
  }

  .travel-desk-panel__content :global(.city-panel-list > :first-child) {
    grid-column: 1 / -1;
  }

  .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child),
  .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child),
  .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child) {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(280px, .78fr);
    min-height: 330px;
  }

  .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child .partner-card__image),
  .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child .selection-card__image),
  .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child .place-card__image) {
    height: 100%;
    min-height: 330px;
  }

  .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child .partner-card__copy),
  .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child .selection-card__copy),
  .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child .place-card__preview) {
    min-height: 330px;
    justify-content: center;
    padding: clamp(2rem, 4vw, 3.5rem);
  }

  .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child .partner-card__copy h3),
  .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child .selection-card__copy h3),
  .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child .place-card__preview h3) {
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .travel-desk-panel__content :global(.partner-card),
  .travel-desk-panel__content :global(.selection-card),
  .travel-desk-panel__content :global(.place-card) {
    box-shadow: 7px 9px 0 rgba(49,85,69,.085);
  }

  .travel-desk-panel__content :global(.city-panel-list > :nth-child(4n + 2)) {
    transform: rotate(-.18deg);
  }

  .travel-desk-panel__content :global(.city-panel-list > :nth-child(4n + 3)) {
    transform: rotate(.16deg);
  }

  .travel-desk-panel__content :global(.city-panel-list > :hover) {
    transform: translateY(-4px) rotate(0);
  }

  .travel-desk-panel__content :global(.city-panel-empty) {
    padding: clamp(2.8rem, 5vw, 4.5rem);
    border: 1px dashed rgba(49,85,69,.3);
    background: rgba(255,252,245,.45);
    text-align: center;
  }

  .travel-desk-panel__content :global(.city-panel-empty h4) {
    margin: 0 0 .85rem;
    color: #315545;
    font: 500 clamp(1.7rem, 3vw, 2.55rem)/1.1 Fraunces, Georgia, serif;
  }

  .travel-desk-panel__content :global(.city-panel-empty p) {
    max-width: 36rem;
    margin: 0 auto;
    color: rgba(31,41,36,.65);
    line-height: 1.65;
  }

  @keyframes travel-desk-panel-in {
    from { opacity: 0; transform: translateY(7px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1080px) {
    .travel-desk-panel__header {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }

    .travel-desk-panel__header aside {
      grid-column: 2;
      max-width: 42rem;
    }
  }

  @media (max-width: 760px) {
    .travel-desk-panel__header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .travel-desk-panel__chapter {
      display: flex;
      gap: .55rem;
      align-items: baseline;
      padding: 0;
    }

    .travel-desk-panel__chapter span,
    .travel-desk-panel__chapter strong {
      display: inline;
      margin: 0;
    }

    .travel-desk-panel__chapter strong {
      font-size: 1.4rem;
    }

    .travel-desk-panel__header aside {
      grid-column: auto;
    }

    .travel-desk-panel__divider {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .travel-desk-panel__divider span {
      display: none;
    }

    .travel-desk-panel__content :global(.city-panel-list) {
      grid-template-columns: 1fr;
    }

    .travel-desk-panel__content :global(.city-panel-list > :first-child) {
      grid-column: auto;
    }

    .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child),
    .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child),
    .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child) {
      display: block;
      min-height: 0;
    }

    .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child .partner-card__image),
    .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child .selection-card__image),
    .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child .place-card__image) {
      height: 220px;
      min-height: 0;
    }

    .travel-desk-panel__content :global(.city-panel-list > .partner-card:first-child .partner-card__copy),
    .travel-desk-panel__content :global(.city-panel-list > .selection-card:first-child .selection-card__copy),
    .travel-desk-panel__content :global(.city-panel-list > .place-card:first-child .place-card__preview) {
      min-height: 0;
      justify-content: initial;
      padding: 24px 23px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .travel-desk-panel { animation: none; }
  }
</style>
