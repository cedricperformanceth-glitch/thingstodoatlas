---
interface Props {
  slug: string;
  cityName: string;
  title: string;
  count: number;
  noun: string;
  intro?: string;
  summary?: string;
  fieldNote?: string;
  active?: boolean;
}

const {
  slug,
  cityName,
  count,
  noun,
  summary = `${count} ${noun} in ${cityName}`,
  fieldNote = '01',
  active = false
} = Astro.props;

const cityId = cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const panelId = `travel-desk-panel-${cityId}-${slug}`;
const hasFilters = Astro.slots.has('filters');
---

<article
  class:list={['travel-desk-panel', { 'is-active': active }]}
  id={panelId}
  role="tabpanel"
  tabindex="-1"
  data-travel-desk-panel={slug}
  hidden={!active}
>
  <header class="travel-desk-panel__header">
    <p class="travel-desk-panel__summary hand-note">{summary}</p>
    <div class="travel-desk-panel__chapter">
      <span>FIELD NOTE</span>
      <strong>{fieldNote}</strong>
    </div>
  </header>

  {hasFilters && <div class="travel-desk-panel__tools"><slot name="filters" /></div>}

  <div class="travel-desk-panel__divider" aria-hidden="true">
    <span></span><small>OPEN THE CARDS FOR THE FULL FIELD NOTE</small><span></span>
  </div>

  <div class="travel-desk-panel__content"><slot /></div>
</article>

<style>
  .travel-desk-panel[hidden] { display: none; }

  .travel-desk-panel {
    outline: none;
    animation: travel-desk-panel-in 220ms cubic-bezier(.22,.75,.2,1) both;
  }

  .travel-desk-panel__header {
    position: relative;
    display: grid;
    place-items: start center;
    min-height: 2.7rem;
    margin-top: clamp(-3.25rem, -3.5vw, -2.55rem);
  }

  .travel-desk-panel__summary {
    max-width: calc(100% - 10rem);
    margin: .12rem auto 0;
    color: #315545;
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    transform: rotate(-.65deg);
  }

  .travel-desk-panel__chapter {
    position: absolute;
    top: -.1rem;
    right: 0;
    display: flex;
    gap: .45rem;
    align-items: baseline;
    color: #315545;
  }

  .travel-desk-panel__chapter span {
    color: rgba(31,57,45,.48);
    font: 700 .47rem/1 'DM Sans', sans-serif;
    letter-spacing: .15em;
  }

  .travel-desk-panel__chapter strong {
    font: 400 clamp(1.25rem, 1.8vw, 1.7rem)/1 Fraunces, Georgia, serif;
  }

  .travel-desk-panel__tools {
    display: flex;
    justify-content: center;
    margin: .5rem 0 .9rem;
  }

  .travel-desk-panel__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: .7rem;
    align-items: center;
    margin: .85rem 0 clamp(1.15rem, 2vw, 1.65rem);
  }

  .travel-desk-panel__tools + .travel-desk-panel__divider { margin-top: .45rem; }
  .travel-desk-panel__divider span { height: 1px; background: rgba(49,85,69,.18); }
  .travel-desk-panel__divider small {
    color: rgba(31,57,45,.44);
    font: 700 .45rem/1 'DM Sans', sans-serif;
    letter-spacing: .13em;
  }

  .travel-desk-panel__content :global(.city-panel-list) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.78rem, 1.35vw, 1.08rem);
    align-items: stretch;
  }

  .travel-desk-panel__content :global(.city-panel-list--selection) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .travel-desk-panel__content :global(.city-panel-list--selection > :first-child) {
    grid-column: 1 / -1;
  }

  .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child) {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(250px, .84fr);
    min-height: 230px;
  }

  .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__image) {
    height: 230px !important;
  }

  .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__copy) {
    min-height: 230px !important;
    justify-content: center;
    padding: 1.5rem 1.65rem !important;
  }

  .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__copy h3) {
    font-size: clamp(1.8rem, 2.6vw, 2.45rem) !important;
  }

  .travel-desk-panel__content :global(.partner-card),
  .travel-desk-panel__content :global(.selection-card),
  .travel-desk-panel__content :global(.place-card),
  .travel-desk-panel__content :global(.map-address-card),
  .travel-desk-panel__content :global(.landmark-category-card) {
    min-width: 0;
    box-shadow: 4px 5px 0 rgba(49,85,69,.075) !important;
  }

  .travel-desk-panel__content :global(.partner-card__image),
  .travel-desk-panel__content :global(.selection-card__image),
  .travel-desk-panel__content :global(.place-card__image),
  .travel-desk-panel__content :global(.map-address-card__image),
  .travel-desk-panel__content :global(.landmark-category-card__visual) {
    height: 158px !important;
    min-height: 0 !important;
  }

  .travel-desk-panel__content :global(.partner-card__copy),
  .travel-desk-panel__content :global(.selection-card__copy),
  .travel-desk-panel__content :global(.place-card__preview),
  .travel-desk-panel__content :global(.map-address-card__copy),
  .travel-desk-panel__content :global(.landmark-category-card__copy) {
    min-height: 160px !important;
    padding: 17px 17px 16px !important;
  }

  .travel-desk-panel__content :global(.partner-card__copy h3),
  .travel-desk-panel__content :global(.selection-card__copy h3),
  .travel-desk-panel__content :global(.place-card__preview h3),
  .travel-desk-panel__content :global(.map-address-card__copy h3),
  .travel-desk-panel__content :global(.landmark-category-card__copy h3) {
    margin-bottom: 8px !important;
    font-size: clamp(1.28rem, 1.8vw, 1.62rem) !important;
    line-height: 1.03 !important;
  }

  .travel-desk-panel__content :global(.partner-card__copy > span),
  .travel-desk-panel__content :global(.selection-card__copy > span),
  .travel-desk-panel__content :global(.place-card__preview > p:not(.place-card__type)),
  .travel-desk-panel__content :global(.map-address-card__copy > span),
  .travel-desk-panel__content :global(.landmark-category-card__copy > span) {
    font-size: .68rem !important;
    line-height: 1.45 !important;
  }

  .travel-desk-panel__content :global(.partner-card__copy p),
  .travel-desk-panel__content :global(.selection-card__copy p),
  .travel-desk-panel__content :global(.place-card__type),
  .travel-desk-panel__content :global(.map-address-card__copy > p),
  .travel-desk-panel__content :global(.landmark-category-card__copy > p) {
    margin-bottom: 7px !important;
    font-size: .49rem !important;
  }

  .travel-desk-panel__content :global(.partner-card__copy b),
  .travel-desk-panel__content :global(.selection-card__copy b),
  .travel-desk-panel__content :global(.place-card__cta) {
    padding-top: 12px !important;
    font-size: .49rem !important;
  }

  .travel-desk-panel__content :global(.map-address-card__copy small),
  .travel-desk-panel__content :global(.landmark-category-card__meta) {
    margin-top: 10px !important;
    font-size: .48rem !important;
  }

  .travel-desk-panel__content :global(.map-address-card__actions),
  .travel-desk-panel__content :global(.landmark-category-card__actions) {
    gap: 6px !important;
    padding-top: 12px !important;
  }

  .travel-desk-panel__content :global(.map-address-card__actions a),
  .travel-desk-panel__content :global(.map-address-card__actions button),
  .travel-desk-panel__content :global(.landmark-category-card__actions a),
  .travel-desk-panel__content :global(.landmark-category-card__actions button) {
    min-height: 32px !important;
    padding: 8px 9px !important;
    font-size: .49rem !important;
  }

  .travel-desk-panel__content :global(.partner-card__number),
  .travel-desk-panel__content :global(.selection-card__number),
  .travel-desk-panel__content :global(.place-card__number),
  .travel-desk-panel__content :global(.map-address-card__number),
  .travel-desk-panel__content :global(.landmark-category-card__number) {
    top: 10px !important;
    left: 10px !important;
    width: 34px !important;
    height: 34px !important;
    font-size: .76rem !important;
  }

  .travel-desk-panel__content :global(.partner-card__source),
  .travel-desk-panel__content :global(.selection-card__badge),
  .travel-desk-panel__content :global(.place-card__photo-note),
  .travel-desk-panel__content :global(.map-address-card__source),
  .travel-desk-panel__content :global(.landmark-category-card__source) {
    right: 10px !important;
    bottom: 9px !important;
  }

  .travel-desk-panel__content :global(.city-panel-list > :nth-child(5n + 2)) { transform: rotate(-.12deg); }
  .travel-desk-panel__content :global(.city-panel-list > :nth-child(5n + 4)) { transform: rotate(.12deg); }
  .travel-desk-panel__content :global(.city-panel-list > :hover) { transform: translateY(-3px) rotate(0); }

  .travel-desk-panel__content :global(.city-panel-empty) {
    padding: clamp(2.2rem, 4vw, 3.5rem);
    border: 1px dashed rgba(49,85,69,.3);
    background: rgba(255,252,245,.45);
    text-align: center;
  }
  .travel-desk-panel__content :global(.city-panel-empty h4) {
    margin: 0 0 .7rem;
    color: #315545;
    font: 500 clamp(1.55rem, 2.6vw, 2.2rem)/1.1 Fraunces, Georgia, serif;
  }
  .travel-desk-panel__content :global(.city-panel-empty p) {
    max-width: 36rem;
    margin: 0 auto;
    color: rgba(31,41,36,.65);
    line-height: 1.6;
  }

  @keyframes travel-desk-panel-in {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1120px) {
    .travel-desk-panel__content :global(.city-panel-list) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .travel-desk-panel__header {
      min-height: 2.45rem;
      margin-top: -2.75rem;
      place-items: start;
    }
    .travel-desk-panel__summary {
      max-width: calc(100% - 7rem);
      margin: .2rem 0 0;
      overflow: hidden;
      font-size: 1.05rem;
      text-align: left;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .travel-desk-panel__chapter { right: 0; }
    .travel-desk-panel__chapter span { display: none; }
    .travel-desk-panel__tools { justify-content: flex-start; margin-top: .35rem; }
    .travel-desk-panel__divider {
      grid-template-columns: 1fr;
      margin-top: .65rem;
      text-align: left;
    }
    .travel-desk-panel__divider span { display: none; }
    .travel-desk-panel__content :global(.city-panel-list),
    .travel-desk-panel__content :global(.city-panel-list--selection) { grid-template-columns: 1fr; }
    .travel-desk-panel__content :global(.city-panel-list--selection > :first-child) { grid-column: auto; }
    .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child) {
      display: block;
      min-height: 0;
    }
    .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__image) {
      height: 180px !important;
    }
    .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__copy) {
      min-height: 165px !important;
      justify-content: initial;
      padding: 18px 18px 17px !important;
    }
    .travel-desk-panel__content :global(.city-panel-list--selection > .selection-card:first-child .selection-card__copy h3) {
      font-size: 1.55rem !important;
    }
    .travel-desk-panel__content :global(.partner-card__image),
    .travel-desk-panel__content :global(.selection-card__image),
    .travel-desk-panel__content :global(.place-card__image),
    .travel-desk-panel__content :global(.map-address-card__image),
    .travel-desk-panel__content :global(.landmark-category-card__visual) { height: 180px !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .travel-desk-panel { animation: none; }
  }
</style>