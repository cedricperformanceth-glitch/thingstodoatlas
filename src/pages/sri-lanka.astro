---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanMyTripIntro from '../components/PlanMyTripIntro.astro';
import LandmarkModal from '../components/LandmarkModal.astro';

const gridColumns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
