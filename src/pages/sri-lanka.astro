---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanMyTripIntro from '../components/PlanMyTripIntro.astro';

const gridColumns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
const gridRows = Array.from({ length: 12 }, (_, index) => index + 1);
const mirissa = { x: 448, y: 1472 };
const ahangama = { x: 384, y: 1472 };
const sigiriya = { x: 408, y: 768 };
const adamsPeak = { x: 448, y: 1048 };
---

<BaseLayout
  title="Explore Sri Lanka"
  description="Choose your next stop on the Sri Lanka map. More destinations will be added as the atlas grows."
  canonical="https://thingstodoatlas.com/sri-lanka"
>
  <section class="laos-map-page" aria-labelledby="sri-lanka-map-title">
    <div class="map-sheet">
      <div class="map-layers">
        <header class="map-sheet__header">
          <span class="map-sheet__note">FIELD MAP · SRI LANKA</span>
          <div class="map-sheet__title-block">
            <svg class="map-sheet__title-art" viewBox="0 0 680 112" role="presentation" aria-hidden="true">
              <text class="map-sheet__chapter" x="677" y="20" text-anchor="end">SRI LANKA · CHAPTER 03</text>
              <text class="map-sheet__title" x="680" y="88" text-anchor="end">Choose a place on the map</text>
            </svg>
            <h2 id="sri-lanka-map-title" class="visually-hidden">Choose a place on the map</h2>
          </div>
        </header>
        <img
          class="map-drawing"
          src="/images/hand-drawn/sri-lanka-map.webp"
          alt="Hand-drawn map of Sri Lanka"
          width="676"
          height="1166"
        />
        <svg class="map-grid" viewBox="0 0 1024 1536" role="img" aria-labelledby="sri-lanka-grid-title sri-lanka-grid-description">
          <title id="sri-lanka-grid-title">Destinations on the Sri Lanka map</title>
          <desc id="sri-lanka-grid-description">Mirissa and Ahangama are available along the southern coast, Sigiriya is available in the centre of the island, and Adam's Peak is available in the central highlands.</desc>
          <g class="map-grid__lines" aria-hidden="true">
            {Array.from({ length: 9 }, (_, index) => (
              <line x1={index * 128} y1="0" x2={index * 128} y2="1536" />
            ))}
            {Array.from({ length: 13 }, (_, index) => (
              <line x1="0" y1={index * 128} x2="1024" y2={index * 128} />
            ))}
          </g>
          <g class="map-grid__labels map-grid__labels--columns" aria-hidden="true">
            {gridColumns.map((label, index) => (
              <text x={(index * 128) + 64} y="34" text-anchor="middle">{label}</text>
            ))}
          </g>
          <g class="map-grid__labels map-grid__labels--rows" aria-hidden="true">
            {gridRows.map((label, index) => (
              <text x="18" y={(index * 128) + 74}>{label}</text>
            ))}
          </g>

          <a class="city-marker city-marker--active" href="/sri-lanka/sigiriya" aria-label="Explore Sigiriya">
            <circle class="city-marker__ring" cx={sigiriya.x} cy={sigiriya.y} r="22" />
            <circle class="city-marker__dot" cx={sigiriya.x} cy={sigiriya.y} r="9" />
            <path class="city-marker__leader" d={`M${sigiriya.x + 12} ${sigiriya.y + 12} L${sigiriya.x + 54} ${sigiriya.y + 54}`} />
            <text class="city-marker__label city-marker__label--down-right" x={sigiriya.x + 62} y={sigiriya.y + 92}>Sigiriya</text>
          </a>

          <a class="city-marker city-marker--active" href="/sri-lanka/adams-peak" aria-label="Explore Adam's Peak">
            <circle class="city-marker__ring" cx={adamsPeak.x} cy={adamsPeak.y} r="22" />
            <circle class="city-marker__dot" cx={adamsPeak.x} cy={adamsPeak.y} r="9" />
            <path class="city-marker__leader" d={`M${adamsPeak.x + 12} ${adamsPeak.y + 12} L${adamsPeak.x + 54} ${adamsPeak.y + 54}`} />
            <text class="city-marker__label city-marker__label--down-right" x={adamsPeak.x + 62} y={adamsPeak.y + 92}>Adam's Peak</text>
          </a>

          <a class="city-marker city-marker--active" href="/sri-lanka/ahangama" aria-label="Explore Ahangama">
            <circle class="city-marker__ring" cx={ahangama.x} cy={ahangama.y} r="22" />
            <circle class="city-marker__dot" cx={ahangama.x} cy={ahangama.y} r="9" />
            <path class="city-marker__leader" d={`M${ahangama.x - 12} ${ahangama.y + 12} L${ahangama.x - 54} ${ahangama.y + 54}`} />
            <text class="city-marker__label city-marker__label--down-left" x={ahangama.x - 62} y={ahangama.y + 92}>Ahangama</text>
          </a>

          <a class="city-marker city-marker--active" href="/sri-lanka/mirissa" aria-label="Explore Mirissa">
            <circle class="city-marker__ring" cx={mirissa.x} cy={mirissa.y} r="22" />
            <circle class="city-marker__dot" cx={mirissa.x} cy={mirissa.y} r="9" />
            <path class="city-marker__leader" d={`M${mirissa.x} ${mirissa.y + 16} L${mirissa.x} ${mirissa.y + 54}`} />
            <text class="city-marker__label city-marker__label--below" x={mirissa.x} y={mirissa.y + 92}>Mirissa</text>
          </a>
        </svg>
      </div>
    </div>
    <PlanMyTripIntro />
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&display=swap');

  .laos-map-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2));
    background: #f2eee3;
    color: #1f2924;
  }

  .map-sheet {
    position: relative;
    width: fit-content;
    margin: 0 auto;
    padding: 26px 26px 10px;
    border: 1px solid rgba(31, 41, 36, 0.14);
    background: #f7f2e6;
    overflow: visible;
  }

  .map-sheet::before,
  .map-sheet::after {
    content: '';
    position: absolute;
    z-index: 3;
    width: 78px;
    height: 22px;
    background: rgba(199, 181, 143, 0.48);
  }

  .map-sheet::before { top: -9px; left: 8%; transform: rotate(-4deg); }
  .map-sheet::after { right: 8%; bottom: -8px; transform: rotate(3deg); }

  .map-layers {
    position: relative;
    width: 80vw;
    height: 80vw;
    margin: 0 auto;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(31, 41, 36, 0.2), 0 8px 22px rgba(31, 41, 36, 0.06);
    overflow: hidden;
  }

  .map-drawing,
  .map-grid {
    position: absolute;
    left: calc(50% + 85px);
    top: 50%;
    display: block;
    width: 33.235vw;
    height: 49.8525vw;
    transform: translate(-50%, -42%);
  }

  .map-drawing { object-fit: contain; }

  .map-grid {
    z-index: 1;
    overflow: visible;
    pointer-events: auto;
  }

  .map-grid__lines,
  .map-grid__labels { pointer-events: none; }

  .map-grid__lines line {
    stroke: rgba(42, 75, 61, 0.22);
    stroke-width: 1.5;
    stroke-dasharray: 8 10;
    vector-effect: non-scaling-stroke;
  }

  .map-grid__labels text {
    fill: rgba(42, 75, 61, 0.58);
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 27px;
    font-weight: 600;
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .map-grid__labels--rows text { text-anchor: start; }

  .city-marker { color: #d97745; cursor: pointer; outline: none; }
  .city-marker--active { color: #d97745; }
  .city-marker--inactive { color: #7f6d33; cursor: default; }
  .city-marker__ring {
    fill: color-mix(in srgb, currentColor 14%, transparent);
    stroke: currentColor;
    stroke-width: 3;
    transition: opacity 180ms ease, transform 180ms ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .city-marker__dot { fill: currentColor; stroke: #fff; stroke-width: 3; }
  .city-marker__leader { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .city-marker__label {
    fill: currentColor;
    font-family: Georgia, serif;
    font-size: 34px;
    font-weight: 700;
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 7px;
    stroke-linejoin: round;
  }
  .city-marker__label--below { text-anchor: middle; }
  .city-marker__label--down-left { text-anchor: end; }
  .city-marker__label--down-right { text-anchor: start; }
  .city-marker:hover .city-marker__ring,
  .city-marker:focus .city-marker__ring { transform: scale(1.18); }

  .map-sheet__header {
    position: absolute;
    z-index: 2;
    top: clamp(1.4rem, 3vw, 2.5rem);
    left: clamp(1.25rem, 4vw, 3.25rem);
    right: clamp(1.25rem, 4vw, 3.25rem);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    color: #1f392d;
    pointer-events: none;
  }

  .map-sheet__title-block { width: min(42rem, 70%); margin-left: auto; text-align: right; }
  .map-sheet__title-art { display: block; width: 100%; height: auto; overflow: visible; }
  .map-sheet__chapter,
  .map-sheet__title {
    fill: #1f392d;
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-style: normal;
  }
  .map-sheet__chapter { font-size: 15px; font-weight: 500; letter-spacing: 0.12em; opacity: 0.62; }
  .map-sheet__title { font-size: 51px; font-weight: 550; letter-spacing: 0.01em; opacity: 0.93; }
  .map-sheet__note {
    position: static;
    flex: 0 0 auto;
    margin-top: 0.15rem;
    color: #1f392d;
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.08em;
    opacity: 0.58;
    white-space: nowrap;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .laos-map-page { padding-top: 3.5rem; }
    .map-sheet { width: auto; padding: 0.75rem 0.75rem 10px; }
    .map-sheet__header { gap: 0.15rem; flex-wrap: wrap; }
    .map-sheet__title-block { width: 100%; order: 2; }
    .map-sheet__note { order: 1; margin-right: auto; margin-left: 0; }
    .map-sheet__chapter { font-size: 12px; }
    .map-sheet__title { font-size: 42px; }
    .map-sheet__note { font-size: 13px; }
    .map-layers { width: calc(100vw - 4rem); height: calc(100vw - 4rem); }
    .map-drawing,
    .map-grid {
      left: calc(50% + 85px);
      width: calc((100vw - 4rem) * 0.4154375);
      height: calc((100vw - 4rem) * 0.62315625);
    }
    .map-grid__labels text { font-size: 34px; }
  }
</style>