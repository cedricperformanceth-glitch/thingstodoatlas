---

<BaseLayout
  title="Explore Sri Lanka"
  description="Choose your next stop on the Sri Lanka map. More destinations will be added as the atlas grows."
  canonical="https://thingstodoatlas.com/sri-lanka"
>
  <section class="laos-map-page" aria-labelledby="sri-lanka-map-title">
    <div class="map-sheet">
      <div class="map-layers">
        <header class="map-sheet__header">
          <span class="map-sheet__note">FIELD MAP · SRI LANKA</span>
          <div class="map-sheet__title-block">
            <svg class="map-sheet__title-art" viewBox="0 0 680 112" role="presentation" aria-hidden="true">
              <text class="map-sheet__chapter" x="677" y="20" text-anchor="end">SRI LANKA · CHAPTER 03</text>
              <text class="map-sheet__title" x="680" y="88" text-anchor="end">Choose a place on the map</text>
            </svg>
            <h2 id="sri-lanka-map-title" class="visually-hidden">Choose a place on the map</h2>
          </div>
        </header>
        <div class="map-country-layer">
          <img
            class="map-drawing"
            src="/images/hand-drawn/sri-lanka-map.webp"
            alt="Hand-drawn map of Sri Lanka"
            width="676"
            height="1166"
          />

          <svg class="map-grid" viewBox="0 0 1024 1536" aria-hidden="true">
            <g class="map-grid__lines">
              {Array.from({ length: 9 }, (_, index) => (
                <line x1={index * 128} y1="0" x2={index * 128} y2="1536" />
              ))}
              {Array.from({ length: 13 }, (_, index) => (
                <line x1="0" y1={index * 128} x2="1024" y2={index * 128} />
              ))}
            </g>
            <g class="map-grid__labels map-grid__labels--columns">
              {gridColumns.map((label, index) => (
                <text x={(index * 128) + 64} y="34" text-anchor="middle">{label}</text>
              ))}
            </g>
            <g class="map-grid__labels map-grid__labels--rows">
              {gridRows.map((label, index) => (
                <text x="18" y={(index * 128) + 74}>{label}</text>
              ))}
            </g>
          </svg>

          <svg class="map-overlay" viewBox="0 0 1024 1536" role="img" aria-labelledby="sri-lanka-map-svg-title sri-lanka-map-description">
            <title id="sri-lanka-map-svg-title">Destinations and cultural landmarks on the Sri Lanka map</title>
            <desc id="sri-lanka-map-description">The map includes city guides, geographical landmarks and a red cultural note for Devil's Dance that is not intended as an exact location.</desc>

            <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Sigiriya landmark details" data-open-landmark="sigiriya-modal">
              <circle class="city-marker__ring" cx={sigiriya.x} cy={sigiriya.y} r="22" />
              <circle class="city-marker__dot" cx={sigiriya.x} cy={sigiriya.y} r="9" />
              <path class="city-marker__leader" d={`M${sigiriya.x + 12} ${sigiriya.y + 12} L${sigiriya.x + 54} ${sigiriya.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-right" x={sigiriya.x + 62} y={sigiriya.y + 92}>Sigiriya</text>
            </g>

            <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Adam's Peak landmark details" data-open-landmark="adams-peak-modal">
              <circle class="city-marker__ring" cx={adamsPeak.x} cy={adamsPeak.y} r="22" />
              <circle class="city-marker__dot" cx={adamsPeak.x} cy={adamsPeak.y} r="9" />
              <path class="city-marker__leader" d={`M${adamsPeak.x + 12} ${adamsPeak.y + 12} L${adamsPeak.x + 54} ${adamsPeak.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-right" x={adamsPeak.x + 62} y={adamsPeak.y + 92}>Adam's Peak</text>
            </g>

            <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Yala National Park landmark details" data-open-landmark="yala-national-park-modal">
              <circle class="city-marker__ring" cx={yalaNationalPark.x} cy={yalaNationalPark.y} r="22" />
              <circle class="city-marker__dot" cx={yalaNationalPark.x} cy={yalaNationalPark.y} r="9" />
              <path class="city-marker__leader" d={`M${yalaNationalPark.x + 12} ${yalaNationalPark.y - 12} L${yalaNationalPark.x + 58} ${yalaNationalPark.y - 58}`} />
              <text class="city-marker__label city-marker__label--up-right" x={yalaNationalPark.x + 66} y={yalaNationalPark.y - 70}>Yala National Park</text>
            </g>

            <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Ella Train landmark details" data-open-landmark="ella-train-modal">
              <circle class="city-marker__ring" cx={ellaTrain.x} cy={ellaTrain.y} r="22" />
              <circle class="city-marker__dot" cx={ellaTrain.x} cy={ellaTrain.y} r="9" />
              <path class="city-marker__leader" d={`M${ellaTrain.x + 12} ${ellaTrain.y + 12} L${ellaTrain.x + 58} ${ellaTrain.y + 58}`} />
              <text class="city-marker__label city-marker__label--down-right" x={ellaTrain.x + 66} y={ellaTrain.y + 92}>Ella Train</text>
            </g>

            <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Sri Dalada Maligawa landmark details" data-open-landmark="sri-dalada-maligawa-modal">
              <circle class="city-marker__ring" cx={sriDaladaMaligawa.x} cy={sriDaladaMaligawa.y} r="22" />
              <circle class="city-marker__dot" cx={sriDaladaMaligawa.x} cy={sriDaladaMaligawa.y} r="9" />
              <path class="city-marker__leader" d={`M${sriDaladaMaligawa.x - 12} ${sriDaladaMaligawa.y - 12} L${sriDaladaMaligawa.x - 58} ${sriDaladaMaligawa.y - 58}`} />
              <text class="city-marker__label city-marker__label--up-left" x={sriDaladaMaligawa.x - 66} y={sriDaladaMaligawa.y - 70}>Sri Dalada Maligawa</text>
            </g>

            <g class="city-marker city-marker--ritual" role="button" tabindex="0" aria-label="Open Devil's Dance cultural note" data-open-landmark="devils-dance-modal">
              <circle class="city-marker__ring" cx={devilsDance.x} cy={devilsDance.y} r="22" />
              <circle class="city-marker__dot" cx={devilsDance.x} cy={devilsDance.y} r="9" />
              <path class="city-marker__leader" d={`M${devilsDance.x + 12} ${devilsDance.y - 12} L${devilsDance.x + 58} ${devilsDance.y - 58}`} />
              <text class="city-marker__label city-marker__label--up-right" x={devilsDance.x + 66} y={devilsDance.y - 70}>Devil's Dance</text>
            </g>

            <g class="city-marker city-marker--inactive" aria-label="Arugam Bay coming soon">
              <circle class="city-marker__ring" cx={arugamBay.x} cy={arugamBay.y} r="22" />
              <circle class="city-marker__dot" cx={arugamBay.x} cy={arugamBay.y} r="9" />
              <path class="city-marker__leader" d={`M${arugamBay.x + 12} ${arugamBay.y - 12} L${arugamBay.x + 54} ${arugamBay.y - 54}`} />
              <text class="city-marker__label city-marker__label--up-right" x={arugamBay.x + 62} y={arugamBay.y - 66}>Arugam Bay</text>
            </g>

            <a class="city-marker city-marker--active" href="/sri-lanka/negombo" aria-label="Explore Negombo">
              <circle class="city-marker__ring" cx={negombo.x} cy={negombo.y} r="22" />
              <circle class="city-marker__dot" cx={negombo.x} cy={negombo.y} r="9" />
              <path class="city-marker__leader" d={`M${negombo.x - 12} ${negombo.y - 14} L${negombo.x - 58} ${negombo.y - 67}`} />
              <text class="city-marker__label city-marker__label--up-left" x={negombo.x - 66} y={negombo.y - 77}>Negombo</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/colombo" aria-label="Explore Colombo">
              <circle class="city-marker__ring" cx={colombo.x} cy={colombo.y} r="22" />
              <circle class="city-marker__dot" cx={colombo.x} cy={colombo.y} r="9" />
              <path class="city-marker__leader" d={`M${colombo.x - 13} ${colombo.y + 11} L${colombo.x - 63} ${colombo.y + 52}`} />
              <text class="city-marker__label city-marker__label--down-left" x={colombo.x - 71} y={colombo.y + 84}>Colombo</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/ahangama" aria-label="Explore Ahangama">
              <circle class="city-marker__ring" cx={ahangama.x} cy={ahangama.y} r="22" />
              <circle class="city-marker__dot" cx={ahangama.x} cy={ahangama.y} r="9" />
              <path class="city-marker__leader" d={`M${ahangama.x - 12} ${ahangama.y + 12} L${ahangama.x - 54} ${ahangama.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-left" x={ahangama.x - 62} y={ahangama.y + 92}>Ahangama</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/mirissa" aria-label="Explore Mirissa">
              <circle class="city-marker__ring" cx={mirissa.x} cy={mirissa.y} r="22" />
              <circle class="city-marker__dot" cx={mirissa.x} cy={mirissa.y} r="9" />
              <path class="city-marker__leader" d={`M${mirissa.x} ${mirissa.y + 16} L${mirissa.x} ${mirissa.y + 54}`} />
              <text class="city-marker__label city-marker__label--below" x={mirissa.x} y={mirissa.y + 92}>Mirissa</text>
            </a>
          </svg>
        </div>
      </div>
    </div>
    <PlanMyTripIntro />
  </section>

  <LandmarkModal
    id="sigiriya-modal"
    name="Sigiriya"
    region="Central Province · Sri Lanka"
    description="A monumental rock fortress rising above the plains, combining ancient ruins, gardens, frescoes and a steep climb to the summit. This field card will be expanded with verified local notes."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Sigiriya%2C%20Sri%20Lanka"
    gallery={sigiriyaGallery}
    facts={[
      { label: 'Getting there', value: 'Commonly reached from Dambulla, Habarana or nearby guesthouses by tuk-tuk, bus or private driver.' },
      { label: 'Best time', value: 'Early morning is generally the most comfortable time for the climb.' },
      { label: 'What to wear', value: 'Light clothing, sun protection and shoes suitable for many stairs.' },
      { label: 'Price', value: 'Paid entrance. Confirm the current official ticket price before visiting.' },
      { label: 'Duration', value: 'Allow roughly two to three hours for the full visit.' },
      { label: 'Difficulty', value: 'Moderate climb with exposed stairways and limited shade.' }
    ]}
  />

  <LandmarkModal
    id="adams-peak-modal"
    name="Adam's Peak"
    region="Central Highlands · Sri Lanka"
    description="A sacred mountain and demanding pilgrimage climb, usually approached at night to reach the summit around sunrise. This field card will be expanded with verified seasonal and transport notes."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Adam%27s%20Peak%2C%20Sri%20Lanka"
    gallery={adamsPeakGallery}
    facts={[
      { label: 'Getting there', value: 'Most visitors begin from Nallathanniya or Dalhousie, reached by bus, train connections and local transport.' },
      { label: 'Best time', value: 'The main pilgrimage season and weather conditions should be checked before setting out.' },
      { label: 'What to wear', value: 'Warm layers for the summit, comfortable clothing and reliable walking shoes.' },
      { label: 'Price', value: 'The climb itself is generally free, but transport and local services cost extra.' },
      { label: 'Duration', value: 'Plan several hours for the ascent and descent.' },
      { label: 'Difficulty', value: 'Demanding, with a long staircase and substantial elevation gain.' }
    ]}
  />

  <LandmarkModal
    id="yala-national-park-modal"
    name="Yala National Park"
    country="Sri Lanka"
    fieldCardNumber="03"
    region="Southern & Uva Provinces · South-east Sri Lanka"
    description="A protected landscape of dry forest, scrub, lagoons and rocky coastline, best known for wildlife safaris and the chance to encounter Sri Lankan leopards, elephants, crocodiles and birdlife."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Yala%20National%20Park%2C%20Sri%20Lanka"
    gallery={yalaGallery}
    facts={[
      { label: 'Getting there', value: 'Tissamaharama and Kataragama are common bases. The park is entered with an authorised safari vehicle and driver through the operating entrance for your chosen block.' },
      { label: 'Best time', value: 'Dawn and late afternoon usually offer cooler conditions and better wildlife activity. Opening arrangements can change seasonally, so check locally.' },
      { label: 'What to wear', value: 'Light neutral clothing, sun protection and a layer for the early drive. Bring water and protect cameras from dust.' },
      { label: 'Price', value: 'Park admission, vehicle and guide costs are separate and can change. Confirm the full safari price before booking.' },
      { label: 'Duration', value: 'A standard safari is usually a half-day; a full-day visit provides more time but also more heat and driving.' },
      { label: 'Difficulty', value: 'Physically easy but bumpy, dusty and sometimes crowded. Wildlife sightings are never guaranteed.' }
    ]}
  />

  <LandmarkModal
    id="ella-train-modal"
    name="Ella Train"
    country="Sri Lanka"
    fieldCardNumber="04"
    region="Central Highlands · Ella & Demodara"
    description="The hill-country railway journey around Ella is part transport, part landscape experience: tea estates, misty ridges, small stations and the celebrated Nine Arches Bridge. It is a route rather than one single attraction."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Nine%20Arches%20Bridge%2C%20Ella%2C%20Sri%20Lanka"
    gallery={ellaTrainGallery}
    facts={[
      { label: 'Getting there', value: 'Ella railway station connects with the main hill-country line. The Nine Arches Bridge lies between Ella and Demodara and can also be reached on foot from nearby roads and trails.' },
      { label: 'Best time', value: 'Travel in daylight for the views. Weather, delays and crowd levels vary, especially during weekends and holidays.' },
      { label: 'What to wear', value: 'Bring a light layer for cooler highland air and rain protection. Keep luggage compact and secure around doors and platforms.' },
      { label: 'Price', value: 'Ticket prices depend on route and class. Reserved seats can sell out, so use official railway channels or check at a station.' },
      { label: 'Duration', value: 'The full Kandy–Ella journey takes much of the day; shorter sections such as Nanu Oya–Ella still deliver the main highland scenery.' },
      { label: 'Difficulty', value: 'The train itself is easy, but crowded carriages, stairs, uneven platforms and walking approaches to the bridge require care.' }
    ]}
  />

  <LandmarkModal
    id="sri-dalada-maligawa-modal"
    name="Sri Dalada Maligawa"
    country="Sri Lanka"
    fieldCardNumber="05"
    region="Kandy · Central Province"
    description="The Temple of the Sacred Tooth Relic is one of Sri Lanka’s most important Buddhist sites, built within Kandy’s former royal palace complex. The annual Kandy Esala Perahera is a major night procession associated with the temple, bringing together drummers, dancers, torchbearers and ceremonial elephants around a replica relic casket."
