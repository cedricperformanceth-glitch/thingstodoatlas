---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanMyTripIntro from '../components/PlanMyTripIntro.astro';
import LandmarkModal from '../components/LandmarkModal.astro';

const mirissa = { x: 448, y: 1472 };
const ahangama = { x: 384, y: 1472 };
const sigiriya = { x: 408, y: 768 };
const adamsPeak = { x: 448, y: 1172 };
const negombo = { x: 224, y: 969 };
const colombo = { x: 224, y: 1152 };
const arugamBay = { x: 896, y: 1172 };

const sigiriyaGallery = [
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sigiriya_Rock_Fortress.jpg?width=1600',
    alt: 'Sigiriya Rock Fortress rising above the surrounding green landscape',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Sigiriya_Rock_Fortress.jpg',
    author: 'Satheesha J.',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sigiriya%2C_Rock_Fortress.jpg?width=1600',
    alt: 'View across the ruins and plains from the summit of Sigiriya',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Sigiriya,_Rock_Fortress.jpg',
    author: 'Tlbatt',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sigiriya_rock_fortress.jpg?width=1600',
    alt: 'The lion gate and staircase leading higher up Sigiriya Rock',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Sigiriya_rock_fortress.jpg',
    author: 'Himam123',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Rock_Fortress.jpg?width=1600',
    alt: 'Sigiriya Rock Fortress seen from a distance across the countryside',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Rock_Fortress.jpg',
    author: 'Jithma Kalingu',
    license: 'CC BY-SA 4.0'
  }
];

const adamsPeakGallery = [
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Sunrise_from_the_top_of_Sri_Pada_%28Adam%27s_Peak%29_Sri_Lanka.jpg?width=1600',
    alt: "Sunrise viewed from the summit of Adam's Peak",
    sourcePage: "https://commons.wikimedia.org/wiki/File:Sunrise_from_the_top_of_Sri_Pada_(Adam's_Peak)_Sri_Lanka.jpg",
    author: 'Eli Solidum',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Shadow_of_the_peak_when_sun_rising.jpg?width=1600',
    alt: "The triangular shadow of Adam's Peak at sunrise",
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Shadow_of_the_peak_when_sun_rising.jpg',
    author: 'Sameera Madusanka',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Adams_peak_sripada_footpath_to_climb.jpg?width=1600',
    alt: "The long staircase and pilgrimage path climbing Adam's Peak",
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Adams_peak_sripada_footpath_to_climb.jpg',
    author: 'Nisal Senanayaka',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Top_of_Adams_peak_in_Srilanka.jpg?width=1600',
    alt: "The summit area and shrine at the top of Adam's Peak",
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Top_of_Adams_peak_in_Srilanka.jpg',
    author: 'Dharshana',
    license: 'CC BY-SA 4.0'
  }
];
---

<BaseLayout
  title="Explore Sri Lanka"
  description="Choose your next stop on the Sri Lanka map. More destinations will be added as the atlas grows."
  canonical="https://thingstodoatlas.com/sri-lanka"
>
  <section class="laos-map-page" aria-labelledby="sri-lanka-map-title">
    <div class="map-sheet">
      <div class="map-layers">
        <header class="map-sheet__header">
          <span class="map-sheet__note">FIELD MAP · SRI LANKA</span>
          <div class="map-sheet__title-block">
            <svg class="map-sheet__title-art" viewBox="0 0 680 112" role="presentation" aria-hidden="true">
              <text class="map-sheet__chapter" x="677" y="20" text-anchor="end">SRI LANKA · CHAPTER 03</text>
              <text class="map-sheet__title" x="680" y="88" text-anchor="end">Choose a place on the map</text>
            </svg>
            <h2 id="sri-lanka-map-title" class="visually-hidden">Choose a place on the map</h2>
          </div>
        </header>
        <div class="map-country-layer">
          <img
            class="map-drawing"
            src="/images/hand-drawn/sri-lanka-map.webp"
            alt="Hand-drawn map of Sri Lanka"
            width="676"
            height="1166"
          />
          <svg class="map-overlay" viewBox="0 0 1024 1536" role="img" aria-labelledby="sri-lanka-map-svg-title sri-lanka-map-description">
            <title id="sri-lanka-map-svg-title">Destinations on the Sri Lanka map</title>
            <desc id="sri-lanka-map-description">Mirissa and Ahangama are available along the southern coast, Sigiriya is available in the centre of the island, Adam's Peak is available in the central highlands, Negombo and Colombo are available on the west coast, and Arugam Bay is marked as an upcoming destination on the east coast.</desc>

            <g class="city-marker city-marker--active" role="button" tabindex="0" aria-label="Open Sigiriya landmark details" data-open-landmark="sigiriya-modal">
              <circle class="city-marker__ring" cx={sigiriya.x} cy={sigiriya.y} r="22" />
              <circle class="city-marker__dot" cx={sigiriya.x} cy={sigiriya.y} r="9" />
              <path class="city-marker__leader" d={`M${sigiriya.x + 12} ${sigiriya.y + 12} L${sigiriya.x + 54} ${sigiriya.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-right" x={sigiriya.x + 62} y={sigiriya.y + 92}>Sigiriya</text>
            </g>

            <g class="city-marker city-marker--active" role="button" tabindex="0" aria-label="Open Adam's Peak landmark details" data-open-landmark="adams-peak-modal">
              <circle class="city-marker__ring" cx={adamsPeak.x} cy={adamsPeak.y} r="22" />
              <circle class="city-marker__dot" cx={adamsPeak.x} cy={adamsPeak.y} r="9" />
              <path class="city-marker__leader" d={`M${adamsPeak.x + 12} ${adamsPeak.y + 12} L${adamsPeak.x + 54} ${adamsPeak.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-right" x={adamsPeak.x + 62} y={adamsPeak.y + 92}>Adam's Peak</text>
            </g>

            <g class="city-marker city-marker--inactive" aria-label="Arugam Bay coming soon">
              <circle class="city-marker__ring" cx={arugamBay.x} cy={arugamBay.y} r="22" />
              <circle class="city-marker__dot" cx={arugamBay.x} cy={arugamBay.y} r="9" />
              <path class="city-marker__leader" d={`M${arugamBay.x + 12} ${arugamBay.y - 12} L${arugamBay.x + 54} ${arugamBay.y - 54}`} />
              <text class="city-marker__label city-marker__label--up-right" x={arugamBay.x + 62} y={arugamBay.y - 66}>Arugam Bay</text>
            </g>

            <a class="city-marker city-marker--active" href="/sri-lanka/negombo" aria-label="Explore Negombo">
              <circle class="city-marker__ring" cx={negombo.x} cy={negombo.y} r="22" />
              <circle class="city-marker__dot" cx={negombo.x} cy={negombo.y} r="9" />
              <path class="city-marker__leader" d={`M${negombo.x - 12} ${negombo.y - 14} L${negombo.x - 58} ${negombo.y - 67}`} />
              <text class="city-marker__label city-marker__label--up-left" x={negombo.x - 66} y={negombo.y - 77}>Negombo</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/colombo" aria-label="Explore Colombo">
              <circle class="city-marker__ring" cx={colombo.x} cy={colombo.y} r="22" />
              <circle class="city-marker__dot" cx={colombo.x} cy={colombo.y} r="9" />
              <path class="city-marker__leader" d={`M${colombo.x - 13} ${colombo.y + 11} L${colombo.x - 63} ${colombo.y + 52}`} />
              <text class="city-marker__label city-marker__label--down-left" x={colombo.x - 71} y={colombo.y + 84}>Colombo</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/ahangama" aria-label="Explore Ahangama">
              <circle class="city-marker__ring" cx={ahangama.x} cy={ahangama.y} r="22" />
              <circle class="city-marker__dot" cx={ahangama.x} cy={ahangama.y} r="9" />
              <path class="city-marker__leader" d={`M${ahangama.x - 12} ${ahangama.y + 12} L${ahangama.x - 54} ${ahangama.y + 54}`} />
              <text class="city-marker__label city-marker__label--down-left" x={ahangama.x - 62} y={ahangama.y + 92}>Ahangama</text>
            </a>

            <a class="city-marker city-marker--active" href="/sri-lanka/mirissa" aria-label="Explore Mirissa">
              <circle class="city-marker__ring" cx={mirissa.x} cy={mirissa.y} r="22" />
              <circle class="city-marker__dot" cx={mirissa.x} cy={mirissa.y} r="9" />
              <path class="city-marker__leader" d={`M${mirissa.x} ${mirissa.y + 16} L${mirissa.x} ${mirissa.y + 54}`} />
              <text class="city-marker__label city-marker__label--below" x={mirissa.x} y={mirissa.y + 92}>Mirissa</text>
            </a>
          </svg>
        </div>
      </div>
    </div>
    <PlanMyTripIntro />
  </section>

  <LandmarkModal
    id="sigiriya-modal"
    name="Sigiriya"
    region="Central Province · Sri Lanka"
    description="A monumental rock fortress rising above the plains, combining ancient ruins, gardens, frescoes and a steep climb to the summit. This field card will be expanded with verified local notes."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Sigiriya%2C%20Sri%20Lanka"
    gallery={sigiriyaGallery}
    facts={[
      { label: 'Getting there', value: 'Commonly reached from Dambulla, Habarana or nearby guesthouses by tuk-tuk, bus or private driver.' },
      { label: 'Best time', value: 'Early morning is generally the most comfortable time for the climb.' },
      { label: 'What to wear', value: 'Light clothing, sun protection and shoes suitable for many stairs.' },
      { label: 'Price', value: 'Paid entrance. Confirm the current official ticket price before visiting.' },
      { label: 'Duration', value: 'Allow roughly two to three hours for the full visit.' },
      { label: 'Difficulty', value: 'Moderate climb with exposed stairways and limited shade.' }
    ]}
  />

  <LandmarkModal
    id="adams-peak-modal"
    name="Adam's Peak"
    region="Central Highlands · Sri Lanka"
    description="A sacred mountain and demanding pilgrimage climb, usually approached at night to reach the summit around sunrise. This field card will be expanded with verified seasonal and transport notes."
    mapsUrl="https://www.google.com/maps/search/?api=1&query=Adam%27s%20Peak%2C%20Sri%20Lanka"
    gallery={adamsPeakGallery}
    facts={[
      { label: 'Getting there', value: 'Most visitors begin from Nallathanniya or Dalhousie, reached by bus, train connections and local transport.' },
      { label: 'Best time', value: 'The main pilgrimage season and weather conditions should be checked before setting out.' },
      { label: 'What to wear', value: 'Warm layers for the summit, comfortable clothing and reliable walking shoes.' },
      { label: 'Price', value: 'The climb itself is generally free, but transport and local services cost extra.' },
      { label: 'Duration', value: 'Plan several hours for the ascent and descent.' },
      { label: 'Difficulty', value: 'Demanding, with a long staircase and substantial elevation gain.' }
    ]}
  />
</BaseLayout>

<script>
  const openLandmark = (trigger) => {
    const id = trigger.dataset.openLandmark;
    const dialog = id ? document.getElementById(id) : null;
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
  };

  document.querySelectorAll('[data-open-landmark]').forEach((trigger) => {
    trigger.addEventListener('click', () => openLandmark(trigger));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLandmark(trigger);
      }
    });
  });

  document.querySelectorAll('.landmark-modal').forEach((dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.querySelector('[data-close-landmark]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('[data-add-landmark]')?.addEventListener('click', (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      button.textContent = 'Added to my trip ✓';
      button.disabled = true;
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&display=swap');

  .laos-map-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2));
    background: #f2eee3;
    color: #1f2924;
  }

  .map-sheet {
    position: relative;
    width: fit-content;
    margin: 0 auto;
    padding: 26px 26px 10px;
    border: 1px solid rgba(31, 41, 36, 0.14);
    background: #f7f2e6;
    overflow: visible;
  }

  .map-sheet::before,
  .map-sheet::after {
    content: '';
    position: absolute;
    z-index: 3;
    width: 78px;
    height: 22px;
    background: rgba(199, 181, 143, 0.48);
  }

  .map-sheet::before { top: -9px; left: 8%; transform: rotate(-4deg); }
  .map-sheet::after { right: 8%; bottom: -8px; transform: rotate(3deg); }

  .map-layers {
    position: relative;
    width: 80vw;
    height: 80vw;
    margin: 0 auto;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(31, 41, 36, 0.2), 0 8px 22px rgba(31, 41, 36, 0.06);
    overflow: hidden;
  }

  .map-country-layer {
    position: absolute;
    left: calc(50% + 85px);
    top: 50%;
    width: 33.235vw;
    aspect-ratio: 1024 / 1536;
    transform: translate(-50%, -42%);
  }

  .map-drawing,
  .map-overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-drawing { object-fit: contain; }
  .map-overlay { z-index: 1; overflow: visible; pointer-events: auto; }

  .city-marker { color: #d97745; cursor: pointer; outline: none; }
  .city-marker--active { color: #d97745; }
  .city-marker--inactive { color: #7f6d33; cursor: default; }
  .city-marker__ring { fill: color-mix(in srgb, currentColor 14%, transparent); stroke: currentColor; stroke-width: 3; transition: opacity 180ms ease, transform 180ms ease; transform-box: fill-box; transform-origin: center; }
  .city-marker__dot { fill: currentColor; stroke: #fff; stroke-width: 3; }
  .city-marker__leader { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .city-marker__label { fill: currentColor; font-family: Georgia, serif; font-size: 44px; font-weight: 700; paint-order: stroke; stroke: #fff; stroke-width: 9px; stroke-linejoin: round; }
  .city-marker__label--below { text-anchor: middle; }
  .city-marker__label--down-left { text-anchor: end; }
  .city-marker__label--down-right { text-anchor: start; }
  .city-marker__label--up-left { text-anchor: end; }
  .city-marker__label--up-right { text-anchor: start; }
  .city-marker:hover .city-marker__ring,
  .city-marker:focus .city-marker__ring { transform: scale(1.18); }

  .map-sheet__header {
    position: absolute;
    z-index: 2;
    top: clamp(1.4rem, 3vw, 2.5rem);
    left: clamp(1.25rem, 4vw, 3.25rem);
    right: clamp(1.25rem, 4vw, 3.25rem);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    color: #1f392d;
    pointer-events: none;
  }

  .map-sheet__title-block { width: min(42rem, 70%); margin-left: auto; text-align: right; }
  .map-sheet__title-art { display: block; width: 100%; height: auto; overflow: visible; }
  .map-sheet__chapter,
  .map-sheet__title { fill: #1f392d; font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive; font-style: normal; }
  .map-sheet__chapter { font-size: 15px; font-weight: 500; letter-spacing: 0.12em; opacity: 0.62; }
  .map-sheet__title { font-size: 51px; font-weight: 550; letter-spacing: 0.01em; opacity: 0.93; }
  .map-sheet__note { position: static; flex: 0 0 auto; margin-top: 0.15rem; color: #1f392d; font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive; font-size: 16px; font-style: normal; font-weight: 500; letter-spacing: 0.08em; opacity: 0.58; white-space: nowrap; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 700px) {
    .laos-map-page { padding-top: 3.5rem; }
    .map-sheet { width: auto; padding: 0.75rem 0.75rem 10px; }
    .map-layers { width: calc(100vw - 2.5rem); height: calc(100vw - 2.5rem); }
    .map-country-layer { left: calc(50% + 24px); width: 42vw; }
    .city-marker__label { font-size: 40px; stroke-width: 8px; }
    .map-sheet__header { top: 1rem; left: 1rem; right: 1rem; }
    .map-sheet__title-block { width: min(78%, 28rem); }
    .map-sheet__note { font-size: 13px; }
    .map-sheet__chapter { font-size: 13px; }
    .map-sheet__title { font-size: 44px; }
  }
</style>
