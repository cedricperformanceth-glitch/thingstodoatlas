    author: 'Manelka Jayasundara',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Elephants_in_the_Yala_National_Park.jpg?width=1600',
    alt: 'Elephants together in the dry landscape of Yala National Park',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Elephants_in_the_Yala_National_Park.jpg',
    author: 'Manelka Jayasundara',
    license: 'CC BY-SA 4.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Wetland_-_Yala_NP.jpg?width=1600',
    alt: 'Wetland and lake habitat inside Yala National Park',
