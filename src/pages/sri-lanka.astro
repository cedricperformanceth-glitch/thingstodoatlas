];

const devilsDanceGallery = [
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Devil_Dance_Kandy_Sri_Lanka.jpg?width=1600',
    alt: 'A Sri Lankan Devil Dance performance with ritual costume and movement',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Devil_Dance_Kandy_Sri_Lanka.jpg',
    author: 'Philip Nalangan',
    license: 'CC BY-SA 3.0'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Gara_Yaka_Thovil_ceremony.jpg?width=1600',
    alt: 'A performer during a Gara Yaka thovil healing ceremony',
    sourcePage: 'https://commons.wikimedia.org/wiki/File:Gara_Yaka_Thovil_ceremony.jpg',
    author: 'Wikimedia Commons',
    license: 'CC BY-SA 4.0'
  },
  {
    src: '/images/laos/landmarks/devil-dance-03.webp',
    alt: 'Hand-drawn scene of the Devil Dance ceremony in Sri Lanka'
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Devil_mask2%28js%29.jpg?width=1600',
    alt: 'Traditional Sri Lankan Naga Raksha demon mask',
