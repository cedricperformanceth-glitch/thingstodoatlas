---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import { laos } from '../../data/atlas';
---
<BaseLayout title="Laos travel guide" description={laos.intro} canonical="https://thingstodoatlas.com/laos"><section class="page-header container"><Breadcrumbs items={[{label:'Laos'}]} /><p class="eyebrow">{laos.eyebrow}</p><h1>Take the scenic route<br /><em>through Laos.</em></h1><p class="lede">{laos.intro}</p></section><section class="section container"><div class="section-intro"><p class="eyebrow">Choose a destination</p><h2>Three different rhythms</h2><p>Start with what you want from the journey. Each place earns its place in the atlas through useful, local detail.</p></div><div class="destination-grid">{laos.destinations.map((destination) => <a class="destination-card destination-card--stack" href={destination.status === 'active' ? `/laos/${destination.slug}` : '#'} aria-disabled={destination.status !== 'active'}><img src={destination.image} alt={`${destination.name} in Laos`} loading="lazy" /><div><span>{destination.status}</span><h3>{destination.name}</h3><p>{destination.description}</p>{destination.status === 'active' && <b>Explore Pakse →</b>}</div></a>)}</div></section></BaseLayout>
