---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import ExploreBoard from '../../components/ExploreBoard.astro';
import LandmarkModalSet from '../../components/LandmarkModalSet.astro';
import CityCategorySPA from '../../components/TravelDeskCategorySPA.astro';
import CityCategoryPanel from '../../components/TravelDeskCategoryPanel.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import type { Place } from '../../data/atlas';
import { donDetLandmarks } from '../../data/donDetLandmarks';
import { donDetStays } from '../../data/donDetPlaces';
import donDetDrawingUrl from '../../../calque SVG/laos-mekong-fisherman.webp?url';

const donDetPostcardFacts = [
  { label: 'August 2026', icon: 'calendar' as const },
  { label: 'Bicycle island base', icon: 'road' as const },
  { label: 'Tropical Mekong', icon: 'climate' as const },
  { label: 'Si Phan Don', icon: 'location' as const }
];

const getLandmarkFact = (landmark: (typeof donDetLandmarks)[number], label: string) =>
  landmark.facts.find((fact) => fact.label === label)?.value || 'Check the latest local information before leaving Don Det.';

const activityDetails: Record<string, {
  subcategory: string;
  cardNote: string;
  whyWeRecommend: string;
  highlights: string[];
  bestFor: string;
}> = {
  'don-khon-railway-bridge': {
    subcategory: 'Island bicycle route',
    cardNote: 'cross into Don Khon',
    whyWeRecommend: 'This is the easiest way to turn a stay on Don Det into a real island journey. The bridge, village paths and old railway traces make a natural half-day route without needing a complicated excursion.',
    highlights: ['Old railway bridge', 'Bicycle-friendly route', 'Don Khon village paths', 'Half-day island loop'],
    bestFor: 'Cycling, walking and an easy island day'
  },
  'khone-phapheng-falls': {
    subcategory: 'Mekong waterfall excursion',
    cardNote: 'see the river at full scale',
    whyWeRecommend: 'Khone Phapheng shows the southern Mekong at a completely different scale from the calm water around Don Det. It works best as a dedicated half-day trip rather than a quick roadside stop.',
    highlights: ['Major Mekong cataracts', 'Multiple viewpoints', 'Half-day excursion', 'Near the Cambodian border'],
    bestFor: 'A dramatic Mekong landscape beyond the islands'
  },
  'cambodia-from-don-det': {
    subcategory: 'International onward route',
    cardNote: 'prepare the border day',
    whyWeRecommend: 'Don Det is often the final Lao stop before Cambodia. Saving this route as a proper address card keeps the border, transport and timing notes together before the transfer day.',
    highlights: ['Nakasang connection', 'International land border', 'Route toward Stung Treng', 'Full transfer day'],
    bestFor: 'Planning the onward journey from Laos to Cambodia'
  }
};

const donDetThingsToDo: Place[] = donDetLandmarks.map((landmark) => {
  const image = landmark.gallery[0];
  const details = activityDetails[landmark.slug];

  return {
    slug: landmark.slug,
    name: landmark.name,
    category: 'things-to-do',
    subcategory: details.subcategory,
    cuisine: 'Experience',
    city: 'Don Det',
    country: landmark.country,
    image: image?.src || '/images/laos/don-det.webp',
    imageAlt: image?.alt || `${landmark.name} near Don Det`,
    cardNote: details.cardNote,
    shortDescription: landmark.cityContext.summary,
    description: landmark.description,
    whyWeRecommend: details.whyWeRecommend,
    highlights: details.highlights,
    mapsUrl: landmark.mapsUrl,
    status: 'needs-review',
    lastChecked: 'August 2026',
    hours: getLandmarkFact(landmark, 'Best time'),
    price: getLandmarkFact(landmark, 'Price'),
    address: landmark.region,
    bestFor: details.bestFor,
    imageSourceUrl: image?.sourcePage || null,
    imageSourceType: image?.sourcePage ? 'wikimedia' : undefined,
    imageAuthor: image?.author || null,
    imageLicense: image?.license || null,
    imageIsGeneric: false
  };
});

const getStaySide = (address: string) => {
  const normalizedAddress = address.toLowerCase();
  if (normalizedAddress.includes('sunset')) return 'Sunset side';
  if (normalizedAddress.includes('sunrise')) return 'Sunrise side';
  if (normalizedAddress.includes('northern') || normalizedAddress.includes('main pier')) return 'Near the arrival area';
  return 'Don Det island base';
};

const donDetGuesthouses: Place[] = donDetStays.map((stay) => ({
  slug: stay.slug,
  name: stay.name,
  category: stay.category,
  subcategory: stay.subcategory,
  cuisine: 'Accommodation',
  city: stay.city,
  country: stay.country,
  image: stay.image,
  imageAlt: stay.imageAlt,
  cardNote: stay.subcategory.toLowerCase(),
  shortDescription: stay.shortDescription,
  description: stay.shortDescription,
  whyWeRecommend: `Keep ${stay.name} in the notebook as a practical ${stay.subcategory.toLowerCase()} option on Don Det. Open the saved address to compare its location with the pier, the sunrise side and the sunset side before booking directly.`,
  highlights: [stay.subcategory, getStaySide(stay.address), 'Google Maps address saved', 'Independent island shortlist'],
  mapsUrl: stay.mapsUrl,
  status: 'needs-review',
  lastChecked: 'August 2026',
  hours: 'Confirm check-in and reception hours directly',
  price: 'Check current room rates directly',
  address: stay.address,
  bestFor: stay.subcategory,
  imageIsGeneric: !stay.imageSourceLabel.startsWith('PROPERTY PHOTO')
}));

const emptyPlaces: Place[] = [];
const addressCategories = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · RIVER · SLOW', icon: 'restaurants' as const, noun: 'restaurants', fieldNote: '01', places: emptyPlaces },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · SHADE · PAUSE', icon: 'cafes' as const, noun: 'cafés', fieldNote: '02', places: emptyPlaces },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · ISLAND · SIMPLE', icon: 'guesthouses' as const, noun: 'stays', fieldNote: '03', places: donDetGuesthouses },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'BOATS · MONEY · BORDER', icon: 'essential' as const, noun: 'useful addresses', fieldNote: '05', places: emptyPlaces }
];

const firstAddressCategories = addressCategories.slice(0, 3);
const essentialCategory = addressCategories[3];

const categoryTabs = [
  ...firstAddressCategories.map(({ slug, title, kicker, icon, places }) => ({
    slug,
    title,
    kicker,
    icon,
    count: places.length,
    ...(places.length === 0 ? { countLabel: 'notes soon' } : {})
  })),
  {
    slug: 'things-to-do',
    title: 'Things to do',
    kicker: 'CYCLE · BOAT · EXPLORE',
    icon: 'explore' as const,
    count: donDetThingsToDo.length
  },
  {
    slug: essentialCategory.slug,
    title: essentialCategory.title,
    kicker: essentialCategory.kicker,
    icon: essentialCategory.icon,
    count: essentialCategory.places.length,
    countLabel: 'notes soon'
  }
];
---

<BaseLayout
  title="Things to do in Don Det, Laos"
  description="Prepare a stay on Don Det with island routes to Don Khon, Khone Phapheng Falls, Cambodia and a shortlist of highly rated island guesthouses."
  canonical="https://thingstodoatlas.com/laos/don-det"
>
  <main class="don-det-page">
    <div class="pakse-page don-det-envelope-host">
      <CityPostcardHero
        cityName="Don Det"
        description={[
          'A small Mekong island where bicycles, hammocks and river paths',
          'replace the road. Don Det is a base for Don Khon, the southern',
          'waterfalls and the onward journey toward Cambodia.'
        ]}
        photoSrc="/images/laos/don-det.webp"
        photoAlt="Riverside scenery on Don Det in the Four Thousand Islands of southern Laos"
        facts={donDetPostcardFacts}
        backHref="/laos"
        backLabel="Back to the Laos map"
        drawingSrc={donDetDrawingUrl}
        drawingAlt="Hand-drawn Mekong fisherman beside a small river boat"
        drawingCaption="Mekong islands · the road becomes a river"
      />
    </div>

    <ExploreBoard
      cityName="Don Det"
      landmarks={donDetLandmarks}
      eyebrow="What can I actually do from Don Det?"
      title="Explore from Don Det"
      intro="Cross into Don Khon, follow the old railway route, stand above the southern Mekong falls, or use the island as the final Lao stop before Cambodia."
      note="Here, the road narrows into island paths — and eventually reaches a border."
      wide
    />

    <CityCategorySPA
      cityName="Don Det"
      categories={categoryTabs}
      defaultSlug="accommodation"
      title="Plan your stay in Don Det"
      intro=""
      transitionTitle="Now for the practical side."
      transitionText="Eat · sleep · explore · prepare the river ahead"
    >
      {firstAddressCategories.map((category) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Don Det"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro=""
          fieldNote={category.fieldNote}
          active={category.slug === 'accommodation'}
        >
          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, index) => (
                <PlaceCard place={place} index={index} />
              ))}
            </div>
          ) : (
            <div class="city-panel-empty">
              <h4>This notebook tab is ready.</h4>
              <p>Checked Don Det addresses will appear here as the island guide is documented.</p>
            </div>
          )}
        </CityCategoryPanel>
      ))}

      <CityCategoryPanel
        slug="things-to-do"
        cityName="Don Det"
        title="Things to do"
        count={donDetThingsToDo.length}
        noun="addresses"
        intro=""
        fieldNote="04"
      >
        <div class="city-panel-list">
          {donDetThingsToDo.map((place, index) => (
            <PlaceCard place={place} index={index} />
          ))}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel
        slug={essentialCategory.slug}
        cityName="Don Det"
        title={essentialCategory.title}
        count={essentialCategory.places.length}
        noun={essentialCategory.noun}
        intro=""
        fieldNote={essentialCategory.fieldNote}
      >
        <div class="city-panel-empty">
          <h4>This notebook tab is ready.</h4>
          <p>Checked Don Det addresses will appear here as the island guide is documented.</p>
        </div>
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
  <LandmarkModalSet landmarks={donDetLandmarks} />
</BaseLayout>

<style>
  .don-det-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }
</style>

<style is:global>
  #main-content .pakse-page.don-det-envelope-host .city-postcard::before {
    background-image: url('/images/laos/don-det-airmail-envelope-stamped-v1.webp');
  }
</style>