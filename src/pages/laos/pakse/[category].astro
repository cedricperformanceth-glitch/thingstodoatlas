---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceCard from '../../../components/PlaceCard.astro';
import { categories, getCategory, getPlacesForCategory } from '../../../data/atlas';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug } }));
}

const { category: slug } = Astro.params;
const category = getCategory(slug!);
const places = getPlacesForCategory(slug!);
if (!category) throw new Error('Category not found');
const placeCount = places.length;
const placeCountWords = [
  'Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
  'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen'
];
const placeCountLabel = placeCountWords[placeCount] ?? String(placeCount);
const placeCountNoun = placeCount === 1 ? 'place' : 'places';
const addressCountNoun = placeCount === 1 ? 'address' : 'addresses';
const hasPlaces = placeCount > 0;
const isRestaurantCategory = slug === 'restaurants';
const isCafeCategory = slug === 'cafes';
const isGymCategory = slug === 'gyms-fitness';
const isAccommodationCategory = slug === 'accommodation';
const isMarketCategory = slug === 'markets-shopping';
const isInformationCategory = slug === 'essential-information';
const pageDescription = isRestaurantCategory
  ? `${category.description} Discover practical details, what to order and why each restaurant belongs in the guide.`
  : isCafeCategory
    ? `${category.description} Discover why each café is worth saving, plus the practical details for planning your stop.`
    : isGymCategory
      ? `${category.description} Discover training styles, practical details and why each gym belongs in the guide.`
      : isAccommodationCategory
        ? `${category.description} Compare guesthouses, hostels and hotels, then save the stays that fit your trip.`
        : isMarketCategory
          ? `${category.description} Compare local markets, shopping centres and useful places to stock up.`
          : isInformationCategory
            ? `${category.description} Keep visa, hospital and healthcare locations ready before you need them.`
            : `${category.description} Discover practical rental details and why each address belongs in the guide.`;
const schemaPlaceType = isRestaurantCategory
  ? 'Restaurant'
  : isCafeCategory
    ? 'CafeOrCoffeeShop'
    : isGymCategory
      ? 'ExerciseGym'
      : isAccommodationCategory
        ? 'LodgingBusiness'
        : 'LocalBusiness';
const getSchemaPlaceType = (place: (typeof places)[number]) => {
  if (isMarketCategory) {
    if (place.subcategory === 'Shopping centre') return 'ShoppingCenter';
    if (place.subcategory === 'Supermarket') return 'GroceryStore';
    return 'Store';
  }
  if (isInformationCategory) {
    if (place.subcategory === 'Immigration office') return 'GovernmentOffice';
    if (place.subcategory === 'Provincial hospital') return 'Hospital';
    if (place.subcategory === 'Dental clinic') return 'Dentist';
  }
  return schemaPlaceType;
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.name} in Pakse`,
  itemListElement: places.map((place, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': getSchemaPlaceType(place),
      name: place.name,
      ...(isRestaurantCategory || isCafeCategory ? { servesCuisine: place.cuisine } : {}),
      image: place.image,
      telephone: place.phone || undefined,
      priceRange: place.status === 'verified' ? place.price : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: place.address,
        addressLocality: place.city,
        addressCountry: 'LA'
      },
      hasMap: place.mapsUrl,
      url: `https://thingstodoatlas.com/laos/pakse/${slug}#${place.slug}`
    }
  }))
};
---
<BaseLayout
  title={`${category.name} in Pakse`}
  description={pageDescription}
  canonical={`https://thingstodoatlas.com/laos/pakse/${slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="restaurant-listing container" aria-labelledby="restaurant-list-title">
    <header class="restaurant-listing__header">
      <div>
        <p class="eyebrow">The shortlist</p>
        <h1 id="restaurant-list-title">
          {hasPlaces ? <>{placeCountLabel} {placeCountNoun} to<br /><em>begin with.</em></> : <>{category.name}<br /><em>field guide.</em></>}
        </h1>
      </div>
      <div class="restaurant-listing__aside">
        <span>{String(placeCount).padStart(2, '0')}</span>
        <p>{addressCountNoun} in<br />the notebook</p>
      </div>
    </header>

    <div class="restaurant-listing__rule">
      <span>{hasPlaces ? 'Choose a card to open the full field note' : 'Field notes underway'}</span>
      <span>Pakse · updated July 2026</span>
    </div>

    {hasPlaces ? (
      <div class="place-list">
        {places.map((place, index) => <PlaceCard place={place} index={index} />)}
      </div>
    ) : (
      <div class="restaurant-listing__empty">
        <p class="eyebrow">Coming together</p>
        <h2>The useful stops are being documented.</h2>
        <p>This page is ready, but the shortlist will only be published once the addresses and field notes have been checked.</p>
        <a href="/laos/pakse">Back to the Pakse notebook →</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .restaurant-listing { padding: 118px 0 140px; }
  .restaurant-listing__header {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: end;
    margin-bottom: 48px;
  }
  .restaurant-listing__header h1 { margin-bottom: 0; font-size: clamp(2.5rem, 5vw, 4.9rem); }
  .restaurant-listing__aside {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-bottom: 9px;
    color: var(--muted);
  }
  .restaurant-listing__aside span { color: var(--terracotta); font: 500 2.4rem/1 Fraunces, serif; }
  .restaurant-listing__aside p {
    margin: 0;
    font-size: .58rem;
    letter-spacing: .11em;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .restaurant-listing__rule {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: .58rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .place-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 32px);
    align-items: stretch;
  }
  .restaurant-listing__empty {
    max-width: 670px;
    padding: clamp(34px, 5vw, 66px) 0 8px;
  }
  .restaurant-listing__empty h2 {
    margin: 8px 0 16px;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }
  .restaurant-listing__empty > p:not(.eyebrow) {
    max-width: 590px;
    color: var(--muted);
  }
  .restaurant-listing__empty a {
    display: inline-block;
    margin-top: 22px;
    color: var(--terracotta);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  @media (max-width: 980px) {
    .place-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .restaurant-listing { padding: 94px 0 92px; }
    .restaurant-listing__header { align-items: flex-end; margin-bottom: 34px; }
    .restaurant-listing__header h1 { font-size: clamp(2.75rem, 12vw, 3.7rem); }
    .restaurant-listing__aside { display: none; }
    .restaurant-listing__rule { display: grid; gap: 7px; }
    .place-list { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
