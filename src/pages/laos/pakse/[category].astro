---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceCard from '../../../components/PlaceCard.astro';
import { categories, getCategory, getPlacesForCategory } from '../../../data/atlas';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug } }));
}

const { category: slug } = Astro.params;
const category = getCategory(slug!);
const places = getPlacesForCategory(slug!);
if (!category) throw new Error('Category not found');
const placeCount = places.length;
const placeCountWords = [
  'Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
  'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen'
];
const placeCountLabel = placeCountWords[placeCount] ?? String(placeCount);
const placeCountNoun = placeCount === 1 ? 'place' : 'places';
const addressCountNoun = placeCount === 1 ? 'address' : 'addresses';
const hasPlaces = placeCount > 0;
const isRestaurantCategory = slug === 'restaurants';
const isCafeCategory = slug === 'cafes';
const isGymCategory = slug === 'gyms-fitness';
const isAccommodationCategory = slug === 'accommodation';
const isMarketCategory = slug === 'markets-shopping';
const isInformationCategory = slug === 'essential-information';
const pageDescription = isRestaurantCategory
  ? `${category.description} Discover practical details, what to order and why each restaurant belongs in the guide.`
  : isCafeCategory
    ? `${category.description} Discover why each café is worth saving, plus the practical details for planning your stop.`
    : isGymCategory
      ? `${category.description} Discover training styles, practical details and why each gym belongs in the guide.`
      : isAccommodationCategory
        ? `${category.description} Compare guesthouses, hostels and hotels, then save the stays that fit your trip.`
        : isMarketCategory
          ? `${category.description} Compare local markets, shopping centres and useful places to stock up.`
          : isInformationCategory
            ? `${category.description} Keep visa, hospital and healthcare locations ready before you need them.`
            : `${category.description} Discover practical rental details and why each address belongs in the guide.`;
const schemaPlaceType = isRestaurantCategory
  ? 'Restaurant'
  : isCafeCategory
    ? 'CafeOrCoffeeShop'
    : isGymCategory
      ? 'ExerciseGym'
      : isAccommodationCategory
        ? 'LodgingBusiness'
        : 'LocalBusiness';
const getSchemaPlaceType = (place: (typeof places)[number]) => {
  if (isMarketCategory) {
    if (place.subcategory === 'Shopping centre') return 'ShoppingCenter';
    if (place.subcategory === 'Supermarket') return 'GroceryStore';
    return 'Store';
  }
  if (isInformationCategory) {
    if (place.subcategory === 'Immigration office') return 'GovernmentOffice';
    if (place.subcategory === 'Provincial hospital') return 'Hospital';
    if (place.subcategory === 'Dental clinic') return 'Dentist';
  }
  return schemaPlaceType;
};

const restaurantFilters = [
  { value: 'all', label: 'All' },
  { value: 'lao', label: 'Lao' },
  { value: 'european', label: 'European' },
  { value: 'bar', label: 'Bar' }
] as const;

const getRestaurantFilterTags = (place: (typeof places)[number]) => {
  const cuisineAndType = `${place.cuisine} ${place.subcategory}`.toLowerCase();
  const barDetails = `${place.subcategory} ${place.highlights.join(' ')}`.toLowerCase();
  const tags = ['all'];

  if (/\blao\b/.test(cuisineAndType)) tags.push('lao');
  if (/(french|italian|european)/.test(place.cuisine.toLowerCase())) tags.push('european');
  if (/(\bbar\b|beer garden|restaurant and bar)/.test(barDetails)) tags.push('bar');

  return tags;
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.name} in Pakse`,
  itemListElement: places.map((place, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': getSchemaPlaceType(place),
      name: place.name,
      ...(isRestaurantCategory || isCafeCategory ? { servesCuisine: place.cuisine } : {}),
      image: place.image,
      telephone: place.phone || undefined,
      priceRange: place.status === 'verified' ? place.price : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: place.address,
        addressLocality: place.city,
        addressCountry: 'LA'
      },
      hasMap: place.mapsUrl,
      url: `https://thingstodoatlas.com/laos/pakse/${slug}#${place.slug}`
    }
  }))
};
---
<BaseLayout
  title={`${category.name} in Pakse`}
  description={pageDescription}
  canonical={`https://thingstodoatlas.com/laos/pakse/${slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section
    class:list={[
      'restaurant-listing',
      'container',
      { 'restaurant-listing--restaurants': isRestaurantCategory }
    ]}
    aria-labelledby="restaurant-list-title"
  >
    {isRestaurantCategory ? (
      <header class="chapter-sheet">
        <div class="chapter-sheet__meta" aria-label="Chapter information">
          <div>
            <span>Field Note 04</span>
            <strong>Restaurants</strong>
          </div>
          <div>
            <span>Pakse, Laos</span>
            <strong>Updated July 2026</strong>
          </div>
        </div>

        <div class="chapter-sheet__title">
          <h1 id="restaurant-list-title">
            <span>{placeCount} restaurants in Pakse</span>
            <em>to begin with.</em>
          </h1>
          <p>
            From local Lao kitchens to European tables and late-night bars, these are the addresses
            worth keeping in your notebook.
          </p>
        </div>

        <nav class="chapter-filters" aria-label="Filter Pakse restaurants">
          {restaurantFilters.map((filter) => (
            <button
              class:list={['chapter-filter', { 'is-active': filter.value === 'all' }]}
              type="button"
              data-restaurant-filter={filter.value}
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))}
        </nav>
        <p class="restaurant-filter__status" data-filter-status aria-live="polite">
          {placeCount} addresses shown
        </p>
      </header>
    ) : (
      <header class="restaurant-listing__header">
        <div>
          <p class="eyebrow">The shortlist</p>
          <h1 id="restaurant-list-title">
            {hasPlaces ? <>{placeCountLabel} {placeCountNoun} to<br /><em>begin with.</em></> : <>{category.name}<br /><em>field guide.</em></>}
          </h1>
        </div>
        <div class="restaurant-listing__aside">
          <span>{String(placeCount).padStart(2, '0')}</span>
          <p>{addressCountNoun} in<br />the notebook</p>
        </div>
      </header>
    )}

    {!isRestaurantCategory && (
      <div class="restaurant-listing__rule">
        <span>{hasPlaces ? 'Choose a card to open the full field note' : 'Field notes underway'}</span>
        <span>Pakse · updated July 2026</span>
      </div>
    )}

    {hasPlaces ? (
      <div class="place-list">
        {places.map((place, index) => isRestaurantCategory ? (
          <div
            class="place-list__item"
            data-restaurant-card
            data-filter-tags={getRestaurantFilterTags(place).join(' ')}
          >
            <PlaceCard place={place} index={index} />
          </div>
        ) : (
          <PlaceCard place={place} index={index} />
        ))}
      </div>
    ) : (
      <div class="restaurant-listing__empty">
        <p class="eyebrow">Coming together</p>
        <h2>The useful stops are being documented.</h2>
        <p>This page is ready, but the shortlist will only be published once the addresses and field notes have been checked.</p>
        <a href="/laos/pakse">Back to the Pakse notebook →</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .restaurant-listing { padding: 118px 0 140px; }
  .restaurant-listing--restaurants { padding-top: 88px; }
  .restaurant-listing__header {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: end;
    margin-bottom: 48px;
  }
  .restaurant-listing__header h1 { margin-bottom: 0; font-size: clamp(2.5rem, 5vw, 4.9rem); }
  .restaurant-listing__aside {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-bottom: 9px;
    color: var(--muted);
  }
  .restaurant-listing__aside span { color: var(--terracotta); font: 500 2.4rem/1 Fraunces, serif; }
  .restaurant-listing__aside p {
    margin: 0;
    font-size: .58rem;
    letter-spacing: .11em;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .restaurant-listing__rule {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: .58rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .chapter-sheet {
    position: relative;
    z-index: 1;
    padding: clamp(26px, 4vw, 43px) clamp(24px, 5vw, 62px) clamp(47px, 6vw, 68px);
    border: 1px solid rgba(75, 81, 70, .2);
    border-bottom: 0;
    background: #f0eadf;
    box-shadow: 0 18px 42px rgba(49, 85, 69, .08);
  }
  .chapter-sheet::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: -18px;
    left: -1px;
    height: 20px;
    background: #f0eadf;
    clip-path: polygon(
      0 0, 100% 0, 100% 44%, 96% 72%, 91% 47%, 86% 83%, 80% 55%,
      74% 77%, 68% 50%, 62% 88%, 56% 58%, 49% 80%, 43% 48%, 36% 84%,
      30% 54%, 23% 76%, 17% 46%, 11% 82%, 5% 53%, 0 72%
    );
  }
  .chapter-sheet__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(75, 81, 70, .24);
  }
  .chapter-sheet__meta div {
    display: grid;
    gap: 7px;
  }
  .chapter-sheet__meta div:last-child { text-align: right; }
  .chapter-sheet__meta span,
  .chapter-sheet__meta strong {
    color: var(--green);
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .13em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .chapter-sheet__meta strong { color: var(--terracotta); }
  .chapter-sheet__title { margin-top: clamp(37px, 5vw, 60px); }
  .chapter-sheet__title h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.8rem, 5.8vw, 5.65rem);
    line-height: .97;
  }
  .chapter-sheet__title h1 span,
  .chapter-sheet__title h1 em { display: block; }
  .chapter-sheet__title h1 em { color: var(--green); }
  .chapter-sheet__title p {
    max-width: 710px;
    margin: 24px 0 31px;
    color: var(--muted);
    font-size: clamp(.82rem, 1.2vw, .94rem);
    line-height: 1.7;
  }
  .chapter-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 12px;
    align-items: center;
  }
  .chapter-filter {
    position: relative;
    flex: 0 0 auto;
    min-width: 62px;
    padding: 10px 17px;
    border: 0;
    background: transparent;
    color: var(--green);
    font: 700 .61rem/1 'DM Sans', sans-serif;
    letter-spacing: .11em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .chapter-filter::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(49, 85, 69, .36);
    border-radius: 48% 52% 46% 54% / 54% 46% 55% 45%;
    transform: rotate(.6deg);
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .chapter-filter:nth-child(even)::before { transform: rotate(-.8deg); }
  .chapter-filter:hover { color: var(--terracotta); transform: translateY(-1px); }
  .chapter-filter:hover::before { border-color: var(--terracotta); transform: rotate(-1deg); }
  .chapter-filter.is-active {
    border-radius: 48% 52% 46% 54% / 54% 46% 55% 45%;
    background: var(--green);
    color: var(--white);
  }
  .chapter-filter.is-active::before { border-color: var(--green); }
  .chapter-filter:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }
  .restaurant-filter__status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }
  .place-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 32px);
    align-items: stretch;
  }
  .restaurant-listing--restaurants .place-list {
    position: relative;
    z-index: 0;
    margin-top: 7px;
  }
  .place-list__item { display: contents; }
  .place-list__item[hidden] { display: none; }
  .restaurant-listing__empty {
    max-width: 670px;
    padding: clamp(34px, 5vw, 66px) 0 8px;
  }
  .restaurant-listing__empty h2 {
    margin: 8px 0 16px;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }
  .restaurant-listing__empty > p:not(.eyebrow) {
    max-width: 590px;
    color: var(--muted);
  }
  .restaurant-listing__empty a {
    display: inline-block;
    margin-top: 22px;
    color: var(--terracotta);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  @media (max-width: 980px) {
    .place-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .restaurant-listing { padding: 94px 0 92px; }
    .restaurant-listing--restaurants { padding-top: 72px; }
    .restaurant-listing__header { align-items: flex-end; margin-bottom: 34px; }
    .restaurant-listing__header h1 { font-size: clamp(2.75rem, 12vw, 3.7rem); }
    .restaurant-listing__aside { display: none; }
    .restaurant-listing__rule { display: grid; gap: 7px; }
    .chapter-sheet {
      padding: 23px 20px 48px;
      box-shadow: 0 13px 30px rgba(49, 85, 69, .08);
    }
    .chapter-sheet__meta { gap: 14px; padding-bottom: 16px; }
    .chapter-sheet__meta span,
    .chapter-sheet__meta strong { font-size: .51rem; letter-spacing: .1em; }
    .chapter-sheet__title { margin-top: 31px; }
    .chapter-sheet__title h1 { font-size: clamp(2.55rem, 12vw, 3.75rem); }
    .chapter-sheet__title p { margin: 19px 0 25px; font-size: .8rem; }
    .chapter-filters {
      flex-wrap: nowrap;
      margin-right: -20px;
      padding: 3px 20px 7px 1px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .chapter-filters::-webkit-scrollbar { display: none; }
    .chapter-filter { padding: 10px 15px; }
    .place-list { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter-filter,
    .chapter-filter::before { transition: none; }
  }
</style>

<script>
  const restaurantFilterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-restaurant-filter]')
  );
  const restaurantCards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-restaurant-card]')
  );
  const restaurantFilterStatus = document.querySelector<HTMLElement>('[data-filter-status]');

  restaurantFilterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const activeFilter = button.dataset.restaurantFilter || 'all';
      let visibleCount = 0;

      restaurantFilterButtons.forEach((filterButton) => {
        const isActive = filterButton === button;
        filterButton.classList.toggle('is-active', isActive);
        filterButton.setAttribute('aria-pressed', String(isActive));
      });

      restaurantCards.forEach((card) => {
        const filterTags = card.dataset.filterTags?.split(' ') || [];
        const isVisible = filterTags.includes(activeFilter);
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (restaurantFilterStatus) {
        restaurantFilterStatus.textContent =
          `${visibleCount} ${visibleCount === 1 ? 'address' : 'addresses'} shown`;
      }
    });
  });
</script>
