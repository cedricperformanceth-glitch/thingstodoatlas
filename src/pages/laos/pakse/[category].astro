---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceCard from '../../../components/PlaceCard.astro';
import { categories, getCategory, getPlacesForCategory } from '../../../data/atlas';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug } }));
}

const { category: slug } = Astro.params;
const category = getCategory(slug!);
const places = getPlacesForCategory(slug!);
if (!category) throw new Error('Category not found');
const placeCount = places.length;
const hasPlaces = placeCount > 0;
const isRestaurantCategory = slug === 'restaurants';
const isCafeCategory = slug === 'cafes';
const isGymCategory = slug === 'gyms-fitness';
const isAccommodationCategory = slug === 'accommodation';
const isMarketCategory = slug === 'markets-shopping';
const isInformationCategory = slug === 'essential-information';
const pageDescription = isRestaurantCategory
  ? `${category.description} Discover practical details, what to order and why each restaurant belongs in the guide.`
  : isCafeCategory
    ? `${category.description} Discover why each café is worth saving, plus the practical details for planning your stop.`
    : isGymCategory
      ? `${category.description} Discover training styles, practical details and why each gym belongs in the guide.`
      : isAccommodationCategory
        ? `${category.description} Compare guesthouses, hostels and hotels, then save the stays that fit your trip.`
        : isMarketCategory
          ? `${category.description} Compare local markets, shopping centres and useful places to stock up.`
          : isInformationCategory
            ? `${category.description} Keep visa, hospital and healthcare locations ready before you need them.`
            : `${category.description} Discover practical details and why each address belongs in the guide.`;
const schemaPlaceType = isRestaurantCategory
  ? 'Restaurant'
  : isCafeCategory
    ? 'CafeOrCoffeeShop'
    : isGymCategory
      ? 'ExerciseGym'
      : isAccommodationCategory
        ? 'LodgingBusiness'
        : 'LocalBusiness';
const getSchemaPlaceType = (place: (typeof places)[number]) => {
  if (isMarketCategory) {
    if (place.subcategory === 'Shopping centre') return 'ShoppingCenter';
    if (place.subcategory === 'Supermarket') return 'GroceryStore';
    return 'Store';
  }
  if (isInformationCategory) {
    if (place.subcategory === 'Immigration office') return 'GovernmentOffice';
    if (place.subcategory === 'Provincial hospital') return 'Hospital';
    if (place.subcategory === 'Dental clinic') return 'Dentist';
  }
  return schemaPlaceType;
};

const categoryPresentation: Record<string, { fieldNote: string; noun: string; intro: string }> = {
  restaurants: {
    fieldNote: '04',
    noun: 'restaurants',
    intro: 'From local Lao kitchens to European tables and late-night bars, these are the addresses worth keeping in your notebook.'
  },
  cafes: {
    fieldNote: '05',
    noun: 'cafés',
    intro: 'Good coffee, calm corners and easy places to slow down for an hour in Pakse.'
  },
  accommodation: {
    fieldNote: '06',
    noun: 'stays',
    intro: 'Simple guesthouses, comfortable hotels and practical bases for exploring Pakse and the south.'
  },
  'scooter-rental': {
    fieldNote: '07',
    noun: 'rental addresses',
    intro: 'Trusted places to find a scooter, check the basics and prepare for the roads beyond town.'
  },
  'bolaven-loop': {
    fieldNote: '08',
    noun: 'loop notes',
    intro: 'Routes, waterfalls, coffee stops and practical field notes for the road into the Bolaven Plateau.'
  },
  waterfalls: {
    fieldNote: '09',
    noun: 'waterfalls',
    intro: 'The cascades and river landscapes worth adding to a route through Southern Laos.'
  },
  'things-to-do': {
    fieldNote: '10',
    noun: 'things to do',
    intro: 'Ideas for a day, a weekend or a longer stay, gathered into one practical field guide.'
  },
  'gyms-fitness': {
    fieldNote: '11',
    noun: 'places to train',
    intro: 'Muay Lao camps, weight rooms and useful places to keep moving while you are in Pakse.'
  },
  'markets-shopping': {
    fieldNote: '12',
    noun: 'markets and shops',
    intro: 'Fresh markets, evening stalls and practical shops worth knowing around Pakse.'
  },
  'essential-information': {
    fieldNote: '13',
    noun: 'useful addresses',
    intro: 'Visa services, healthcare and practical locations to keep close before you need them.'
  }
};
const presentation = categoryPresentation[slug!] ?? {
  fieldNote: category.icon,
  noun: category.name.toLowerCase(),
  intro: category.description
};

const restaurantFilters = [
  { value: 'all', label: 'All' },
  { value: 'lao', label: 'Lao' },
  { value: 'european', label: 'European' },
  { value: 'bar', label: 'Bar' }
] as const;

const getRestaurantFilterTags = (place: (typeof places)[number]) => {
  const cuisineAndType = `${place.cuisine} ${place.subcategory}`.toLowerCase();
  const barDetails = `${place.subcategory} ${place.highlights.join(' ')}`.toLowerCase();
  const tags = ['all'];
  if (/\blao\b/.test(cuisineAndType)) tags.push('lao');
  if (/(french|italian|european)/.test(place.cuisine.toLowerCase())) tags.push('european');
  if (/(\bbar\b|beer garden|restaurant and bar)/.test(barDetails)) tags.push('bar');
  return tags;
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category.name} in Pakse`,
  itemListElement: places.map((place, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': getSchemaPlaceType(place),
      name: place.name,
      ...(isRestaurantCategory || isCafeCategory ? { servesCuisine: place.cuisine } : {}),
      image: place.image,
      telephone: place.phone || undefined,
      priceRange: place.status === 'verified' ? place.price : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: place.address,
        addressLocality: place.city,
        addressCountry: 'LA'
      },
      hasMap: place.mapsUrl,
      url: `https://thingstodoatlas.com/laos/pakse/${slug}#${place.slug}`
    }
  }))
};
---
<BaseLayout
  title={`${category.name} in Pakse`}
  description={pageDescription}
  canonical={`https://thingstodoatlas.com/laos/pakse/${slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="restaurant-listing restaurant-listing--editorial container" aria-labelledby="restaurant-list-title">
    <header class="chapter-sheet">
      <div class="chapter-sheet__meta" aria-label="Chapter information">
        <div>
          <span>Field Note {presentation.fieldNote}</span>
          <strong>{category.name}</strong>
        </div>
        <div>
          <span>Pakse, Laos</span>
          <strong>Updated July 2026</strong>
        </div>
      </div>

      <div class="chapter-sheet__title">
        <h1 id="restaurant-list-title">
          <span>{placeCount} {presentation.noun} in Pakse</span>
          <em>{hasPlaces ? 'to begin with.' : 'field guide.'}</em>
        </h1>
        <div class="chapter-sheet__aside">
          <p>{presentation.intro}</p>
          {isRestaurantCategory && (
            <>
              <nav class="chapter-filters" aria-label="Filter Pakse restaurants">
                {restaurantFilters.map((filter) => (
                  <button
                    class:list={['chapter-filter', { 'is-active': filter.value === 'all' }]}
                    type="button"
                    data-restaurant-filter={filter.value}
                    aria-pressed={filter.value === 'all' ? 'true' : 'false'}
                  >
                    {filter.label}
                  </button>
                ))}
              </nav>
              <p class="restaurant-filter__status" data-filter-status aria-live="polite">
                {placeCount} addresses shown
              </p>
            </>
          )}
        </div>
      </div>
    </header>

    {hasPlaces ? (
      <div class="place-list">
        {places.map((place, index) => isRestaurantCategory ? (
          <div
            class="place-list__item"
            data-restaurant-card
            data-filter-tags={getRestaurantFilterTags(place).join(' ')}
          >
            <PlaceCard place={place} index={index} />
          </div>
        ) : (
          <div class="place-list__item">
            <PlaceCard place={place} index={index} />
          </div>
        ))}
      </div>
    ) : (
      <div class="restaurant-listing__empty">
        <p class="eyebrow">Coming together</p>
        <h2>The useful stops are being documented.</h2>
        <p>This page is ready, but the shortlist will only be published once the addresses and field notes have been checked.</p>
        <a href="/laos/pakse">Back to the Pakse notebook →</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .restaurant-listing { padding: 88px 0 140px; }
  .chapter-sheet {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(38px, 4.5vw, 58px);
  }
  .chapter-sheet__meta {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
    margin-bottom: clamp(42px, 5vw, 66px);
    padding: 18px clamp(20px, 2.6vw, 34px) 24px;
    border: 0;
    border-bottom: 0;
    background: #ffffff;
    box-shadow: 0 9px 24px rgba(49, 85, 69, .055);
  }
  .chapter-sheet__meta::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 10px;
    background: #ffffff;
    clip-path: polygon(
      0 0, 100% 0, 100% 42%, 96% 72%, 91% 48%, 86% 80%, 81% 52%,
      75% 76%, 69% 46%, 63% 82%, 57% 54%, 51% 74%, 45% 48%, 39% 80%,
      33% 51%, 27% 77%, 21% 47%, 15% 82%, 9% 52%, 4% 74%, 0 48%
    );
  }
  .chapter-sheet__meta div { display: grid; gap: 5px; }
  .chapter-sheet__meta div:last-child { text-align: right; }
  .chapter-sheet__meta span,
  .chapter-sheet__meta strong {
    color: var(--green);
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: .13em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .chapter-sheet__meta strong { color: var(--terracotta); }
  .chapter-sheet__title {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(275px, .72fr);
    gap: clamp(38px, 5vw, 78px);
    align-items: end;
    padding: 0 clamp(4px, 1vw, 14px);
  }
  .chapter-sheet__title h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3.15rem, 4.55vw, 4.85rem);
    line-height: .95;
    letter-spacing: -.025em;
  }
  .chapter-sheet__title h1 span,
  .chapter-sheet__title h1 em { display: block; }
  .chapter-sheet__title h1 em { color: var(--green); }
  .chapter-sheet__aside { max-width: 410px; padding-bottom: 4px; }
  .chapter-sheet__aside > p {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: clamp(.78rem, 1vw, .9rem);
    line-height: 1.65;
  }
  .chapter-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 9px;
    align-items: center;
  }
  .chapter-filter {
    position: relative;
    flex: 0 0 auto;
    min-width: 57px;
    padding: 9px 14px;
    border: 0;
    background: transparent;
    color: var(--green);
    font: 700 .61rem/1 'DM Sans', sans-serif;
    letter-spacing: .11em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .chapter-filter::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(49, 85, 69, .36);
    border-radius: 48% 52% 46% 54% / 54% 46% 55% 45%;
  }
  .chapter-filter.is-active {
    border-radius: 48% 52% 46% 54% / 54% 46% 55% 45%;
    background: var(--green);
    color: var(--white);
  }
  .restaurant-filter__status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }
  .place-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 32px);
    align-items: stretch;
  }
  .place-list__item { min-width: 0; }
  .place-list__item[hidden] { display: none; }
  .restaurant-listing__empty {
    max-width: 670px;
    padding: clamp(34px, 5vw, 66px) 0 8px;
  }
  .restaurant-listing__empty h2 {
    margin: 8px 0 16px;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }
  .restaurant-listing__empty > p:not(.eyebrow) { max-width: 590px; color: var(--muted); }
  .restaurant-listing__empty a {
    display: inline-block;
    margin-top: 22px;
    color: var(--terracotta);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  @media (max-width: 980px) {
    .place-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chapter-sheet__title {
      grid-template-columns: minmax(0, 1.55fr) minmax(250px, .8fr);
      gap: 32px;
    }
    .chapter-sheet__title h1 { font-size: clamp(2.8rem, 6vw, 3.8rem); }
  }
  @media (max-width: 700px) {
    .restaurant-listing { padding: 72px 0 92px; }
    .chapter-sheet { padding-bottom: 36px; }
    .chapter-sheet__meta {
      gap: 14px;
      margin-bottom: 38px;
      padding: 15px 16px 20px;
    }
    .chapter-sheet__meta span,
    .chapter-sheet__meta strong { font-size: .51rem; letter-spacing: .1em; }
    .chapter-sheet__title {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 0 2px;
    }
    .chapter-sheet__title h1 { font-size: clamp(2.55rem, 12vw, 3.75rem); }
    .chapter-sheet__aside { max-width: 100%; padding-bottom: 0; }
    .chapter-sheet__aside > p { margin: 0 0 21px; font-size: .8rem; }
    .chapter-filters {
      flex-wrap: nowrap;
      margin-right: -2px;
      padding: 3px 2px 7px 1px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .chapter-filters::-webkit-scrollbar { display: none; }
    .chapter-filter { padding: 10px 15px; }
    .place-list { grid-template-columns: 1fr; gap: 22px; }
  }
</style>

<script>
  const restaurantFilterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-restaurant-filter]')
  );
  const restaurantCards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-restaurant-card]')
  );
  const restaurantFilterStatus = document.querySelector<HTMLElement>('[data-filter-status]');

  restaurantFilterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const activeFilter = button.dataset.restaurantFilter || 'all';
      let visibleCount = 0;
      restaurantFilterButtons.forEach((filterButton) => {
        const isActive = filterButton === button;
        filterButton.classList.toggle('is-active', isActive);
        filterButton.setAttribute('aria-pressed', String(isActive));
      });
      restaurantCards.forEach((card) => {
        const filterTags = card.dataset.filterTags?.split(' ') || [];
        const isVisible = filterTags.includes(activeFilter);
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });
      if (restaurantFilterStatus) {
        restaurantFilterStatus.textContent = `${visibleCount} ${visibleCount === 1 ? 'address' : 'addresses'} shown`;
      }
    });
  });
</script>
