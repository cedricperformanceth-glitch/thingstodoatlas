---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import WatPhouFieldGuide from '../../../../components/WatPhouFieldGuide.astro';
import LandmarkGuideFinalCta from '../../../../components/LandmarkGuideFinalCta.astro';
import { laosLandmarkPageBySlug } from '../../../../data/laosLandmarkPageRegistry';
import { watPhouImages, watPhouSchema } from '../../../../data/watPhouPrototype';
import '../../../../styles/wat-phou-field-guide.css';
import '../../../../styles/wat-phou-refinements.css';
import '../../../../styles/field-guide-position.css';
import '../../../../styles/landmark-field-guide-shared.css';

const entry = laosLandmarkPageBySlug['wat-phou'];
const publishedGallery = Object.values(watPhouImages).map((image) => ({
  src: image.src,
  alt: image.alt,
  sourcePage: image.source,
  author: image.credit,
  license: image.license
}));
---

<BaseLayout
  title="Wat Phou (Vat Phou) from Pakse"
  description="Visit Wat Phou (Vat Phou) in Champasak, Laos: Khmer temple history, UNESCO landscape, the climb, best time, transport from Pakse and practical tips."
  canonical="https://thingstodoatlas.com/laos/pakse/things-to-do/wat-phou"
>
  <script type="application/ld+json" set:html={JSON.stringify(watPhouSchema)} />
  <div class="landmark-guide-custom-page">
    <WatPhouFieldGuide />
    <div class="landmark-guide-shared-cta">
      <LandmarkGuideFinalCta entry={entry} gallery={publishedGallery} />
    </div>
  </div>

  <script>
    const wireLandmarkFieldCards = () => {
      const routes = new Map([
        ['Bolaven Plateau', '/laos/pakse/things-to-do/bolaven-plateau']
      ]);
      document.querySelectorAll<HTMLAnchorElement>('.field-guide-related-card').forEach((card) => {
        const title = card.querySelector('strong')?.textContent?.trim() || '';
        const route = routes.get(title);
        if (route) card.href = route;
      });
    };
    wireLandmarkFieldCards();
    document.addEventListener('astro:page-load', wireLandmarkFieldCards);
  </script>
</BaseLayout>
