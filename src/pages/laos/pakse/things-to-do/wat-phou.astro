---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import WatPhouFieldGuide from '../../../../components/WatPhouFieldGuide.astro';
import { watPhouSchema } from '../../../../data/watPhouPrototype';
import '../../../../styles/wat-phou-field-guide.css';
import '../../../../styles/wat-phou-refinements.css';
import '../../../../styles/field-guide-position.css';
---

<BaseLayout
  title="Wat Phou (Vat Phou) from Pakse"
  description="Visit Wat Phou (Vat Phou) in Champasak, Laos: Khmer temple history, UNESCO landscape, the climb, best time, transport from Pakse and practical tips."
  canonical="https://thingstodoatlas.com/laos/pakse/things-to-do/wat-phou"
>
  <script type="application/ld+json" set:html={JSON.stringify(watPhouSchema)} />
  <WatPhouFieldGuide />

  <script>
    const wireBolavenFieldCard = () => {
      document.querySelectorAll<HTMLAnchorElement>('.field-guide-related-card').forEach((card) => {
        const title = card.querySelector('strong')?.textContent?.trim();
        if (title === 'Bolaven Plateau') card.href = '/laos/pakse/things-to-do/bolaven-plateau';
      });
    };
    wireBolavenFieldCard();
    document.addEventListener('astro:page-load', wireBolavenFieldCard);
  </script>
</BaseLayout>
