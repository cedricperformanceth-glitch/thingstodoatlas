---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import CategoryGrid from '../../../components/CategoryGrid.astro'; import { categories, pakse } from '../../../data/atlas';
---
<BaseLayout title="Pakse travel guide" description={pakse.intro} canonical="https://thingstodoatlas.com/laos/pakse"><section class="city-hero container"><Breadcrumbs items={[{label:'Laos',href:'/laos'},{label:'Pakse'}]} /><div class="city-hero__grid"><div><p class="eyebrow">Laos · City guide</p><h1>Pakse, at<br /><em>your pace.</em></h1><p class="lede">{pakse.intro}</p></div><div class="fact-list">{pakse.essential.map((fact, index) => <div><span>0{index + 1}</span><p>{fact}</p></div>)}</div></div></section><section class="section container"><div class="section-intro"><p class="eyebrow">Explore Pakse</p><h2>Find the right page for today</h2><p>Choose a guide below. The list pages go straight to the places, with no extra step in between.</p></div><CategoryGrid active={categories.filter((category) => ['restaurants','cafes','accommodation','things-to-do','gyms-fitness'].includes(category.slug))} /></section></BaseLayout>
