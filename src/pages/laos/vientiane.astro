---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import VientianeEditorialGuide from '../../components/VientianeEditorialGuide.astro';
import ExploreBoard from '../../components/ExploreBoard.astro';
import CityCategorySPA from '../../components/TravelDeskCategorySPA.astro';
import CityCategoryPanel from '../../components/TravelDeskCategoryPanel.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import type { Place } from '../../data/atlas';
import { vientianeCityLinks } from '../../data/vientianeCityLinks';
import {
  vientianeCafes,
  vientianeGuesthouses,
  vientianeRestaurants
} from '../../data/vientianePlaces';
import vientianeDrawingUrl from '../../../calque SVG/laos-pha-that-luang.webp?url';

const vientianePostcardFacts = [
  { label: 'August 2026', icon: 'calendar' as const },
  { label: 'Capital city base', icon: 'road' as const },
  { label: 'Tropical monsoon', icon: 'climate' as const },
  { label: 'Mekong riverfront', icon: 'location' as const }
];

const emptyPlaces: Place[] = [];
const categoryTabs = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · CAPITAL · EVENING', icon: 'restaurants' as const, noun: 'restaurants', fieldNote: '01', places: vientianeRestaurants },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · BAKERY · PAUSE', icon: 'cafes' as const, noun: 'cafés', fieldNote: '02', places: vientianeCafes },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · CENTRAL · CONNECT', icon: 'guesthouses' as const, noun: 'stays', fieldNote: '03', places: vientianeGuesthouses },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · TRAFFIC · CITY', icon: 'scooter' as const, noun: 'rental addresses', fieldNote: '04', places: emptyPlaces },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'TEMPLES · RIVER · EXPLORE', icon: 'explore' as const, noun: 'experiences', fieldNote: '05', places: emptyPlaces },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · RECOVER', icon: 'gyms' as const, noun: 'places to train', fieldNote: '06', places: emptyPlaces },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', icon: 'markets' as const, noun: 'markets and shops', fieldNote: '07', places: emptyPlaces },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'HEALTH · BORDER · BASICS', icon: 'essential' as const, noun: 'useful addresses', fieldNote: '08', places: emptyPlaces }
];

const spaTabs = categoryTabs.map(({ slug, title, kicker, icon, places }) => ({
  slug,
  title,
  kicker,
  icon,
  count: places.length,
  ...(places.length === 0 ? { countLabel: 'notes soon' } : {})
}));
---

<BaseLayout
  title="Things to do in Vientiane, Laos"
  description="Prepare a stay in Vientiane with 30 restaurant addresses, 23 cafés, 25 guesthouses and direct onward city routes toward Vang Vieng, Luang Prabang and Pakse."
  canonical="https://thingstodoatlas.com/laos/vientiane"
>
  <main class="vientiane-page">
    <div class="pakse-page vientiane-envelope-host">
      <CityPostcardHero
        cityName="Vientiane"
        description={[
          'A low-rise capital of temple roofs, shaded streets and Mekong evenings.',
          'Vientiane brings national monuments, practical city services and the main',
          'connections north, south and across the Thai border into one calm base.'
        ]}
        photoSrc="https://commons.wikimedia.org/wiki/Special:Redirect/file/That_Louang_Vientiane.jpg?width=1600"
        photoAlt="Pha That Luang in Vientiane, Laos"
        facts={vientianePostcardFacts}
        backHref="/laos"
        backLabel="Back to the Laos map"
        drawingSrc={vientianeDrawingUrl}
        drawingAlt="Hand-drawn Pha That Luang monument in Vientiane"
        drawingCaption="Capital notes · temple roofs beside the Mekong"
      />
    </div>
    <VientianeEditorialGuide />

    <ExploreBoard
      cityName="Vientiane"
      landmarks={vientianeCityLinks}
      eyebrow="Where can I continue from Vientiane?"
      title="Explore from Vientiane"
      intro="Use the capital as a transport hinge: follow the railway north to Vang Vieng and Luang Prabang, or continue toward Pakse and southern Laos."
      note="Each card opens the city chapter directly."
      wide
    />

    <CityCategorySPA
      cityName="Vientiane"
      categories={spaTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Vientiane"
      intro=""
      transitionTitle="Now for the practical side."
      transitionText="Eat · sleep · pause · prepare the next connection"
    >
      {categoryTabs.map((category, index) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Vientiane"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro=""
          fieldNote={category.fieldNote}
          active={index === 0}
        >
          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, placeIndex) => (
                <PlaceCard place={place} index={placeIndex} />
              ))}
            </div>
          ) : (
            <div class="city-panel-empty">
              <h4>This notebook tab is ready.</h4>
              <p>Checked Vientiane addresses will appear here as the capital guide is documented.</p>
            </div>
          )}
        </CityCategoryPanel>
      ))}
    </CityCategorySPA>
  </main>
</BaseLayout>

<script>
  const installVientianeCityLinks = () => {
    const marker = '__vientianeExploreBoardCityLinks';
    const browserWindow = window as Window & Record<string, boolean>;
    if (browserWindow[marker]) return;
    browserWindow[marker] = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const card = target.closest<HTMLElement>('[data-open-landmark^="city-link:"]');
      if (!card) return;

      const route = card.dataset.openLandmark?.replace('city-link:', '');
      if (!route) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      window.location.assign(route);
    }, true);
  };

  installVientianeCityLinks();
  document.addEventListener('astro:page-load', installVientianeCityLinks);
</script>

<style>
  .vientiane-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }
</style>

<style is:global>
  #main-content .pakse-page.vientiane-envelope-host .city-postcard::before {
    background-image: url('/images/laos/vientiane-airmail-envelope-stamped-v1.webp');
  }
</style>
