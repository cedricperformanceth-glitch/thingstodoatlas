---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import ThakhekEditorialGuide from '../../components/ThakhekEditorialGuide.astro';
import ExploreBoard from '../../components/ExploreBoard.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import LandmarkCategoryCard from '../../components/LandmarkCategoryCard.astro';
import LandmarkModalSet from '../../components/LandmarkModalSet.astro';
import MapAddressCard from '../../components/MapAddressCard.astro';
import { thakhekLandmarks } from '../../data/thakhekLandmarks';
import {
  thakhekCafes,
  thakhekEssentialInformation,
  thakhekGuesthouses,
  thakhekMarkets,
  thakhekRestaurants,
  thakhekScooterRentals,
  thakhekThingsToDo
} from '../../data/thakhekPlaces';
import thakhekDrawingUrl from '../../../calque SVG/laos-northern-road-tuk-tuk.webp?url';

const thakhekPostcardFacts = [
  { label: 'July 2026', icon: 'calendar' as const },
  { label: 'Loop road base', icon: 'road' as const },
  { label: 'Limestone & caves', icon: 'climate' as const },
  { label: 'Khammouane Province', icon: 'location' as const }
];

const mapCategories = [
  {
    slug: 'restaurants',
    title: 'Restaurants',
    kicker: 'EAT · LOCAL · RIVERSIDE',
    icon: 'restaurants' as const,
    noun: 'restaurants',
    intro: 'A small working list of confirmed restaurants around central Thakhek and the Mekong side of town.',
    places: thakhekRestaurants
  },
  {
    slug: 'cafes',
    title: 'Cafés',
    kicker: 'COFFEE · PAUSE · SHADE',
    icon: 'cafes' as const,
    noun: 'cafés',
    intro: 'Coffee stops for a slow morning, a planning session or a break before returning to the road.',
    places: thakhekCafes
  },
  {
    slug: 'guesthouses',
    title: 'Guesthouses',
    kicker: 'SLEEP · LOOP · OLD TOWN',
    icon: 'guesthouses' as const,
    noun: 'stays',
    intro: 'Hostels, bungalows and resort-style bases for the first or final night of the Thakhek Loop.',
    places: thakhekGuesthouses
  },
  {
    slug: 'scooter-rental',
    title: 'Motorbike Rental',
    kicker: 'KEYS · HELMET · LOOP',
    icon: 'scooter' as const,
    noun: 'rental addresses',
    intro: 'Central rental addresses to compare before starting the loop. Always inspect the bike and rental terms before leaving.',
    places: thakhekScooterRentals
  },
  {
    slug: 'markets-shopping',
    title: 'Markets',
    kicker: 'NIGHT · FOOD · LOCAL',
    icon: 'markets' as const,
    noun: 'markets',
    intro: 'Local market addresses for an evening walk, simple food and a look at everyday Thakhek after sunset.',
    places: thakhekMarkets
  },
  {
    slug: 'essential-information',
    title: 'Essential Information',
    kicker: 'HEALTH · HELP · BASICS',
    icon: 'essential' as const,
    noun: 'useful addresses',
    intro: 'Practical addresses worth saving before they are needed, beginning with the provincial hospital.',
    places: thakhekEssentialInformation
  }
];

const categoryTabs = [
  ...mapCategories.map(({ slug, title, kicker, icon, places }) => ({ slug, title, kicker, icon, count: places.length })),
  {
    slug: 'things-to-do',
    title: 'Things to do',
    kicker: 'CAVES · WATER · EXPLORE',
    icon: 'explore' as const,
    count: thakhekLandmarks.length + thakhekThingsToDo.length
  }
];
---

<BaseLayout
  title="Things to do in Thakhek, Laos"
  description="Use Thakhek as a base for the Thakhek Loop, caves, river stops, restaurants, cafés, guesthouses, motorbike rentals and practical local addresses."
  canonical="https://thingstodoatlas.com/laos/thakhek"
>
  <main class="thakhek-page">
    <CityPostcardHero
      cityName="Thakhek"
      description={[
        'A Mekong town that becomes a starting line for limestone roads,',
        'cave country and the long arc of the Thakhek Loop. Stay for the',
        'old streets, then let the road carry the chapter east.'
      ]}
      photoSrc="/images/places/thakhek-01.webp"
      photoAlt="Historic streets of Thakhek in central Laos"
      facts={thakhekPostcardFacts}
      backHref="/laos"
      backLabel="Back to the Laos map"
      drawingSrc={thakhekDrawingUrl}
      drawingAlt="Hand-drawn Lao tuk-tuk travelling along an open road"
      drawingCaption="Road notes · the loop turns east"
    />
    <ThakhekEditorialGuide />

    <ExploreBoard
      cityName="Thakhek"
      landmarks={thakhekLandmarks}
      eyebrow="What can I actually do from Thakhek?"
      title="Explore from Thakhek"
      intro="Thakhek is the starting point for the limestone roads of Khammouane. Choose a cave journey to open its complete field note, practical details and route information."
      note="The town is the base. The loop begins when the road turns east."
      wide
    />

    <CityCategorySPA
      cityName="Thakhek"
      categories={categoryTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Thakhek"
      intro="Choose the useful section you need: food, coffee, accommodation, motorbike rental, markets, practical information or places to explore."
    >
      {mapCategories.map((category, categoryIndex) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Thakhek"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro={category.intro}
          active={categoryIndex === 0}
        >
          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, index) => <MapAddressCard place={place} cityName="Thakhek" index={index} />)}
            </div>
          ) : (
            <div class="city-panel-empty">
              <h4>The useful stops are being documented.</h4>
              <p>This section will fill as soon as its addresses have been checked.</p>
            </div>
          )}
        </CityCategoryPanel>
      ))}

      <CityCategoryPanel
        slug="things-to-do"
        cityName="Thakhek"
        title="Things to do"
        count={thakhekLandmarks.length + thakhekThingsToDo.length}
        noun="places and field notes"
        intro="Caves, river stops and shorter local explorations gathered in one section."
      >
        <div class="city-panel-list">
          {thakhekLandmarks.map((landmark, index) => (
            <LandmarkCategoryCard landmark={landmark} index={index} />
          ))}
          {thakhekThingsToDo.map((place, index) => (
            <MapAddressCard place={place} cityName="Thakhek" index={index + thakhekLandmarks.length} />
          ))}
        </div>
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
  <LandmarkModalSet landmarks={thakhekLandmarks} />
</BaseLayout>

<style>
  .thakhek-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }
</style>
