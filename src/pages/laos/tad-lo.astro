---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import TadLoEditorialGuide from '../../components/TadLoEditorialGuide.astro';
import ExploreBoard from '../../components/ExploreBoard.astro';
import CityCategorySPA from '../../components/TravelDeskCategorySPA.astro';
import CityCategoryPanel from '../../components/TravelDeskCategoryPanel.astro';
import PartnerPlaceCard from '../../components/PartnerPlaceCard.astro';
import ActivityLinkCard from '../../components/ActivityLinkCard.astro';
import SelectionPlaceCard from '../../components/SelectionPlaceCard.astro';
import { tadLoExperiences, tadLoLocalAddresses } from '../../data/tadLoPlaces';
import {
  fandeeIslandSelection,
  tadLoTreasureHuntSelection,
  vatPaaForestSelection
} from '../../data/tadLoSelections';

const tadLoPostcardFacts = [
  { label: 'July 2026', icon: 'calendar' as const },
  { label: 'Walkable village base', icon: 'road' as const },
  { label: 'Waterfalls & coffee', icon: 'climate' as const },
  { label: 'Salavan Province', icon: 'location' as const }
];

const requireTadLoExperience = (slug: string) => {
  const place = tadLoExperiences.find((item) => item.slug === slug);
  if (!place) throw new Error(`Missing Tad Lo experience: ${slug}`);
  return place;
};

const tadLoBoardSelections = [
  {
    slug: 'tad-lo-waterfall',
    name: 'Tad Lo Waterfall',
    kicker: 'WATERFALL · WALKABLE · VILLAGE',
    duration: '2–3 hours',
    route: 'Walkable from Tad Lo'
  },
  {
    slug: 'cooking-class-nyay',
    name: 'Cooking with Nyay',
    kicker: 'COOKING · LOCAL · HALF DAY',
    duration: 'Half day',
    route: 'Walkable · booking required'
  },
  {
    slug: 'vat-paa-ancient-forest',
    name: 'Vat Paa Forest',
    kicker: 'FOREST · BUDDHA · QUIET',
    duration: 'Less than 3 hours',
    route: 'Transport useful'
  }
];

const tadLoExploreLandmarks = tadLoBoardSelections.map((selection) => {
  const place = requireTadLoExperience(selection.slug);
  const gallery = place.galleryImages?.length
    ? place.galleryImages
    : [{ src: place.image, alt: place.imageAlt }];

  return {
    modalId: `activity-page-${place.slug}`,
    name: selection.name,
    gallery,
    cityContext: {
      kicker: selection.kicker,
      summary: place.shortDescription,
      duration: selection.duration,
      route: selection.route
    }
  };
});

const duplicateSelection = <T extends { slug: string }>(place: T, suffix: string) => ({
  ...place,
  slug: `${place.slug}-${suffix}`
});

const tadLoSelections = [
  fandeeIslandSelection,
  tadLoTreasureHuntSelection,
  vatPaaForestSelection
];
const tadLoTreasureHuntCategorySelection = duplicateSelection(tadLoTreasureHuntSelection, 'things-to-do');
const fandeeIslandGuesthouseSelection = duplicateSelection(fandeeIslandSelection, 'guesthouses');
const tadLoPartnerExperiences = tadLoExperiences;
const tadLoExperienceCount = tadLoPartnerExperiences.length + 1;
const tadLoGuesthouses = tadLoLocalAddresses.filter((place) => place.category === 'accommodation' && place.slug !== 'fandee-island');
const tadLoGuesthouseCount = tadLoGuesthouses.length + 1;
const tadLoRestaurants = tadLoLocalAddresses.filter((place) => place.category === 'restaurants');
const tadLoEssentials = tadLoLocalAddresses.filter((place) => place.category === 'essential-information');

const categoryTabs = [
  { slug: 'my-selection', title: 'My Selection', kicker: 'ATLAS · CHOSEN · SPECIAL', icon: 'selection' as const, count: tadLoSelections.length, countLabel: `${tadLoSelections.length} picks` },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', icon: 'explore' as const, count: tadLoExperienceCount },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · NATURE · VILLAGE', icon: 'guesthouses' as const, count: tadLoGuesthouseCount },
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, count: tadLoRestaurants.length },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'GUIDES · ROADS · BASICS', icon: 'essential' as const, count: tadLoEssentials.length }
];
---

<BaseLayout
  title="Tad Lo travel guide"
  description="Explore Tad Lo through waterfall field notes, local activities and a single-page guide to guesthouses, restaurants and practical information."
  canonical="https://thingstodoatlas.com/laos/tad-lo"
>
  <main class="tad-lo-page">
    <CityPostcardHero
      cityName="Tad Lo"
      description={[
        'Waterfalls, coffee, village life and forest roads with enough time',
        'to notice where you are. Tad Lo is a small, walkable base for a',
        'slower chapter on the Bolaven Plateau.'
      ]}
      photoSrc="/images/laos/tad-lo.webp"
      photoAlt="A view of Tad Lo in southern Laos"
      facts={tadLoPostcardFacts}
      backHref="/laos"
      backLabel="Back to the Laos map"
      drawingSrc="/images/laos/tad-lo-waterfall-boat-v3.webp"
      drawingAlt="Hand-drawn view of Tad Lo waterfalls and riverside fishing"
      drawingCaption="Waterfalls · a slower road south"
      partner={{
        label: 'LOCAL PARTNER',
        title: 'In partnership with Visit Tad Lo',
        href: 'https://visit-tadlo.com/en'
      }}
    />
    <TadLoEditorialGuide />

    <ExploreBoard
      cityName="Tad Lo"
      landmarks={tadLoExploreLandmarks}
      eyebrow="What can I actually do in Tad Lo?"
      title="Explore from Tad Lo"
      intro="Begin with the waterfall, share a local cooking experience, or slow the day down beneath the trees at Vat Paa Forest."
      note="Three different rhythms, all starting from the same small village."
      wide
    />

    <CityCategorySPA
      cityName="Tad Lo"
      categories={categoryTabs}
      defaultSlug="my-selection"
      title="Plan your stay in Tad Lo"
      intro=""
      transitionTitle="Now for the practical side."
      transitionText="Eat · sleep · explore · prepare the road ahead"
    >
      <CityCategoryPanel slug="my-selection" cityName="Tad Lo" title="My Selection" count={tadLoSelections.length} noun="Atlas selections" intro="" fieldNote="01" active>
        <div class="city-panel-list city-panel-list--selection">
          <SelectionPlaceCard place={fandeeIslandSelection} index={0} />
          <SelectionPlaceCard place={tadLoTreasureHuntSelection} index={1} />
          <SelectionPlaceCard place={vatPaaForestSelection} index={2} />
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="things-to-do" cityName="Tad Lo" title="Things to do" count={tadLoExperienceCount} noun="experiences" intro="" fieldNote="02">
        <div class="city-panel-list">
          <div data-selection-alias={tadLoTreasureHuntSelection.slug}>
            <SelectionPlaceCard place={tadLoTreasureHuntCategorySelection} index={0} />
          </div>
          {tadLoPartnerExperiences.map((place, index) => (
            <ActivityLinkCard
              place={place}
              index={index + 1}
              href={`/laos/tad-lo/things-to-do/${place.slug}`}
            />
          ))}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="accommodation" cityName="Tad Lo" title="Guesthouses" count={tadLoGuesthouseCount} noun="stays" intro="" fieldNote="03">
        <div class="city-panel-list">
          <div data-selection-alias={fandeeIslandSelection.slug}>
            <SelectionPlaceCard place={fandeeIslandGuesthouseSelection} index={0} />
          </div>
          {tadLoGuesthouses.map((place, index) => <PartnerPlaceCard place={place} index={index + 1} />)}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="restaurants" cityName="Tad Lo" title="Restaurants" count={tadLoRestaurants.length} noun="restaurants" intro="" fieldNote="04">
        {tadLoRestaurants.length ? <div class="city-panel-list">{tadLoRestaurants.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Restaurant notes are being checked.</h4><p>The tab is ready and will fill as local addresses are confirmed.</p></div>}
      </CityCategoryPanel>

      <CityCategoryPanel slug="essential-information" cityName="Tad Lo" title="Essential Information" count={tadLoEssentials.length} noun="useful addresses" intro="" fieldNote="05">
        {tadLoEssentials.length ? <div class="city-panel-list">{tadLoEssentials.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Practical notes are being checked.</h4><p>The tab is ready for the next locally verified information.</p></div>}
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
</BaseLayout>

<style>
  .tad-lo-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .tad-lo-page :global(.explore-board) {
    isolation: isolate;
  }

  .tad-lo-page :global(.explore-board)::before {
    content: '';
    position: absolute;
    top: clamp(1.55rem, 2.5vw, 2.15rem);
    right: clamp(1.25rem, 2.4vw, 2.2rem);
    z-index: 1;
    width: clamp(8.8rem, 12vw, 11.8rem);
    aspect-ratio: 360 / 230;
    pointer-events: none;
    background: url('/images/laos/tad-lo/explore-three-coffee-beans.svg') center / contain no-repeat;
    opacity: .72;
    filter: drop-shadow(.5px .5px 0 rgba(255, 255, 255, .08));
    transform: rotate(-7deg);
  }

  @media (max-width: 940px) {
    .tad-lo-page :global(.explore-board)::before {
      display: none;
    }
  }
</style>

<script>
  const setupTadLoSelectionAliases = () => {
    document.querySelectorAll<HTMLElement>('[data-selection-alias]').forEach((root) => {
      if (root.dataset.selectionAliasReady === 'true') return;
      root.dataset.selectionAliasReady = 'true';

      const canonicalId = root.dataset.selectionAlias;
      const saveButton = root.querySelector<HTMLButtonElement>('[data-trip-add]');
      if (!canonicalId || !saveButton) return;

      saveButton.dataset.tripId = canonicalId;
      try {
        const tripPlace = JSON.parse(saveButton.dataset.tripPlace || '{}');
        tripPlace.id = canonicalId;
        tripPlace.url = `${location.pathname}#${canonicalId}`;
        saveButton.dataset.tripPlace = JSON.stringify(tripPlace);
      } catch {
        // Keep the card usable even if an old payload cannot be parsed.
      }
    });
  };

  const setupTadLoExploreBoard = () => {
    document.querySelectorAll<HTMLButtonElement>('.tad-lo-page .explore-board-section [data-open-landmark]').forEach((button) => {
      if (button.dataset.tadLoExploreReady === 'true') return;
      button.dataset.tadLoExploreReady = 'true';

      const targetId = button.dataset.openLandmark || '';
      if (!targetId.startsWith('activity-page-')) return;

      const slug = targetId.replace('activity-page-', '');
      const action = button.querySelector<HTMLElement>('.explore-board-card__action');
      if (action) action.innerHTML = 'open the field note <b aria-hidden="true">↗</b>';
      button.setAttribute('aria-label', `Open ${slug.replaceAll('-', ' ')} field note`);

      button.addEventListener('click', () => {
        window.location.href = `/laos/tad-lo/things-to-do/${slug}`;
      });
    });
  };

  const setupTadLoPage = () => {
    setupTadLoSelectionAliases();
    setupTadLoExploreBoard();
  };

  setupTadLoPage();
  document.addEventListener('astro:page-load', setupTadLoPage);
</script>
