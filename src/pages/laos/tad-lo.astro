---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitySpotlightSection from '../../components/CitySpotlightSection.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import PartnerPlaceCard from '../../components/PartnerPlaceCard.astro';
import SelectionPlaceCard from '../../components/SelectionPlaceCard.astro';
import { tadLoExperiences, tadLoLocalAddresses } from '../../data/tadLoPlaces';
import { fandeeIslandSelection } from '../../data/tadLoSelections';

const tadLoSpotlights = tadLoExperiences.slice(0, 3).map((place) => ({
  slug: place.slug,
  name: place.name,
  image: place.image,
  imageAlt: place.imageAlt,
  kicker: place.subcategory.toUpperCase(),
  summary: place.shortDescription,
  duration: place.bestFor,
  route: place.address,
  dialogId: `partner-place-${place.slug}`
}));

const tadLoGuesthouses = tadLoLocalAddresses.filter((place) => place.category === 'accommodation' && place.slug !== 'fandee-island');
const tadLoRestaurants = tadLoLocalAddresses.filter((place) => place.category === 'restaurants');
const tadLoEssentials = tadLoLocalAddresses.filter((place) => place.category === 'essential-information');

const categoryTabs = [
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', icon: 'explore' as const, count: tadLoExperiences.length },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · NATURE · VILLAGE', icon: 'guesthouses' as const, count: tadLoGuesthouses.length + 1 },
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, count: tadLoRestaurants.length },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'GUIDES · ROADS · BASICS', icon: 'essential' as const, count: tadLoEssentials.length }
];
---

<BaseLayout
  title="Tad Lo travel guide"
  description="Explore Tad Lo through three waterfall field notes and a single-page guide to activities, guesthouses, restaurants and practical information, in partnership with Visit Tad Lo."
  canonical="https://thingstodoatlas.com/laos/tad-lo"
>
  <main class="tad-lo-page">
    <section class="tad-lo-hero" aria-labelledby="tad-lo-title">
      <div class="tad-lo-hero__copy">
        <a class="tad-lo-hero__back" href="/laos">← Back to the Laos map</a>
        <p class="tad-lo-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="tad-lo-title">Tad Lo</h1>
        <p class="tad-lo-hero__lede">Waterfalls, coffee, village life and forest roads with enough time to notice where you are.</p>
        <div class="tad-lo-hero__notebook-meta" aria-label="Tad Lo notebook information">
          <span>Salavan Province</span><span>Walkable village base</span><span>Waterfalls & coffee</span><span>July 2026</span>
        </div>
        <a class="tad-lo-partner" href="https://visit-tadlo.com/en" target="_blank" rel="noreferrer">
          <span>LOCAL PARTNER</span><strong>In partnership with Visit Tad Lo</strong><b aria-hidden="true">↗</b>
        </a>
        <span class="tad-lo-hero__field-note">FIELD NOTE — Water, coffee · unhurried village roads</span>
      </div>

      <figure class="tad-lo-hero__visual">
        <span class="tad-lo-hero__tape tad-lo-hero__tape--top" aria-hidden="true"></span>
        <span class="tad-lo-hero__stamp" aria-hidden="true">TAD LO<br />07 · 2026</span>
        <img src="/images/laos/tad-lo.webp" alt="A view of Tad Lo in southern Laos" width="1600" height="1100" fetchpriority="high" />
        <figcaption>Salavan · a slower base around three waterfalls</figcaption>
        <span class="tad-lo-hero__tape tad-lo-hero__tape--bottom" aria-hidden="true"></span>
      </figure>
    </section>

    <CitySpotlightSection
      cityName="Tad Lo"
      eyebrow="TAD LO · THREE WATERFALL NOTES"
      title="Begin with the water"
      items={tadLoSpotlights}
      panelSlug="things-to-do"
      asideTitle="A village shaped by the waterfalls around it"
      asideParagraphs={[
        'Tad Hang, Tad Lo and Tad Soung give the village its natural rhythm. Each one asks for a different amount of time, transport and attention.',
        'Start with the walkable falls, then decide whether the road toward Tad Soung belongs in this stay. The complete practical layer remains connected to the local Visit Tad Lo guide.'
      ]}
      asideNote="Open a waterfall note first. The practical notebook stays on the same page below."
    />

    <CityCategorySPA
      cityName="Tad Lo"
      categories={categoryTabs}
      defaultSlug="things-to-do"
      title="Plan your stay in Tad Lo"
      intro="The buttons keep the whole Tad Lo guide on one page. Opening Guesthouses closes Things to do; opening Restaurants closes Guesthouses."
    >
      <CityCategoryPanel slug="things-to-do" cityName="Tad Lo" title="Things to do" count={tadLoExperiences.length} noun="experiences" intro="Waterfalls, workshops, coffee and local outings gathered with Visit Tad Lo." fieldNote="04" active>
        <div class="city-panel-list">{tadLoExperiences.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="accommodation" cityName="Tad Lo" title="Guesthouses" count={tadLoGuesthouses.length + 1} noun="stays" intro="The golden card marks an Atlas selection. The other stays remain locally documented addresses from Visit Tad Lo." fieldNote="05">
        <div class="city-panel-list">
          <SelectionPlaceCard place={fandeeIslandSelection} index={0} />
          {tadLoGuesthouses.map((place, index) => <PartnerPlaceCard place={place} index={index + 1} />)}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="restaurants" cityName="Tad Lo" title="Restaurants" count={tadLoRestaurants.length} noun="restaurants" intro="Simple village food and useful places to eat without leaving the Tad Lo chapter." fieldNote="06">
        {tadLoRestaurants.length ? <div class="city-panel-list">{tadLoRestaurants.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Restaurant notes are being checked.</h4><p>The tab is ready and will fill as local addresses are confirmed.</p></div>}
      </CityCategoryPanel>

      <CityCategoryPanel slug="essential-information" cityName="Tad Lo" title="Essential Information" count={tadLoEssentials.length} noun="useful addresses" intro="Guides, transport checks and practical local information before leaving the village." fieldNote="07">
        {tadLoEssentials.length ? <div class="city-panel-list">{tadLoEssentials.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Practical notes are being checked.</h4><p>The tab is ready for the next locally verified information.</p></div>}
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
</BaseLayout>

<style>
  .tad-lo-page{min-height:100vh;background:#f2eee3;color:#1f2924}
  .tad-lo-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(20rem,32rem);align-items:center;gap:clamp(2.5rem,6vw,6rem);width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(5.5rem,8vw,7.5rem) 0 clamp(3rem,5vw,4.5rem)}.tad-lo-hero__copy{position:relative;z-index:2;max-width:35rem}.tad-lo-hero__back{display:inline-flex;margin-bottom:2.2rem;color:rgba(31,57,45,.62);font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.tad-lo-hero__eyebrow{margin:0 0 .75rem;color:#8a4d36;font-size:.72rem;font-weight:700;letter-spacing:.18em}.tad-lo-hero h1{margin:0;color:#1f392d;font:400 clamp(4.7rem,10vw,8.2rem)/.82 Georgia,'Times New Roman',serif;letter-spacing:-.07em}.tad-lo-hero__lede{max-width:33rem;margin:1.35rem 0 0;color:#3f4943;font:400 clamp(1rem,1.5vw,1.22rem)/1.58 Georgia,'Times New Roman',serif}.tad-lo-hero__notebook-meta{display:flex;flex-wrap:wrap;gap:.45rem .9rem;margin-top:1rem;color:rgba(31,57,45,.72);font:600 .67rem/1.3 'Segoe Print','Bradley Hand',cursive}.tad-lo-hero__notebook-meta span+span::before{content:'·';margin-right:.9rem;color:#b76645}.tad-lo-hero__field-note{display:inline-block;margin-top:1rem;color:rgba(31,57,45,.6);font:500 .78rem/1.2 'Segoe Print','Bradley Hand',cursive;transform:rotate(-1.2deg)}
  .tad-lo-partner{display:grid;grid-template-columns:1fr auto;gap:4px 20px;width:min(100%,410px);margin-top:1.4rem;padding:13px 15px;border:1px solid rgba(49,85,69,.35);background:rgba(247,242,230,.78);color:#315545}.tad-lo-partner span{grid-column:1;color:#b76645;font-size:.48rem;font-weight:800;letter-spacing:.15em}.tad-lo-partner strong{grid-column:1;font-size:.72rem}.tad-lo-partner b{grid-column:2;grid-row:1/3;align-self:center;color:#b76645;font-size:1.2rem}
  .tad-lo-hero__visual{position:relative;margin:0;padding:.5rem .5rem 1.55rem;background:#fbf8f0;box-shadow:0 10px 24px rgba(38,45,40,.1);transform:rotate(.7deg)}.tad-lo-hero__visual img{display:block;width:100%;height:clamp(14rem,24vw,20rem);object-fit:cover;object-position:center;filter:saturate(.86) contrast(.96)}.tad-lo-hero__visual figcaption{position:absolute;left:.75rem;bottom:.38rem;color:rgba(31,41,36,.62);font:500 .62rem/1 'Segoe Print','Bradley Hand',cursive}.tad-lo-hero__tape{position:absolute;z-index:2;width:4rem;height:.9rem;background:rgba(196,177,139,.48)}.tad-lo-hero__tape--top{top:-.3rem;left:50%;transform:translateX(-50%) rotate(-3deg)}.tad-lo-hero__tape--bottom{right:1rem;bottom:-.3rem;transform:rotate(4deg)}.tad-lo-hero__stamp{position:absolute;z-index:3;top:1rem;right:-1.4rem;display:grid;place-items:center;width:3.7rem;height:3.7rem;border:1px solid rgba(138,77,54,.44);border-radius:50%;color:rgba(138,77,54,.62);font-size:.5rem;font-weight:700;letter-spacing:.08em;line-height:1.2;text-align:center;transform:rotate(7deg)}.tad-lo-hero__stamp::after{content:'';position:absolute;inset:.28rem;border:1px dashed currentColor;border-radius:50%}
  @media(max-width:820px){.tad-lo-hero{grid-template-columns:1fr;gap:2rem;padding-top:4rem}.tad-lo-hero__visual{width:min(100%,34rem);margin:0 auto}.tad-lo-hero__visual img{height:clamp(14rem,55vw,20rem)}}
  @media(max-width:560px){.tad-lo-hero{width:min(100% - 2rem,1180px);padding-top:3.5rem}.tad-lo-hero h1{font-size:clamp(4.3rem,24vw,6rem)}.tad-lo-hero__notebook-meta{display:grid;grid-template-columns:1fr 1fr}.tad-lo-hero__notebook-meta span+span::before{display:none}.tad-lo-partner{width:100%}}
</style>
