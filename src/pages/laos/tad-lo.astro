---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitySpotlightSection from '../../components/CitySpotlightSection.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import PartnerPlaceCard from '../../components/PartnerPlaceCard.astro';
import SelectionPlaceCard from '../../components/SelectionPlaceCard.astro';
import { tadLoExperiences, tadLoLocalAddresses } from '../../data/tadLoPlaces';
import { fandeeIslandSelection } from '../../data/tadLoSelections';

const waterfallSpotlights = tadLoExperiences.slice(0, 3).map((place) => ({
  slug: place.slug,
  name: place.name,
  image: place.image,
  imageAlt: place.imageAlt,
  kicker: place.subcategory.toUpperCase(),
  summary: place.shortDescription,
  duration: place.bestFor,
  route: place.address,
  dialogId: `partner-place-${place.slug}`
}));

const tadLoSpotlights = [
  ...waterfallSpotlights,
  {
    slug: 'fandee-island-treasure-hunt',
    name: 'Fandee Island Treasure Hunt',
    image: '/images/tad-lo/iFandeeisland 01.webp',
    imageAlt: 'Fandee Island nature setting in Tad Lo, southern Laos',
    kicker: 'TREASURE HUNT · WALKABLE',
    summary: 'A small adventure through Tad Lo built around thirteen quests to solve along the way.',
    duration: '13 quests around Tad Lo',
    route: 'Fandee Island · Tad Lo',
    href: 'https://treasure-hunt.fandee-island.com/',
    external: true
  }
];

const tadLoGuesthouses = tadLoLocalAddresses.filter((place) => place.category === 'accommodation' && place.slug !== 'fandee-island');
const tadLoRestaurants = tadLoLocalAddresses.filter((place) => place.category === 'restaurants');
const tadLoEssentials = tadLoLocalAddresses.filter((place) => place.category === 'essential-information');

const categoryTabs = [
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', icon: 'explore' as const, count: tadLoExperiences.length },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · NATURE · VILLAGE', icon: 'guesthouses' as const, count: tadLoGuesthouses.length + 1 },
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, count: tadLoRestaurants.length },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'GUIDES · ROADS · BASICS', icon: 'essential' as const, count: tadLoEssentials.length }
];
---

<BaseLayout
  title="Tad Lo travel guide"
  description="Explore Tad Lo through waterfall field notes, a thirteen-quest treasure hunt and a single-page guide to activities, guesthouses, restaurants and practical information."
  canonical="https://thingstodoatlas.com/laos/tad-lo"
>
  <main class="tad-lo-page">
    <section class="pakse-hero" aria-labelledby="tad-lo-title">
      <div class="pakse-hero__copy">
        <p class="pakse-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="tad-lo-title">Tad Lo</h1>
        <p class="pakse-hero__lede">Waterfalls, coffee, village life and forest roads with enough time to notice where you are.</p>
        <a class="tad-lo-partner" href="https://visit-tadlo.com/en" target="_blank" rel="noreferrer">
          <span>LOCAL PARTNER</span><strong>In partnership with Visit Tad Lo</strong><b aria-hidden="true">↗</b>
        </a>
      </div>

      <a class="pakse-hero__back" href="/laos">← Back to the Laos map</a>

      <figure class="pakse-hero__visual">
        <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
        <span class="pakse-hero__stamp" aria-hidden="true">TAD LO<br />07 · 2026</span>
        <img src="/images/laos/tad-lo.webp" alt="A view of Tad Lo in southern Laos" width="1600" height="1100" fetchpriority="high" />
        <figcaption>Salavan · a slower base around three waterfalls</figcaption>
        <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
      </figure>

      <div class="pakse-hero__photo-meta" aria-label="Tad Lo notebook information">
        <span>Salavan Province</span>
        <span>Walkable village base</span>
        <span>Waterfalls & coffee</span>
        <span>July 2026</span>
      </div>

      <figure class="pakse-hero__boat">
        <span class="pakse-hero__field-note">FIELD NOTE — Water, coffee · unhurried village roads</span>
        <img src="/images/laos/tad-lo-waterfall-boat-v3.webp" alt="Hand-drawn view of Tad Lo waterfalls and riverside fishing" width="1296" height="916" decoding="async" />
        <figcaption>Waterfalls · a slower road south</figcaption>
      </figure>
    </section>

    <CitySpotlightSection
      cityName="Tad Lo"
      eyebrow="TAD LO · FOUR FIELD NOTES"
      title="Begin with the water"
      items={tadLoSpotlights}
      panelSlug="things-to-do"
      maxItems={4}
      asideTitle="Three waterfalls, then a different kind of trail"
      asideParagraphs={[
        'Tad Hang, Tad Lo and Tad Soung give the village its natural rhythm. Each one asks for a different amount of time, transport and attention.',
        'After the waterfalls, Fandee Island turns the village into a small playground with thirteen quests to solve around Tad Lo.'
      ]}
      asideNote="Open a waterfall field note or begin the treasure hunt in a new tab."
    />

    <CityCategorySPA
      cityName="Tad Lo"
      categories={categoryTabs}
      defaultSlug="things-to-do"
      title="Plan your stay in Tad Lo"
      intro="The buttons keep the whole Tad Lo guide on one page. Opening Guesthouses closes Things to do; opening Restaurants closes Guesthouses."
    >
      <CityCategoryPanel slug="things-to-do" cityName="Tad Lo" title="Things to do" count={tadLoExperiences.length} noun="experiences" intro="Waterfalls, workshops, coffee and local outings gathered with Visit Tad Lo." fieldNote="04" active>
        <div class="city-panel-list">{tadLoExperiences.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="accommodation" cityName="Tad Lo" title="Guesthouses" count={tadLoGuesthouses.length + 1} noun="stays" intro="The golden card marks an Atlas selection. The other stays remain locally documented addresses from Visit Tad Lo." fieldNote="05">
        <div class="city-panel-list">
          <SelectionPlaceCard place={fandeeIslandSelection} index={0} />
          {tadLoGuesthouses.map((place, index) => <PartnerPlaceCard place={place} index={index + 1} />)}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="restaurants" cityName="Tad Lo" title="Restaurants" count={tadLoRestaurants.length} noun="restaurants" intro="Simple village food and useful places to eat without leaving the Tad Lo chapter." fieldNote="06">
        {tadLoRestaurants.length ? <div class="city-panel-list">{tadLoRestaurants.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Restaurant notes are being checked.</h4><p>The tab is ready and will fill as local addresses are confirmed.</p></div>}
      </CityCategoryPanel>

      <CityCategoryPanel slug="essential-information" cityName="Tad Lo" title="Essential Information" count={tadLoEssentials.length} noun="useful addresses" intro="Guides, transport checks and practical local information before leaving the village." fieldNote="07">
        {tadLoEssentials.length ? <div class="city-panel-list">{tadLoEssentials.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Practical notes are being checked.</h4><p>The tab is ready for the next locally verified information.</p></div>}
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
</BaseLayout>

<style>
  .tad-lo-page{min-height:100vh;background:#f2eee3;color:#1f2924}
  .tad-lo-page>:global(.city-spotlights){padding-top:clamp(1.25rem,2.2vw,1.9rem)}
  .pakse-hero{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(17rem,21rem) minmax(0,1fr) minmax(11rem,16rem);align-items:start;justify-content:start;column-gap:clamp(.5rem,1.4vw,1.25rem);width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(5.5rem,7vw,6.75rem) 0 clamp(.7rem,1vw,1rem)}
  .pakse-hero__copy{position:relative;z-index:6;grid-column:2;grid-row:1 / span 2;max-width:30rem;margin-left:-.35rem}
  .pakse-hero__back{position:relative;z-index:7;grid-column:3;grid-row:1;align-self:start;justify-self:end;display:inline-flex;margin:0;color:rgba(31,57,45,.62);font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
  .pakse-hero__eyebrow{margin:0 0 .65rem;color:#8a4d36;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
  .pakse-hero h1{position:relative;z-index:7;display:flex;align-items:baseline;width:max-content;margin:0;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4rem,8vw,6.8rem);font-weight:400;letter-spacing:-.065em;line-height:.84}
  .pakse-hero__lede{max-width:31rem;margin:clamp(1rem,1.6vw,1.35rem) 0 0;color:#3f4943;font-family:Georgia,'Times New Roman',serif;font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.55}
  .pakse-hero__photo-meta{grid-column:1;grid-row:2;display:grid;grid-template-columns:repeat(2,minmax(0,max-content));gap:.42rem 1rem;width:min(100%,21rem);margin:-.55rem 0 0;color:rgba(31,57,45,.72);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.66rem;line-height:1.25}
  .pakse-hero__photo-meta span{display:inline-flex;align-items:center;gap:.38rem;white-space:nowrap}
  .pakse-hero__field-note{display:block;margin:0 0 .18rem;color:rgba(31,57,45,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(.68rem,.82vw,.78rem);letter-spacing:.03em;text-align:center;transform:rotate(-1.5deg)}
  .tad-lo-partner{display:grid;grid-template-columns:1fr auto;gap:4px 20px;width:min(100%,410px);margin-top:1.4rem;padding:13px 15px;border:1px solid rgba(49,85,69,.35);background:rgba(247,242,230,.78);color:#315545}
  .tad-lo-partner span{grid-column:1;color:#b76645;font-size:.48rem;font-weight:800;letter-spacing:.15em}
  .tad-lo-partner strong{grid-column:1;font-size:.72rem}
  .tad-lo-partner b{grid-column:2;grid-row:1/3;align-self:center;color:#b76645;font-size:1.2rem}
  .pakse-hero__boat{position:relative;z-index:2;grid-column:3;grid-row:1 / span 2;align-self:start;width:min(100%,16rem);min-height:12rem;margin:6.65rem auto 0;pointer-events:none;transform:translate(-20px,-50px) rotate(-2deg)}
  .pakse-hero__boat img{display:block;width:100%;height:auto;object-fit:contain}
  .pakse-hero__boat figcaption{margin:-.05rem 0 0;color:rgba(31,57,45,.58);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.58rem;letter-spacing:.02em;text-align:center;transform:rotate(1deg)}
  .pakse-hero__visual{position:relative;z-index:2;grid-column:1;grid-row:1;width:min(100%,21rem);margin:1.45rem 0 0;padding:.42rem .42rem 1.35rem;background:#fbf8f0;box-shadow:0 10px 24px rgba(38,45,40,.1);transform:rotate(.8deg)}
  .pakse-hero__visual img{display:block;width:100%;height:clamp(9rem,11.5vw,11.25rem);object-fit:cover;object-position:center;filter:saturate(.88) contrast(.97)}
  .pakse-hero__visual figcaption{position:absolute;left:.65rem;bottom:.32rem;margin:0;color:rgba(31,41,36,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.54rem;letter-spacing:.03em;white-space:nowrap}
  .pakse-hero__tape{position:absolute;z-index:5;width:3.8rem;height:.8rem;background:rgba(196,177,139,.48);pointer-events:none}
  .pakse-hero__tape--top{top:-.28rem;left:50%;transform:translateX(-50%) rotate(-3deg)}
  .pakse-hero__tape--bottom{right:.8rem;bottom:-.28rem;transform:rotate(4deg)}
  .pakse-hero__stamp{position:absolute;z-index:4;top:.85rem;right:-1.55rem;display:grid;place-items:center;width:3.4rem;height:3.4rem;border:1px solid rgba(138,77,54,.42);border-radius:50%;color:rgba(138,77,54,.58);font-size:.5rem;font-weight:700;letter-spacing:.08em;line-height:1.25;text-align:center;transform:rotate(8deg)}
  .pakse-hero__stamp::after{content:'';position:absolute;inset:.25rem;border:1px dashed currentColor;border-radius:50%;opacity:.55}
  @media(max-width:1050px) and (min-width:821px){
    .pakse-hero{grid-template-columns:minmax(17rem,21rem) minmax(0,1fr);row-gap:.25rem}
    .pakse-hero__copy{grid-column:2;grid-row:1 / span 2}
    .pakse-hero__back{grid-column:2;grid-row:1;justify-self:end}
    .pakse-hero__visual{grid-column:1;grid-row:1}
    .pakse-hero__photo-meta{grid-column:1;grid-row:2;margin-top:-.5rem}
    .pakse-hero__boat{grid-column:2;grid-row:2 / span 2;width:min(100%,13.5rem);margin:-1.3rem 20px 0 auto;transform:translateY(-50px) rotate(-2deg)}
  }
  @media(max-width:820px){
    .tad-lo-page>:global(.city-spotlights){padding-top:1rem}
    .pakse-hero{grid-template-columns:1fr;gap:1rem;padding-top:4rem;padding-bottom:.8rem}
    .pakse-hero__copy{grid-column:1;grid-row:1;max-width:36rem;margin-left:0}
    .pakse-hero__back{position:absolute;top:4rem;right:0;grid-column:auto;grid-row:auto;font-size:.57rem}
    .pakse-hero__visual{grid-column:1;grid-row:2;width:min(100%,24rem);margin:0 auto}
    .pakse-hero__photo-meta{grid-column:1;grid-row:3;width:min(100%,24rem);margin:-.55rem auto 0}
    .pakse-hero__boat{grid-column:1;grid-row:4;width:min(82vw,18rem);margin:-1.35rem auto 0;transform:translateY(-50px) rotate(-2deg)}
    .pakse-hero__visual img{height:clamp(9rem,32vw,11.25rem)}
  }
  @media(max-width:540px){
    .pakse-hero{width:min(100% - 2rem,1180px);gap:.75rem;padding-top:3.75rem;padding-bottom:.65rem}
    .pakse-hero__back{top:3.75rem;font-size:.52rem;letter-spacing:.075em}
    .pakse-hero h1{font-size:clamp(4rem,23vw,5.5rem)}
    .pakse-hero__lede{font-size:1rem;line-height:1.55}
    .pakse-hero__photo-meta{grid-template-columns:1fr 1fr;gap:.4rem .7rem;width:min(100%,21rem);font-size:.62rem}
    .pakse-hero__visual{width:min(100%,21rem)}
    .pakse-hero__visual img{height:9.5rem}
    .pakse-hero__boat{width:min(78vw,16rem);margin-top:-1.55rem}
  }
</style>
