---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import CitySpotlightSection from '../../components/CitySpotlightSection.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import PartnerPlaceCard from '../../components/PartnerPlaceCard.astro';
import SelectionPlaceCard from '../../components/SelectionPlaceCard.astro';
import { tadLoExperiences, tadLoLocalAddresses } from '../../data/tadLoPlaces';
import { fandeeIslandSelection } from '../../data/tadLoSelections';

const tadLoPostcardFacts = [
  { label: 'July 2026', icon: 'calendar' as const },
  { label: 'Walkable village base', icon: 'road' as const },
  { label: 'Waterfalls & coffee', icon: 'climate' as const },
  { label: 'Salavan Province', icon: 'location' as const }
];

const waterfallSpotlights = tadLoExperiences.slice(0, 3).map((place) => ({
  slug: place.slug,
  name: place.name,
  image: place.image,
  imageAlt: place.imageAlt,
  kicker: place.subcategory.toUpperCase(),
  summary: place.shortDescription,
  duration: place.bestFor,
  route: place.address,
  dialogId: `partner-place-${place.slug}`
}));

const tadLoSpotlights = [
  ...waterfallSpotlights,
  {
    slug: 'fandee-island-treasure-hunt',
    name: 'Fandee Island Treasure Hunt',
    image: '/images/tad-lo/iFandeeisland 01.webp',
    imageAlt: 'Fandee Island nature setting in Tad Lo, southern Laos',
    kicker: 'TREASURE HUNT · WALKABLE',
    summary: 'A small adventure through Tad Lo built around thirteen quests to solve along the way.',
    duration: '13 quests around Tad Lo',
    route: 'Fandee Island · Tad Lo',
    href: 'https://treasure-hunt.fandee-island.com/',
    external: true
  }
];

const tadLoGuesthouses = tadLoLocalAddresses.filter((place) => place.category === 'accommodation' && place.slug !== 'fandee-island');
const tadLoRestaurants = tadLoLocalAddresses.filter((place) => place.category === 'restaurants');
const tadLoEssentials = tadLoLocalAddresses.filter((place) => place.category === 'essential-information');

const categoryTabs = [
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', icon: 'explore' as const, count: tadLoExperiences.length },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · NATURE · VILLAGE', icon: 'guesthouses' as const, count: tadLoGuesthouses.length + 1 },
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, count: tadLoRestaurants.length },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'GUIDES · ROADS · BASICS', icon: 'essential' as const, count: tadLoEssentials.length }
];
---

<BaseLayout
  title="Tad Lo travel guide"
  description="Explore Tad Lo through waterfall field notes, a thirteen-quest treasure hunt and a single-page guide to activities, guesthouses, restaurants and practical information."
  canonical="https://thingstodoatlas.com/laos/tad-lo"
>
  <main class="tad-lo-page">
    <CityPostcardHero
      cityName="Tad Lo"
      eyebrow="LAOS · CHAPTER 02"
      description="Waterfalls, coffee, village life and forest roads with enough time to notice where you are. Tad Lo is a small, walkable base for a slower chapter on the Bolaven Plateau."
      photoSrc="/images/laos/tad-lo.webp"
      photoAlt="A view of Tad Lo in southern Laos"
      facts={tadLoPostcardFacts}
      fieldNote="FIELD NOTE — Water, coffee · unhurried village roads"
      backHref="/laos"
      backLabel="Back to the Laos map"
      postmarkDate="07 · 2026"
      stampLabel="LAOS"
      stampMotif="mountain"
      drawingSrc="/images/laos/tad-lo-waterfall-boat-v3.webp"
      drawingAlt="Hand-drawn view of Tad Lo waterfalls and riverside fishing"
      drawingCaption="Waterfalls · a slower road south"
      partner={{
        label: 'LOCAL PARTNER',
        title: 'In partnership with Visit Tad Lo',
        href: 'https://visit-tadlo.com/en'
      }}
    />

    <CitySpotlightSection
      cityName="Tad Lo"
      eyebrow="TAD LO · FOUR FIELD NOTES"
      title="Begin with the water"
      items={tadLoSpotlights}
      panelSlug="things-to-do"
      maxItems={4}
      asideTitle="Three waterfalls, then a different kind of trail"
      asideParagraphs={[
        'Tad Hang, Tad Lo and Tad Soung give the village its natural rhythm. Each one asks for a different amount of time, transport and attention.',
        'After the waterfalls, Fandee Island turns the village into a small playground with thirteen quests to solve around Tad Lo.'
      ]}
      asideNote="Open a waterfall field note or begin the treasure hunt in a new tab."
    />

    <CityCategorySPA
      cityName="Tad Lo"
      categories={categoryTabs}
      defaultSlug="things-to-do"
      title="Plan your stay in Tad Lo"
      intro="The buttons keep the whole Tad Lo guide on one page. Opening Guesthouses closes Things to do; opening Restaurants closes Guesthouses."
    >
      <CityCategoryPanel slug="things-to-do" cityName="Tad Lo" title="Things to do" count={tadLoExperiences.length} noun="experiences" intro="Waterfalls, workshops, coffee and local outings gathered with Visit Tad Lo." fieldNote="04" active>
        <div class="city-panel-list">{tadLoExperiences.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="accommodation" cityName="Tad Lo" title="Guesthouses" count={tadLoGuesthouses.length + 1} noun="stays" intro="The golden card marks an Atlas selection. The other stays remain locally documented addresses from Visit Tad Lo." fieldNote="05">
        <div class="city-panel-list">
          <SelectionPlaceCard place={fandeeIslandSelection} index={0} />
          {tadLoGuesthouses.map((place, index) => <PartnerPlaceCard place={place} index={index + 1} />)}
        </div>
      </CityCategoryPanel>

      <CityCategoryPanel slug="restaurants" cityName="Tad Lo" title="Restaurants" count={tadLoRestaurants.length} noun="restaurants" intro="Simple village food and useful places to eat without leaving the Tad Lo chapter." fieldNote="06">
        {tadLoRestaurants.length ? <div class="city-panel-list">{tadLoRestaurants.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Restaurant notes are being checked.</h4><p>The tab is ready and will fill as local addresses are confirmed.</p></div>}
      </CityCategoryPanel>

      <CityCategoryPanel slug="essential-information" cityName="Tad Lo" title="Essential Information" count={tadLoEssentials.length} noun="useful addresses" intro="Guides, transport checks and practical local information before leaving the village." fieldNote="07">
        {tadLoEssentials.length ? <div class="city-panel-list">{tadLoEssentials.map((place, index) => <PartnerPlaceCard place={place} index={index} />)}</div> : <div class="city-panel-empty"><h4>Practical notes are being checked.</h4><p>The tab is ready for the next locally verified information.</p></div>}
      </CityCategoryPanel>
    </CityCategorySPA>
  </main>
</BaseLayout>

<style>
  .tad-lo-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .tad-lo-page > :global(.city-spotlights) {
    padding-top: clamp(1.25rem, 2.2vw, 1.9rem);
  }

  @media (max-width: 820px) {
    .tad-lo-page > :global(.city-spotlights) {
      padding-top: 1rem;
    }
  }
</style>
