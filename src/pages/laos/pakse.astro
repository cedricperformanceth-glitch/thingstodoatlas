---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    slug: 'restaurants',
    title: 'Restaurants',
    kicker: 'EAT · LOCAL · SLOW',
    text: 'Local favourites, street-side tables and reliable places worth saving.',
    icon: 'restaurants',
  },
  {
    slug: 'cafes',
    title: 'Cafés',
    kicker: 'COFFEE · PAUSE · SHADE',
    text: 'Quiet corners, good coffee and easy places to slow down for an hour.',
    icon: 'cafes',
  },
  {
    slug: 'guesthouses',
    title: 'Guesthouses',
    kicker: 'SLEEP · SIMPLE · CENTRAL',
    text: 'Comfortable stays, local guesthouses and practical bases around town.',
    icon: 'guesthouses',
  },
  {
    slug: 'scooter-rental',
    title: 'Scooter Rental',
    kicker: 'KEYS · HELMET · ROAD',
    text: 'Trusted rentals, useful checks and the right bike for the roads ahead.',
    icon: 'scooter',
  },
  {
    slug: 'bolaven-loop',
    title: 'Bolaven Loop',
    kicker: 'ROADS · FALLS · COFFEE',
    text: 'Routes, stops and field notes for the journey into the plateau.',
    icon: 'bolaven',
  },
  {
    slug: 'things-to-do',
    title: 'Things to Do',
    kicker: 'WALK · SEE · EXPLORE',
    text: 'Temples, river views, local corners and ideas for a day in Pakse.',
    icon: 'activities',
  },
  {
    slug: 'gyms-fitness',
    title: 'Gyms & Fitness',
    kicker: 'TRAIN · MOVE · SWEAT',
    text: 'Muay Thai, weights and practical places to keep training on the road.',
    icon: 'gyms',
  },
  {
    slug: 'massage-wellness',
    title: 'Massage & Wellness',
    kicker: 'REST · RESET · RECOVER',
    text: 'Massage, recovery and calm places for a slower part of the day.',
    icon: 'wellness',
  },
  {
    slug: 'markets-shopping',
    title: 'Markets & Shopping',
    kicker: 'MARKETS · GOODS · FINDS',
    text: 'Fresh markets, useful shops and small things worth bringing home.',
    icon: 'markets',
  },
  {
    slug: 'essential-information',
    title: 'Essential Information',
    kicker: 'VISA · HEALTH · BASICS',
    text: 'Hospitals, pharmacies, visa help, ATMs, SIM cards and useful contacts.',
    icon: 'essential',
  },
];
---

<BaseLayout
  title="Things to do in Pakse, Laos"
  description="Discover Pakse, a relaxed southern Laos base for local streets, Mekong sunsets and journeys toward the Bolaven Plateau."
  canonical="https://thingstodoatlas.com/laos/pakse"
>
  <main class="pakse-page">
    <section class="pakse-hero" aria-labelledby="pakse-title">
      <div class="pakse-hero__copy">
        <p class="pakse-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="pakse-title">Pakse</h1>
        <p class="pakse-hero__lede">
          The gateway to Southern Laos. A relaxed riverside city where local life, coffee culture and the road to the Bolaven Plateau begin within a few kilometres.
        </p>
        <span class="pakse-hero__field-note">FIELD NOTE — Mekong light · southern roads</span>
      </div>

      <figure class="pakse-hero__visual">
        <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
        <img
          src="/images/laos/pakse.webp"
          alt="A view of Pakse in southern Laos"
          width="1600"
          height="1100"
          fetchpriority="high"
        />
        <figcaption>Southern Laos · first notes from the road</figcaption>
        <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="pakse-categories" aria-labelledby="pakse-categories-title">
      <div class="pakse-categories__heading">
        <p>PAKSE DIRECTORY</p>
        <h2 id="pakse-categories-title">Open the notebook</h2>
      </div>

      <div class="category-grid">
        {categories.map((category, index) => (
          <a
            class={`category-note category-note--${index % 4}`}
            href={`/laos/pakse/${category.slug}`}
            aria-label={`Explore ${category.title} in Pakse`}
          >
            <span class="category-note__tape" aria-hidden="true"></span>
            <span class="category-note__paper-line category-note__paper-line--top" aria-hidden="true"></span>
            <span class="category-note__paper-line category-note__paper-line--bottom" aria-hidden="true"></span>

            <span class="category-note__illustration" aria-hidden="true">
              {category.icon === 'restaurants' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M25 55c4 29 20 44 50 44s46-15 50-44" stroke-width="3.2" />
                    <path d="M21 52c8-10 24-14 54-14s46 4 54 14c-8 10-24 14-54 14S29 62 21 52Z" stroke-width="3.2" />
                    <path d="M36 55c10-6 20-7 39-7s31 2 42 8M42 60c8-10 16-9 25 0 8-10 16-10 25 0 7-8 15-8 22-1" stroke-width="2" />
                    <path d="M93 42 130 9M101 46l37-28" stroke-width="4" />
                    <path d="M59 31c-7-9-3-17 2-23M73 31c-6-9-2-18 3-25M86 32c-5-8-1-15 4-21" stroke-width="2" />
                    <path d="M36 106c23 4 49 4 76 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'cafes' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M35 43h68v35c0 14-11 25-25 25H60c-14 0-25-11-25-25Z" stroke-width="3" />
                    <path d="M103 51h12c11 0 18 7 18 16s-7 16-18 16h-12" stroke-width="3" />
                    <path d="M31 43h77M43 107h72" stroke-width="2" />
                    <path d="M57 32c-7-9 4-14-1-23M76 32c-8-10 5-15 0-25M94 32c-6-8 4-13 1-21" stroke-width="2.3" />
                    <path d="M49 54c15 5 30 5 44 0" stroke-width="1.4" opacity=".6" />
                  </g>
                </svg>
              )}

              {category.icon === 'guesthouses' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M25 55 80 16l55 39" stroke-width="3.2" />
                    <path d="M34 49v58h92V49" stroke-width="3" />
                    <path d="M66 107V72h28v35M46 62h15v17H46zM100 62h15v17h-15z" stroke-width="2.4" />
                    <path d="M42 37V21h18v4" stroke-width="2.4" />
                    <path d="M18 109c37-4 83-4 124 0" stroke-width="1.4" opacity=".55" />
                  </g>
                </svg>
              )}

              {category.icon === 'scooter' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M40 83c0-28 19-51 46-56 24-4 45 8 53 29-13-6-27-8-41-5-18 4-32 16-39 32Z" stroke-width="3.2" />
                    <path d="M59 83h68c0 14-11 24-25 24H82c-13 0-23-10-23-24Z" stroke-width="3" />
                    <path d="M92 51c4 8 6 18 5 29M111 49c5 8 8 18 8 29" stroke-width="2" />
                    <path d="M34 83h26M71 106c-8-4-14-10-17-18" stroke-width="2.2" />
                    <path d="M45 110c25 3 54 3 84 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'bolaven' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m22 28 34-10 47 12 35-10v73l-35 10-47-12-34 10Z" stroke-width="3" />
                    <path d="M56 18v73M103 30v73" stroke-width="2" />
                    <path d="M37 78c12-31 28-9 42-29 12-17 22 4 38-10" stroke-width="2.6" stroke-dasharray="5 5" />
                    <circle cx="37" cy="78" r="4" stroke-width="2" />
                    <circle cx="117" cy="39" r="4" stroke-width="2" />
                    <path d="M67 82c5-9 9-18 12-27M79 55l7 8M79 55l-8 7" stroke-width="2" />
                  </g>
                </svg>
              )}

              {category.icon === 'activities' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="54" cy="66" r="24" stroke-width="3" />
                    <circle cx="106" cy="66" r="24" stroke-width="3" />
                    <path d="M75 52h10M66 57l9-5M94 57l-9-5M75 52v14M85 52v14" stroke-width="3" />
                    <path d="M28 66H16M144 66h-12M80 29V14" stroke-width="2.2" />
                    <path d="M43 96c24 6 49 6 74 0" stroke-width="1.4" opacity=".5" />
                    <path d="M48 39 39 25M112 39l9-14" stroke-width="2" />
                  </g>
                </svg>
              )}

              {category.icon === 'gyms' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M28 45v31M39 37v47M51 32v57M109 32v57M121 37v47M132 45v31" stroke-width="4" />
                    <path d="M51 60h58" stroke-width="5" />
                    <path d="M19 60h9M132 60h9" stroke-width="3" />
                    <path d="M52 99c20 4 38 4 57 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'wellness' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M80 96c-9-18-9-35 0-52 9 17 9 34 0 52Z" stroke-width="2.8" />
                    <path d="M79 92c-20-7-31-20-35-39 19 2 34 14 35 39ZM81 92c20-7 31-20 35-39-19 2-34 14-35 39Z" stroke-width="2.8" />
                    <path d="M70 96c-19 1-34-6-45-20 17-7 34-2 45 20ZM90 96c19 1 34-6 45-20-17-7-34-2-45 20Z" stroke-width="2.8" />
                    <path d="M40 105c27 4 54 4 80 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'markets' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M34 48h92l-12 58H46Z" stroke-width="3" />
                    <path d="M55 49c2-22 12-34 25-34s23 12 25 34" stroke-width="3" />
                    <path d="M49 63h66M46 78h72M43 93h73" stroke-width="1.8" />
                    <path d="M58 49v57M77 49v57M96 49v57M114 49v57" stroke-width="1.5" opacity=".75" />
                    <path d="M34 111c30 3 62 3 94 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'essential' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="30" y="34" width="100" height="72" rx="6" stroke-width="3" />
                    <path d="M59 34V23h42v11" stroke-width="3" />
                    <path d="M70 51h20v14h14v20H90v14H70V85H56V65h14Z" stroke-width="3" />
                    <path d="M42 111c26 3 51 3 76 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}
            </span>

            <span class="category-note__copy">
              <span class="category-note__kicker">{category.kicker}</span>
              <span class="category-note__title">{category.title}</span>
              <span class="category-note__text">{category.text}</span>
              <span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span>
            </span>

            <span class="category-note__corner" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pakse-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .pakse-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(4.75rem, 7vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .pakse-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 31rem;
  }

  .pakse-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: #8a4d36;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pakse-hero h1 {
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4rem, 8vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  .pakse-hero__lede {
    max-width: 29rem;
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    color: #3f4943;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.58;
  }

  .pakse-hero__field-note {
    display: inline-block;
    margin-top: 1.2rem;
    color: rgba(31, 57, 45, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(0.72rem, 0.9vw, 0.82rem);
    letter-spacing: 0.04em;
    transform: rotate(-1.5deg);
  }

  .pakse-hero__visual {
    position: relative;
    width: clamp(24rem, 36vw, 34rem);
    margin: 0;
    padding: 0.5rem 0.5rem 1.6rem;
    background: #fbf8f0;
    box-shadow: 0 10px 24px rgba(38, 45, 40, 0.1);
    transform: rotate(0.8deg);
  }

  .pakse-hero__visual img {
    display: block;
    width: 100%;
    height: clamp(12rem, 16vw, 15rem);
    object-fit: cover;
    object-position: center;
    filter: saturate(0.88) contrast(0.97);
  }

  .pakse-hero__visual figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.4rem;
    margin: 0;
    color: rgba(31, 41, 36, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.58rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .pakse-hero__tape {
    position: absolute;
    z-index: 2;
    width: 3.8rem;
    height: 0.8rem;
    background: rgba(196, 177, 139, 0.48);
    pointer-events: none;
  }

  .pakse-hero__tape--top {
    top: -0.28rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .pakse-hero__tape--bottom {
    right: 1rem;
    bottom: -0.28rem;
    transform: rotate(4deg);
  }

  .pakse-categories {
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(5rem, 8vw, 8rem);
  }

  .pakse-categories__heading {
    margin-bottom: clamp(1.8rem, 3vw, 2.8rem);
  }

  .pakse-categories__heading p {
    margin: 0 0 0.4rem;
    color: rgba(31, 57, 45, 0.56);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .pakse-categories__heading h2 {
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .category-note {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: 11.5rem;
    padding: 1.15rem 1.15rem 1.2rem;
    color: #181a18;
    text-decoration: none;
    background: #f8f5ec;
    border: 1px solid rgba(24, 26, 24, 0.76);
    box-shadow: 4px 5px 0 rgba(24, 26, 24, 0.07), 0 12px 24px rgba(31, 41, 36, 0.07);
    transition: transform 180ms ease, box-shadow 180ms ease;
    isolation: isolate;
  }

  .category-note--0 { transform: rotate(-0.35deg); }
  .category-note--1 { transform: rotate(0.22deg); }
  .category-note--2 { transform: rotate(0.38deg); }
  .category-note--3 { transform: rotate(-0.18deg); }

  .category-note::before,
  .category-note::after {
    content: '';
    position: absolute;
    inset: 4px;
    z-index: -1;
    pointer-events: none;
  }

  .category-note::before {
    border: 1px solid rgba(24, 26, 24, 0.16);
  }

  .category-note::after {
    background-image:
      radial-gradient(circle at 18% 22%, rgba(24, 26, 24, 0.07) 0 0.55px, transparent 0.65px),
      radial-gradient(circle at 82% 72%, rgba(24, 26, 24, 0.05) 0 0.5px, transparent 0.6px);
    background-size: 17px 17px, 21px 21px;
    opacity: 0.65;
  }

  .category-note:hover,
  .category-note:focus-visible {
    transform: translateY(-3px) rotate(0deg);
    box-shadow: 6px 8px 0 rgba(24, 26, 24, 0.07), 0 18px 30px rgba(31, 41, 36, 0.11);
  }

  .category-note:focus-visible {
    outline: 2px solid #1f392d;
    outline-offset: 4px;
  }

  .category-note__tape {
    position: absolute;
    top: -0.45rem;
    left: 0.9rem;
    width: 4.3rem;
    height: 1.25rem;
    background: rgba(213, 204, 184, 0.76);
    border: 1px solid rgba(24, 26, 24, 0.18);
    clip-path: polygon(2% 12%, 95% 0, 100% 84%, 5% 100%);
    transform: rotate(-6deg);
  }

  .category-note:nth-child(even) .category-note__tape {
    left: auto;
    right: 1.1rem;
    transform: rotate(5deg);
  }

  .category-note__paper-line {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    height: 1px;
    background: rgba(24, 26, 24, 0.12);
    pointer-events: none;
  }

  .category-note__paper-line--top { top: 0.65rem; }
  .category-note__paper-line--bottom { bottom: 0.65rem; }

  .category-note__illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 7.4rem;
    color: #101210;
  }

  .category-note__illustration svg {
    display: block;
    width: min(100%, 8rem);
    height: auto;
  }

  .category-note__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .category-note__kicker {
    margin-bottom: 0.35rem;
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .category-note__title {
    position: relative;
    display: inline-block;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .category-note__title::after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.35rem;
    bottom: -0.18rem;
    height: 1px;
    background: currentColor;
    transform: rotate(-1.2deg);
    transform-origin: left center;
  }

  .category-note__text {
    max-width: 21rem;
    margin-top: 0.72rem;
    color: rgba(24, 26, 24, 0.75);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.84rem;
    line-height: 1.42;
  }

  .category-note__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.72rem;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .category-note__meta span {
    transition: transform 180ms ease;
  }

  .category-note:hover .category-note__meta span,
  .category-note:focus-visible .category-note__meta span {
    transform: translateX(3px);
  }

  .category-note__corner {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 2rem;
    height: 2rem;
    background: linear-gradient(135deg, transparent 0 47%, rgba(24, 26, 24, 0.2) 48% 49%, #e8e2d5 50% 100%);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  @media (max-width: 920px) {
    .pakse-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 5rem;
      padding-bottom: 2.5rem;
    }

    .pakse-hero__copy { max-width: 36rem; }

    .pakse-hero__visual {
      width: min(100%, 34rem);
      margin: 0 auto;
    }

    .pakse-hero__visual img { height: clamp(11rem, 42vw, 15rem); }

    .category-grid { grid-template-columns: 1fr; }

    .category-note {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      min-height: 10.8rem;
    }
  }

  @media (max-width: 540px) {
    .pakse-hero {
      width: min(100% - 2rem, 1180px);
      gap: 1.25rem;
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }

    .pakse-hero h1 { font-size: clamp(4rem, 23vw, 5.5rem); }

    .pakse-hero__lede {
      font-size: 1rem;
      line-height: 1.55;
    }

    .pakse-hero__visual {
      width: 100%;
      transform: rotate(0.5deg);
    }

    .pakse-hero__visual img { height: 11rem; }

    .pakse-categories {
      width: min(100% - 2rem, 1180px);
      padding-top: 1.5rem;
    }

    .category-note {
      grid-template-columns: 6.3rem minmax(0, 1fr);
      gap: 0.75rem;
      min-height: 9.6rem;
      padding: 1rem 0.9rem 1rem;
    }

    .category-note__illustration { min-height: 6rem; }
    .category-note__illustration svg { width: min(100%, 6rem); }
    .category-note__text { font-size: 0.78rem; }
    .category-note__meta { margin-top: 0.55rem; }
  }
</style>
