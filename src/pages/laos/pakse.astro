---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    slug: 'restaurants',
    title: 'Restaurants',
    kicker: 'EAT · LOCAL · SLOW',
    text: 'Local favourites, street-side tables and reliable places worth saving.',
    icon: 'restaurants',
  },
  {
    slug: 'cafes',
    title: 'Cafés',
    kicker: 'COFFEE · PAUSE · SHADE',
    text: 'Quiet corners, good coffee and easy places to slow down for an hour.',
    icon: 'cafes',
  },
  {
    slug: 'accommodation',
    title: 'Guesthouses',
    kicker: 'SLEEP · SIMPLE · CENTRAL',
    text: 'Comfortable stays, local guesthouses and practical bases around town.',
    icon: 'guesthouses',
  },
  {
    slug: 'scooter-rental',
    title: 'Scooter Rental',
    kicker: 'KEYS · HELMET · ROAD',
    text: 'Trusted rentals, useful checks and the right bike for the roads ahead.',
    icon: 'scooter',
  },
  {
    slug: 'bolaven-loop',
    title: 'Bolaven Loop',
    kicker: 'ROADS · FALLS · COFFEE',
    text: 'Routes, stops and field notes for the journey into the plateau.',
    icon: 'bolaven',
  },
  {
    slug: 'gyms-fitness',
    title: 'Gyms & Fitness',
    kicker: 'TRAIN · MOVE · SWEAT',
    text: 'Muay Thai, weights and practical places to keep training on the road.',
    icon: 'gyms',
  },
  {
    slug: 'markets-shopping',
    title: 'Markets & Shopping',
    kicker: 'MARKETS · GOODS · FINDS',
    text: 'Fresh markets, useful shops and small things worth bringing home.',
    icon: 'markets',
  },
  {
    slug: 'essential-information',
    title: 'Essential Information',
    kicker: 'VISA · HEALTH · BASICS',
    text: 'Hospitals, pharmacies, visa help, ATMs, SIM cards and useful contacts.',
    icon: 'essential',
  },
];
---

<BaseLayout
  title="Things to do in Pakse, Laos"
  description="Discover Pakse, a relaxed southern Laos base for local streets, Mekong sunsets and journeys toward the Bolaven Plateau."
  canonical="https://thingstodoatlas.com/laos/pakse"
>
  <main class="pakse-page">
    <section class="pakse-hero" aria-labelledby="pakse-title">
      <div class="pakse-hero__copy">
        <p class="pakse-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="pakse-title">Pakse</h1>
        <p class="pakse-hero__lede">
          The gateway to Southern Laos. A relaxed riverside city where local life, coffee culture and the road to the Bolaven Plateau begin within a few kilometres.
        </p>

        <div class="pakse-hero__notebook-meta" aria-label="Pakse notebook information">
          <span>
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 16s5-4.6 5-9A5 5 0 0 0 4 7c0 4.4 5 9 5 9Z"/><circle cx="9" cy="7" r="1.7"/></svg>
            Southern Laos
          </span>
          <span>
            <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="8" rx="1.5"/><path d="M5 12v2M13 12v2M5 7h8M6 4V2.8M12 4V2.8"/></svg>
            Route 13
          </span>
          <span>
            <svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="3.2"/><path d="M9 1.8v2M9 14.2v2M1.8 9h2M14.2 9h2M3.9 3.9l1.4 1.4M12.7 12.7l1.4 1.4M14.1 3.9l-1.4 1.4M5.3 12.7l-1.4 1.4"/></svg>
            Tropical climate
          </span>
          <span>
            <svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="11" rx="1.2"/><path d="M6 2.5v3M12 2.5v3M3 7h12"/></svg>
            July 2026
          </span>
        </div>

        <span class="pakse-hero__field-note">FIELD NOTE — Mekong light · southern roads</span>
      </div>

      <figure class="pakse-hero__visual">
        <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
        <span class="pakse-hero__stamp" aria-hidden="true">PAKSE<br />07 · 2026</span>
        <span class="pakse-hero__arrow" aria-hidden="true">
          <svg viewBox="0 0 90 58"><path d="M6 48c24-4 43-15 65-37"/><path d="m61 11 12-2-2 12"/></svg>
        </span>
        <span class="pakse-hero__annotation" aria-hidden="true">first light by the Mekong</span>
        <img
          src="/images/laos/pakse.webp"
          alt="A view of Pakse in southern Laos"
          width="1600"
          height="1100"
          fetchpriority="high"
        />
        <figcaption>Southern Laos · first notes from the road</figcaption>
        <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="pakse-categories" aria-labelledby="pakse-categories-title">
      <div class="pakse-categories__heading">
        <p>PAKSE DIRECTORY</p>
        <h2 id="pakse-categories-title">Open the notebook</h2>
      </div>

      <div class="category-grid">
        {categories.map((category, index) => (
          <a
            class={`category-note category-note--${index % 4}`}
            href={`/laos/pakse/${category.slug}`}
            aria-label={`Explore ${category.title} in Pakse`}
          >
            <span class="category-note__tape" aria-hidden="true"></span>
            <span class="category-note__illustration" aria-hidden="true">
              {category.icon === 'restaurants' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M25 55c4 29 20 44 50 44s46-15 50-44" stroke-width="3.2" />
                    <path d="M21 52c8-10 24-14 54-14s46 4 54 14c-8 10-24 14-54 14S29 62 21 52Z" stroke-width="3.2" />
                    <path d="M36 55c10-6 20-7 39-7s31 2 42 8M42 60c8-10 16-9 25 0 8-10 16-10 25 0 7-8 15-8 22-1" stroke-width="2" />
                    <path d="M93 42 130 9M101 46l37-28" stroke-width="4" />
                    <path d="M59 31c-7-9-3-17 2-23M73 31c-6-9-2-18 3-25M86 32c-5-8-1-15 4-21" stroke-width="2" />
                    <path d="M36 106c23 4 49 4 76 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'cafes' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M35 43h68v35c0 14-11 25-25 25H60c-14 0-25-11-25-25Z" stroke-width="3" />
                    <path d="M103 51h12c11 0 18 7 18 16s-7 16-18 16h-12" stroke-width="3" />
                    <path d="M31 43h77M43 107h72" stroke-width="2" />
                    <path d="M57 32c-7-9 4-14-1-23M76 32c-8-10 5-15 0-25M94 32c-6-8 4-13 1-21" stroke-width="2.3" />
                    <path d="M49 54c15 5 30 5 44 0" stroke-width="1.4" opacity=".6" />
                  </g>
                </svg>
              )}

              {category.icon === 'guesthouses' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M25 55 80 16l55 39" stroke-width="3.2" />
                    <path d="M34 49v58h92V49" stroke-width="3" />
                    <path d="M66 107V72h28v35M46 62h15v17H46zM100 62h15v17h-15z" stroke-width="2.4" />
                    <path d="M42 37V21h18v4" stroke-width="2.4" />
                    <path d="M18 109c37-4 83-4 124 0" stroke-width="1.4" opacity=".55" />
                  </g>
                </svg>
              )}

              {category.icon === 'scooter' && (
                <img class="category-note__traced-art" src="/images/laos/pakse-scooter-helmet.svg" alt="" />
              )}

              {category.icon === 'bolaven' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m22 28 34-10 47 12 35-10v73l-35 10-47-12-34 10Z" stroke-width="3" />
                    <path d="M56 18v73M103 30v73" stroke-width="2" />
                    <path d="M37 78c12-31 28-9 42-29 12-17 22 4 38-10" stroke-width="2.6" stroke-dasharray="5 5" />
                    <circle cx="37" cy="78" r="4" stroke-width="2" />
                    <circle cx="117" cy="39" r="4" stroke-width="2" />
                    <path d="M67 82c5-9 9-18 12-27M79 55l7 8M79 55l-8 7" stroke-width="2" />
                  </g>
                </svg>
              )}

              {category.icon === 'gyms' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M28 45v31M39 37v47M51 32v57M109 32v57M121 37v47M132 45v31" stroke-width="4" />
                    <path d="M51 60h58" stroke-width="5" />
                    <path d="M19 60h9M132 60h9" stroke-width="3" />
                    <path d="M52 99c20 4 38 4 57 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'markets' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M34 48h92l-12 58H46Z" stroke-width="3" />
                    <path d="M55 49c2-22 12-34 25-34s23 12 25 34" stroke-width="3" />
                    <path d="M49 63h66M46 78h72M43 93h73" stroke-width="1.8" />
                    <path d="M58 49v57M77 49v57M96 49v57M114 49v57" stroke-width="1.5" opacity=".75" />
                    <path d="M34 111c30 3 62 3 94 0" stroke-width="1.4" opacity=".5" />
                  </g>
                </svg>
              )}

              {category.icon === 'essential' && (
                <svg viewBox="0 0 160 120" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M25 46c0-9 7-16 16-16h71c9 0 16 7 16 16v50c0 9-7 16-16 16H41c-9 0-16-7-16-16Z" stroke-width="3" />
                    <path d="M51 30c2-12 10-18 25-18s23 6 25 18" stroke-width="3" />
                    <path d="M56 29c3-7 9-10 20-10s17 3 20 10" stroke-width="1.6" opacity=".7" />
                    <path d="M25 48c27 4 62 4 103 0" stroke-width="2" />
                    <path d="M119 47v49c0 9-7 16-16 16" stroke-width="1.6" opacity=".65" />
                    <path d="M109 48v49c0 5-4 9-9 9" stroke-width="1.8" />
                    <path d="M111 59c5 2 6 7 2 11l-3 3 4 15c1 5-2 8-6 9" stroke-width="2" />
                    <path d="M55 70h17V57h15v13h17v15H87v14H72V85H55Z" stroke-width="2.8" />
                    <path d="M31 88l10-6M32 98l11-7M42 107l10-6M94 108l10-6" stroke-width="1.3" opacity=".6" />
                    <path d="M39 39c13-2 26-2 39-1M39 43c11-1 21-1 31 0" stroke-width="1.1" opacity=".5" />
                    <path d="M35 115c25 3 57 3 85 0" stroke-width="1.3" opacity=".45" />
                  </g>
                </svg>
              )}
            </span>

            <span class="category-note__copy">
              <span class="category-note__kicker">{category.kicker}</span>
              <span class="category-note__title">{category.title}</span>
              <span class="category-note__text">{category.text}</span>
              <span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span>
            </span>

            <span class="category-note__corner" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pakse-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .pakse-hero {
    position: relative;
    display: grid;
    grid-template-columns: 34rem minmax(17rem, 24rem);
    align-items: start;
    justify-content: start;
    column-gap: 0;
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(5.5rem, 7vw, 6.75rem) 0 clamp(1.25rem, 2vw, 1.75rem);
  }

  .pakse-hero__copy {
    position: relative;
    z-index: 6;
    max-width: none;
  }

  .pakse-hero__eyebrow {
    margin: 0 0 0.65rem;
    color: #8a4d36;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pakse-hero h1 {
    position: relative;
    z-index: 7;
    width: max-content;
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4rem, 8vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  .pakse-hero__lede {
    max-width: 29rem;
    margin: clamp(1rem, 1.6vw, 1.35rem) 0 0;
    color: #3f4943;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.55;
  }

  .pakse-hero__notebook-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0.45rem 1.1rem;
    margin-top: 1rem;
    color: rgba(31, 57, 45, 0.72);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .pakse-hero__notebook-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    white-space: nowrap;
  }

  .pakse-hero__notebook-meta svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.78;
  }

  .pakse-hero__field-note {
    display: inline-block;
    margin-top: 0.95rem;
    color: rgba(31, 57, 45, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(0.72rem, 0.9vw, 0.82rem);
    letter-spacing: 0.04em;
    transform: rotate(-1.5deg);
  }

  .pakse-hero__visual {
    position: relative;
    z-index: 2;
    width: clamp(17rem, 25vw, 24rem);
    margin: 1.45rem 0 0 -13rem;
    padding: 0.42rem 0.42rem 1.35rem;
    background: #fbf8f0;
    box-shadow: 0 10px 24px rgba(38, 45, 40, 0.1);
    transform: rotate(0.8deg);
  }

  .pakse-hero__visual img {
    display: block;
    width: 100%;
    height: clamp(9rem, 11.5vw, 11.25rem);
    object-fit: cover;
    object-position: center;
    filter: saturate(0.88) contrast(0.97);
  }

  .pakse-hero__visual figcaption {
    position: absolute;
    left: 0.65rem;
    bottom: 0.32rem;
    margin: 0;
    color: rgba(31, 41, 36, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.54rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .pakse-hero__tape {
    position: absolute;
    z-index: 5;
    width: 3.8rem;
    height: 0.8rem;
    background: rgba(196, 177, 139, 0.48);
    pointer-events: none;
  }

  .pakse-hero__tape--top {
    top: -0.28rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .pakse-hero__tape--bottom {
    right: 0.8rem;
    bottom: -0.28rem;
    transform: rotate(4deg);
  }

  .pakse-hero__stamp {
    position: absolute;
    z-index: 4;
    top: 0.85rem;
    right: -1.55rem;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border: 1px solid rgba(138, 77, 54, 0.42);
    border-radius: 50%;
    color: rgba(138, 77, 54, 0.58);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: center;
    transform: rotate(8deg);
  }

  .pakse-hero__stamp::after {
    content: '';
    position: absolute;
    inset: 0.25rem;
    border: 1px dashed currentColor;
    border-radius: 50%;
    opacity: 0.55;
  }

  .pakse-hero__arrow {
    position: absolute;
    z-index: 4;
    left: -3.4rem;
    top: 1.6rem;
    width: 4.6rem;
    color: rgba(31, 57, 45, 0.48);
    transform: rotate(-7deg);
  }

  .pakse-hero__arrow svg {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pakse-hero__annotation {
    position: absolute;
    z-index: 4;
    right: 0.45rem;
    bottom: -1.45rem;
    color: rgba(31, 57, 45, 0.55);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.58rem;
    letter-spacing: 0.02em;
    transform: rotate(-2.5deg);
    white-space: nowrap;
  }

  .pakse-categories {
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(5rem, 8vw, 8rem);
  }

  .pakse-categories__heading {
    margin-bottom: 1.4rem;
  }

  .pakse-categories__heading p {
    margin: 0 0 0.4rem;
    color: rgba(31, 57, 45, 0.56);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .pakse-categories__heading h2 {
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .category-note {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: 11rem;
    padding: 1.15rem;
    overflow: visible;
    color: #181a18;
    text-decoration: none;
    background: #f8f5ec;
    border: 1px solid rgba(24, 26, 24, 0.2);
    box-shadow: 0 5px 12px rgba(31, 41, 36, 0.045);
    transition: transform 180ms ease, box-shadow 180ms ease;
    isolation: isolate;
  }

  .category-note--0 { transform: rotate(-0.4deg); }
  .category-note--1 { transform: rotate(0.35deg); }
  .category-note--2 { transform: rotate(-0.2deg); }
  .category-note--3 { transform: rotate(0.5deg); }

  .category-note::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    display: none;
    border-radius: 50%;
    background: radial-gradient(circle at 78% 28%, rgba(143, 102, 63, 0.09), transparent 0 18%, rgba(143, 102, 63, 0.035) 28%, transparent 43%);
    transform: rotate(-8deg) scale(0.9);
  }

  .category-note:nth-child(2)::after,
  .category-note:nth-child(5)::after {
    display: block;
  }

  .category-note:hover,
  .category-note:focus-visible {
    transform: translateY(-2px) rotate(0deg);
    box-shadow: 0 8px 16px rgba(31, 41, 36, 0.075);
  }

  .category-note:focus-visible {
    outline: 2px solid #1f392d;
    outline-offset: 5px;
  }

  .category-note__tape {
    position: absolute;
    top: -0.45rem;
    left: 0.75rem;
    width: 4.3rem;
    height: 1.25rem;
    background: rgba(213, 204, 184, 0.72);
    border: 0;
    clip-path: polygon(2% 12%, 95% 0, 100% 84%, 5% 100%);
    transform: rotate(-6deg);
    box-shadow: none;
  }

  .category-note:nth-child(2) .category-note__tape,
  .category-note:nth-child(3) .category-note__tape,
  .category-note:nth-child(5) .category-note__tape,
  .category-note:nth-child(7) .category-note__tape,
  .category-note:nth-child(8) .category-note__tape {
    display: none;
  }

  .category-note:nth-child(4) .category-note__tape {
    left: auto;
    right: 1rem;
    transform: rotate(5deg);
  }

  .category-note__illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 7.5rem;
    color: #101210;
  }

  .category-note__illustration svg {
    display: block;
    width: min(100%, 8.7rem);
    height: auto;
    filter: contrast(1.05);
  }

  .category-note__traced-art {
    display: block;
    width: min(100%, 8.7rem);
    height: auto;
    object-fit: contain;
    filter: contrast(1.08);
  }

  .category-note__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .category-note__kicker {
    margin-bottom: 0.35rem;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .category-note__title {
    position: relative;
    display: inline-block;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .category-note__title::after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.25rem;
    bottom: -0.16rem;
    height: 1.5px;
    background: currentColor;
    transform: rotate(-1.2deg);
    transform-origin: left center;
  }

  .category-note__text {
    max-width: 20rem;
    margin-top: 0.8rem;
    color: rgba(24, 26, 24, 0.76);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.88rem;
    line-height: 1.42;
  }

  .category-note__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.72rem;
    font-weight: 700;
