---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import PakseEditorialGuide from '../../components/PakseEditorialGuide.astro';
import CityLandmarkSection from '../../components/CityLandmarkSection.astro';
import LandmarkModalSet from '../../components/LandmarkModalSet.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { getLandmarksForCity } from '../../data/laosLandmarks';
import { getPlacesForCategory } from '../../data/atlas';

const pakseLandmarks = getLandmarksForCity('pakse');

const paksePostcardFacts = [
  { label: 'July 2026', icon: 'calendar' as const },
  { label: 'Road-trip base', icon: 'road' as const },
  { label: 'Tropical climate', icon: 'climate' as const },
  { label: 'Southern Laos', icon: 'location' as const }
];

const categoryTabs = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, fieldNote: '04', noun: 'restaurants', intro: 'From local Lao kitchens to European tables and late-night bars, these are the addresses worth keeping in your notebook.' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · PAUSE · SHADE', icon: 'cafes' as const, fieldNote: '05', noun: 'cafés', intro: 'Good coffee, calm corners and easy places to slow down for an hour in Pakse.' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · SIMPLE · CENTRAL', icon: 'guesthouses' as const, fieldNote: '06', noun: 'stays', intro: 'Simple guesthouses, comfortable hotels and practical bases for exploring Pakse and the south.' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · HELMET · ROAD', icon: 'scooter' as const, fieldNote: '07', noun: 'rental addresses', intro: 'Trusted places to find a scooter, check the basics and prepare for the roads beyond town.' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · SWEAT', icon: 'gyms' as const, fieldNote: '08', noun: 'places to train', intro: 'Muay Lao camps, weight rooms and useful places to keep moving while you are in Pakse.' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', icon: 'markets' as const, fieldNote: '09', noun: 'markets and shops', intro: 'Fresh markets, evening stalls and practical shops worth knowing around Pakse.' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'VISA · HEALTH · BASICS', icon: 'essential' as const, fieldNote: '10', noun: 'useful addresses', intro: 'Visa services, healthcare and practical locations to keep close before you need them.' }
].map((category) => ({ ...category, places: getPlacesForCategory(category.slug) }));

const spaTabs = categoryTabs.map(({ slug, title, kicker, icon, places }) => ({ slug, title, kicker, icon, count: places.length }));
const restaurantFilters = [
  { value: 'all', label: 'All' },
  { value: 'lao', label: 'Lao' },
  { value: 'european', label: 'European' },
  { value: 'bar', label: 'Bar' }
];

const getRestaurantFilterTags = (place: (typeof categoryTabs)[number]['places'][number]) => {
  const cuisineAndType = `${place.cuisine} ${place.subcategory}`.toLowerCase();
  const barDetails = `${place.subcategory} ${place.highlights.join(' ')}`.toLowerCase();
  const tags = ['all'];
  if (/\blao\b/.test(cuisineAndType)) tags.push('lao');
  if (/(french|italian|european)/.test(place.cuisine.toLowerCase())) tags.push('european');
  if (/(\bbar\b|beer garden|restaurant and bar)/.test(barDetails)) tags.push('bar');
  return tags;
};
---

<BaseLayout
  title="Things to do in Pakse, Laos"
  description="Discover what to do in and around Pakse, the Southern Laos base for the Bolaven Plateau, Wat Phou, Mekong roads and practical local addresses."
  canonical="https://thingstodoatlas.com/laos/pakse"
>
  <main class="pakse-page">
    <CityPostcardHero
      cityName="Pakse"
      eyebrow="LAOS · CHAPTER 02"
      description="The gateway to Southern Laos. More than a list of city sights, Pakse is a relaxed riverside base for the Bolaven Plateau, Wat Phou and the roads that continue south."
      photoSrc="/images/laos/pakse.webp"
      photoAlt="A view of Pakse in southern Laos"
      facts={paksePostcardFacts}
      fieldNote="FIELD NOTE — Mekong light · roads beginning here"
      backHref="/laos"
      backLabel="Back to the Laos map"
      postmarkDate="07 · 2026"
      stampLabel="LAOS"
      stampMotif="river"
      drawingSrc="/images/laos/pakse-fisherman-boat-v3.webp"
      drawingAlt="Hand-drawn boat on the Mekong near Pakse"
      drawingCaption="Mekong · the road beside the river"
      partner={{
        label: 'LOCAL PARTNER',
        title: 'In partnership with Muay Thai Pakse',
        href: 'https://muaythaipakse.com'
      }}
    />
    <PakseEditorialGuide />

    <CityLandmarkSection
      cityName="Pakse"
      eyebrow="PAKSE & SOUTHERN LAOS"
      title="Explore from Pakse"
      landmarks={pakseLandmarks}
      asideTitle="A city that opens the road south"
      asideParagraphs={[
        'Pakse is not a city built around a long checklist of monuments. Its real value is its location: a calm, practical place to prepare the journeys that define Southern Laos.',
        'Travellers stop here to rent a scooter, reach the Bolaven Plateau, visit Wat Phou and continue along the Mekong toward Si Phan Don. The city gives those roads a useful starting point.'
      ]}
      asideNote="Choose the journey first. The practical notebook comes next."
    />

    <CityCategorySPA
      cityName="Pakse"
      categories={spaTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Pakse"
      intro="Choose one small notebook tab. The current list closes when another opens, while every saved address remains in My Trip."
    >
      {categoryTabs.map((category, categoryIndex) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Pakse"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro={category.intro}
          fieldNote={category.fieldNote}
          active={categoryIndex === 0}
        >
          {category.slug === 'restaurants' && (
            <div slot="filters" class="pakse-restaurant-filters" data-pakse-restaurant-filters>
              <nav aria-label="Filter Pakse restaurants">
                {restaurantFilters.map((filter) => (
                  <button
                    class:list={['pakse-filter', { 'is-active': filter.value === 'all' }]}
                    type="button"
                    data-pakse-filter={filter.value}
                    aria-pressed={filter.value === 'all' ? 'true' : 'false'}
                  >
                    {filter.label}
                  </button>
                ))}
              </nav>
              <p data-pakse-filter-status aria-live="polite">{category.places.length} addresses shown</p>
            </div>
          )}

          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, index) => (
                <div
                  data-pakse-restaurant-card={category.slug === 'restaurants' ? '' : undefined}
                  data-filter-tags={category.slug === 'restaurants' ? getRestaurantFilterTags(place).join(' ') : undefined}
                >
                  <PlaceCard place={place} index={index} />
                </div>
              ))}
            </div>
          ) : (
            <div class="city-panel-empty">
              <h4>The useful stops are being documented.</h4>
              <p>This section is ready and will fill as soon as the addresses and field notes have been checked.</p>
            </div>
          )}
        </CityCategoryPanel>
      ))}
    </CityCategorySPA>
  </main>
  <LandmarkModalSet landmarks={pakseLandmarks} />
</BaseLayout>

<style>
  .pakse-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .pakse-restaurant-filters nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pakse-filter {
    min-width: 57px;
    padding: 9px 14px;
    border: 1px solid rgba(49, 85, 69, .25);
    background: transparent;
    color: var(--green);
    font: 700 .61rem/1 'DM Sans', sans-serif;
    cursor: pointer;
  }

  .pakse-filter.is-active {
    border-color: var(--green);
    background: var(--green);
    color: #fff;
  }

  .pakse-restaurant-filters p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: .62rem;
  }
</style>

<script>
  const setupPakseRestaurantFilters = () => {
    const root = document.querySelector<HTMLElement>('[data-pakse-restaurant-filters]');
    if (!root || root.dataset.filterReady === 'true') return;

    root.dataset.filterReady = 'true';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pakse-filter]')];
    const panel = root.closest('[data-city-category-panel]');
    const cards = [...(panel?.querySelectorAll<HTMLElement>('[data-pakse-restaurant-card]') || [])];
    const status = root.querySelector<HTMLElement>('[data-pakse-filter-status]');

    buttons.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.pakseFilter || 'all';
      let shown = 0;

      buttons.forEach((entry) => {
        const active = entry === button;
        entry.classList.toggle('is-active', active);
        entry.setAttribute('aria-pressed', String(active));
      });

      cards.forEach((card) => {
        const visible = value === 'all' || (card.dataset.filterTags || '').split(' ').includes(value);
        card.hidden = !visible;
        if (visible) shown += 1;
      });

      if (status) status.textContent = `${shown} ${shown === 1 ? 'address' : 'addresses'} shown`;
    }));
  };

  setupPakseRestaurantFilters();
  document.addEventListener('astro:page-load', setupPakseRestaurantFilters);
</script>
