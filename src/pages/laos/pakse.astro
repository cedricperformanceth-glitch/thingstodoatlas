---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityLandmarkSection from '../../components/CityLandmarkSection.astro';
import LandmarkModalSet from '../../components/LandmarkModalSet.astro';
import CityCategorySPA from '../../components/CityCategorySPA.astro';
import CityCategoryPanel from '../../components/CityCategoryPanel.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { getLandmarksForCity } from '../../data/laosLandmarks';
import { getPlacesForCategory } from '../../data/atlas';

const pakseLandmarks = getLandmarksForCity('pakse');

const categoryTabs = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', icon: 'restaurants' as const, fieldNote: '04', noun: 'restaurants', intro: 'From local Lao kitchens to European tables and late-night bars, these are the addresses worth keeping in your notebook.' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · PAUSE · SHADE', icon: 'cafes' as const, fieldNote: '05', noun: 'cafés', intro: 'Good coffee, calm corners and easy places to slow down for an hour in Pakse.' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · SIMPLE · CENTRAL', icon: 'guesthouses' as const, fieldNote: '06', noun: 'stays', intro: 'Simple guesthouses, comfortable hotels and practical bases for exploring Pakse and the south.' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · HELMET · ROAD', icon: 'scooter' as const, fieldNote: '07', noun: 'rental addresses', intro: 'Trusted places to find a scooter, check the basics and prepare for the roads beyond town.' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · SWEAT', icon: 'gyms' as const, fieldNote: '08', noun: 'places to train', intro: 'Muay Lao camps, weight rooms and useful places to keep moving while you are in Pakse.' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', icon: 'markets' as const, fieldNote: '09', noun: 'markets and shops', intro: 'Fresh markets, evening stalls and practical shops worth knowing around Pakse.' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'VISA · HEALTH · BASICS', icon: 'essential' as const, fieldNote: '10', noun: 'useful addresses', intro: 'Visa services, healthcare and practical locations to keep close before you need them.' }
].map((category) => ({ ...category, places: getPlacesForCategory(category.slug) }));

const spaTabs = categoryTabs.map(({ slug, title, kicker, icon, places }) => ({ slug, title, kicker, icon, count: places.length }));
const restaurantFilters = [
  { value: 'all', label: 'All' },
  { value: 'lao', label: 'Lao' },
  { value: 'european', label: 'European' },
  { value: 'bar', label: 'Bar' }
];
const getRestaurantFilterTags = (place: (typeof categoryTabs)[number]['places'][number]) => {
  const cuisineAndType = `${place.cuisine} ${place.subcategory}`.toLowerCase();
  const barDetails = `${place.subcategory} ${place.highlights.join(' ')}`.toLowerCase();
  const tags = ['all'];
  if (/\blao\b/.test(cuisineAndType)) tags.push('lao');
  if (/(french|italian|european)/.test(place.cuisine.toLowerCase())) tags.push('european');
  if (/(\bbar\b|beer garden|restaurant and bar)/.test(barDetails)) tags.push('bar');
  return tags;
};
---

<BaseLayout
  title="Things to do in Pakse, Laos"
  description="Discover what to do in and around Pakse, the Southern Laos base for the Bolaven Plateau, Wat Phou, Mekong roads and practical local addresses."
  canonical="https://thingstodoatlas.com/laos/pakse"
>
  <main class="pakse-page">
    <section class="pakse-hero" aria-labelledby="pakse-title">
      <div class="pakse-hero__copy">
        <p class="pakse-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="pakse-title"><span class="pakse-hero__initial">P</span><span class="pakse-hero__rest">akse</span></h1>
        <p class="pakse-hero__lede">The gateway to Southern Laos. More than a list of city sights, Pakse is a relaxed riverside base for the Bolaven Plateau, Wat Phou and the roads that continue south.</p>
        <div class="pakse-hero__notebook-meta" aria-label="Pakse notebook information">
          <span><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 16s5-4.6 5-9A5 5 0 0 0 4 7c0 4.4 5 9 5 9Z"/><circle cx="9" cy="7" r="1.7"/></svg>Southern Laos</span>
          <span><svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="8" rx="1.5"/><path d="M5 12v2M13 12v2M5 7h8M6 4V2.8M12 4V2.8"/></svg>Road-trip base</span>
          <span><svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="3.2"/><path d="M9 1.8v2M9 14.2v2M1.8 9h2M14.2 9h2M3.9 3.9l1.4 1.4M12.7 12.7l1.4 1.4M14.1 3.9l-1.4 1.4M5.3 12.7l-1.4 1.4"/></svg>Tropical climate</span>
          <span><svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="11" rx="1.2"/><path d="M6 2.5v3M12 2.5v3M3 7h12"/></svg>July 2026</span>
        </div>
        <span class="pakse-hero__field-note">FIELD NOTE — Mekong light · roads beginning here</span>
        <img class="pakse-hero__boat" src="/images/laos/pakse-boat.webp" alt="Hand-drawn boat on the Mekong near Pakse" width="1402" height="1122" decoding="async" />
      </div>

      <figure class="pakse-hero__visual">
        <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
        <span class="pakse-hero__stamp" aria-hidden="true">PAKSE<br />07 · 2026</span>
        <span class="pakse-hero__arrow" aria-hidden="true"><svg viewBox="0 0 90 58"><path d="M6 48c24-4 43-15 65-37"/><path d="m61 11 12-2-2 12"/></svg></span>
        <span class="pakse-hero__annotation" aria-hidden="true">the road starts here</span>
        <img src="/images/laos/pakse.webp" alt="A view of Pakse in southern Laos" width="1600" height="1100" fetchpriority="high" />
        <figcaption>Southern Laos · a practical base between journeys</figcaption>
        <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
      </figure>
    </section>

    <CityLandmarkSection
      cityName="Pakse"
      eyebrow="PAKSE & SOUTHERN LAOS"
      title="Explore from Pakse"
      landmarks={pakseLandmarks}
      asideTitle="A city that opens the road south"
      asideParagraphs={[
        'Pakse is not a city built around a long checklist of monuments. Its real value is its location: a calm, practical place to prepare the journeys that define Southern Laos.',
        'Travellers stop here to rent a scooter, reach the Bolaven Plateau, visit Wat Phou and continue along the Mekong toward Si Phan Don. The city gives those roads a useful starting point.'
      ]}
      asideNote="Choose the journey first. The practical notebook comes next."
    />

    <CityCategorySPA
      cityName="Pakse"
      categories={spaTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Pakse"
      intro="Choose one small notebook tab. The current list closes when another opens, while every saved address remains in My Trip."
    >
      {categoryTabs.map((category, categoryIndex) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Pakse"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro={category.intro}
          fieldNote={category.fieldNote}
          active={categoryIndex === 0}
        >
          {category.slug === 'restaurants' && (
            <div slot="filters" class="pakse-restaurant-filters" data-pakse-restaurant-filters>
              <nav aria-label="Filter Pakse restaurants">
                {restaurantFilters.map((filter) => <button class:list={['pakse-filter', { 'is-active': filter.value === 'all' }]} type="button" data-pakse-filter={filter.value} aria-pressed={filter.value === 'all' ? 'true' : 'false'}>{filter.label}</button>)}
              </nav>
              <p data-pakse-filter-status aria-live="polite">{category.places.length} addresses shown</p>
            </div>
          )}
          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, index) => (
                <div
                  data-pakse-restaurant-card={category.slug === 'restaurants' ? '' : undefined}
                  data-filter-tags={category.slug === 'restaurants' ? getRestaurantFilterTags(place).join(' ') : undefined}
                >
                  <PlaceCard place={place} index={index} />
                </div>
              ))}
            </div>
          ) : (
            <div class="city-panel-empty"><h4>The useful stops are being documented.</h4><p>This section is ready and will fill as soon as the addresses and field notes have been checked.</p></div>
          )}
        </CityCategoryPanel>
      ))}
    </CityCategorySPA>
  </main>
  <LandmarkModalSet landmarks={pakseLandmarks} />
</BaseLayout>

<style>
  .pakse-page{min-height:100vh;background:#f2eee3;color:#1f2924}
  .pakse-hero{position:relative;display:grid;grid-template-columns:minmax(17rem,24rem) 34rem;align-items:start;justify-content:start;column-gap:0;width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(5.5rem,7vw,6.75rem) 0 clamp(2.4rem,4vw,3.5rem)}
  .pakse-hero__copy{position:relative;z-index:6;grid-column:2;max-width:34rem;margin-left:-.65rem}.pakse-hero__eyebrow{margin:0 0 .65rem;color:#8a4d36;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
  .pakse-hero h1{position:relative;z-index:7;display:flex;align-items:baseline;width:max-content;margin:0;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4rem,8vw,6.8rem);font-weight:400;letter-spacing:-.065em;line-height:.84}.pakse-hero__initial{display:inline-block;transform:translateX(-1.3rem)}.pakse-hero__rest{display:inline-block;transform:translateX(-1.05rem)}
  .pakse-hero__lede{max-width:31rem;margin:clamp(1rem,1.6vw,1.35rem) 0 0;color:#3f4943;font-family:Georgia,'Times New Roman',serif;font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.55}
  .pakse-hero__notebook-meta{display:grid;grid-template-columns:repeat(2,minmax(0,max-content));gap:.45rem 1.1rem;margin-top:1rem;color:rgba(31,57,45,.72);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.68rem;line-height:1.25}.pakse-hero__notebook-meta span{display:inline-flex;align-items:center;gap:.38rem;white-space:nowrap}.pakse-hero__notebook-meta svg{width:.85rem;height:.85rem;fill:none;stroke:currentColor;stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round;opacity:.78}.pakse-hero__field-note{display:inline-block;margin-top:.95rem;color:rgba(31,57,45,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(.72rem,.9vw,.82rem);letter-spacing:.04em;transform:rotate(-1.5deg)}
  .pakse-hero__boat{display:block;width:min(15rem,72%);height:auto;margin:1.25rem 0 0 auto;object-fit:contain;transform:rotate(-2deg);opacity:.88}.pakse-hero__visual{position:relative;z-index:2;grid-column:1;grid-row:1;width:clamp(17rem,25vw,24rem);margin:1.45rem 0 0;padding:.42rem .42rem 1.35rem;background:#fbf8f0;box-shadow:0 10px 24px rgba(38,45,40,.1);transform:rotate(.8deg)}.pakse-hero__visual img{display:block;width:100%;height:clamp(9rem,11.5vw,11.25rem);object-fit:cover;object-position:center;filter:saturate(.88) contrast(.97)}.pakse-hero__visual figcaption{position:absolute;left:.65rem;bottom:.32rem;margin:0;color:rgba(31,41,36,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.54rem;letter-spacing:.03em;white-space:nowrap}.pakse-hero__tape{position:absolute;z-index:5;width:3.8rem;height:.8rem;background:rgba(196,177,139,.48);pointer-events:none}.pakse-hero__tape--top{top:-.28rem;left:50%;transform:translateX(-50%) rotate(-3deg)}.pakse-hero__tape--bottom{right:.8rem;bottom:-.28rem;transform:rotate(4deg)}.pakse-hero__stamp{position:absolute;z-index:4;top:.85rem;right:-1.55rem;display:grid;place-items:center;width:3.4rem;height:3.4rem;border:1px solid rgba(138,77,54,.42);border-radius:50%;color:rgba(138,77,54,.58);font-size:.5rem;font-weight:700;letter-spacing:.08em;line-height:1.25;text-align:center;transform:rotate(8deg)}.pakse-hero__stamp::after{content:'';position:absolute;inset:.25rem;border:1px dashed currentColor;border-radius:50%;opacity:.55}.pakse-hero__arrow{position:absolute;z-index:4;left:-3.4rem;top:1.6rem;width:4.6rem;color:rgba(31,57,45,.48);transform:rotate(-7deg)}.pakse-hero__arrow svg{display:block;width:100%;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.pakse-hero__annotation{position:absolute;z-index:4;right:.45rem;bottom:-1.45rem;color:rgba(31,57,45,.55);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.58rem;letter-spacing:.02em;transform:rotate(-2.5deg);white-space:nowrap}
  .pakse-restaurant-filters nav{display:flex;flex-wrap:wrap;gap:8px}.pakse-filter{min-width:57px;padding:9px 14px;border:1px solid rgba(49,85,69,.25);background:transparent;color:var(--green);font:700 .61rem/1 'DM Sans',sans-serif;cursor:pointer}.pakse-filter.is-active{border-color:var(--green);background:var(--green);color:#fff}.pakse-restaurant-filters p{margin:10px 0 0;color:var(--muted);font-size:.62rem}
  @media(max-width:820px){.pakse-hero{grid-template-columns:1fr;gap:1.35rem;padding-top:4rem;padding-bottom:2.7rem}.pakse-hero__copy{grid-column:1;grid-row:1;max-width:36rem;margin-left:0}.pakse-hero__initial,.pakse-hero__rest{transform:none}.pakse-hero__visual{grid-column:1;grid-row:2;width:min(100%,24rem);margin:0 auto}.pakse-hero__visual img{height:clamp(9rem,32vw,11.25rem)}.pakse-hero__arrow{left:-2.3rem;top:1.1rem;width:3.7rem}}
  @media(max-width:540px){.pakse-hero{width:min(100% - 2rem,1180px);gap:1rem;padding-top:3.75rem;padding-bottom:2.4rem}.pakse-hero h1{font-size:clamp(4rem,23vw,5.5rem)}.pakse-hero__lede{font-size:1rem;line-height:1.55}.pakse-hero__notebook-meta{grid-template-columns:1fr 1fr;gap:.45rem .7rem;font-size:.62rem}.pakse-hero__visual{width:min(100%,21rem)}.pakse-hero__visual img{height:9.5rem}}
</style>

<script>
  const setupPakseRestaurantFilters = () => {
    const root = document.querySelector<HTMLElement>('[data-pakse-restaurant-filters]');
    if (!root || root.dataset.filterReady === 'true') return;
    root.dataset.filterReady = 'true';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pakse-filter]')];
    const panel = root.closest('[data-city-category-panel]');
    const cards = [...(panel?.querySelectorAll<HTMLElement>('[data-pakse-restaurant-card]') || [])];
    const status = root.querySelector<HTMLElement>('[data-pakse-filter-status]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.pakseFilter || 'all';
      let shown = 0;
      buttons.forEach((entry) => {
        const active = entry === button;
        entry.classList.toggle('is-active', active);
        entry.setAttribute('aria-pressed', String(active));
      });
      cards.forEach((card) => {
        const visible = value === 'all' || (card.dataset.filterTags || '').split(' ').includes(value);
        card.hidden = !visible;
        if (visible) shown += 1;
      });
      if (status) status.textContent = `${shown} ${shown === 1 ? 'address' : 'addresses'} shown`;
    }));
  };
  setupPakseRestaurantFilters();
  document.addEventListener('astro:page-load', setupPakseRestaurantFilters);
</script>
