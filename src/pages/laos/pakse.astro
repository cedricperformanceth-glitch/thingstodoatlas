---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Things to do in Pakse, Laos"
  description="Discover Pakse, a relaxed southern Laos base for local streets, Mekong sunsets and journeys toward the Bolaven Plateau."
  canonical="https://thingstodoatlas.com/laos/pakse"
>
  <main class="pakse-page">
    <section class="pakse-hero" aria-labelledby="pakse-title">
      <div class="pakse-hero__copy">
        <p class="pakse-hero__eyebrow">LAOS · CHAPTER 02</p>
        <h1 id="pakse-title">Pakse</h1>
        <p class="pakse-hero__lede">
          The gateway to Southern Laos. A relaxed riverside city where local life, coffee culture and the road to the Bolaven Plateau begin within a few kilometres.
        </p>
        <span class="pakse-hero__field-note">FIELD NOTE — Mekong light · southern roads</span>
      </div>

      <figure class="pakse-hero__visual">
        <span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span>
        <img
          src="/images/laos/pakse.webp"
          alt="A view of Pakse in southern Laos"
          width="1600"
          height="1100"
          fetchpriority="high"
        />
        <figcaption>Southern Laos · first notes from the road</figcaption>
        <span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="pakse-categories" aria-labelledby="pakse-categories-title">
      <div class="pakse-categories__heading">
        <p>PAKSE DIRECTORY</p>
        <h2 id="pakse-categories-title">Open the notebook</h2>
      </div>

      <a class="category-note category-note--restaurants" href="/laos/pakse/restaurants" aria-label="Explore restaurants in Pakse">
        <span class="category-note__tape" aria-hidden="true"></span>
        <span class="category-note__paper-line category-note__paper-line--top" aria-hidden="true"></span>
        <span class="category-note__paper-line category-note__paper-line--bottom" aria-hidden="true"></span>

        <span class="category-note__illustration" aria-hidden="true">
          <svg viewBox="0 0 240 180" role="img" focusable="false">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M36 84c5 43 27 67 72 67 44 0 66-24 72-67" stroke-width="4.2" />
              <path d="M31 80c10-13 31-19 77-19s67 6 77 19c-9 14-31 20-77 20S40 94 31 80Z" stroke-width="4.2" />
              <path d="M49 83c14-8 30-11 59-11 30 0 47 4 61 12" stroke-width="2.8" />
              <path d="M56 91c11-14 24-13 37 0 12-15 25-15 38 0 11-13 23-13 34-2" stroke-width="3" />
              <path d="M64 105c12 10 22 10 34 0 12 11 24 11 36 0 10 9 20 10 31 3" stroke-width="2.7" />
              <path d="M70 122c21 7 50 7 76 0" stroke-width="2.2" opacity=".75" />
              <path d="M62 151c26 7 68 7 93 0" stroke-width="2.5" />
              <path d="M49 142c-5-13-8-29-9-47" stroke-width="1.7" opacity=".7" />
              <path d="M59 147c-4-13-7-29-8-48M72 150c-3-12-5-25-6-39M85 152c-2-11-3-23-4-35M132 152c2-12 4-24 5-36M146 149c3-12 5-26 6-40M159 145c4-12 6-26 7-42" stroke-width="1.4" opacity=".66" />
              <path d="M136 67 190 16M146 72l55-45" stroke-width="6" />
              <path d="M190 16l9 10M201 27l8 9" stroke-width="2" opacity=".65" />
              <path d="M91 48c-11-14-4-26 4-35M111 48c-10-14-3-28 5-39M132 50c-8-13-2-24 6-33" stroke-width="3" />
              <path d="M31 157c31 7 62 9 93 8M47 164c34 5 68 5 101 0M66 170c27 2 53 1 80-3" stroke-width="1.6" opacity=".5" />
            </g>
          </svg>
        </span>

        <span class="category-note__copy">
          <span class="category-note__kicker">EAT · LOCAL · SLOW</span>
          <span class="category-note__title">Restaurants</span>
          <span class="category-note__text">Local favourites, street-side tables and reliable places worth saving.</span>
          <span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span>
        </span>

        <span class="category-note__corner" aria-hidden="true"></span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .pakse-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }

  .pakse-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(4.75rem, 7vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .pakse-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 31rem;
  }

  .pakse-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: #8a4d36;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pakse-hero h1 {
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4rem, 8vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  .pakse-hero__lede {
    max-width: 29rem;
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    color: #3f4943;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.58;
  }

  .pakse-hero__field-note {
    display: inline-block;
    margin-top: 1.2rem;
    color: rgba(31, 57, 45, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(0.72rem, 0.9vw, 0.82rem);
    letter-spacing: 0.04em;
    transform: rotate(-1.5deg);
  }

  .pakse-hero__visual {
    position: relative;
    width: clamp(24rem, 36vw, 34rem);
    margin: 0;
    padding: 0.5rem 0.5rem 1.6rem;
    background: #fbf8f0;
    box-shadow: 0 10px 24px rgba(38, 45, 40, 0.1);
    transform: rotate(0.8deg);
  }

  .pakse-hero__visual img {
    display: block;
    width: 100%;
    height: clamp(12rem, 16vw, 15rem);
    object-fit: cover;
    object-position: center;
    filter: saturate(0.88) contrast(0.97);
  }

  .pakse-hero__visual figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.4rem;
    margin: 0;
    color: rgba(31, 41, 36, 0.62);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.58rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .pakse-hero__tape {
    position: absolute;
    z-index: 2;
    width: 3.8rem;
    height: 0.8rem;
    background: rgba(196, 177, 139, 0.48);
    pointer-events: none;
  }

  .pakse-hero__tape--top {
    top: -0.28rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .pakse-hero__tape--bottom {
    right: 1rem;
    bottom: -0.28rem;
    transform: rotate(4deg);
  }

  .pakse-categories {
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(5rem, 8vw, 8rem);
  }

  .pakse-categories__heading {
    margin-bottom: 1.4rem;
  }

  .pakse-categories__heading p {
    margin: 0 0 0.4rem;
    color: rgba(31, 57, 45, 0.56);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .pakse-categories__heading h2 {
    margin: 0;
    color: #1f392d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .category-note {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    width: min(100%, 760px);
    min-height: 17rem;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    overflow: visible;
    color: #181a18;
    text-decoration: none;
    background:
      linear-gradient(rgba(255,255,255,.18), rgba(255,255,255,.18)),
      #f8f5ec;
    border: 1px solid rgba(24, 26, 24, 0.78);
    box-shadow:
      5px 7px 0 rgba(24, 26, 24, 0.08),
      0 16px 30px rgba(31, 41, 36, 0.08);
    transform: rotate(-0.35deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
    isolation: isolate;
  }

  .category-note::before,
  .category-note::after {
    content: '';
    position: absolute;
    inset: 5px;
    z-index: -1;
    pointer-events: none;
  }

  .category-note::before {
    border: 1px solid rgba(24, 26, 24, 0.18);
    transform: rotate(0.15deg);
  }

  .category-note::after {
    background-image:
      radial-gradient(circle at 18% 22%, rgba(24, 26, 24, 0.07) 0 0.7px, transparent 0.8px),
      radial-gradient(circle at 82% 72%, rgba(24, 26, 24, 0.055) 0 0.6px, transparent 0.7px);
    background-size: 18px 18px, 23px 23px;
    opacity: 0.7;
  }

  .category-note:hover,
  .category-note:focus-visible {
    transform: translateY(-4px) rotate(0.15deg);
    box-shadow:
      7px 10px 0 rgba(24, 26, 24, 0.08),
      0 22px 38px rgba(31, 41, 36, 0.12);
  }

  .category-note:focus-visible {
    outline: 2px solid #1f392d;
    outline-offset: 5px;
  }

  .category-note__tape {
    position: absolute;
    top: -0.7rem;
    left: 1.1rem;
    width: 6.7rem;
    height: 2.15rem;
    background: rgba(213, 204, 184, 0.78);
    border: 1px solid rgba(24, 26, 24, 0.2);
    clip-path: polygon(2% 12%, 95% 0, 100% 84%, 5% 100%);
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.32);
  }

  .category-note__paper-line {
    position: absolute;
    left: 1rem;
    right: 1rem;
    height: 1px;
    background: rgba(24, 26, 24, 0.14);
    pointer-events: none;
  }

  .category-note__paper-line--top {
    top: 0.9rem;
  }

  .category-note__paper-line--bottom {
    bottom: 0.9rem;
  }

  .category-note__illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    color: #101210;
  }

  .category-note__illustration svg {
    display: block;
    width: min(100%, 15rem);
    height: auto;
    filter: contrast(1.05);
  }

  .category-note__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .category-note__kicker {
    margin-bottom: 0.55rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .category-note__title {
    position: relative;
    display: inline-block;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(2rem, 4vw, 3.35rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .category-note__title::after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.5rem;
    bottom: -0.28rem;
    height: 2px;
    background: currentColor;
    transform: rotate(-1.2deg);
    transform-origin: left center;
  }

  .category-note__text {
    max-width: 25rem;
    margin-top: 1.25rem;
    color: rgba(24, 26, 24, 0.78);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(0.96rem, 1.3vw, 1.08rem);
    line-height: 1.55;
  }

  .category-note__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.3rem;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .category-note__meta span {
    transition: transform 180ms ease;
  }

  .category-note:hover .category-note__meta span,
  .category-note:focus-visible .category-note__meta span {
    transform: translateX(4px);
  }

  .category-note__corner {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 3.2rem;
    height: 3.2rem;
    background:
      linear-gradient(135deg, transparent 0 47%, rgba(24, 26, 24, 0.22) 48% 49%, #e8e2d5 50% 100%);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
    filter: drop-shadow(-2px -2px 1px rgba(24, 26, 24, 0.08));
  }

  @media (max-width: 820px) {
    .pakse-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 5rem;
      padding-bottom: 2.5rem;
    }

    .pakse-hero__copy {
      max-width: 36rem;
    }

    .pakse-hero__visual {
      width: min(100%, 34rem);
      margin: 0 auto;
    }

    .pakse-hero__visual img {
      height: clamp(11rem, 42vw, 15rem);
    }

    .category-note {
      width: 100%;
    }
  }

  @media (max-width: 620px) {
    .category-note {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      min-height: 0;
      padding: 1.5rem 1.3rem 1.8rem;
    }

    .category-note__illustration {
      min-height: 9rem;
    }

    .category-note__illustration svg {
      width: min(74%, 12rem);
    }

    .category-note__copy {
      align-items: center;
      text-align: center;
    }

    .category-note__text {
      max-width: 21rem;
    }
  }

  @media (max-width: 540px) {
    .pakse-hero {
      width: min(100% - 2rem, 1180px);
      gap: 1.25rem;
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }

    .pakse-hero h1 {
      font-size: clamp(4rem, 23vw, 5.5rem);
    }

    .pakse-hero__lede {
      font-size: 1rem;
      line-height: 1.55;
    }

    .pakse-hero__visual {
      width: 100%;
      transform: rotate(0.5deg);
    }

    .pakse-hero__visual img {
      height: 11rem;
    }

    .pakse-categories {
      width: min(100% - 2rem, 1180px);
      padding-top: 1.5rem;
    }
  }
</style>
