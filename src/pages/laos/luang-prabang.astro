---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import CityCategorySPA from '../../components/TravelDeskCategorySPA.astro';
import CityCategoryPanel from '../../components/TravelDeskCategoryPanel.astro';
import type { Place } from '../../data/atlas';
import luangPrabangDrawingUrl from '../../../calque SVG/laos-luang-prabang-temple.webp?url';

const luangPrabangPostcardFacts = [
  { label: 'August 2026', icon: 'calendar' as const },
  { label: 'UNESCO old town', icon: 'road' as const },
  { label: 'Tropical monsoon', icon: 'climate' as const },
  { label: 'Luang Prabang Province', icon: 'location' as const }
];

const emptyPlaces: Place[] = [];
const categoryTabs = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · EVENING', icon: 'restaurants' as const, noun: 'restaurants', fieldNote: '01' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · BAKERY · PAUSE', icon: 'cafes' as const, noun: 'cafés', fieldNote: '02' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · OLD TOWN · RIVER', icon: 'guesthouses' as const, noun: 'stays', fieldNote: '03' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · ROADS · WATERFALLS', icon: 'scooter' as const, noun: 'rental addresses', fieldNote: '04' },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'TEMPLES · FALLS · EXPLORE', icon: 'explore' as const, noun: 'experiences', fieldNote: '05' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · RECOVER', icon: 'gyms' as const, noun: 'places to train', fieldNote: '06' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'NIGHT MARKET · CRAFTS · FINDS', icon: 'markets' as const, noun: 'markets and shops', fieldNote: '07' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'HEALTH · TRANSPORT · BASICS', icon: 'essential' as const, noun: 'useful addresses', fieldNote: '08' }
].map((category) => ({ ...category, places: emptyPlaces }));

const spaTabs = categoryTabs.map(({ slug, title, kicker, icon, places }) => ({
  slug,
  title,
  kicker,
  icon,
  count: places.length,
  countLabel: 'notes soon'
}));
---

<BaseLayout
  title="Things to do in Luang Prabang, Laos"
  description="Open the Luang Prabang city chapter and prepare the old town, Mekong riverfront, temple streets and journeys beyond the city."
  canonical="https://thingstodoatlas.com/laos/luang-prabang"
>
  <main class="luang-prabang-page">
    <div class="pakse-page luang-prabang-envelope-host">
      <CityPostcardHero
        cityName="Luang Prabang"
        description={[
          'A quiet old royal capital where temple roofs meet the Mekong and Nam Khan.',
          'Use the old town as a walking base, then continue toward waterfalls, river roads',
          'and the northern railway connections beyond the peninsula.'
        ]}
        photoSrc="/images/laos/luang-prabang.webp"
        photoAlt="Luang Prabang old town in northern Laos"
        facts={luangPrabangPostcardFacts}
        backHref="/laos"
        backLabel="Back to the Laos map"
        drawingSrc={luangPrabangDrawingUrl}
        drawingAlt="Hand-drawn temple scene inspired by Luang Prabang"
        drawingCaption="Temple roofs · river mornings · northern roads"
      />
    </div>

    <CityCategorySPA
      cityName="Luang Prabang"
      categories={spaTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Luang Prabang"
      intro=""
      transitionTitle="Now for the practical side."
      transitionText="Eat · sleep · explore · prepare the next road"
    >
      {categoryTabs.map((category, index) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Luang Prabang"
          title={category.title}
          count={0}
          noun={category.noun}
          intro=""
          fieldNote={category.fieldNote}
          active={index === 0}
        >
          <div class="city-panel-empty">
            <h4>This notebook tab is ready.</h4>
            <p>Checked Luang Prabang addresses will appear here as the city guide is documented.</p>
          </div>
        </CityCategoryPanel>
      ))}
    </CityCategorySPA>
  </main>
</BaseLayout>

<style>
  .luang-prabang-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }
</style>

<style is:global>
  #main-content .pakse-page.luang-prabang-envelope-host .city-postcard::before {
    background-image: url('/images/laos/luang-prabang-airmail-envelope-stamped-v1.webp');
  }
</style>
