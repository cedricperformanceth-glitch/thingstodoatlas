---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPostcardHero from '../../components/CityPostcardHero.astro';
import ExploreBoard from '../../components/ExploreBoard.astro';
import LandmarkModalSet from '../../components/LandmarkModalSet.astro';
import CityCategorySPA from '../../components/TravelDeskCategorySPA.astro';
import CityCategoryPanel from '../../components/TravelDeskCategoryPanel.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import type { Place } from '../../data/atlas';
import {
  luangPrabangExploreLandmarks,
  luangPrabangLandmarks
} from '../../data/luangPrabangLandmarks';
import {
  luangPrabangCafes,
  luangPrabangGuesthouses,
  luangPrabangRestaurants
} from '../../data/luangPrabangPlaces';
import luangPrabangDrawingUrl from '../../../calque SVG/laos-luang-prabang-temple.webp?url';

const luangPrabangPostcardFacts = [
  { label: 'August 2026', icon: 'calendar' as const },
  { label: 'UNESCO old town', icon: 'road' as const },
  { label: 'Tropical monsoon', icon: 'climate' as const },
  { label: 'Luang Prabang Province', icon: 'location' as const }
];

const emptyPlaces: Place[] = [];
const categoryTabs = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · EVENING', icon: 'restaurants' as const, noun: 'restaurants', fieldNote: '01', places: luangPrabangRestaurants },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · BAKERY · PAUSE', icon: 'cafes' as const, noun: 'cafés', fieldNote: '02', places: luangPrabangCafes },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · OLD TOWN · RIVER', icon: 'guesthouses' as const, noun: 'stays', fieldNote: '03', places: luangPrabangGuesthouses },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · ROADS · WATERFALLS', icon: 'scooter' as const, noun: 'rental addresses', fieldNote: '04', places: emptyPlaces },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'TEMPLES · FALLS · EXPLORE', icon: 'explore' as const, noun: 'experiences', fieldNote: '05', places: emptyPlaces },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · RECOVER', icon: 'gyms' as const, noun: 'places to train', fieldNote: '06', places: emptyPlaces },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'NIGHT MARKET · CRAFTS · FINDS', icon: 'markets' as const, noun: 'markets and shops', fieldNote: '07', places: emptyPlaces },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'HEALTH · TRANSPORT · BASICS', icon: 'essential' as const, noun: 'useful addresses', fieldNote: '08', places: emptyPlaces }
];

const spaTabs = categoryTabs.map(({ slug, title, kicker, icon, places }) => ({
  slug,
  title,
  kicker,
  icon,
  count: places.length,
  ...(places.length === 0 ? { countLabel: 'notes soon' } : {})
}));
---

<BaseLayout
  title="Things to do in Luang Prabang, Laos"
  description="Prepare Luang Prabang with Pha Pa Tou, Kuang Si Waterfall, the slow boat to Huay Xai, 32 restaurants, 22 cafés and 35 guesthouses."
  canonical="https://thingstodoatlas.com/laos/luang-prabang"
>
  <main class="luang-prabang-page">
    <div class="pakse-page luang-prabang-envelope-host">
      <CityPostcardHero
        cityName="Luang Prabang"
        description={[
          'A quiet old royal capital where temple roofs meet the Mekong and Nam Khan.',
          'Use the old town as a walking base, then continue toward waterfalls, river roads',
          'and the northern railway connections beyond the peninsula.'
        ]}
        photoSrc="/images/laos/luang-prabang.webp"
        photoAlt="Luang Prabang old town in northern Laos"
        facts={luangPrabangPostcardFacts}
        backHref="/laos"
        backLabel="Back to the Laos map"
        drawingSrc={luangPrabangDrawingUrl}
        drawingAlt="Hand-drawn temple scene inspired by Luang Prabang"
        drawingCaption="Temple roofs · river mornings · northern roads"
      />
    </div>

    <ExploreBoard
      cityName="Luang Prabang"
      landmarks={luangPrabangExploreLandmarks}
      eyebrow="What can I explore beyond the old town?"
      title="Explore from Luang Prabang"
      intro="Choose a mountain journey, a waterfall day or the slow Mekong route toward the Thai border. Each card opens the complete field note."
      note="Open a card for the route, timing, practical details and map."
      wide
    />

    <CityCategorySPA
      cityName="Luang Prabang"
      categories={spaTabs}
      defaultSlug="restaurants"
      title="Plan your stay in Luang Prabang"
      intro=""
      transitionTitle="Now for the practical side."
      transitionText="Eat · sleep · explore · prepare the next road"
    >
      {categoryTabs.map((category, index) => (
        <CityCategoryPanel
          slug={category.slug}
          cityName="Luang Prabang"
          title={category.title}
          count={category.places.length}
          noun={category.noun}
          intro=""
          fieldNote={category.fieldNote}
          active={index === 0}
        >
          {category.places.length ? (
            <div class="city-panel-list">
              {category.places.map((place, placeIndex) => (
                <PlaceCard place={place} index={placeIndex} />
              ))}
            </div>
          ) : (
            <div class="city-panel-empty">
              <h4>This notebook tab is ready.</h4>
              <p>Checked Luang Prabang addresses will appear here as the city guide is documented.</p>
            </div>
          )}
        </CityCategoryPanel>
      ))}
    </CityCategorySPA>
  </main>

  <LandmarkModalSet landmarks={luangPrabangLandmarks} />
</BaseLayout>

<style>
  .luang-prabang-page {
    min-height: 100vh;
    background: #f2eee3;
    color: #1f2924;
  }
</style>

<style is:global>
  #main-content .pakse-page.luang-prabang-envelope-host .city-postcard::before {
    background-image: url('/images/laos/luang-prabang-airmail-envelope-stamped-v1.webp');
  }
</style>
