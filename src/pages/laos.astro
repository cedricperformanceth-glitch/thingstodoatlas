---
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = [
  { name: 'Luang Prabang', x: 287, y: 218, status: 'future' },
  { name: 'Tad Lo', x: 365, y: 608, status: 'open', href: '/laos/tad-lo' },
  { name: 'Pakse', x: 323, y: 680, status: 'open', href: '/laos/pakse' }
];
---

<BaseLayout
  title="Explore Laos"
  description="Choose your next stop on an illustrated map of Laos. Begin with Pakse or Tad Lo, with more destinations added as the atlas grows."
  canonical="https://thingstodoatlas.com/laos"
>
  <section class="laos-map-page" aria-labelledby="laos-map-title">
    <header class="laos-map-intro">
      <p class="eyebrow">Laos · Chapter 02</p>
      <h1 id="laos-map-title">Choose a place<br /><em>on the map.</em></h1>
      <p>Only the green destinations are open for now. More points will appear as the atlas grows.</p>
    </header>

    <div class="map-sheet">
      <span class="map-sheet__note">Field map · not to scale</span>

      <svg class="laos-map" viewBox="0 0 620 920" role="img" aria-labelledby="map-title map-description">
        <title id="map-title">Illustrated map of Laos</title>
        <desc id="map-description">A hand-drawn style map showing Pakse and Tad Lo as available destinations and Luang Prabang as a future destination.</desc>

        <defs>
          <filter id="roughen" x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="8" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>

        <g class="map-outline" filter="url(#roughen)">
          <path d="M330 52 C302 83 278 113 274 146 C270 177 288 203 277 232 C265 265 235 285 236 319 C237 353 264 369 258 401 C252 431 223 449 229 484 C236 521 273 532 274 569 C275 600 250 628 255 663 C260 696 292 714 291 748 C290 782 268 804 278 838 C290 875 331 883 357 856 C383 829 375 792 390 764 C406 734 440 718 439 684 C438 650 409 631 413 598 C417 565 448 544 445 510 C442 478 413 462 417 428 C421 396 450 376 447 341 C444 306 413 290 414 256 C415 221 441 194 428 162 C417 133 384 121 376 91 C370 68 356 47 330 52 Z" />
          <path class="map-outline__echo" d="M326 60 C299 90 286 117 281 147 C275 181 294 204 283 235 C270 269 243 291 244 320 C246 351 269 370 264 400 C258 432 232 451 237 483 C243 515 280 532 281 567 C283 601 258 629 263 660 C268 692 299 711 299 747 C298 780 277 804 286 834" />
        </g>

        <g class="river-lines" aria-hidden="true">
          <path d="M337 104 C321 164 327 221 314 280 C302 336 315 392 305 449 C294 510 311 566 302 627 C296 670 306 716 322 772" />
          <path d="M320 326 C349 348 357 378 350 409" />
          <path d="M304 538 C334 553 348 574 349 603" />
        </g>

        <g class="terrain-marks" aria-hidden="true">
          <path d="M286 170 l12 -14 l12 15 M303 184 l15 -18 l14 17 M339 251 l13 -16 l13 16 M275 461 l12 -14 l12 15 M363 514 l14 -17 l14 17" />
          <path d="M288 730 C309 719 333 719 353 730 M294 744 C315 734 337 735 358 747" />
        </g>

        {destinations.map((destination) => destination.status === 'open' ? (
          <a class="destination destination--open" href={destination.href} aria-label={`Explore ${destination.name}`}>
            <circle class="destination__pulse" cx={destination.x} cy={destination.y} r="18" />
            <circle class="destination__dot" cx={destination.x} cy={destination.y} r="7" />
            <path class="destination__leader" d={`M${destination.x + 10} ${destination.y - 3} C${destination.x + 28} ${destination.y - 13}, ${destination.x + 42} ${destination.y - 13}, ${destination.x + 54} ${destination.y - 13}`} />
            <text class="destination__name" x={destination.x + 60} y={destination.y - 8}>{destination.name}</text>
            <text class="destination__status" x={destination.x + 60} y={destination.y + 13}>explore</text>
          </a>
        ) : (
          <g class="destination destination--future" aria-label={`${destination.name}, coming later`}>
            <circle class="destination__dot" cx={destination.x} cy={destination.y} r="5" />
            <path class="destination__leader" d={`M${destination.x + 9} ${destination.y - 2} C${destination.x + 25} ${destination.y - 12}, ${destination.x + 39} ${destination.y - 12}, ${destination.x + 51} ${destination.y - 12}`} />
            <text class="destination__name" x={destination.x + 57} y={destination.y - 7}>{destination.name}</text>
            <text class="destination__status" x={destination.x + 57} y={destination.y + 13}>later chapter</text>
          </g>
        ))}

        <g class="map-compass" transform="translate(470 760)" aria-hidden="true">
          <circle cx="0" cy="0" r="35" />
          <path d="M0 -27 L6 -5 L0 0 L-6 -5 Z M0 27 L-6 5 L0 0 L6 5 Z M-27 0 L-5 -6 L0 0 L-5 6 Z M27 0 L5 6 L0 0 L5 -6 Z" />
          <text x="0" y="-44">N</text>
        </g>
      </svg>

      <div class="map-legend" aria-label="Map legend">
        <span><i class="map-legend__dot map-legend__dot--open"></i> Open chapter</span>
        <span><i class="map-legend__dot"></i> Future chapter</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .laos-map-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2));
    background: #f2eee3;
    color: #1f2924;
  }

  .laos-map-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .laos-map-intro h1 {
    margin: 0.35rem 0 1rem;
    font-size: clamp(3.2rem, 9vw, 7.8rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .laos-map-intro h1 em {
    font-weight: 400;
  }

  .laos-map-intro > p:last-child {
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .map-sheet {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 1px solid rgba(31, 41, 36, 0.18);
    background:
      linear-gradient(rgba(49, 85, 69, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(49, 85, 69, 0.025) 1px, transparent 1px),
      #f7f2e6;
    background-size: 28px 28px;
  }

  .map-sheet::before,
  .map-sheet::after {
    content: '';
    position: absolute;
    width: 78px;
    height: 22px;
    background: rgba(199, 181, 143, 0.48);
    transform: rotate(-4deg);
  }

  .map-sheet::before { top: -9px; left: 8%; }
  .map-sheet::after { right: 8%; bottom: -8px; transform: rotate(3deg); }

  .map-sheet__note {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: Georgia, serif;
    font-size: 0.75rem;
    font-style: italic;
    letter-spacing: 0.06em;
    opacity: 0.58;
  }

  .laos-map {
    display: block;
    width: min(100%, 650px);
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .map-outline path {
    fill: rgba(49, 85, 69, 0.055);
    stroke: #26362e;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-outline .map-outline__echo {
    fill: none;
    stroke-width: 0.9;
    opacity: 0.34;
  }

  .river-lines path {
    fill: none;
    stroke: #64786f;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 2 5;
    opacity: 0.55;
  }

  .terrain-marks path {
    fill: none;
    stroke: #59675f;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
  }

  .destination {
    color: #315545;
    text-decoration: none;
  }

  .destination__dot {
    fill: #f7f2e6;
    stroke: currentColor;
    stroke-width: 3;
  }

  .destination--open .destination__dot {
    fill: #315545;
  }

  .destination__pulse {
    fill: rgba(49, 85, 69, 0.09);
    stroke: rgba(49, 85, 69, 0.32);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: map-pulse 2.8s ease-out infinite;
  }

  .destination__leader {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .destination__name {
    fill: currentColor;
    font-family: Georgia, serif;
    font-size: 22px;
    font-weight: 700;
  }

  .destination__status {
    fill: currentColor;
    font-family: Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .destination--future {
    color: #7f857e;
    opacity: 0.68;
  }

  a.destination {
    cursor: pointer;
  }

  a.destination:hover,
  a.destination:focus-visible {
    color: #1d392d;
    outline: none;
  }

  a.destination:hover .destination__dot,
  a.destination:focus-visible .destination__dot {
    stroke-width: 5;
  }

  .map-compass circle,
  .map-compass path {
    fill: none;
    stroke: #59675f;
    stroke-width: 1;
    opacity: 0.55;
  }

  .map-compass text {
    fill: #59675f;
    font-family: Georgia, serif;
    font-size: 13px;
    text-anchor: middle;
    opacity: 0.75;
  }

  .map-legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 0.75rem 0 0.25rem;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .map-legend__dot {
    width: 9px;
    height: 9px;
    border: 1.5px solid #7f857e;
    border-radius: 50%;
  }

  .map-legend__dot--open {
    border-color: #315545;
    background: #315545;
  }

  @keyframes map-pulse {
    0% { transform: scale(0.7); opacity: 0.65; }
    75%, 100% { transform: scale(1.3); opacity: 0; }
  }

  @media (max-width: 640px) {
    .laos-map-page {
      padding-top: 3rem;
    }

    .map-sheet {
      padding: 2.75rem 0.25rem 1rem;
    }

    .map-sheet__note {
      top: 0.9rem;
      right: 0.85rem;
    }

    .destination__name {
      font-size: 19px;
    }

    .map-legend {
      gap: 0.8rem;
      font-size: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .destination__pulse { animation: none; }
  }
</style>
