---
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = [
  { name: 'Luang Prabang', x: 455, y: 345, status: 'future' },
  { name: 'Tad Lo', x: 585, y: 1125, status: 'open', href: '/laos/tad-lo' },
  { name: 'Pakse', x: 510, y: 1260, status: 'open', href: '/laos/pakse' }
];
---

<BaseLayout
  title="Explore Laos"
  description="Choose your next stop on an illustrated map of Laos. Begin with Pakse or Tad Lo, with more destinations added as the atlas grows."
  canonical="https://thingstodoatlas.com/laos"
>
  <section class="laos-map-page" aria-labelledby="laos-map-title">
    <header class="laos-map-intro">
      <p class="eyebrow">Laos · Chapter 02</p>
      <h1 id="laos-map-title">Choose a place<br /><em>on the map.</em></h1>
      <p>Only the green destinations are open for now. More points will appear as the atlas grows.</p>
    </header>

    <div class="map-sheet">
      <span class="map-sheet__note">Field map · not to scale</span>

      <div class="map-layers">
        <img
          class="map-drawing"
          src="/images/hand-drawn/laos-map.webp"
          alt="Hand-drawn map of Laos"
          width="1024"
          height="1536"
        />

        <svg class="map-overlay" viewBox="0 0 1024 1536" role="img" aria-labelledby="map-title map-description">
          <title id="map-title">Destinations in Laos</title>
          <desc id="map-description">Pakse and Tad Lo are available destinations. Luang Prabang is a future chapter.</desc>

          {destinations.map((destination) => destination.status === 'open' ? (
            <a class="destination destination--open" href={destination.href} aria-label={`Explore ${destination.name}`}>
              <circle class="destination__pulse" cx={destination.x} cy={destination.y} r="30" />
              <circle class="destination__dot" cx={destination.x} cy={destination.y} r="11" />
              <path class="destination__leader" d={`M${destination.x + 16} ${destination.y - 4} C${destination.x + 44} ${destination.y - 24}, ${destination.x + 70} ${destination.y - 24}, ${destination.x + 92} ${destination.y - 24}`} />
              <text class="destination__name" x={destination.x + 103} y={destination.y - 14}>{destination.name}</text>
              <text class="destination__status" x={destination.x + 103} y={destination.y + 18}>explore</text>
            </a>
          ) : (
            <g class="destination destination--future" aria-label={`${destination.name}, future chapter`}>
              <circle class="destination__dot" cx={destination.x} cy={destination.y} r="9" />
              <path class="destination__leader" d={`M${destination.x + 15} ${destination.y - 3} C${destination.x + 42} ${destination.y - 22}, ${destination.x + 67} ${destination.y - 22}, ${destination.x + 88} ${destination.y - 22}`} />
              <text class="destination__name" x={destination.x + 99} y={destination.y - 12}>{destination.name}</text>
              <text class="destination__status" x={destination.x + 99} y={destination.y + 19}>later chapter</text>
            </g>
          ))}
        </svg>
      </div>

      <div class="map-legend" aria-label="Map legend">
        <span><i class="map-legend__dot map-legend__dot--open"></i> Open chapter</span>
        <span><i class="map-legend__dot"></i> Future chapter</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .laos-map-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2));
    background: #f2eee3;
    color: #1f2924;
  }

  .laos-map-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .laos-map-intro h1 {
    margin: 0.35rem 0 1rem;
    font-size: clamp(3.2rem, 9vw, 7.8rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .laos-map-intro h1 em {
    font-weight: 400;
  }

  .laos-map-intro > p:last-child {
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .map-sheet {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 1px solid rgba(31, 41, 36, 0.18);
    background: #f7f2e6;
  }

  .map-sheet::before,
  .map-sheet::after {
    content: '';
    position: absolute;
    z-index: 3;
    width: 78px;
    height: 22px;
    background: rgba(199, 181, 143, 0.48);
  }

  .map-sheet::before {
    top: -9px;
    left: 8%;
    transform: rotate(-4deg);
  }

  .map-sheet::after {
    right: 8%;
    bottom: -8px;
    transform: rotate(3deg);
  }

  .map-sheet__note {
    position: absolute;
    z-index: 4;
    top: 1.25rem;
    right: 1.5rem;
    font-family: Georgia, serif;
    font-size: 0.75rem;
    font-style: italic;
    letter-spacing: 0.06em;
    opacity: 0.58;
  }

  .map-layers {
    position: relative;
    width: min(100%, 620px);
    margin: 0 auto;
  }

  .map-drawing {
    display: block;
    width: 100%;
    height: auto;
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .destination {
    color: #315545;
  }

  a.destination {
    pointer-events: auto;
    cursor: pointer;
    text-decoration: none;
  }

  .destination__dot {
    fill: #f7f2e6;
    stroke: currentColor;
    stroke-width: 5;
  }

  .destination--open .destination__dot {
    fill: #315545;
  }

  .destination__pulse {
    fill: rgba(49, 85, 69, 0.1);
    stroke: rgba(49, 85, 69, 0.34);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: map-pulse 2.8s ease-out infinite;
  }

  .destination__leader {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .destination__name {
    fill: currentColor;
    font-family: Georgia, serif;
    font-size: 34px;
    font-weight: 700;
  }

  .destination__status {
    fill: currentColor;
    font-family: Arial, sans-serif;
    font-size: 15px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .destination--future {
    color: #7f857e;
    opacity: 0.72;
  }

  a.destination:hover,
  a.destination:focus-visible {
    color: #1d392d;
    outline: none;
  }

  a.destination:hover .destination__dot,
  a.destination:focus-visible .destination__dot {
    stroke-width: 8;
  }

  .map-legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1rem 0 0.25rem;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .map-legend__dot {
    width: 9px;
    height: 9px;
    border: 1px solid #7f857e;
    border-radius: 50%;
  }

  .map-legend__dot--open {
    border-color: #315545;
    background: #315545;
  }

  @keyframes map-pulse {
    0% { opacity: 0.75; transform: scale(0.72); }
    75%, 100% { opacity: 0; transform: scale(1.35); }
  }

  @media (max-width: 640px) {
    .laos-map-page {
      padding-top: 3.5rem;
    }

    .map-sheet {
      padding: 0.75rem;
    }

    .map-sheet__note {
      top: 0.8rem;
      right: 0.9rem;
      font-size: 0.65rem;
    }

    .map-layers {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .destination__pulse {
      animation: none;
    }
  }
</style>
