---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanMyTripIntro from '../components/PlanMyTripIntro.astro';
import LandmarkModalSet from '../components/LandmarkModalSet.astro';
import { laosLandmarks } from '../data/laosLandmarks';

const gridColumns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
const gridRows = Array.from({ length: 12 }, (_, index) => index + 1);

const pakse = { x: 679, y: 1024 };
const vientiane = { x: 384, y: 657 };
const tadLo = { x: 736, y: 970 };
const donDet = { x: 696, y: 1152 };
const luangPrabang = { x: 356, y: 576 };
const bolavenPlateau = { x: 800, y: 930 };
const watPhou = { x: 586, y: 1060 };
const khonePhapheng = { x: 696, y: 1188 };
const xeBangFai = { x: 708, y: 832 };
const phaPaTou = { x: 430, y: 500 };
const kongLor = { x: 650, y: 760 };
const hmongCulture = { x: 258, y: 404 };
---

<BaseLayout title="Explore Laos" description="Choose your next stop on an illustrated map of Laos. Compare city bases, open landmark field cards and begin planning the roads between them." canonical="https://thingstodoatlas.com/laos">
  <section class="laos-map-page" aria-labelledby="laos-map-title">
    <div class="map-sheet">
      <div class="map-layers">
        <header class="map-sheet__header">
          <span class="map-sheet__note">FIELD MAP · LAOS</span>
          <div class="map-sheet__title-block">
            <p class="map-sheet__chapter">LAOS · CHAPTER 02</p>
            <h1 id="laos-map-title" class="map-sheet__title">Choose a place on the map</h1>
            <div class="map-sheet__legend" aria-label="Map legend">
              <span class="map-sheet__legend-item map-sheet__legend-item--city"><i aria-hidden="true"></i>City guide</span>
              <span class="map-sheet__legend-item map-sheet__legend-item--landmark"><i aria-hidden="true"></i>Field note</span>
              <span class="map-sheet__legend-item map-sheet__legend-item--culture"><i aria-hidden="true"></i>Cultural note</span>
              <span class="map-sheet__legend-item map-sheet__legend-item--planned"><i aria-hidden="true"></i>Coming soon</span>
            </div>
          </div>
        </header>

        <img class="map-drawing" src="/images/hand-drawn/laos-map.webp" alt="Hand-drawn map of Laos" width="1024" height="1536" />

        <svg class="map-grid" viewBox="0 0 1024 1536" aria-hidden="true">
          <g class="map-grid__lines">{Array.from({ length: 9 }, (_, index) => <line x1={index * 128} y1="0" x2={index * 128} y2="1536" />)}{Array.from({ length: 13 }, (_, index) => <line x1="0" y1={index * 128} x2="1024" y2={index * 128} />)}</g>
          <g class="map-grid__labels map-grid__labels--columns">{gridColumns.map((label, index) => <text x={(index * 128) + 64} y="34" text-anchor="middle">{label}</text>)}</g>
          <g class="map-grid__labels map-grid__labels--rows">{gridRows.map((label, index) => <text x="18" y={(index * 128) + 74}>{label}</text>)}</g>
        </svg>

        <svg class="map-overlay" viewBox="0 0 1024 1536" role="img" aria-labelledby="map-title map-description">
          <title id="map-title">Destinations, landmarks and cultural notes on the Laos map</title>
          <desc id="map-description">Pakse and Tad Lo open city guides. Bolaven Plateau, Wat Phou, Khone Phapheng Falls, Xe Bang Fai Cave, Pha Pa Tou and Kong Lor Cave open landmark field cards. A Hmong culture note is marked symbolically in northern Laos. Vientiane, Don Det and Luang Prabang are being documented.</desc>

          <g class="city-marker city-marker--culture" role="button" tabindex="0" aria-label="Open Hmong culture note" data-open-landmark="hmong-cultural-modal">
            <circle class="city-marker__ring" cx={hmongCulture.x} cy={hmongCulture.y} r="20"/>
            <circle class="city-marker__dot" cx={hmongCulture.x} cy={hmongCulture.y} r="8"/>
            <path class="city-marker__leader" d={`M${hmongCulture.x + 12} ${hmongCulture.y - 8} L${hmongCulture.x + 70} ${hmongCulture.y - 42}`}/>
            <text class="city-marker__label city-marker__label--culture" x={hmongCulture.x + 78} y={hmongCulture.y - 48}>Hmong culture</text>
          </g>

          <a class="city-marker city-marker--city city-marker--active" href="/laos/pakse" aria-label="Explore Pakse">
            <circle class="city-marker__ring" cx={pakse.x} cy={pakse.y} r="22"/><circle class="city-marker__dot" cx={pakse.x} cy={pakse.y} r="9"/><path class="city-marker__leader" d={`M${pakse.x - 15} ${pakse.y - 5} L${pakse.x - 76} ${pakse.y - 28}`}/><text class="city-marker__label city-marker__label--left" x={pakse.x - 84} y={pakse.y - 32}>Pakse</text>
            <foreignObject class="city-preview" x="34" y="830" width="470" height="430"><div class="city-note city-note--active city-note--pakse" xmlns="http://www.w3.org/1999/xhtml"><span class="city-note__tape" aria-hidden="true"></span><img src="/images/laos/pakse.webp" alt="Pakse, Laos"/><div class="city-note__body"><span class="city-note__badge">Southern Laos base</span><strong>Pakse</strong><p>A relaxed transit city for the Bolaven Plateau, Wat Phou and the roads toward Si Phan Don.</p><span class="city-note__tags">Bolaven · Wat Phou · Mekong south</span><small>Open the city chapter and plan from here.</small></div></div></foreignObject>
          </a>

          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Bolaven Plateau landmark details" data-open-landmark="bolaven-plateau-modal"><circle class="city-marker__ring" cx={bolavenPlateau.x} cy={bolavenPlateau.y} r="20"/><circle class="city-marker__dot" cx={bolavenPlateau.x} cy={bolavenPlateau.y} r="8"/><path class="city-marker__leader" d={`M${bolavenPlateau.x + 12} ${bolavenPlateau.y - 10} L${bolavenPlateau.x + 54} ${bolavenPlateau.y - 48}`}/><text class="city-marker__label city-marker__label--landmark" x={bolavenPlateau.x + 62} y={bolavenPlateau.y - 54}>Bolaven Plateau</text></g>
          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Wat Phou landmark details" data-open-landmark="wat-phou-modal"><circle class="city-marker__ring" cx={watPhou.x} cy={watPhou.y} r="20"/><circle class="city-marker__dot" cx={watPhou.x} cy={watPhou.y} r="8"/><path class="city-marker__leader" d={`M${watPhou.x - 12} ${watPhou.y + 10} L${watPhou.x - 54} ${watPhou.y + 46}`}/><text class="city-marker__label city-marker__label--left city-marker__label--landmark" x={watPhou.x - 62} y={watPhou.y + 58}>Wat Phou</text></g>
          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Khone Phapheng Falls landmark details" data-open-landmark="khone-phapheng-modal"><circle class="city-marker__ring" cx={khonePhapheng.x} cy={khonePhapheng.y} r="20"/><circle class="city-marker__dot" cx={khonePhapheng.x} cy={khonePhapheng.y} r="8"/><path class="city-marker__leader" d={`M${khonePhapheng.x - 12} ${khonePhapheng.y + 8} L${khonePhapheng.x - 58} ${khonePhapheng.y + 42}`}/><text class="city-marker__label city-marker__label--left city-marker__label--landmark" x={khonePhapheng.x - 66} y={khonePhapheng.y + 54}>Khone Phapheng</text></g>
          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Xe Bang Fai Cave landmark details" data-open-landmark="xe-bang-fai-modal"><circle class="city-marker__ring" cx={xeBangFai.x} cy={xeBangFai.y} r="20"/><circle class="city-marker__dot" cx={xeBangFai.x} cy={xeBangFai.y} r="8"/><path class="city-marker__leader" d={`M${xeBangFai.x + 12} ${xeBangFai.y} L${xeBangFai.x + 74} ${xeBangFai.y}`}/><text class="city-marker__label city-marker__label--landmark" x={xeBangFai.x + 82} y={xeBangFai.y + 8}>Xe Bang Fai</text></g>
          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Pha Pa Tou landmark details" data-open-landmark="pha-pa-tou-modal"><circle class="city-marker__ring" cx={phaPaTou.x} cy={phaPaTou.y} r="20"/><circle class="city-marker__dot" cx={phaPaTou.x} cy={phaPaTou.y} r="8"/><path class="city-marker__leader" d={`M${phaPaTou.x + 12} ${phaPaTou.y} L${phaPaTou.x + 74} ${phaPaTou.y}`}/><text class="city-marker__label city-marker__label--landmark" x={phaPaTou.x + 82} y={phaPaTou.y + 8}>Pha Pa Tou</text></g>
          <g class="city-marker city-marker--landmark" role="button" tabindex="0" aria-label="Open Kong Lor Cave landmark details" data-open-landmark="kong-lor-modal"><circle class="city-marker__ring" cx={kongLor.x} cy={kongLor.y} r="20"/><circle class="city-marker__dot" cx={kongLor.x} cy={kongLor.y} r="8"/><path class="city-marker__leader" d={`M${kongLor.x + 12} ${kongLor.y} L${kongLor.x + 74} ${kongLor.y}`}/><text class="city-marker__label city-marker__label--landmark" x={kongLor.x + 82} y={kongLor.y + 8}>Kong Lor</text></g>

          <g class="city-marker city-marker--city city-marker--inactive" tabindex="0" role="button" aria-disabled="true" aria-label="Vientiane guide coming soon"><circle class="city-marker__ring" cx={vientiane.x} cy={vientiane.y} r="22"/><circle class="city-marker__dot" cx={vientiane.x} cy={vientiane.y} r="9"/><path class="city-marker__leader" d={`M${vientiane.x - 15} ${vientiane.y + 4} L${vientiane.x - 76} ${vientiane.y + 65}`}/><text class="city-marker__label city-marker__label--left" x={vientiane.x - 84} y={vientiane.y + 73}>Vientiane</text><foreignObject class="city-preview" x="34" y="830" width="470" height="430"><div class="city-note city-note--vientiane" xmlns="http://www.w3.org/1999/xhtml"><span class="city-note__tape" aria-hidden="true"></span><img src="/images/laos/vientiane.webp" alt="Vientiane, Laos"/><div class="city-note__body"><span class="city-note__badge">Field notes underway</span><strong>Vientiane</strong><p>This chapter is currently being documented. Local addresses and practical notes are on the way.</p><small>Available soon.</small></div></div></foreignObject></g>

          <a class="city-marker city-marker--city city-marker--active" href="/laos/tad-lo" aria-label="Explore Tad Lo"><circle class="city-marker__ring" cx={tadLo.x} cy={tadLo.y} r="22"/><circle class="city-marker__dot" cx={tadLo.x} cy={tadLo.y} r="9"/><path class="city-marker__leader" d={`M${tadLo.x + 15} ${tadLo.y - 5} L${tadLo.x + 76} ${tadLo.y - 28}`}/><text class="city-marker__label" x={tadLo.x + 84} y={tadLo.y - 32}>Tad Lo</text><foreignObject class="city-preview" x="34" y="830" width="470" height="430"><div class="city-note city-note--active city-note--tadlo" xmlns="http://www.w3.org/1999/xhtml"><span class="city-note__tape" aria-hidden="true"></span><img src="/images/laos/tad-lo.webp" alt="Tad Lo, Laos"/><div class="city-note__body"><span class="city-note__badge">Ready to explore</span><strong>Tad Lo</strong><p>Waterfalls, village roads and a slower chapter in the Bolaven countryside.</p><small>Click the city to open its chapter.</small></div></div></foreignObject></a>

          <g class="city-marker city-marker--city city-marker--inactive" tabindex="0" role="button" aria-disabled="true" aria-label="Don Det guide coming soon"><circle class="city-marker__ring" cx={donDet.x} cy={donDet.y} r="22"/><circle class="city-marker__dot" cx={donDet.x} cy={donDet.y} r="9"/><path class="city-marker__leader" d={`M${donDet.x + 15} ${donDet.y + 2} L${donDet.x + 76} ${donDet.y + 18}`}/><text class="city-marker__label" x={donDet.x + 84} y={donDet.y + 27}>Don Det</text><foreignObject class="city-preview" x="34" y="830" width="470" height="430"><div class="city-note city-note--dondet" xmlns="http://www.w3.org/1999/xhtml"><span class="city-note__tape" aria-hidden="true"></span><img src="/images/laos/don-det.webp" alt="Don Det, Laos"/><div class="city-note__body"><span class="city-note__badge">Next chapter</span><strong>Don Det</strong><p>The island guide is still taking shape, with places, routes and riverside notes to come.</p><small>Work in progress.</small></div></div></foreignObject></g>

          <g class="city-marker city-marker--city city-marker--inactive" tabindex="0" role="button" aria-disabled="true" aria-label="Luang Prabang guide coming soon"><circle class="city-marker__ring" cx={luangPrabang.x} cy={luangPrabang.y} r="22"/><circle class="city-marker__dot" cx={luangPrabang.x} cy={luangPrabang.y} r="9"/><path class="city-marker__leader" d={`M${luangPrabang.x + 15} ${luangPrabang.y - 5} L${luangPrabang.x + 76} ${luangPrabang.y - 28}`}/><text class="city-marker__label" x={luangPrabang.x + 84} y={luangPrabang.y - 32}>Luang Prabang</text><foreignObject class="city-preview" x="34" y="830" width="470" height="430"><div class="city-note city-note--luang" xmlns="http://www.w3.org/1999/xhtml"><span class="city-note__tape" aria-hidden="true"></span><img src="/images/laos/luang-prabang.webp" alt="Luang Prabang, Laos"/><div class="city-note__body"><span class="city-note__badge">On the road</span><strong>Luang Prabang</strong><p>Research is underway. A carefully selected city guide will be added here soon.</p><small>Coming later.</small></div></div></foreignObject></g>
        </svg>
      </div>
    </div>
    <PlanMyTripIntro />
  </section>
  <LandmarkModalSet landmarks={laosLandmarks} />
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&display=swap');
  .laos-map-page{min-height:100vh;padding:clamp(4rem,8vw,7rem) max(1.25rem,calc((100vw - 1180px)/2));background:#f2eee3;color:#1f2924}.map-sheet{position:relative;width:fit-content;margin:0 auto;padding:26px 26px 10px;border:1px solid rgba(31,41,36,.14);background:#f7f2e6;overflow:visible}.map-sheet::before,.map-sheet::after{content:'';position:absolute;z-index:3;width:78px;height:22px;background:rgba(199,181,143,.48)}.map-sheet::before{top:-9px;left:8%;transform:rotate(-4deg)}.map-sheet::after{right:8%;bottom:-8px;transform:rotate(3deg)}.map-layers{position:relative;width:80vw;height:80vw;margin:0 auto;background:#fff;box-shadow:0 0 0 1px rgba(31,41,36,.2),0 8px 22px rgba(31,41,36,.06);overflow:hidden}.map-sheet__header{position:absolute;z-index:4;top:clamp(1.4rem,3vw,2.5rem);left:clamp(1.25rem,4vw,3.25rem);right:clamp(1.25rem,4vw,3.25rem);display:flex;align-items:flex-start;justify-content:space-between;gap:1.25rem;color:#1f392d;pointer-events:none}.map-sheet__title-block{width:min(42rem,70%);margin-left:auto;text-align:right}.map-sheet__chapter,.map-sheet__title{color:#1f392d;font-family:'Caveat','Segoe Print','Bradley Hand',cursive}.map-sheet__chapter{margin:0 0 .2rem;font-size:15px;font-weight:500;line-height:1;letter-spacing:.12em;opacity:.62}.map-sheet__title{margin:0;font-size:clamp(2.6rem,3.4vw,3.2rem);font-weight:550;line-height:1;letter-spacing:.01em;opacity:.93}.map-sheet__legend{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.45rem 1rem;margin-top:.85rem;color:#415047;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:.88rem;font-weight:600;line-height:1}.map-sheet__legend-item{display:inline-flex;align-items:center;gap:.38rem;white-space:nowrap}.map-sheet__legend-item i{width:.58rem;height:.58rem;border:1.5px solid currentColor;border-radius:50%;box-shadow:inset 0 0 0 2px #fff;flex:0 0 auto}.map-sheet__legend-item--city{color:#002868}.map-sheet__legend-item--landmark{color:#ce1126}.map-sheet__legend-item--culture{color:#2f7652}.map-sheet__legend-item--planned{color:#7f6d33}.map-sheet__note{flex:0 0 auto;margin-top:.15rem;color:#1f392d;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:16px;font-weight:500;letter-spacing:.08em;opacity:.58;white-space:nowrap}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.map-drawing,.map-grid,.map-overlay{position:absolute;left:50%;top:50%;width:61.2vw;height:91.8vw;transform:translate(-50%,-50%)}.map-drawing{display:block;object-fit:contain}.map-grid{z-index:1;display:block;overflow:hidden;pointer-events:none}.map-overlay{z-index:2;display:block;overflow:hidden;pointer-events:auto}.map-grid__lines line{stroke:rgba(42,75,61,.22);stroke-width:1.5;stroke-dasharray:8 10;vector-effect:non-scaling-stroke}.map-grid__labels text{fill:rgba(42,75,61,.58);font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:27px;font-weight:600;paint-order:stroke;stroke:rgba(255,255,255,.9);stroke-width:5px;stroke-linejoin:round}.map-grid__labels--rows text{text-anchor:start}.city-marker{cursor:pointer;outline:none}.laos-map-page .city-marker--active{color:#002868}.laos-map-page .city-marker--landmark{color:#ce1126}.laos-map-page .city-marker--culture{color:#2f7652}.laos-map-page .city-marker--inactive{color:#7f6d33;cursor:default}.city-marker__ring{fill:color-mix(in srgb,currentColor 14%,transparent);stroke:currentColor;stroke-width:3;transition:opacity 180ms ease,transform 180ms ease;transform-box:fill-box;transform-origin:center}.city-marker__dot{fill:currentColor;stroke:#fff;stroke-width:3}.city-marker__leader{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.city-marker__label{fill:currentColor;font-family:Georgia,serif;font-size:30px;font-weight:700;paint-order:stroke;stroke:#fff;stroke-width:7px;stroke-linejoin:round}.city-marker--landmark .city-marker__label{font-size:27px;stroke-width:6px}.city-marker--culture .city-marker__ring{fill:transparent;stroke-width:2.5px;stroke-dasharray:4 3}.city-marker--culture .city-marker__dot{fill:#fff;stroke:currentColor;stroke-width:2.5px}.city-marker--culture .city-marker__leader{stroke-width:1.5px}.city-marker--culture .city-marker__label{font-size:18px;stroke-width:5px}.city-marker__label--left{text-anchor:end}.city-marker--inactive .city-marker__ring,.city-marker--inactive .city-marker__dot,.city-marker--inactive .city-marker__leader,.city-marker--inactive .city-marker__label{opacity:.88}.city-marker:hover .city-marker__ring,.city-marker:focus .city-marker__ring{transform:scale(1.18)}.city-preview{opacity:0;visibility:hidden;pointer-events:none;overflow:hidden;transition:opacity 180ms ease,visibility 180ms ease}.city-marker:hover .city-preview,.city-marker:focus .city-preview,.city-marker:focus-visible .city-preview{opacity:1;visibility:visible}.city-note{position:relative;width:420px;min-height:350px;padding:24px 24px 22px;background:#f6dc57;color:#29342f;box-shadow:0 18px 36px rgba(32,42,36,.2);font-family:'Caveat','Segoe Print','Bradley Hand',cursive;transform:rotate(-1.4deg)}.city-note--tadlo,.city-note--dondet{transform:rotate(1.2deg)}.city-note--active{background:#88acd1}.city-note__tape{position:absolute;z-index:2;top:-13px;left:50%;width:112px;height:28px;background:rgba(232,224,198,.76);transform:translateX(-50%) rotate(-2deg)}.city-note img{display:block;width:100%;height:145px;object-fit:cover;object-position:center 62%;filter:saturate(.68) contrast(.92);border:7px solid rgba(255,255,255,.72);box-sizing:border-box}.city-note__body{padding:15px 5px 0}.city-note__badge{display:inline-block;margin-bottom:5px;font-size:18px;font-weight:600;line-height:1;letter-spacing:.025em;color:#5f532d}.city-note--active .city-note__badge{color:#254864}.city-note strong{display:block;margin-bottom:4px;font-size:40px;font-weight:700;line-height:.98}.city-note p{margin:0 0 7px;font-size:20px;font-weight:500;line-height:1.15;color:rgba(41,52,47,.86)}.city-note__tags{display:block;margin:0 0 8px;color:rgba(31,63,86,.88);font-size:17px;font-weight:700;line-height:1.05}.city-note small{display:block;font-size:17px;font-weight:500;line-height:1.1;color:rgba(49,85,69,.82)}.city-note--active small{color:rgba(31,63,86,.86)}@media(max-width:1100px){.city-preview{display:none}}@media(max-width:700px){.laos-map-page{padding-top:3.5rem}.map-sheet{width:auto;padding:.75rem .75rem 10px}.map-sheet__header{gap:.15rem;flex-wrap:wrap}.map-sheet__title-block{width:100%;order:2}.map-sheet__note{order:1;margin-right:auto;margin-left:0}.map-sheet__chapter{font-size:12px}.map-sheet__title{font-size:42px}.map-sheet__legend{gap:.35rem .7rem;margin-top:.55rem;font-size:.74rem}.map-sheet__note{font-size:13px}.map-layers{width:calc(100vw - 4rem);height:calc(100vw - 4rem)}.map-drawing,.map-grid,.map-overlay{width:calc((100vw - 4rem)*.765);height:calc((100vw - 4rem)*1.1475)}.map-grid__labels text{font-size:34px}}
</style>
