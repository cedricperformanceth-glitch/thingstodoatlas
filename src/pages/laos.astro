---
import BaseLayout from '../layouts/BaseLayout.astro';

const pakse = { x: 679, y: 1024 };
const vientiane = { x: 384, y: 657 };
const tadLo = { x: 736, y: 970 };
const donDet = { x: 696, y: 1152 };
const luangPrabang = { x: 356, y: 576 };
---

<BaseLayout
  title="Explore Laos"
  description="Choose your next stop on an illustrated map of Laos. Begin with Pakse or Tad Lo, with more destinations added as the atlas grows."
  canonical="https://thingstodoatlas.com/laos"
>
  <section class="laos-map-page" aria-labelledby="laos-map-title">
    <header class="laos-map-intro">
      <p class="eyebrow">Laos · Chapter 02</p>
      <h1 id="laos-map-title">Choose a place<br /><em>on the map.</em></h1>
      <p>Follow the marked destinations across Laos and choose where the next chapter begins.</p>
    </header>

    <div class="map-sheet">
      <span class="map-sheet__note">Field map · Laos</span>

      <div class="map-layers">
        <img
          class="map-drawing"
          src="/images/hand-drawn/laos-map.webp"
          alt="Hand-drawn map of Laos"
          width="1024"
          height="1536"
        />

        <svg class="map-overlay" viewBox="0 0 1024 1536" role="img" aria-labelledby="map-title map-description">
          <title id="map-title">Destinations on the Laos map</title>
          <desc id="map-description">Marked destinations include Pakse, Vientiane, Tad Lo, Don Det and Luang Prabang.</desc>

          <g class="temporary-marker" aria-label="Pakse reference point">
            <circle class="temporary-marker__ring" cx={pakse.x} cy={pakse.y} r="22" />
            <circle class="temporary-marker__dot" cx={pakse.x} cy={pakse.y} r="9" />
            <path class="temporary-marker__leader" d={`M${pakse.x - 15} ${pakse.y - 5} L${pakse.x - 76} ${pakse.y - 28}`} />
            <text class="temporary-marker__label temporary-marker__label--left" x={pakse.x - 84} y={pakse.y - 32}>Pakse</text>
          </g>

          <g class="temporary-marker" aria-label="Vientiane reference point">
            <circle class="temporary-marker__ring" cx={vientiane.x} cy={vientiane.y} r="22" />
            <circle class="temporary-marker__dot" cx={vientiane.x} cy={vientiane.y} r="9" />
            <path class="temporary-marker__leader" d={`M${vientiane.x + 15} ${vientiane.y - 5} L${vientiane.x + 76} ${vientiane.y - 28}`} />
            <text class="temporary-marker__label" x={vientiane.x + 84} y={vientiane.y - 32}>Vientiane</text>
          </g>

          <g class="temporary-marker" aria-label="Tad Lo reference point">
            <circle class="temporary-marker__ring" cx={tadLo.x} cy={tadLo.y} r="22" />
            <circle class="temporary-marker__dot" cx={tadLo.x} cy={tadLo.y} r="9" />
            <path class="temporary-marker__leader" d={`M${tadLo.x + 15} ${tadLo.y - 5} L${tadLo.x + 76} ${tadLo.y - 28}`} />
            <text class="temporary-marker__label" x={tadLo.x + 84} y={tadLo.y - 32}>Tad Lo</text>
          </g>

          <g class="temporary-marker" aria-label="Don Det reference point">
            <circle class="temporary-marker__ring" cx={donDet.x} cy={donDet.y} r="22" />
            <circle class="temporary-marker__dot" cx={donDet.x} cy={donDet.y} r="9" />
            <path class="temporary-marker__leader" d={`M${donDet.x + 15} ${donDet.y - 5} L${donDet.x + 76} ${donDet.y - 28}`} />
            <text class="temporary-marker__label" x={donDet.x + 84} y={donDet.y - 32}>Don Det</text>
          </g>

          <g class="temporary-marker" aria-label="Luang Prabang reference point">
            <circle class="temporary-marker__ring" cx={luangPrabang.x} cy={luangPrabang.y} r="22" />
            <circle class="temporary-marker__dot" cx={luangPrabang.x} cy={luangPrabang.y} r="9" />
            <path class="temporary-marker__leader" d={`M${luangPrabang.x + 15} ${luangPrabang.y - 5} L${luangPrabang.x + 76} ${luangPrabang.y - 28}`} />
            <text class="temporary-marker__label" x={luangPrabang.x + 84} y={luangPrabang.y - 32}>Luang Prabang</text>
          </g>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .laos-map-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1180px) / 2));
    background: #f2eee3;
    color: #1f2924;
  }

  .laos-map-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .laos-map-intro h1 {
    margin: 0.35rem 0 1rem;
    font-size: clamp(3.2rem, 9vw, 7.8rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .laos-map-intro h1 em {
    font-weight: 400;
  }

  .laos-map-intro > p:last-child {
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .map-sheet {
    position: relative;
    width: 700px;
    margin: 0 auto;
    padding: 40px;
    border: 1px solid rgba(31, 41, 36, 0.14);
    background: #f7f2e6;
  }

  .map-sheet::before,
  .map-sheet::after {
    content: '';
    position: absolute;
    z-index: 3;
    width: 78px;
    height: 22px;
    background: rgba(199, 181, 143, 0.48);
  }

  .map-sheet::before {
    top: -9px;
    left: 8%;
    transform: rotate(-4deg);
  }

  .map-sheet::after {
    right: 8%;
    bottom: -8px;
    transform: rotate(3deg);
  }

  .map-sheet__note {
    position: absolute;
    z-index: 4;
    top: 1.25rem;
    right: 1.5rem;
    font-family: Georgia, serif;
    font-size: 0.75rem;
    font-style: italic;
    letter-spacing: 0.06em;
    opacity: 0.62;
  }

  .map-layers {
    position: relative;
    width: 620px;
    margin: 0 auto;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(31, 41, 36, 0.2),
      0 8px 22px rgba(31, 41, 36, 0.06);
  }

  .map-drawing {
    display: block;
    width: 620px;
    height: auto;
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 620px;
    height: 930px;
    overflow: visible;
    pointer-events: none;
  }

  .temporary-marker {
    color: #315545;
  }

  .temporary-marker__ring {
    fill: rgba(49, 85, 69, 0.1);
    stroke: currentColor;
    stroke-width: 3;
  }

  .temporary-marker__dot {
    fill: currentColor;
    stroke: #fff;
    stroke-width: 3;
  }

  .temporary-marker__leader {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .temporary-marker__label {
    fill: currentColor;
    font-family: Georgia, serif;
    font-size: 34px;
    font-weight: 700;
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 7px;
    stroke-linejoin: round;
  }

  .temporary-marker__label--left {
    text-anchor: end;
  }

  @media (max-width: 700px) {
    .laos-map-page {
      padding-top: 3.5rem;
    }

    .map-sheet {
      width: auto;
      padding: 0.75rem;
    }

    .map-sheet__note {
      top: 0.8rem;
      right: 0.9rem;
      font-size: 0.65rem;
    }

    .map-layers,
    .map-drawing,
    .map-overlay {
      width: 100%;
    }

    .map-overlay {
      height: 100%;
    }
  }
</style>