---
import BaseLayout from '../../layouts/BaseLayout.astro';
const categories = [
  { slug: 'restaurants', title: 'Restaurants', kicker: 'EAT · LOCAL · SLOW', text: 'Local favourites, street-side tables and reliable places worth saving.', icon: 'restaurants' },
  { slug: 'cafes', title: 'Cafés', kicker: 'COFFEE · PAUSE · SHADE', text: 'Quiet corners, good coffee and easy places to slow down for an hour.', icon: 'cafes' },
  { slug: 'accommodation', title: 'Guesthouses', kicker: 'SLEEP · SIMPLE · CENTRAL', text: 'Comfortable stays, local guesthouses and practical bases around town.', icon: 'guesthouses' },
  { slug: 'scooter-rental', title: 'Scooter Rental', kicker: 'KEYS · HELMET · ROAD', text: 'Trusted rentals, useful checks and the right bike for the roads ahead.', icon: 'scooter' },
  { slug: 'things-to-do', title: 'Things to do', kicker: 'WALK · SEE · EXPLORE', text: 'Experiences, local landmarks and useful ideas for your stay.', icon: 'bolaven' },
  { slug: 'gyms-fitness', title: 'Gyms & Fitness', kicker: 'TRAIN · MOVE · SWEAT', text: 'Muay Thai, weights and practical places to keep training on the road.', icon: 'gyms' },
  { slug: 'markets-shopping', title: 'Markets & Shopping', kicker: 'MARKETS · GOODS · FINDS', text: 'Fresh markets, useful shops and small things worth bringing home.', icon: 'markets' },
  { slug: 'essential-information', title: 'Essential Information', kicker: 'VISA · HEALTH · BASICS', text: 'Hospitals, pharmacies, visa help, ATMs, SIM cards and useful contacts.', icon: 'essential' },
];
---
<BaseLayout title="Things to do in Ahangama, Sri Lanka" description="Discover Ahangama, a southern coastal town shaped by surf breaks, cafés, village roads and a growing creative scene." canonical="https://thingstodoatlas.com/sri-lanka/ahangama">
<main class="pakse-page"><section class="pakse-hero" aria-labelledby="ahangama-title"><div class="pakse-hero__copy"><p class="pakse-hero__eyebrow">SRI LANKA · CHAPTER 03</p><h1 id="ahangama-title">Ahangama</h1><p class="pakse-hero__lede">A southern coastal town shaped by surf breaks, cafés, village roads and a growing creative scene.</p><span class="pakse-hero__field-note">FIELD NOTE — Surf lines · village roads</span></div><figure class="pakse-hero__visual"><span class="pakse-hero__tape pakse-hero__tape--top" aria-hidden="true"></span><img src="/images/placeholder-travel.webp" alt="A view of Ahangama in Sri Lanka" width="1600" height="1100" fetchpriority="high"/><figcaption>Ahangama · first notes from the road</figcaption><span class="pakse-hero__tape pakse-hero__tape--bottom" aria-hidden="true"></span></figure></section><section class="pakse-categories" aria-labelledby="ahangama-categories-title"><div class="pakse-categories__heading"><p>AHANGAMA DIRECTORY</p><h2 id="ahangama-categories-title">Open the notebook</h2></div><div class="category-grid">{categories.map((category,index)=>(<a class={`category-note category-note--${index%4}`} href={`/sri-lanka/ahangama/${category.slug}`} aria-label={`Explore ${category.title} in Ahangama`}><span class="category-note__tape" aria-hidden="true"></span><span class="category-note__illustration" aria-hidden="true">{category.icon==='restaurants'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M25 55c4 29 20 44 50 44s46-15 50-44" stroke-width="3.2"/><path d="M21 52c8-10 24-14 54-14s46 4 54 14c-8 10-24 14-54 14S29 62 21 52Z" stroke-width="3.2"/></g></svg>}{category.icon==='cafes'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M35 43h68v35c0 14-11 25-25 25H60c-14 0-25-11-25-25Z" stroke-width="3"/><path d="M103 51h12c11 0 18 7 18 16s-7 16-18 16h-12" stroke-width="3"/></g></svg>}{category.icon==='guesthouses'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M25 55 80 16l55 39" stroke-width="3.2"/><path d="M34 49v58h92V49" stroke-width="3"/></g></svg>}{category.icon==='scooter'&&<img class="category-note__traced-art" src="/images/laos/pakse-scooter-helmet.svg" alt=""/>}{category.icon==='bolaven'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="m22 28 34-10 47 12 35-10v73l-35 10-47-12-34 10Z" stroke-width="3"/><path d="M56 18v73M103 30v73" stroke-width="2"/></g></svg>}{category.icon==='gyms'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M28 45v31M39 37v47M51 32v57M109 32v57M121 37v47M132 45v31" stroke-width="4"/><path d="M51 60h58" stroke-width="5"/></g></svg>}{category.icon==='markets'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M34 48h92l-12 58H46Z" stroke-width="3"/><path d="M55 49c2-22 12-34 25-34s23 12 25 34" stroke-width="3"/></g></svg>}{category.icon==='essential'&&<svg viewBox="0 0 160 120"><g fill="none" stroke="currentColor"><path d="M25 46c0-9 7-16 16-16h71c9 0 16 7 16 16v50c0 9-7 16-16 16H41c-9 0-16-7-16-16Z" stroke-width="3"/><path d="M55 70h17V57h15v13h17v15H87v14H72V85H55Z" stroke-width="2.8"/></g></svg>}</span><span class="category-note__copy"><span class="category-note__kicker">{category.kicker}</span><span class="category-note__title">{category.title}</span><span class="category-note__text">{category.text}</span><span class="category-note__meta">Open the list <span aria-hidden="true">→</span></span></span><span class="category-note__corner" aria-hidden="true"></span></a>))}</div></section></main></BaseLayout>
<style>.pakse-page{min-height:100vh;background:#f2eee3;color:#1f2924}.pakse-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:clamp(2rem,5vw,5rem);width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(4.75rem,7vw,6rem) 0 clamp(2rem,4vw,3rem)}.pakse-hero__copy{position:relative;z-index:2;max-width:31rem}.pakse-hero__eyebrow{margin:0 0 .75rem;color:#8a4d36;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.pakse-hero h1{margin:0;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4rem,8vw,6.8rem);font-weight:400;letter-spacing:-.065em;line-height:.84}.pakse-hero__lede{max-width:29rem;margin:clamp(1.25rem,2vw,1.75rem) 0 0;color:#3f4943;font-family:Georgia,'Times New Roman',serif;font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.58}.pakse-hero__field-note{display:inline-block;margin-top:1.2rem;color:rgba(31,57,45,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(.72rem,.9vw,.82rem);letter-spacing:.04em;transform:rotate(-1.5deg)}.pakse-hero__visual{position:relative;width:clamp(24rem,36vw,34rem);margin:0;padding:.5rem .5rem 1.6rem;background:#fbf8f0;box-shadow:0 10px 24px rgba(38,45,40,.1);transform:rotate(.8deg)}.pakse-hero__visual img{display:block;width:100%;height:clamp(12rem,16vw,15rem);object-fit:cover}.pakse-hero__visual figcaption{position:absolute;left:.75rem;bottom:.4rem;color:rgba(31,41,36,.62);font-family:'Segoe Print','Bradley Hand',cursive;font-size:.58rem}.pakse-hero__tape{position:absolute;z-index:2;width:3.8rem;height:.8rem;background:rgba(196,177,139,.48)}.pakse-hero__tape--top{top:-.28rem;left:50%;transform:translateX(-50%) rotate(-3deg)}.pakse-hero__tape--bottom{right:1rem;bottom:-.28rem;transform:rotate(4deg)}.pakse-categories{width:min(1180px,calc(100% - 2.5rem));margin:0 auto;padding:clamp(2rem,4vw,4rem) 0 clamp(5rem,8vw,8rem)}.pakse-categories__heading{margin-bottom:1.4rem}.pakse-categories__heading p{margin:0 0 .4rem;color:rgba(31,57,45,.56);font-size:.7rem;font-weight:700;letter-spacing:.2em}.pakse-categories__heading h2{margin:0;color:#1f392d;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,4vw,3.6rem);font-weight:400}.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1rem,2vw,1.5rem)}.category-note{position:relative;display:grid;grid-template-columns:8.5rem minmax(0,1fr);align-items:center;gap:1rem;min-height:11rem;padding:1.15rem;overflow:visible;color:#181a18;text-decoration:none;background:#f8f5ec;border:1px solid rgba(24,26,24,.2);box-shadow:0 5px 12px rgba(31,41,36,.045)}.category-note--0{transform:rotate(-.4deg)}.category-note--1{transform:rotate(.35deg)}.category-note--2{transform:rotate(-.2deg)}.category-note--3{transform:rotate(.5deg)}.category-note__tape{position:absolute;top:-.45rem;left:.75rem;width:4.3rem;height:1.25rem;background:rgba(213,204,184,.72);clip-path:polygon(2% 12%,95% 0,100% 84%,5% 100%);transform:rotate(-6deg)}.category-note:nth-child(2) .category-note__tape,.category-note:nth-child(3) .category-note__tape,.category-note:nth-child(5) .category-note__tape,.category-note:nth-child(7) .category-note__tape,.category-note:nth-child(8) .category-note__tape{display:none}.category-note__illustration{display:flex;align-items:center;justify-content:center;min-height:7.5rem;color:#101210}.category-note__illustration svg,.category-note__traced-art{display:block;width:min(100%,8.7rem);height:auto}.category-note__copy{display:flex;flex-direction:column;align-items:flex-start}.category-note__kicker{margin-bottom:.35rem;font-size:.56rem;font-weight:700;letter-spacing:.15em}.category-note__title{font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(1.45rem,2.4vw,2rem);font-weight:700}.category-note__text{max-width:20rem;margin-top:.8rem;color:rgba(24,26,24,.76);font-family:Georgia,'Times New Roman',serif;font-size:.88rem;line-height:1.42}.category-note__meta{display:inline-flex;gap:.4rem;margin-top:.65rem;font-family:'Segoe Print','Bradley Hand',cursive;font-size:.72rem;font-weight:700}.category-note__corner{display:none}@media(max-width:900px){.category-grid{grid-template-columns:1fr}}@media(max-width:820px){.pakse-hero{grid-template-columns:1fr}.pakse-hero__visual{width:min(100%,34rem);margin:0 auto}}@media(max-width:560px){.category-note{grid-template-columns:6.5rem minmax(0,1fr);min-height:9.5rem;padding:.95rem}}</style>