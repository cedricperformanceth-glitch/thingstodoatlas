---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityGuidePage from '../../components/CityGuidePage.astro';
import { getCityGuide } from '../../data/contentModel';

const city = getCityGuide('sri-lanka', 'ahangama');
if (!city) throw new Error('Ahangama city guide is not configured');
---

<BaseLayout
  title="Things to do in Ahangama, Sri Lanka"
  description={city.description}
  canonical="https://thingstodoatlas.com/sri-lanka/ahangama"
>
  <CityGuidePage city={city} />
</BaseLayout>
