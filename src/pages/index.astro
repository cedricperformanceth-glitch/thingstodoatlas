---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageCountries } from '../data/atlas';
import MicroAnnotation from '../components/micro-annotations/MicroAnnotation.astro';

const homepageCountryChapters = homepageCountries.map((country, index) => index === 1 ? {
  ...country,
  slug: 'laos',
  name: 'Laos',
  mood: 'Authenticity - Road Trip',
  description: 'A country of slow rivers, wild waterfalls and quiet roads, where the journey matters as much as the destination.',
  image: '/images/laos-chapter-main.webp'
} : index === 2 ? {
  ...country,
  slug: 'sri-lanka',
  name: 'Sri Lanka',
  mood: 'Sunset · Serenity',
  description: 'From misty tea hills to the warm southern coast, Sri Lanka unfolds through slow train rides, ocean sunsets and stories shared along the way.',
  image: '/images/hand-drawn/sri-lanka-chapter-main.webp',
  routeNote: 'HILLSIDE TEA · CAMPFIRES ON THE BEACH'
} : country);
---

<BaseLayout title="A living atlas for curious travellers" description="ThingsToDoAtlas is a living travel companion for places worth your time across Thailand, Laos and Sri Lanka.">
  <section class="atlas-hero container" aria-labelledby="hero-title">
    <div class="atlas-hero__copy">
      <img class="journal-drawing journal-drawing--tuk-tuk" src="/images/hand-drawn/tuk-tuk-route.webp" alt="" width="1329" height="1183" aria-hidden="true" />
      <p class="eyebrow">A living travel companion</p>
      <h1 id="hero-title">Explore the Unexpected</h1>
      <h2 class="lede">Every destination has hidden gems waiting to be discovered. Explore authentic places, connect with local culture and uncover unforgettable experiences across Thailand, Laos and Sri Lanka.</h2>
      <a class="button button--arrow" href="#countries">Open your chapter <span aria-hidden="true">↘</span></a>
      <span class="hand-note hero-hand-note">I always begin by<br />looking around.</span>
    </div>
    <div class="atlas-hero__visual">
      <MicroAnnotation name="field-notes-stamp" family="navigation" color="terracotta" size="small" class="atlas-hero__stamp" />
      <img src="/images/heros-page.webp" alt="A visual journey through the landscapes, temples and local streets of Southeast Asia" width="1500" height="837" fetchpriority="high" />
      <span class="image-caption">Somewhere south of the usual route</span>
      <MicroAnnotation name="keep-this-feeling" family="navigation" color="ink" size="medium" class="hero-photo-note" />
      <MicroAnnotation name="notebook-compass" family="terrain" color="terracotta" size="small" class="hero-compass" />
    </div>
  </section>

  <section class="intro-band" aria-labelledby="intro-title">
    <div class="container intro-band__grid">
      <aside class="intro-band__aside">
        <p class="eyebrow">How the journey grows</p>
        <img class="intro-band__green-notebook" src="/images/hand-drawn/travel-notebook-green.webp" alt="" width="1536" height="1024" loading="lazy" aria-hidden="true" />
        <span class="hand-note intro-band__hand-note">Collect places<br />as you go.</span>
      </aside>
      <div class="intro-band__main">
        <h2 id="intro-title">Your journey comes together<br /><em>as you explore.</em></h2>
        <div class="journey-sequence" aria-label="How your journey grows">
          <div class="journey-step"><span class="journey-step__mark" aria-hidden="true">↗</span><strong>Explore</strong><small>Find what feels right</small></div>
          <div class="journey-step"><span class="journey-step__mark" aria-hidden="true">+</span><strong>Save</strong><small>Add it to My Trip</small></div>
          <div class="journey-step"><span class="journey-step__mark" aria-hidden="true">⌁</span><strong>Collect</strong><small>Let the journey take shape</small></div>
          <div class="journey-step"><span class="journey-step__mark" aria-hidden="true">→</span><strong>Take it with you</strong><small>Copy, print or export later</small></div>
        </div>
        <aside class="intro-band__trip-slip" aria-label="My Trip preview">
          <span class="intro-band__trip-label">My Trip</span>
          <ul>
            <li>Scooter rental</li>
            <li>Tad Fane</li>
            <li>Coffee stop</li>
            <li>Guesthouse</li>
          </ul>
          <small>Ready when you are.</small>
        </aside>
        <p class="intro-band__support hand-note">Explore first. Your trip takes shape along the way.</p>
      </div>
    </div>
  </section>

  <section class="country-section container" id="countries" aria-labelledby="countries-title">
    <div class="section-heading">
      <div><p class="eyebrow">The first chapters</p><h2 id="countries-title">Where will you<br /><em>begin?</em></h2></div>
      <p class="section-heading__aside">Three countries.<br />Many ways in.</p>
    </div>
    <div class="country-list">
      {homepageCountryChapters.map((country, index) =>
        <article class:list={["country-feature", "country-feature--1"]} id={index === 0 ? `country-${country.slug}` : `country-${country.slug}-${index + 1}`}>
          <span class="country-feature__stitching" aria-hidden="true"></span>
          <div class="country-feature__image">
            {country.slug === 'sri-lanka'
              ? <div class="country-feature__sri-gallery">
                  <img class="country-feature__sri-polaroid country-feature__sri-polaroid--main" src="/images/hand-drawn/sri-lanka-polaroid-01.webp" alt="Tropical beach and rock on the Sri Lankan coast" width="1254" height="1254" loading="lazy" />
                  <span class="country-feature__sri-first-stop hand-note">First stop<br /><b>— Weligama</b></span>
                  <img class="country-feature__sri-polaroid country-feature__sri-polaroid--coast" src="/images/hand-drawn/sri-lanka-polaroid-02.webp" alt="Sigiriya rock rising above the Sri Lankan landscape" width="1254" height="1254" loading="lazy" />
                  <img class="country-feature__sri-polaroid country-feature__sri-polaroid--beach" src="/images/hand-drawn/sri-lanka-polaroid-03.webp" alt="Sri Lankan train crossing a misty mountain bridge" width="1254" height="1254" loading="lazy" />
                  <img class="country-feature__sri-mask" src="/images/hand-drawn/sri-lanka-mask.webp" alt="" width="720" height="820" loading="lazy" aria-hidden="true" />
                  <span class="country-feature__sri-tape country-feature__sri-tape--main" aria-hidden="true"></span>
                  <span class="country-feature__sri-tape country-feature__sri-tape--coast" aria-hidden="true"></span>
                  <span class="country-feature__sri-tape country-feature__sri-tape--beach" aria-hidden="true"></span>
                </div>
              : <img src={country.image} alt={`${country.name} landscape`} width="1600" height="1100" loading="lazy" />}
            <span class="country-feature__number"><small>CH.</small><b>0{index + 1}</b></span>
            {country.slug === 'thailand' && <>
              <span class="country-feature__photo-note">First stop</span>
              <span class="country-feature__sunrise-note" aria-hidden="true">← sunrise</span>
              <a class="country-feature__photo-link" href={`/${country.slug}`} aria-label={`Explore ${country.name}`}><span>Explore {country.name}</span><svg viewBox="0 0 34 12" aria-hidden="true"><path d="M1 6 C9 5 18 7 31 5 M25 1 L32 5 L26 11" /></svg></a>
              <img class="country-feature__under-drawing" src="/images/hand-drawn/bangkok-skytrain.webp" alt="" width="1536" height="1024" loading="lazy" aria-hidden="true" />
              <img class="country-feature__second-photo" src="/images/thailand-wat-arun.webp" alt="Wat Arun and Bangkok skyline" width="499" height="613" loading="lazy" />
              <svg class="country-feature__photo-connector" viewBox="0 0 120 80" aria-hidden="true"><path d="M3 9 C34 12 51 49 115 70" /></svg>
              <svg class="country-feature__tape country-feature__tape--main" viewBox="0 0 72 18" aria-hidden="true"><path d="M2 3 L68 1 L70 15 L4 17 Z" /></svg>
              <svg class="country-feature__tape country-feature__tape--second" viewBox="0 0 72 18" aria-hidden="true"><path d="M2 3 L68 1 L70 15 L4 17 Z" /></svg>
            </>}
            {country.slug === 'laos' && <>
              <svg class="country-feature__tape country-feature__tape--main" viewBox="0 0 72 18" aria-hidden="true"><path d="M2 3 L68 1 L70 15 L4 17 Z" /></svg>
              <svg class="country-feature__tape country-feature__tape--second" viewBox="0 0 72 18" aria-hidden="true"><path d="M2 3 L68 1 L70 15 L4 17 Z" /></svg>
              <img class="country-feature__laos-tuktuk" src="/images/hand-drawn/tuk-tuk-page.webp" alt="" width="1024" height="1024" loading="lazy" aria-hidden="true" />
            </>}
          </div>
          <div class="country-feature__copy">
            {country.slug === 'sri-lanka' && <img class="country-feature__sri-ticket" src="/images/hand-drawn/sri-lanka-bus-ticket.webp" alt="" width="1024" height="1536" loading="lazy" aria-hidden="true" />}
            <p class:list={["eyebrow", ['thailand', 'laos', 'sri-lanka'].includes(country.slug) && "country-feature__mood-note"]}>{country.mood}</p>
            <h3>{country.name}</h3>
            <p>{country.description}</p>
            {country.slug === 'laos' && <span class="country-feature__route-note hand-note">FIELD NOTE — River mist · quiet rhythms</span>}
            {country.slug === 'laos' && <div class="country-feature__laos-map-row"><img class="journal-drawing journal-drawing--laos-map country-feature__laos-map" src="/images/hand-drawn/laos-map.webp" alt="" width="1024" height="1536" loading="lazy" aria-hidden="true" /><a class="country-feature__photo-link country-feature__photo-link--laos" href={`/${country.slug}`} aria-label={`Explore ${country.name}`}><span>Explore {country.name}</span><svg viewBox="0 0 34 12" aria-hidden="true"><path d="M1 6 C9 5 18 7 31 5 M25 1 L32 5 L26 11" /></svg></a></div>}
            {country.slug === 'laos' && <img class="journal-drawing journal-drawing--lotus" src="/images/hand-drawn/lotus-field-note.webp" alt="" width="1200" height="1200" loading="lazy" aria-hidden="true" />}
            {country.slug === 'thailand' && <span class="country-feature__route-note hand-note">field note — {country.routeNote}</span>}
            {country.slug === 'thailand' && <img class="journal-drawing journal-drawing--thailand-map country-feature__margin-drawing" src="/images/hand-drawn/thailand-map.webp" alt="" width="1024" height="1536" loading="lazy" aria-hidden="true" />}
            {country.slug === 'thailand' && <a class="country-feature__photo-link country-feature__photo-link--right-page" href={`/${country.slug}`} aria-label={`Explore ${country.name}`}><span>Explore {country.name}</span><svg viewBox="0 0 34 12" aria-hidden="true"><path d="M1 6 C9 5 18 7 31 5 M25 1 L32 5 L26 11" /></svg></a>}
            {country.slug === 'sri-lanka' && <span class="country-feature__route-note country-feature__sri-field-note hand-note">FIELD NOTE — {country.routeNote}</span>}
            {country.slug === 'sri-lanka' && <div class="country-feature__sri-map-row">
              <img class="country-feature__sri-map" src="/images/hand-drawn/sri-lanka-map.webp" alt="Hand-drawn map of Sri Lanka" width="676" height="1166" loading="lazy" />
              <a class="country-feature__sri-cta" href="/sri-lanka" aria-label="Explore Sri Lanka"><span>Explore Sri Lanka</span><svg viewBox="0 0 34 12" aria-hidden="true"><path d="M1 6 C9 5 18 7 31 5 M25 1 L32 5 L26 11" /></svg></a>
            </div>}
            {country.slug !== 'sri-lanka' && (country.status === 'open' ? <a class="text-link text-link--large" href={`/${country.slug}`}>Enter the {country.name} chapter <span aria-hidden="true">→</span></a> : <span class="coming-note">Chapter opening soon <span aria-hidden="true">·</span> stay curious</span>)}
          </div>
        </article>
      )}
    </div>
  </section>

  <section class="journey-transition" aria-label="Atlas note">
    <div class="journey-transition__line" aria-hidden="true"></div>
    <div class="container journey-transition__inner">
      <img class="journal-drawing journal-drawing--surfboards" src="/images/hand-drawn/surfboards-palm.webp" alt="" width="1200" height="1200" loading="lazy" aria-hidden="true" />
      <span class="journey-transition__stamp">Field note<br /><b>01</b></span>
      <div class="journey-transition__message">
        <p>There is always another road.<br /><em>Let’s see where it goes.</em></p>
        <a class="journey-transition__cta" href="#countries">
          <span>Choose your next chapter</span>
          <svg viewBox="0 0 42 12" aria-hidden="true"><path d="M1 7 C12 5 24 8 39 5 M33 1 L40 5 L34 11" /></svg>
        </a>
        <nav class="journey-transition__destinations" aria-label="Choose your next destination">
          <a class="journey-transition__destination journey-transition__destination--thailand" href="/thailand">Thailand</a>
          <span aria-hidden="true">·</span>
          <a class="journey-transition__destination journey-transition__destination--laos" href="/laos">Laos</a>
          <span aria-hidden="true">·</span>
          <a class="journey-transition__destination journey-transition__destination--sri-lanka" href="/sri-lanka">Sri Lanka</a>
        </nav>
      </div>
      <span class="journey-transition__coordinates">Mekong · Indian Ocean · Gulf of Thailand</span>
    </div>
  </section>

  <style>
    :global(#country-thailand .country-feature__copy::after){display:none;content:none}
    :global(.intro-band__green-notebook){transform:translateY(70px)}
    :global(.intro-band__hand-note){transform:translateY(70px) rotate(-5deg)}
    @media(min-width:701px){
      :global(.intro-band__hand-note){left:-320px;top:170px;transform:rotate(-40deg)}
    }
    .journey-transition__line{top:58%;transform:rotate(-8deg)}
    .journey-transition__stamp{transform:translateY(28px) rotate(-9deg)}
    .journey-transition__message{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;background:var(--paper-deep);padding:0 22px}
    .journey-transition__message p{margin:0;padding:0;background:transparent}
    .journey-transition__cta{position:relative;display:inline-flex;align-items:center;gap:11px;margin-top:24px;padding:2px 0 9px;color:var(--green);font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:clamp(1.28rem,2vw,1.58rem);font-weight:600;line-height:1;text-decoration:none;transition:transform .2s ease,color .2s ease}
    .journey-transition__cta::after{content:'';position:absolute;left:0;right:46px;bottom:2px;height:3px;border-radius:999px;background:currentColor;opacity:.42;transform:scaleX(.34) rotate(-1deg);transform-origin:left center;transition:transform .22s ease,opacity .22s ease}
    .journey-transition__cta svg{width:42px;height:12px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .22s ease}
    .journey-transition__cta:hover,.journey-transition__cta:focus-visible{color:var(--green-dark);outline:none;transform:translateY(-2px) rotate(-.5deg)}
    .journey-transition__cta:hover::after,.journey-transition__cta:focus-visible::after{opacity:.72;transform:scaleX(1) rotate(-1deg)}
    .journey-transition__cta:hover svg,.journey-transition__cta:focus-visible svg{transform:translateX(4px)}
    .journey-transition__destinations{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:11px;color:var(--muted);font-size:.6rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
    .journey-transition__destination{position:relative;padding:3px 0;color:inherit;text-decoration:none;transition:color .2s ease,transform .2s ease}
    .journey-transition__destination::after{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:999px;background:currentColor;transform:scaleX(0);transform-origin:left center;transition:transform .2s ease}
    .journey-transition__destination:hover,.journey-transition__destination:focus-visible{outline:none;transform:translateY(-1px)}
    .journey-transition__destination:hover::after,.journey-transition__destination:focus-visible::after{transform:scaleX(1)}
    .journey-transition__destination--thailand:hover,.journey-transition__destination--thailand:focus-visible{color:#3478b8}
    .journey-transition__destination--laos:hover,.journey-transition__destination--laos:focus-visible{color:#b7473b}
    .journey-transition__destination--sri-lanka:hover,.journey-transition__destination--sri-lanka:focus-visible{color:#d27b35}
    @media(max-width:700px){.journey-transition__line{top:56%;transform:rotate(-10deg)}.journey-transition__stamp{transform:translateY(18px) rotate(-8deg)}.journey-transition__message{padding:0 8px}.journey-transition__cta{margin-top:20px;font-size:1.24rem}.journey-transition__destinations{gap:6px;font-size:.55rem;letter-spacing:.1em}}
  </style>
</BaseLayout>