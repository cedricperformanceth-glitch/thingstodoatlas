---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanMyTripIntro from '../components/PlanMyTripIntro.astro';

const gridColumns = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
const gridRows = Array.from({ length: 12 }, (_, index) => index + 1);
---

<BaseLayout
  title="Explore Thailand"
  description="Choose your next stop on the Thailand map. More destinations will be added as the atlas grows."
  canonical="https://thingstodoatlas.com/thailand"
>
  <section class="laos-map-page" aria-labelledby="thailand-map-title">
    <div class="map-sheet">
      <div class="map-layers">
        <header class="map-sheet__header">
          <span class="map-sheet__note">FIELD MAP · THAILAND</span>
          <div class="map-sheet__title-block">
            <svg class="map-sheet__title-art" viewBox="0 0 680 112" role="presentation" aria-hidden="true">
              <text class="map-sheet__chapter" x="677" y="20" text-anchor="end">THAILAND · CHAPTER 01</text>
              <text class="map-sheet__title" x="680" y="88" text-anchor="end">Choose a place on the map</text>
            </svg>
            <h2 id="thailand-map-title" class="visually-hidden">Choose a place on the map</h2>
          </div>
        </header>

        <svg class="map-drawing" viewBox="0 0 1024 1536" role="img" aria-labelledby="thailand-art-title thailand-art-desc">
          <title id="thailand-art-title">Hand-drawn map of Thailand</title>
          <desc id="thailand-art-desc">Illustrated Thailand map based on the original notebook artwork.</desc>
          <defs>
            <filter id="thailand-hand-drawn" x="-8%" y="-8%" width="116%" height="116%">
              <feTurbulence type="fractalNoise" baseFrequency="0.008 0.025" numOctaves="2" seed="17" result="noise" />
              <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" xChannelSelector="R" yChannelSelector="G" />
            </filter>
          </defs>
          <g filter="url(#thailand-hand-drawn)">
            <image href="/images/hand-drawn/thailand-map.webp" x="0" y="0" width="1024" height="1536" preserveAspectRatio="xMidYMid meet" />
          </g>
        </svg>

        <svg class="map-grid" viewBox="0 0 1024 1536" aria-hidden="true">
          <g class="map-grid__lines">
            {Array.from({ length: 9 }, (_, index) => (
              <line x1={index * 128} y1="0" x2={index * 128} y2="1536" />
            ))}
            {Array.from({ length: 13 }, (_, index) => (
              <line x1="0" y1={index * 128} x2="1024" y2={index * 128} />
            ))}
          </g>
          <g class="map-grid__labels map-grid__labels--columns">
            {gridColumns.map((label, index) => (
              <text x={(index * 128) + 64} y="34" text-anchor="middle">{label}</text>
            ))}
          </g>
          <g class="map-grid__labels map-grid__labels--rows">
            {gridRows.map((label, index) => (
              <text x="18" y={(index * 128) + 74}>{label}</text>
            ))}
          </g>
        </svg>
      </div>
    </div>
    <PlanMyTripIntro />
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&display=swap');

  .laos-map-page{min-height:100vh;padding:clamp(4rem,8vw,7rem) max(1.25rem,calc((100vw - 1180px)/2));background:#f2eee3;color:#1f2924}
  .map-sheet{position:relative;width:fit-content;margin:0 auto;padding:26px 26px 10px;border:1px solid rgba(31,41,36,.14);background:#f7f2e6;overflow:visible}
  .map-sheet::before,.map-sheet::after{content:'';position:absolute;z-index:3;width:78px;height:22px;background:rgba(199,181,143,.48)}.map-sheet::before{top:-9px;left:8%;transform:rotate(-4deg)}.map-sheet::after{right:8%;bottom:-8px;transform:rotate(3deg)}
  .map-layers{position:relative;width:80vw;height:80vw;margin:0 auto;background:#fff;box-shadow:0 0 0 1px rgba(31,41,36,.2),0 8px 22px rgba(31,41,36,.06);overflow:hidden}
  .map-drawing,.map-grid{position:absolute;left:50%;top:50%;display:block;width:46vw;height:69vw;transform:translate(-50%,-43%)}.map-drawing{overflow:visible}.map-grid{z-index:1;overflow:visible;pointer-events:none}
  .map-grid__lines line{stroke:rgba(42,75,61,.22);stroke-width:1.5;stroke-dasharray:8 10;vector-effect:non-scaling-stroke}.map-grid__labels text{fill:rgba(42,75,61,.58);font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:27px;font-weight:600;paint-order:stroke;stroke:rgba(255,255,255,.9);stroke-width:5px;stroke-linejoin:round}.map-grid__labels--rows text{text-anchor:start}

  /* Shared marker hierarchy used by every country map. */
  .city-marker--active .city-marker__label{font-size:25px}
  .city-marker--landmark .city-marker__label{font-size:20px;stroke-width:5px}
  .city-marker--inactive .city-marker__label{font-size:15px;stroke-width:4px}
  .city-marker--active{color:#487fae}
  .city-marker--landmark{color:#b84a45}
  .city-marker--inactive{color:#7f6d33}

  /* Match the visible Laos marker sizes on the narrower Thailand map. */
  .city-marker--active .city-marker__ring,
  .city-marker--active .city-marker__dot,
  .city-marker--inactive .city-marker__ring,
  .city-marker--inactive .city-marker__dot,
  .city-marker--landmark .city-marker__ring,
  .city-marker--landmark .city-marker__dot{transform-box:fill-box;transform-origin:center}
  .city-marker--active .city-marker__ring,.city-marker--active .city-marker__dot{transform:scale(1.17)!important}
  .city-marker--active:hover .city-marker__ring,.city-marker--active:focus .city-marker__ring{transform:scale(1.38)!important}
  .city-marker--inactive .city-marker__ring,.city-marker--inactive .city-marker__dot,.city-marker--inactive:hover .city-marker__ring,.city-marker--inactive:focus .city-marker__ring{transform:scale(1.06)!important}
  .city-marker--landmark .city-marker__ring,.city-marker--landmark .city-marker__dot{transform:scale(.67)!important}
  .city-marker--landmark:hover .city-marker__ring,.city-marker--landmark:focus .city-marker__ring{transform:scale(.8)!important}

  .map-sheet__header{position:absolute;z-index:2;top:clamp(1.4rem,3vw,2.5rem);left:clamp(1.25rem,4vw,3.25rem);right:clamp(1.25rem,4vw,3.25rem);display:flex;align-items:flex-start;justify-content:space-between;gap:1.25rem;color:#1f392d;pointer-events:none}
  .map-sheet__title-block{width:min(42rem,70%);margin-left:auto;text-align:right}.map-sheet__title-art{display:block;width:100%;height:auto;overflow:visible}.map-sheet__chapter,.map-sheet__title{fill:#1f392d;font-family:'Caveat','Segoe Print','Bradley Hand',cursive}.map-sheet__chapter{font-size:15px;font-weight:500;letter-spacing:.12em;opacity:.62}.map-sheet__title{font-size:51px;font-weight:550;letter-spacing:.01em;opacity:.93}.map-sheet__note{flex:0 0 auto;margin-top:.15rem;color:#1f392d;font-family:'Caveat','Segoe Print','Bradley Hand',cursive;font-size:16px;font-weight:500;letter-spacing:.08em;opacity:.58;white-space:nowrap}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  @media(max-width:700px){.laos-map-page{padding-top:3.5rem}.map-sheet{width:auto;padding:.75rem .75rem 10px}.map-sheet__header{gap:.15rem;flex-wrap:wrap}.map-sheet__title-block{width:100%;order:2}.map-sheet__note{order:1;margin-right:auto;margin-left:0}.map-sheet__chapter{font-size:12px}.map-sheet__title{font-size:42px}.map-sheet__note{font-size:13px}.map-layers{width:calc(100vw - 4rem);height:calc(100vw - 4rem)}.map-drawing,.map-grid{width:calc((100vw - 4rem)*.575);height:calc((100vw - 4rem)*.8625)}.map-grid__labels text{font-size:34px}}
</style>
